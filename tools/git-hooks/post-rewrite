#!/usr/bin/env bash
# rebase（pull --rebase を含む）の後に engine DLL を作り直す（DLL は Git 管理外・issue #785）。
# $1=amend|rebase。amend は HEAD の中身を作業ツリーから作るだけなので対象外。
[ "${1:-}" = rebase ] || exit 0
root="$(git rev-parse --show-toplevel)"
[ -f "$root/tools/sync-engine-dll-if-changed.sh" ] || exit 0
bash "$root/tools/sync-engine-dll-if-changed.sh" ORIG_HEAD HEAD
