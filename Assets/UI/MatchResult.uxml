<?xml version="1.0" encoding="utf-8"?>
<!-- 試合結果画面（GameResult.mock 準拠・2026-11-21 作り直し）。ライブ観戦の終局から自動で開く出口画面。
     上から ①見出し（「試合結果」＋閉じる）②スコア（イニングスコア＋長打の行）③両チームの成績（左＝自校・右＝相手）。
     ①②は固定で、③だけを ScrollView 1つで包む＝左右の列が一緒にスクロールする。
     主要操作は「閉じる」1つだけ（UI原則7）。表の行は MatchResultController が組む。色は固定（スクールカラーは使わない）。 -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="tokens.uss" />
    <Style src="KokoSimTheme.uss" />
    <Style src="Components/components.uss" />
    <Style src="MatchResult.uss" />

    <ui:VisualElement class="ui-root mres-root">

        <!-- ① 見出し -->
        <ui:VisualElement class="mres-head">
            <ui:VisualElement class="mres-head__bar" />
            <ui:Label text="試合結果" class="mres-head__title" />
            <ui:VisualElement class="mres-head__spacer" />
            <ui:Button name="mr-close" text="閉じる" class="mres-close f-body-bd" />
        </ui:VisualElement>

        <!-- ② スコア -->
        <ui:VisualElement class="mres-card mres-score">
            <ui:VisualElement name="mr-line" class="mres-line" />
            <ui:VisualElement name="mr-xbh" class="mres-xbh" />
        </ui:VisualElement>

        <!-- ③ 両チームの成績（ここだけスクロール） -->
        <ui:ScrollView name="mr-body" class="mres-body" mode="Vertical" horizontal-scroller-visibility="Hidden">
            <ui:VisualElement class="mres-cols">
                <ui:VisualElement name="mr-left" class="mres-card mres-side" />
                <ui:VisualElement name="mr-right" class="mres-card mres-side mres-side--right" />
            </ui:VisualElement>
        </ui:ScrollView>

    </ui:VisualElement>
</ui:UXML>
