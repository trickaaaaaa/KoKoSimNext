<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="TopBar" src="Components/TopBar.uxml" />
    <Style src="tokens.uss" />
    <Style src="Components/components.uss" />
    <Style src="KokoSimTheme.uss" />
    <Style src="Components/scorebook.uss" />
    <ui:VisualElement class="root sbk hm-root">

      <!-- ===== 共通トップバー（スコアボード＋ナビ・単一ソース） ===== -->
      <ui:Instance template="TopBar" class="topbar-slot" />

      <!-- ===== 主役のカード（スクールカラー地・高さ148）=====
           大会期間は「次の試合」、大会のない時期は「次の大会まで」。コントローラが
           hm-hero-match / hm-hero-plain を display で二者択一する。地の色は acc-bg（SchoolAccent）。 -->
      <ui:VisualElement name="home-hero" class="hm-hero acc-bg">
        <ui:VisualElement class="hm-hero__ring" />

        <!-- 大会期間：試合まで｜区分・大会名／自校 vs 相手校・ランク｜試合日・天気予報 -->
        <ui:VisualElement name="hm-hero-match" class="hm-hero__state">
          <ui:VisualElement class="hm-hero__big">
            <ui:Label class="hm-hero__big-k" text="試合まで" />
            <ui:VisualElement class="hm-hero__big-row">
              <ui:Label name="hero-days" class="hm-hero__big-num" text="2" />
              <ui:Label name="hero-days-unit" class="hm-hero__big-unit" text="日" />
            </ui:VisualElement>
          </ui:VisualElement>
          <ui:VisualElement class="hm-hero__mid">
            <ui:VisualElement class="hm-hero__row">
              <ui:Label name="game-tag" class="hm-hero__tag" text="リーグ第2戦" />
              <ui:Label name="tournament-name" class="hm-hero__tname" text="" />
            </ui:VisualElement>
            <ui:VisualElement class="hm-hero__row hm-hero__row--teams">
              <ui:Label name="home-team" class="hm-hero__team" text="桜丘" />
              <ui:Label class="hm-hero__vs" text="vs" />
              <ui:Label name="away-team" class="hm-hero__team" text="享栄" />
              <ui:VisualElement name="away-rank-group" class="hm-hero__rank">
                <ui:Label class="hm-hero__rank-k" text="ランク" />
                <ui:VisualElement name="away-rank" class="hm-hero__rank-chip" />
              </ui:VisualElement>
            </ui:VisualElement>
          </ui:VisualElement>
          <ui:VisualElement class="hm-hero__side">
            <ui:VisualElement class="hm-hero__fact">
              <ui:Label class="hm-hero__fact-k" text="試合日" />
              <ui:Label name="match-day" class="hm-hero__fact-v" text="9月15日" />
            </ui:VisualElement>
            <!-- 天気（issue #803/#1199）。試合当日だけ・屋内は出さない＝コントローラが display:none で隠す。 -->
            <ui:VisualElement name="weather-group" class="hm-hero__fact hm-hero__fact--wx">
              <ui:Label class="hm-hero__fact-k" text="天気予報" />
              <ui:VisualElement class="hm-hero__wx">
                <ui:VisualElement name="weather-icon" class="hm-hero__weather-icon wx-icon--sunny-dark" />
                <ui:Label name="weather-temp-num" class="hm-hero__wx-num" text="21" />
                <ui:Label name="weather-temp-unit" class="hm-hero__wx-unit" text="℃" />
              </ui:VisualElement>
            </ui:VisualElement>
            <!-- 次の試合日まで進める（まとめて進行・issue #1479）。止まる条件は HomeDashboardController.Advance。 -->
            <ui:Button name="advance-next-match" class="hm-hero__btn" text="次の試合日まで ▶" />
          </ui:VisualElement>
        </ui:VisualElement>

        <!-- 大会のない時期：〇の大会まで N週｜大会名・開幕の週／週の目盛り -->
        <ui:VisualElement name="hm-hero-plain" class="hm-hero__state">
          <ui:VisualElement class="hm-hero__big">
            <ui:Label name="hero-cd-label" class="hm-hero__big-k" text="夏の大会まで" />
            <ui:VisualElement class="hm-hero__big-row">
              <ui:Label name="hero-cd-num" class="hm-hero__big-num" text="13" />
              <ui:Label name="hero-cd-unit" class="hm-hero__big-unit" text="週" />
            </ui:VisualElement>
          </ui:VisualElement>
          <ui:VisualElement class="hm-hero__mid hm-hero__mid--grow">
            <ui:VisualElement class="hm-hero__row">
              <ui:Label name="next-tournament" class="hm-hero__next" text="夏予選" />
              <ui:Label name="opening-week" class="hm-hero__open" text="7月2週 開幕" />
            </ui:VisualElement>
            <ui:VisualElement name="ticks" class="hm-ticks" />
            <ui:VisualElement name="tick-labels" class="hm-ticks hm-ticks--labels" />
          </ui:VisualElement>
          <!-- 次の大会まで進める（まとめて進行・issue #1479）。目盛りの終点＝次の大会に合わせる。 -->
          <ui:Button name="advance-next-tournament" class="hm-hero__btn hm-hero__btn--plain" text="次の大会まで ▶" />
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- ===== 3列（372｜残り全部｜360・間隔16） ===== -->
      <ui:VisualElement name="home-dash" class="hm-dash">

        <!-- 左：チームランク（縦に伸ばす）／故障者 -->
        <ui:VisualElement class="hm-col hm-col--a">
          <ui:VisualElement name="team-strength-row" class="hm-card hm-card--grow hm-card--link">
            <ui:VisualElement class="hm-card__hd">
              <ui:Label class="hm-card__title" text="チームランク" />
              <ui:VisualElement class="hm-card__hd-right">
                <ui:Label class="hm-card__aside" text="総合" />
                <ui:VisualElement name="team-strength-chip" class="hm-overall__chip" />
                <ui:Label name="team-strength-value" class="hm-overall__v" text="—" />
              </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hm-radar-wrap">
              <ui:VisualElement name="hm-radar" class="hm-radar" />
            </ui:VisualElement>
          </ui:VisualElement>

          <ui:VisualElement name="injury-card" class="hm-card hm-card--inj">
            <ui:VisualElement class="hm-inj-hd">
              <ui:Label class="hm-card__title hm-card__title--sm" text="故障者" />
              <ui:VisualElement class="hm-card__hd-right">
                <ui:Label name="injury-count" class="hm-count__n" text="0" />
                <ui:Label class="hm-count__u" text="人" />
              </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="injury-scroll" mode="Vertical" class="hm-inj-scroll">
              <ui:VisualElement name="injury-list" />
            </ui:ScrollView>
          </ui:VisualElement>
        </ui:VisualElement>

        <!-- 中：チーム成績／チーム内ランキング（縦に伸ばす） -->
        <ui:VisualElement class="hm-col hm-col--b">
          <ui:VisualElement name="stats-card" class="hm-card hm-card--stats">
            <ui:VisualElement name="stats-head" class="hm-st-row hm-st-row--head">
              <ui:Label class="hm-card__title hm-st-k" text="チーム成績" />
              <ui:Label class="hm-st-c hm-st-c--th" text="通算" />
              <ui:Label class="hm-st-c hm-st-c--th hm-st-c--off" text="公式戦" />
              <ui:Label name="stats-cur-head" class="hm-st-cur hm-st-cur--th acc-bg" text="今大会" />
            </ui:VisualElement>
            <ui:VisualElement name="team-stats" />
            <ui:VisualElement name="stats-empty" class="hm-empty">
              <ui:VisualElement class="hm-empty__icon hm-icon-chart" />
              <ui:VisualElement class="hm-empty__text">
                <ui:Label class="hm-empty__t1" text="まだ試合の記録がありません" />
                <ui:Label class="hm-empty__t2" text="練習試合や公式戦を行うと、ここに打率や防御率が出ます" />
              </ui:VisualElement>
            </ui:VisualElement>
          </ui:VisualElement>

          <ui:VisualElement class="hm-card hm-card--grow">
            <ui:VisualElement class="hm-card__hd">
              <ui:Label class="hm-card__title" text="チーム内ランキング" />
              <ui:VisualElement name="rank-scope" class="hm-seg" />
            </ui:VisualElement>
            <ui:VisualElement name="rank-body" class="hm-rk">
              <ui:VisualElement class="hm-rk__col">
                <ui:VisualElement class="hm-rk-row hm-rk-row--head">
                  <ui:Label class="hm-rk-k hm-rk-k--sec" text="打撃" />
                  <ui:Label class="hm-rk-1 hm-rk-th" text="1位" />
                  <ui:Label class="hm-rk-2 hm-rk-th hm-rk-th--r" text="2位" />
                </ui:VisualElement>
                <ui:VisualElement name="rank-bat" />
              </ui:VisualElement>
              <ui:VisualElement class="hm-rk__gap" />
              <ui:VisualElement class="hm-rk__col">
                <ui:VisualElement class="hm-rk-row hm-rk-row--head">
                  <ui:Label class="hm-rk-k hm-rk-k--sec" text="投手" />
                  <ui:Label class="hm-rk-1 hm-rk-th" text="1位" />
                  <ui:Label class="hm-rk-2 hm-rk-th hm-rk-th--r" text="2位" />
                </ui:VisualElement>
                <ui:VisualElement name="rank-pit" />
              </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="rank-empty" class="hm-empty">
              <ui:VisualElement class="hm-empty__icon hm-icon-trophy" />
              <ui:VisualElement class="hm-empty__text">
                <ui:Label class="hm-empty__t1" text="まだランキングはありません" />
                <ui:Label class="hm-empty__t2" text="試合を重ねると、打撃・投手の部門ごとにチーム内の上位が出ます" />
              </ui:VisualElement>
            </ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>

        <!-- 右：個別指導／今週の出来事（縦に伸ばす） -->
        <ui:VisualElement class="hm-col hm-col--c">
          <ui:VisualElement class="hm-card hm-card--side">
            <ui:VisualElement class="hm-card__hd">
              <ui:Label class="hm-card__title" text="個別指導" />
              <ui:VisualElement class="hm-card__hd-right">
                <ui:Label class="hm-card__aside" text="枠" />
                <ui:Label name="guidance-used" class="hm-count__n hm-count__n--sm" text="0" />
                <ui:Label name="guidance-total" class="hm-card__aside" text="/ 3 使用中" />
              </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="guidance-list" />
          </ui:VisualElement>

          <ui:VisualElement class="hm-card hm-card--side hm-card--grow">
            <ui:VisualElement class="hm-card__hd">
              <ui:Label class="hm-card__title" text="今週の出来事" />
            </ui:VisualElement>
            <ui:ScrollView mode="Vertical" class="hm-feed-scroll">
              <ui:VisualElement name="feed-list" />
            </ui:ScrollView>
          </ui:VisualElement>
        </ui:VisualElement>

      </ui:VisualElement>

      <!-- ===== イベント（ノベル提示・設計書03 §5 / issue #609）=====
           案B「トップバー残し・立ち絵中」。暗幕を全画面に敷かず、トップバーの下の本文域だけを
           入れ替える（昼NBの白地に暗幕は合わないため。コントローラが hero/dash と二者択一する）。
           面のどこを押しても次の行へ進み、最後の行で閉じる。 -->
      <ui:VisualElement name="ev-novel" class="ev">
        <ui:VisualElement class="rule-head ev__eyebrow">
          <ui:VisualElement class="rule-head__rule" />
          <ui:Label name="ev-eyebrow" class="rule-head__text" text="今週の出来事" />
        </ui:VisualElement>

        <!-- 立ち絵スロット（役割ごとの単色シルエット。絵が無い役割はこのまま／絵が有る役割は
             ev-portrait-image に差し替わる。差し替え口は EventNovelView.EventPortraits）。
             背景（ev-bg）は場面ごとの写真をぼかした1枚を舞台いっぱいに敷く（issue #1516。差し替え口は EventScenes）。 -->
        <ui:VisualElement class="ev__stage">
          <ui:VisualElement name="ev-bg" class="ev__bg" picking-mode="Ignore" />
          <ui:VisualElement name="ev-portrait" class="ev-por">
            <ui:VisualElement name="ev-portrait-image" class="ev-por__image" />
            <ui:VisualElement class="ev-por__head" />
            <ui:VisualElement class="ev-por__body" />
            <ui:Label name="ev-portrait-role" class="ev-por__role" text="コーチ" />
          </ui:VisualElement>
        </ui:VisualElement>

        <!-- 会話ボックス（話者名＝明朝／本文＝サンセリフ） -->
        <ui:VisualElement class="ev__box">
          <ui:Label name="ev-speaker" class="ev__speaker f-display" text="コーチ" />
          <ui:Label name="ev-say" class="ev__say" text="" />
          <!-- 監督の対応の3択（issue #945・案A＝最後の台詞の下に縦並び）。中身は EventNovelView が部品辞書の ChoiceButton で組む。 -->
          <ui:VisualElement name="ev-choices" class="ev__choices" />
          <ui:VisualElement class="ev__foot">
            <ui:Label name="ev-progress" class="ev__progress f-num" text="" />
            <!-- 会話を飛ばす（赴任イベント・チュートリアルだけ・issue #1496）。押すと最後の行（選択肢）まで進む。 -->
            <ui:Label name="ev-skip" class="ev__skip" text="スキップ ▶▶" />
            <ui:Label name="ev-hint" class="ev__hint" text="クリックで次へ" />
          </ui:VisualElement>
          <!-- 結果（誰の・何が・いくつ）は右下の帯でなく会話の最終行＝結果行（USS の ev__say の result 修飾）で出す
               （2026-08-19 監督指示。旧・案A2 の帯 ev-effect は廃止）。XMLコメント内に二重ハイフンを書くと
               UXML の取り込みが黙って空になる（画面が丸ごと消える）ので、クラス名をそのまま書かない。 -->
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- 大会モード: 開幕バナー（全画面センター・フェード）。既定は非表示、コントローラが出す。 -->
      <ui:VisualElement name="tm-banner" class="ui-root tm-banner">
        <ui:VisualElement class="tm-banner__inner">
          <ui:Label name="tm-banner-top" class="tm-banner__top" text="2028年　夏" />
          <ui:VisualElement class="tm-banner__rule" />
          <ui:Label name="tm-banner-name" class="tm-banner__name" text="選手権神奈川大会" />
          <ui:Label class="tm-banner__open" text="開　幕" />
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- 大会モード: 試合開始ダイアログ（はい／いいえ）。 -->
      <ui:VisualElement name="tm-dialog" class="ui-root tm-scrim">
        <ui:VisualElement class="tm-card tm-dialog__card">
          <ui:Label name="tm-dialog-round" class="tm-dialog__round" text="２回戦" />
          <ui:Label name="tm-dialog-vs" class="tm-dialog__vs" text="vs 享栄 [B]" />
          <ui:Label class="tm-dialog__q" text="試合を始めますか？" />
          <ui:VisualElement class="tm-dialog__btns">
            <ui:Button name="tm-dialog-no" class="tm-btn tm-btn--ghost" text="いいえ" />
            <ui:Button name="tm-dialog-yes" class="tm-btn tm-btn--primary" text="はい" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- 新チーム発足: 次期主将の指名（設計書09 §8）。左に候補リスト、右に選択中の詳細（案C）。
           候補は新最上級生。統率力の生値は出さず、可視情報（総合・精神力・性格・特殊能力）で選ばせる。 -->
      <ui:VisualElement name="nt-modal" class="ui-root modal-scrim">
        <ui:VisualElement class="modal-card nt-card">
          <ui:VisualElement class="nt-hd">
            <ui:Label class="nt-hd__t" text="新チーム始動" />
            <ui:Label name="nt-retired" class="nt-hd__s" text="" />
          </ui:VisualElement>
          <ui:Label name="nt-lead" class="nt-lead" text="" />

          <ui:VisualElement class="nt-body">
            <!-- 左: 候補リスト（32px行） -->
            <ui:VisualElement class="nt-list">
              <ui:VisualElement class="nt-th">
                <ui:Label class="nt-c-no nt-th__c" text="背" />
                <ui:Label class="nt-c-name nt-th__c" text="選手" />
                <ui:Label class="nt-c-mental nt-th__c" text="精神" />
                <ui:Label class="nt-c-rank nt-th__c" text="スタメン" />
                <ui:Label class="nt-c-rank nt-th__c" text="ベンチ" />
                <ui:Label class="nt-c-state nt-th__c" text="チーム状態" />
              </ui:VisualElement>
              <ui:ScrollView name="nt-rows" class="nt-rows" />
            </ui:VisualElement>

            <!-- 右: 選択中の詳細（レーダー＋可視情報＋特殊能力） -->
            <ui:VisualElement class="nt-detail">
              <ui:Label name="nt-d-name" class="nt-d__name" text="" />
              <ui:Label name="nt-d-sub" class="nt-d__sub" text="" />
              <ui:VisualElement name="nt-d-radar" class="nt-d__radar" />
              <ui:VisualElement name="nt-d-facts" class="nt-d__facts" />
              <ui:Label class="nt-d__cap" text="特殊能力" />
              <ui:VisualElement name="nt-d-skills" class="nt-d__skills" />
            </ui:VisualElement>
          </ui:VisualElement>

          <ui:VisualElement class="nt-foot">
            <ui:Label name="nt-note" class="nt-foot__note" text="" />
            <ui:Button name="nt-ok" class="tm-btn tm-btn--primary nt-ok" text="この選手を主将にする" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- 監督オファー: 転任の選択（設計書04 §1.3）。左に候補（残留＋オファー校）、右に選択中の詳細。
           強制転任は残留行が無く候補1件のみ＝拒否できない（設計どおり）。 -->
      <ui:VisualElement name="xt-modal" class="ui-root modal-scrim">
        <ui:VisualElement class="modal-card xt-card">
          <ui:VisualElement class="xt-hd">
            <ui:Label name="xt-hd-title" class="xt-hd__t" text="" />
          </ui:VisualElement>
          <ui:Label name="xt-lead" class="xt-lead" text="" />

          <ui:VisualElement class="xt-body">
            <!-- 左: 候補リスト（32px行） -->
            <ui:VisualElement class="xt-list">
              <ui:VisualElement class="xt-th">
                <ui:Label class="xt-c-name xt-th__c" text="学校" />
                <ui:Label class="xt-c-pref xt-th__c" text="県" />
                <ui:Label class="xt-c-rank xt-th__c" text="格" />
                <ui:Label class="xt-c-power xt-th__c" text="総合" />
              </ui:VisualElement>
              <ui:ScrollView name="xt-rows" class="xt-rows" />
            </ui:VisualElement>

            <!-- 右: 選択中の詳細 -->
            <ui:VisualElement class="xt-detail">
              <ui:Label name="xt-d-name" class="xt-d__name f-display" text="" />
              <ui:Label name="xt-d-sub" class="xt-d__sub" text="" />
              <ui:VisualElement name="xt-d-facts" class="xt-d__facts" />
            </ui:VisualElement>
          </ui:VisualElement>

          <ui:VisualElement class="xt-foot">
            <ui:Label name="xt-note" class="xt-foot__note" text="" />
            <ui:Button name="xt-ok" class="tm-btn tm-btn--primary xt-ok" text="" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- 年契約の更新（設計書04 §1.4a）。契約中の系統を1枚ずつめくって段を選び、最後に年額合計と部費の見込みを確かめる。 -->
      <ui:VisualElement name="cr-modal" class="ui-root modal-scrim">
        <ui:VisualElement class="modal-card crn-card">
          <ui:Label name="cr-title" class="crn-hd" text="" />
          <ui:VisualElement name="cr-body" class="crn-body" />
          <ui:VisualElement class="crn-foot">
            <ui:Button name="cr-back" class="dlg-btn dlg-btn--ghost" text="戻る" />
            <ui:Button name="cr-next" class="dlg-btn dlg-btn--primary" text="次へ" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- 体験版の終了（Web 体験版 #1323・配置A「中央のカード1枚」）。DemoEndPanel が埋める。ストアのボタンは
           ストアページができるまで出さない（DemoGate.StoreUrl）。 -->
      <ui:VisualElement name="de-modal" class="ui-root modal-scrim">
        <ui:VisualElement class="modal-card de-card">
          <ui:Label class="de-hd f-display" text="体験版はここまで" />
          <ui:Label name="de-school" class="de-sub f-display" text="" />
          <ui:VisualElement name="de-rows" class="de-rows" />
          <ui:Label class="de-lead f-body" text="続きは製品版で。3年目の夏へ。" />
          <ui:Button name="de-store" class="dlg-btn dlg-btn--primary de-store" text="ストアページ" />
          <ui:VisualElement class="de-foot">
            <ui:Button name="de-close" class="dlg-btn dlg-btn--ghost" text="閉じる" />
            <ui:Button name="de-title" class="dlg-btn dlg-btn--ghost" text="タイトルへ" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- 大会モード: 試合結果（自動消化）。 -->
      <ui:VisualElement name="tm-result" class="ui-root tm-scrim">
        <ui:VisualElement class="tm-card tm-result__card">
          <ui:Label name="tm-result-round" class="tm-result__round" text="２回戦" />
          <ui:Label name="tm-result-headline" class="tm-result__headline" text="勝利！" />
          <ui:Label name="tm-result-score" class="tm-result__score" text="桜丘 5 - 2 享栄" />
          <ui:Button name="tm-result-ok" class="tm-btn tm-btn--primary" text="次へ" />
        </ui:VisualElement>
      </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
