<?xml version="1.0" encoding="utf-8"?>
<!-- スカウト画面（設計書04 §2.1 受動枠 ／ §2.4 スカウト・issue #587, #867）。
     レイアウトは左に一覧・右に選んだ1人の詳細（オーナー決定2026-11-09・ワイヤー案A＝
     監督選択のB案と同じマスターディテール）。
     スカウト網の契約段はここでは変更しない（買い物の唯一の場所は経営タブ・二重実装しない）。
     上部は共通トップバー（Components/TopBar.uxml）を単一ソースとして使う。 -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="TopBar" src="Components/TopBar.uxml" />
    <Style src="tokens.uss" />
    <Style src="Components/components.uss" />
    <Style src="KokoSimTheme.uss" />
    <Style src="Components/scorebook.uss" />
    <Style src="ScoutScreen.uss" />
    <ui:VisualElement class="root ui-root sbk">

      <ui:Instance template="TopBar" class="topbar-slot" />

      <ui:VisualElement class="sc-main">

        <!-- 見出し（新聞の柱見出し＝RuleHead・設計書16 §5） -->
        <ui:VisualElement class="sc-masthead">
          <ui:VisualElement class="rule-head">
            <ui:VisualElement class="rule-head__rule" />
            <ui:Label class="rule-head__text f-display" text="スカウト" />
          </ui:VisualElement>
        </ui:VisualElement>

        <!-- ===== 共通の上部帯（オーナー決定2026-11-09・ワイヤー案A） ===== -->
        <ui:VisualElement name="sc-topband" class="sc-topband">
          <ui:Label name="sc-net" class="sc-topband__item" text="" />
          <ui:VisualElement class="sc-topband__sep" />
          <ui:Label class="sc-topband__label" text="探す分野" />
          <ui:VisualElement name="sc-field-tabs" class="sc-field-tabs" />
          <ui:VisualElement class="sc-topband__sep" />
          <ui:Label name="sc-slots" class="sc-topband__item" text="" />
          <ui:VisualElement class="sc-topband__spacer" />
          <ui:Label name="sc-milestone" class="sc-topband__item sc-topband__item--muted" text="" />
          <ui:Button name="sc-to-management" class="tool-btn" text="経営で変更" />
        </ui:VisualElement>

        <ui:VisualElement class="sc-split">

          <!-- ===== 左：名簿（入部予定者 / スカウト候補のタブ切替） ===== -->
          <ui:VisualElement class="sc-split__left">
            <ui:VisualElement name="sc-tabs" class="sc-tabs" />
            <ui:VisualElement class="nb-plate sc-plate">
              <ui:VisualElement class="nb-plate__shadow" />
              <ui:VisualElement class="nb-plate__front">

                <ui:VisualElement class="plate-header plate-header--grass">
                  <ui:Label name="sc-list-title" class="plate-header__title" text="入部予定者" />
                  <ui:Label name="sc-list-sub" class="plate-header__sub" text="" />
                </ui:VisualElement>

                <ui:VisualElement class="row-well sc-well">
                  <ui:VisualElement name="sc-thead" class="sc-thead">
                    <ui:Label class="sc-th sc-th--name" text="氏名" />
                    <ui:Label name="sc-th-2" class="sc-th sc-th--hand" text="投打" />
                    <ui:Label name="sc-th-3" class="sc-th sc-th--est" text="事前の見立て" />
                    <ui:Label name="sc-th-4" class="sc-th sc-th--unknown" text="？" />
                    <ui:Label name="sc-th-5" class="sc-th sc-th--visits" text="訪問" />
                  </ui:VisualElement>
                  <ui:ScrollView name="sc-scroll" mode="Vertical" class="sc-scroll">
                    <ui:VisualElement name="sc-rows" />
                  </ui:ScrollView>
                  <ui:Label name="sc-empty" class="sc-empty" text="" />
                </ui:VisualElement>

              </ui:VisualElement>
            </ui:VisualElement>
          </ui:VisualElement>

          <!-- ===== 右：選んだ1人の見立て ===== -->
          <ui:ScrollView mode="Vertical" class="sc-split__right scroll">

            <ui:VisualElement name="sc-detail" class="sc-detail">

              <ui:VisualElement class="sc-head">
                <ui:Label name="sc-name" class="sc-name f-display" text="" />
                <ui:Label name="sc-sub" class="sc-sub" text="" />
              </ui:VisualElement>

              <!-- スカウト候補を見ているときだけ出す（issue #867）。入部の見込み（%）は出さない。 -->
              <ui:VisualElement name="sc-scout-card" class="card">
                <ui:VisualElement class="card__hd card__hd--tight">
                  <ui:Label class="card__hd-title" text="寸評" />
                  <ui:Label name="sc-scout-note" class="card__hd-sub" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="card__body">
                  <ui:Label name="sc-blurb" class="sc-blurb" text="" />
                  <ui:VisualElement name="sc-scout" class="sc-scout" />
                  <ui:VisualElement class="sc-scout__actions">
                    <ui:Button name="sc-visit" class="tool-btn" text="訪問する" />
                    <ui:Label name="sc-scout-status" class="sc-scout__status" text="" />
                  </ui:VisualElement>
                </ui:VisualElement>
              </ui:VisualElement>

              <!-- 見立てと隠しパラメータは横並び（片方だけだと項目4つに対して幅が余りすぎる）。
                   スカウト候補では「わかっていること」（隠し素質）は出さない（issue #867・オーナー決定2）。 -->
              <ui:VisualElement class="sc-row2">
                <ui:VisualElement class="card card--half">
                  <ui:VisualElement class="card__hd card__hd--tight">
                    <ui:Label class="card__hd-title" text="事前の見立て" />
                    <ui:Label name="sc-est-note" class="card__hd-sub" text="" />
                  </ui:VisualElement>
                  <ui:VisualElement class="card__body">
                    <ui:VisualElement name="sc-est" class="sc-est" />
                  </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="sc-hidden-card" class="card card--half sc-card-last">
                  <ui:VisualElement class="card__hd card__hd--tight">
                    <ui:Label class="card__hd-title" text="わかっていること" />
                  </ui:VisualElement>
                  <ui:VisualElement class="card__body">
                    <ui:VisualElement name="sc-hidden" class="sc-hidden" />
                  </ui:VisualElement>
                </ui:VisualElement>
              </ui:VisualElement>

              <!-- 個別能力（段3だけ・issue #867）。 -->
              <ui:VisualElement name="sc-detail-card" class="card">
                <ui:VisualElement class="card__hd card__hd--tight">
                  <ui:Label class="card__hd-title" text="個別能力" />
                </ui:VisualElement>
                <ui:VisualElement class="card__body">
                  <ui:VisualElement name="sc-detail-abilities" class="sc-detail-abilities" />
                </ui:VisualElement>
              </ui:VisualElement>

              <!-- スカウト評（入部予定者のときだけ・受動枠の見立てから起こす一言） -->
              <ui:VisualElement name="sc-comment-card" class="card">
                <ui:VisualElement class="card__hd card__hd--tight">
                  <ui:Label class="card__hd-title" text="スカウト評" />
                </ui:VisualElement>
                <ui:VisualElement class="card__body">
                  <ui:Label name="sc-comment" class="sc-comment" text="" />
                </ui:VisualElement>
              </ui:VisualElement>

            </ui:VisualElement>

            <ui:Label name="sc-detail-empty" class="sc-detail-empty" text="" />

          </ui:ScrollView>

        </ui:VisualElement>

      </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
