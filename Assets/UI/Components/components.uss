/* ═══════════════════════════════════════════════════════════════════════
   components.uss — 部品辞書（UI-BUILD-METHOD Step 2）
   ───────────────────────────────────────────────────────────────────────
   再利用される見た目の最小単位（アトム）を名前付きUSSクラスとして定義する。
   値はすべて tokens.uss の var(--...) を参照し、色・サイズ・余白を直書きしない。
   各アトムは Components/<Name>.uxml に同名のプレビュー（サンプルデータ）を持つ。
   画面側USS（TrainingPlan.uss）はここに無い見た目を自作せず、必要なら辞書へ追加する。
   ═══════════════════════════════════════════════════════════════════════ */

/* ── RankChip：総合/能力ランク S〜G（パワプロ風レター画像 Assets/UI/Images/ranks/） ─
   ランク文字は画像に焼き込み済み（色覚対応＝色＋文字併記はクリア）。Label のテキストは
   レイアウト幅と読み上げのために残し、色を透明にして画像とダブらせない。
   周辺の塗り色（バー・レーダー等）は tokens.uss --rank-* ＝画像から抽出した代表色を使う。 */
.rank-chip {
    min-width: 30px;
    height: 32px;
    -unity-text-align: middle-center;
    font-size: var(--fs-body);
    padding-left: 5px;
    padding-right: 5px;
    color: rgba(0, 0, 0, 0);
    background-size: contain;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
}
.rank-chip--S { background-image: url("project:///Assets/UI/Images/ranks/rank-S.png"); }
.rank-chip--A { background-image: url("project:///Assets/UI/Images/ranks/rank-A.png"); }
.rank-chip--B { background-image: url("project:///Assets/UI/Images/ranks/rank-B.png"); }
.rank-chip--C { background-image: url("project:///Assets/UI/Images/ranks/rank-C.png"); }
.rank-chip--D { background-image: url("project:///Assets/UI/Images/ranks/rank-D.png"); }
.rank-chip--E { background-image: url("project:///Assets/UI/Images/ranks/rank-E.png"); }
.rank-chip--F { background-image: url("project:///Assets/UI/Images/ranks/rank-F.png"); }
.rank-chip--G { background-image: url("project:///Assets/UI/Images/ranks/rank-G.png"); }
/* サイズ違い：総合ランクなど「1画面で1つだけ大きく出す」用途に限る（強調は希少資源＝UI原則②）。 */
/* Small は逆向きの用途＝1画面に何十個も並ぶ密な一覧（試合中の能力ビューア・issue #602）。
   画像は background-size: contain なので、枠を縮めればレターもそのまま縮む。 */
.rank-chip--sm { min-width: 22px; height: 22px; font-size: 13px; padding-left: 0; padding-right: 0; }
.rank-chip--lg { min-width: 44px; height: 44px; font-size: 28px; padding-left: 12px; padding-right: 12px; }
.rank-chip--xl { min-width: 60px; height: 60px; font-size: 40px; padding-left: 18px; padding-right: 18px; }

/* ── TypeChip：タイプ軸バッジ（弾道＝ゴロ型〜フライ型など優劣のない値, issue #219） ─
   RankChip の虹色（--rank-*）は使わない。単色・中立（--color-panel-deep地/--color-chalk文字）で
   「これは優劣ではない」ことが色そのもので分かるようにする。 */
.type-chip {
    height: 24px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: var(--fs-cap);
    color: var(--color-chalk);
    background-color: var(--color-panel-deep);
    border-radius: var(--radius-chip);
    padding-left: var(--sp-2);
    padding-right: var(--sp-2);
    margin-right: var(--sp-3);
}

/* ── CategoryRankChips：選手のカテゴリ別ランク（打撃力/走力/守備力/投手力, Issue #30/#140） ─
   選手一覧など「行1本にチップ4つ＋ラベル」を並べる画面専用。チップ本体は RankChip/RankChipLegacy を流用。 */
.cat-rank-chips { flex-direction: row; flex-wrap: wrap; align-items: center; }
.cat-rank-chips__label { font-size: var(--fs-cap); color: var(--color-muted); margin-left: var(--sp-2); }
/* 2段組（選手一覧の行）：上=打撃力・走力／下=守備力・投手力。1段4組では行幅が足りず中途半端に
   折り返すため段を固定する。ラベルは固定幅・右揃えで上下段のチップ列を縦に揃え、ブロック全体は
   セル内で右寄せ（align-items: flex-end）。 */
.cat-rank-rows { align-items: flex-end; justify-content: center; }
.cat-rank-rows__row { flex-direction: row; align-items: center; margin-top: 1px; margin-bottom: 1px; }
.cat-rank-rows__label {
    width: 58px; -unity-text-align: middle-right;
    font-size: var(--fs-cap); color: var(--color-muted); margin-right: var(--sp-1);
}
/* 小サイズ版（比較カード埋め込み・幅約156px, issue #326①）: 1段4組の全幅版・練習計画のコンパクト版
   （--compact＝1字ラベル）どちらより狭い場所に収める必要があるため、専用の縮小率を持つ。 */
.cat-rank-rows--sm .cat-rank-rows__row { margin-top: 0; margin-bottom: 0; }
.cat-rank-rows--sm .cat-rank-rows__label { width: 32px; font-size: 12px; margin-right: 2px; }
.cat-rank-rows--sm .grade { min-width: 20px; height: 22px; font-size: 12px; padding: 1px 3px; margin-right: 2px; }
/* コンパクト版（Issue #133・練習計画の行メタ枠）：1字ラベル「打走守投」＋小チップで横幅を詰める。 */
.cat-rank-chips--compact .cat-rank-chips__label { margin-left: 2px; margin-right: 2px; }
.cat-rank-chips--compact .grade {
    min-width: 24px; height: 26px; font-size: var(--fs-cap);
    padding-left: 3px; padding-right: 3px;
}
/* さらに小サイズ（issue #452・比較カード埋め込み）：カード幅約156pxへ4組を1行で収める。
   折り返すと2段組に戻って縦の得が消えるので、ラベル余白とチップ幅を詰めて 4×(13+20+2)=140px に収める。
   flex-wrap: nowrap は必須（.cat-rank-chips の wrap を打ち消す）。 */
.cat-rank-chips--sm { flex-wrap: nowrap; justify-content: center; }
.cat-rank-chips--sm .cat-rank-chips__label { font-size: 11px; margin-left: 1px; margin-right: 1px; }
.cat-rank-chips--sm .grade {
    min-width: 20px; height: 20px; font-size: 11px;
    padding-left: 2px; padding-right: 2px;
}

/* ── StackedBar：積み上げ横バー（練習配分の割合可視化, Issue #133） ─
   セグメント色は .stack-bar__seg--X（値は tokens.uss --tm-*）。合計<100% の残りは
   トラック地（白面）が見える＝休養/残り時間。黄はCTA専用なので帯に使わない。 */
.stack-bar {
    flex-direction: row;
    height: 16px;
    background-color: var(--color-panel);
    border-width: var(--border-w); border-color: var(--color-line);
}
.stack-bar__seg { height: 100%; flex-shrink: 0; }
.stack-bar__seg--batting    { background-color: var(--tm-batting); }
.stack-bar__seg--power      { background-color: var(--tm-power); }
.stack-bar__seg--discipline { background-color: var(--tm-discipline); }
.stack-bar__seg--strength   { background-color: var(--tm-strength); }
.stack-bar__seg--defense    { background-color: var(--tm-defense); }
.stack-bar__seg--throwing   { background-color: var(--tm-throwing); }
.stack-bar__seg--baserun    { background-color: var(--tm-baserun); }
.stack-bar__seg--bunt       { background-color: var(--tm-bunt); }
.stack-bar__seg--pitching   { background-color: var(--tm-pitching); }
.stack-bar__seg--breaking   { background-color: var(--tm-breaking); }
.stack-bar__seg--velocity   { background-color: var(--tm-velocity); }
.stack-bar__seg--running    { background-color: var(--tm-running); }
.stack-bar__seg--defpos     { background-color: var(--tm-defpos); }

/* ── TimeAllocSlider：練習時間ドラッグバー（issue #222②） ─
   トラックをクリック/ドラッグした位置を10分刻みへスナップして割り当てる。埋まっていない
   右側は未配分（＝伸ばせる余地）。委任中は .ta-slider--locked で静的表示（ポインタ配線なし）。 */
.ta-slider {
    flex-grow: 1; flex-basis: 0; min-width: 0;
    height: 10px;
    background-color: var(--color-panel-deep);
    border-width: var(--border-w); border-color: var(--color-line);
}
.ta-slider__fill { height: 100%; background-color: var(--color-muted); }
.ta-slider__fill--batting    { background-color: var(--tm-batting); }
.ta-slider__fill--power      { background-color: var(--tm-power); }
.ta-slider__fill--discipline { background-color: var(--tm-discipline); }
.ta-slider__fill--strength   { background-color: var(--tm-strength); }
.ta-slider__fill--defense    { background-color: var(--tm-defense); }
.ta-slider__fill--throwing   { background-color: var(--tm-throwing); }
.ta-slider__fill--baserun    { background-color: var(--tm-baserun); }
.ta-slider__fill--bunt       { background-color: var(--tm-bunt); }
.ta-slider__fill--pitching   { background-color: var(--tm-pitching); }
.ta-slider__fill--breaking   { background-color: var(--tm-breaking); }
.ta-slider__fill--velocity   { background-color: var(--tm-velocity); }
.ta-slider__fill--running    { background-color: var(--tm-running); }
.ta-slider__fill--defpos     { background-color: var(--tm-defpos); }
.ta-slider--locked { opacity: 0.5; }

/* ═══ design-19 デーゲーム・フルNB：枠＋ベタ影の器（G0 技術検証）═════════════════════
   USS に box-shadow / 擬似要素は無いので、ベタ影を2方式で再現する（design-19 §2）。
     ・案イ NbBorder … 非対称ボーダー（右/下だけ影色で太らせる）。1要素で済む＝行など量産部品向け。
     ・案ロ NbPlate  … 背面プレート（wrapper 内に absolute の黒プレートを敷き前面を左上へ寄せる）。
                        真の"ずれた影"が出る＝カード級・CTA など少数の主役向け。要素数は倍。
   どちらも枠色・影色・地色は tokens.uss のインク／面トークンだけを読む。 */

/* ── 案イ：非対称ボーダー（NbBorder）。単一要素にクラス1枚で付く量産用 ── */
.nb-border {
    background-color: var(--day-card);
    border-color: var(--ink);
    border-top-width: var(--nb-border);
    border-left-width: var(--nb-border);
    border-right-width: var(--nb-border);
    border-bottom-width: var(--nb-border);
    border-radius: 0;
}
/* 右下だけ影ぶん太らせて「右下にベタ影が落ちている」ように見せる（枠2px＋影3px＝5px）。 */
.nb-border--shadow {
    border-right-width: 5px;   /* --nb-border(2) + --nb-shadow(3) */
    border-bottom-width: 5px;
}

/* ── 案ロ：背面プレート（NbPlate）。wrapper＋影プレート＋前面の3要素 ──
   wrapper は影ぶんの余白を margin で確保し、影は out-of-flow（レイアウトを押し広げない）。
   前面は不透明面で影の重なり部分を隠す。子順は「影→前面」（後の兄弟が上に描画される）。 */
.nb-plate {
    margin-right: var(--nb-shadow-card);
    margin-bottom: var(--nb-shadow-card);
}
.nb-plate__shadow {
    position: absolute;      /* out-of-flow＝wrapper サイズに影響しない */
    left: var(--nb-shadow-card);
    top: var(--nb-shadow-card);
    width: 100%;             /* = 前面(flow子)の幅。offset ぶん右下へ食み出す＝ベタ影 */
    height: 100%;
    background-color: var(--ink);
}
.nb-plate__front {
    flex-shrink: 0;
    background-color: var(--sf-card);
    border-color: var(--ink);
    border-top-width: var(--nb-border-card);
    border-left-width: var(--nb-border-card);
    border-right-width: var(--nb-border-card);
    border-bottom-width: var(--nb-border-card);
    border-radius: 0;
}

/* ── PlateHeader：ペンキ塗りの見出しプレート（芝＝主／土＝副／空＝操作）＋白抜き題字 ──
   カードの上縁に敷く帯。題字は白抜き、右端にツール操作（並び替え等）を置ける。 */
.plate-header {
    flex-direction: row;
    align-items: center;
    padding: 14px 20px;
    border-bottom-width: var(--nb-border-card);
    border-bottom-color: var(--ink);
}
.plate-header--grass { background-color: var(--grass); }
.plate-header--dirt  { background-color: var(--dirt); }
.plate-header--sky   { background-color: var(--sky); }
.plate-header__title {
    font-size: var(--fs-page);
    letter-spacing: 3px;
    color: #FFFFFF;                    /* 芝/空プレートの白抜き題字 */
}
.plate-header--dirt .plate-header__title { color: var(--ink); }   /* 土プレートは明るいのでインク題字 */
.plate-header__sub {
    font-size: var(--fs-cap);
    color: #FFFFFF;
    opacity: 0.82;
    margin-left: 14px;
}
.plate-header--dirt .plate-header__sub { color: var(--ink); }
.plate-header__spacer { flex-grow: 1; }

/* ── RowWell + RowPanel：一覧の「行を独立パネル化」する共通部品（design-19）───────────
   罫線区切りをやめ、薄い土の井（RowWell）の上に、白い行パネル（RowPanel）を1枚ずつ積む。
   選手一覧・練習割当など**行を並べるあらゆる画面で共通に使う**（各画面で自作しない）。
   行の中身レイアウト（セルの列幅・並び）は各画面が担い、器の見た目だけをここで一元化する。
   影は案イ（非対称ボーダー：右下だけ太らせる）＝1要素で済む量産向け（G0で採用決定）。 */
.row-well {
    background-color: var(--dirt-well);
    padding: 6px 12px 18px 12px;
}
.row-panel {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    min-height: var(--h-row);
    background-color: var(--sf-card);        /* 昼＝白 */
    border-color: var(--ink);
    border-top-width: var(--nb-border);       /* 2px */
    border-left-width: var(--nb-border);
    border-right-width: 5px;                  /* 枠2 + ベタ影3（案イ） */
    border-bottom-width: 5px;
    border-radius: 0;
    margin-bottom: 12px;
    padding-left: var(--sp-4); padding-right: var(--sp-4);
    padding-top: 8px; padding-bottom: 8px;
}
/* クリックで詳細/モーダルへ開く行のホバー（桜色）。 */
.row-panel:hover { background-color: var(--sakura-tint); }
/* 選択行＝桜色＋左端インクの太帯。 */
.row-panel--selected { background-color: var(--sakura-tint); border-left-width: 5px; border-left-color: var(--ink); }
/* 高密度バリアント：部員が多い画面（練習割当）で1画面に見える行数を増やす（Issue #273・オーナー決定値）。
   .row-panel 本体（他画面）はそのまま据え置き、必要な画面だけこのクラスを併せて付ける（UI原則⑤）。 */
.row-panel--dense {
    min-height: var(--h-row-dense);
    padding-top: var(--sp-1); padding-bottom: var(--sp-1);
    margin-bottom: 6px;
}

/* ── SegTabs：区分の切替（セグメント）──
   1つの表の中身を排他で入れ替えるときに使う（区分見出しを縦に積む代わりに横で切る）。
   配色は design-19 の NB スキン（白地＋インク線・選択＝空の青）で、画面ローカルに
   同型を書いていた .tpm-tab / .ms-tab / .lu-tab の共通形をここへ出したもの。
   CTA（応援団赤）とは別＝操作系は空の青（UI原則②・design-19 §5）。 */
.seg-tabs {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
}
.seg-tab {
    height: 34px;
    padding-left: 18px; padding-right: 18px;
    padding-top: 0; padding-bottom: 0;
    -unity-text-align: middle-center;
    font-size: var(--fs-label);
    color: var(--color-muted);
    background-color: var(--sf-card);
    border-width: var(--border-w);
    border-color: var(--color-line);
    border-radius: 0;
    margin: 0;
    margin-right: 2px;
}
.seg-tab:hover { color: var(--color-chalk); }
.seg-tab--on { background-color: var(--sky); color: #FFFFFF; border-color: var(--sky); }

/* ── ToolButton：見出しプレート等に置く操作ボタン（白地・空青文字・インク枠＋小ベタ影）──
   並び替え・切替など。CTA（赤）とは別＝操作系は空の青（design-19 §5）。 */
.tool-btn {
    background-color: var(--sf-card);
    color: var(--sky);
    border-color: var(--ink);
    border-top-width: var(--nb-border); border-left-width: var(--nb-border);
    border-right-width: 4px; border-bottom-width: 4px;   /* 枠2 + 影2 */
    border-radius: 0;
    font-size: var(--fs-label);
    padding: 8px 16px;
}
.tool-btn:hover { color: var(--ink); }

/* ── AbilityRow：能力バー行（アイコン／能力名＋副題／ランクチップ／バー／数値／補足） ─
   能力バーを出す画面はこの部品だけを使う（UI原則③ランク併記・⑤部品辞書の外に出ない）。
   バー色はランク連動色を C# 側（RankPalette＝--rank-*）から与えるためここでは指定しない。
   固定幅の列には flex-shrink: 0 を必ず付ける（可変列に幅を奪われて列がずれるため）。 */
.abil-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--sp-2);
}
.abil-row--dim { opacity: 0.45; }              /* 伸びない能力など（一覧からは消さない） */
.abil-row--divided {
    padding-top: 5px;
    padding-bottom: 5px;
    margin-bottom: 0;
    border-bottom-width: var(--border-w);
    border-bottom-color: var(--color-line);
}
.abil-row__icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    background-color: var(--color-panel);
    color: var(--ink);
    border-radius: var(--radius-chip);
    font-size: var(--fs-label);
    margin-right: var(--sp-2);
}
.abil-row__name { width: 78px; flex-shrink: 0; }
.abil-row__label { font-size: var(--fs-label); color: var(--color-chalk); }
.abil-row__sub { font-size: var(--fs-cap); color: var(--color-muted); margin-top: 2px; }
.abil-row .rank-chip { margin-right: var(--sp-3); }
.abil-row__bar {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 8px;
    background-color: var(--color-panel-deep);
    border-radius: 0;
    margin-right: var(--sp-3);
}
.abil-row__value {
    width: 34px;
    flex-shrink: 0;
    font-size: var(--fs-num);
    -unity-text-align: middle-right;
    color: var(--color-chalk);
}
.abil-row__fill { height: 100%; border-radius: 0; }
/* 上限のない量の数値表示（スタミナ＝目安投球数, issue #356）。バーの無い行で数字＋和文単位（NumUnit）を
   右端＝値列の位置へ寄せる。数字は Oswald（.nu-num=f-num）・単位はサンセリフ（.nu-unit）。 */
.abil-row__numunit {
    margin-left: auto;      /* バーが無いぶん右端へ寄せて他行の値列と縦に揃える */
    flex-shrink: 0;
    justify-content: flex-end;
    align-items: baseline;
}
.abil-row__numunit .nu-num { font-size: var(--fs-num); color: var(--color-chalk); }
.abil-row__note {
    width: 40px;
    flex-shrink: 0;
    font-size: var(--fs-label);
    -unity-text-align: middle-right;
    color: var(--ink);
    margin-left: var(--sp-2);
}
.abil-row__note--muted { color: var(--color-muted); -unity-font-style: normal; }

/* コンパクト（行高32px固定・issue #327②-b）：「この設定で伸びる能力」など14行級の一覧を
   1カラムに一望で収める用。通常行が実測47pxへ膨らむ正体は (a) 19px指定でもフォントのライン高で
   テキスト実高が37pxになる (b) .unity-label 既定マージン（上4/下2px）の2つで、どちらもUSS宣言外。
   テキスト系の子へ高さ32pxを明示してフォント都合から行高を切り離す＝行高はチップと同じ32pxに固定され、
   フォント側の変更で行高が動かなくなる。副題（.abil-row__sub）を持つ行には使わない（2行分の高さが要る）。 */
.abil-row--compact { margin-bottom: 2px; }
.abil-row--compact .abil-row__icon,
.abil-row--compact .rank-chip,
.abil-row--compact .type-chip,
.abil-row--compact .abil-row__label,
.abil-row--compact .abil-row__value,
.abil-row--compact .abil-row__note { margin-top: 0; margin-bottom: 0; }
.abil-row--compact .abil-row__label { height: 32px; -unity-text-align: middle-left; }
.abil-row--compact .abil-row__value,
.abil-row--compact .abil-row__note { height: 32px; }

/* 大（チーム総合力パネル）：指標名を太く、数値を大きく、バーを太くする */
.abil-row--lg .abil-row__name { width: 182px; }
/* 内訳subは名前列の中で折り返す。既定の nowrap だと長い内訳（投手力の「球種（エース偏重）」等）が
   固定幅182pxを越えて右隣の数値に重なって描画される（fs-cap 13px化で顕在化した衝突）。 */
.abil-row--lg .abil-row__sub { white-space: normal; }
.abil-row--lg .abil-row__label { font-size: var(--fs-body); }
.abil-row--lg .rank-chip { margin-right: var(--sp-4); }
.abil-row--lg .abil-row__bar { height: 12px; margin-right: var(--sp-4); }
.abil-row--lg .abil-row__value { width: 58px; font-size: 34px; }

/* ── SimProgress：背景処理の進捗ストリップ（#208） ─────────────────────
   画面下端に「ロード中」＋充填バーだけを出す表示。大会名・県数など内部情報は出さない
   （ラベルは固定・バーの充填だけで進捗を表す）。レイアウト流し込みの最下段に置き（絶対配置に
   しない＝CTA など下端の本文を覆わない）、上端インク線で本文と分節する（UI原則④）。
   非表示時は display:none で場所も取らない（完了で即消える）。 */
.sim-load {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: var(--sp-2) var(--sp-4);
    background-color: var(--color-panel);
    border-top-width: var(--nb-border);
    border-top-color: var(--ink);
}
.sim-load__label {
    font-size: var(--fs-label);
    color: var(--color-chalk);
    margin-right: var(--sp-3);
    flex-shrink: 0;
}
.sim-load__track {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 8px;
    background-color: var(--color-panel-deep);
    border-radius: 0;
}
.sim-load__fill {
    height: 100%;
    width: 0;
    background-color: var(--ink);
    border-radius: 0;
}

/* ── NumberBadge：背番号バッジ ─────────────────────────────────────── */
.num-badge {
    width: 30px;
    height: 30px;
    -unity-text-align: middle-center;
    background-color: var(--color-panel-deep);
    /* 背番号は識別情報でありアクセントではない（UI原則②・黄はデータに使わない）＝文字は白、面は小片色。
       --sm 側だけこの方針で、通常サイズが黄のまま取り残されていたのを F3 で揃えた。
       一覧に20個並ぶ番号が全部アンバーだと、本当のアクセント（今週を進める）が埋もれる。 */
    color: var(--color-chalk);
    border-width: var(--border-w);
    border-color: var(--color-line);
    border-radius: var(--radius-chip);
    font-size: var(--fs-num);
}
.num-badge--out { color: var(--color-faint); border-color: var(--color-line-soft); }

/* ── StatBar：横バー（使用率・疲労・バジェット等） ───────────────────── */
.stat-bar {
    height: 5px;
    background-color: var(--color-panel-deep);
    border-width: var(--border-w);
    border-color: var(--color-line);
    border-radius: 0;
}
.stat-bar__fill {
    height: 100%;
    border-radius: 0;
    background-color: var(--sky);
}
.stat-bar--good .stat-bar__fill { background-color: var(--color-good); }
.stat-bar--warn .stat-bar__fill { background-color: var(--color-warn); }
.stat-bar--tall { height: 8px; border-radius: 0; }
.stat-bar--tall .stat-bar__fill { border-radius: 0; }

/* ── SegmentedControl：N段トグル（強度 軽/普/猛 など） ───────────────── */
.seg {
    flex-direction: row;
    border-width: var(--border-w);
    border-color: var(--color-line);
    border-radius: var(--radius-chip);
    overflow: hidden;
}
.seg__cell {
    -unity-text-align: middle-center;
    color: var(--color-muted);
    background-color: var(--color-panel-deep);
    font-size: var(--fs-label);
}
.seg__cell:hover { color: var(--color-chalk); }
.seg--sm .seg__cell { width: 26px; height: 26px; }
.seg--lg .seg__cell { width: 40px; height: 32px; font-size: 18px; }
/* 文字数が可変なラベル向け（強攻/待て等）。幅固定セルではなくパディングで揃える。 */
.seg--auto .seg__cell { width: auto; height: 24px; padding-left: var(--sp-2); padding-right: var(--sp-2); }
.seg__cell--on { background-color: var(--sky); color: #FFFFFF; }
/* 今は選べないセル（局面が合わない・控えが尽きた等）。押せないことを色だけで示す。 */
.seg__cell--off { color: var(--color-faint); }
.seg__cell--off:hover { color: var(--color-faint); }
.seg__cell--hard { background-color: var(--color-warn); color: var(--color-chalk); }

/* ── Chip：小ラベル（配分チップ・タグ） ─────────────────────────────── */
.chip {
    font-size: var(--fs-cap);
    color: var(--color-chalk);
    background-color: var(--color-line-soft);
    border-radius: var(--radius-chip);
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-right: var(--sp-1);
    margin-bottom: var(--sp-1);
}
.chip--tag {
    color: var(--color-muted);
    background-color: var(--color-panel-deep);
    border-width: var(--border-w);
    border-color: var(--color-line);
    padding-top: 1px;
    padding-bottom: 1px;
    margin-bottom: 0;
}
.chip--out { color: var(--color-warn); border-color: var(--color-warn); }

/* ── FilterChip：トグル可能なフィルタ／ソートチップ ─────────────────── */
.filter-chip {
    font-size: var(--fs-label);
    color: var(--color-muted);
    height: 28px;
    -unity-text-align: middle-center;
    padding-left: 10px;
    padding-right: 10px;
    border-width: var(--border-w);
    border-color: var(--color-line);
    border-radius: var(--radius-chip);
    background-color: var(--color-panel-deep);
    margin-left: var(--sp-1);
}
.filter-chip:hover { border-color: var(--sky); color: var(--color-chalk); }
.filter-chip--on { background-color: var(--sky); color: #FFFFFF; border-color: var(--sky); }

/* ── Switch：オン/オフトグル（委任など） ────────────────────────────── */
.switch {
    width: 44px;
    height: 24px;
    border-radius: var(--radius-pill);
    background-color: var(--color-panel-deep);
    border-width: var(--border-w);
    border-color: var(--color-line);
    justify-content: center;
}
.switch__knob {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: var(--color-muted);
    margin-left: 3px;
}
.switch--on { background-color: var(--sky); border-color: var(--sky); }
.switch--on .switch__knob { background-color: var(--color-ink); margin-left: 22px; }

/* ── StepButton：（− 値 +）の増減ボタン ─────────────────────────────── */
.step-btn {
    width: 28px;
    height: 28px;
    -unity-text-align: middle-center;
    background-color: var(--color-panel);
    color: var(--color-chalk);
    border-width: var(--border-w);
    border-color: var(--color-line);
    border-radius: var(--radius-chip);
    font-size: var(--fs-num);
    margin-left: 2px;
    margin-right: 2px;
}
.step-btn:hover { border-color: var(--sky); }
.step-btn--locked { color: var(--color-line); }

/* ── Panel：見出し付きの区切り枠（画面の基本容器） ───────────────────── */
.panel {
    background-color: var(--color-strip);
    border-radius: var(--radius-panel);
    border-width: var(--border-w);
    border-color: var(--color-line);
}
.panel__title {
    font-size: var(--fs-label);
    color: var(--ink);
    letter-spacing: 1px;
}

/* ── Modal：同一ドキュメント内オーバーレイ（暗幕＋中央カード） ─────────
   別UIDocument/別PanelSettingsはScreenRouterのレンダリング競合になるため使わない。
   スクリムは tp-root 末尾に置き display で開閉、ルート要素なので class="ui-root" を必ず付ける。 */
.modal-scrim {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(6, 12, 8, 0.72);
    align-items: center;
    justify-content: center;
    display: none;
}
.modal-card {
    background-color: var(--color-field);
    border-width: var(--border-w);
    border-color: var(--color-line);
    border-radius: var(--radius-panel);
    flex-direction: column;
}

/* ── DialogButton：modal-card 内の確認ダイアログ用ボタン（issue #508）──────
   主要=CTA・副次=ゴースト・警告=破壊的操作（削除等・本当の警告だけに使う＝UI原則②）。 */
.dlg-btn { min-width: 120px; height: 40px; -unity-text-align: middle-center; font-size: 20px; border-radius: var(--radius-card); margin: 0 8px; }
.dlg-btn--primary { background-color: var(--color-cta); color: #FFFFFF; border-width: 0; }
.dlg-btn--ghost { background-color: var(--color-panel-deep); color: var(--color-chalk); border-width: 1px; border-color: var(--color-line); }
.dlg-btn--warn { background-color: var(--color-warn); color: #FFFFFF; border-width: 0; }

/* ── Banner：強調告知バー（合宿など） ───────────────────────────────── */
.banner {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-panel);
    border-width: var(--border-w);
    border-color: var(--ink);
    border-radius: var(--radius-panel);
    padding-left: var(--sp-3);
    padding-right: var(--sp-3);
    padding-top: var(--sp-2);
    padding-bottom: var(--sp-2);
}
.banner__badge {
    background-color: var(--sky);
    color: #FFFFFF;
    font-size: var(--fs-cap);
    letter-spacing: 2px;
    padding-left: var(--sp-2);
    padding-right: var(--sp-2);
    padding-top: var(--sp-1);
    padding-bottom: var(--sp-1);
    border-radius: var(--radius-chip);
    margin-right: var(--sp-3);
}

/* ── FieldDiamond：ダイヤモンド配置の背番号枠（メンバー設定 1〜9） ───────
   USSにSVGが無いため、内野は rotate:45deg の矩形で近似。スロットは position:absolute で
   コントローラが top/left を inline 指定して配置する（守備位置の慣例座標）。 */
.field-diamond {
    position: relative;
    background-color: var(--field-grass-day);
    border-radius: var(--radius-panel);
    border-width: var(--border-w);
    border-color: var(--color-line);
    overflow: hidden;
}
/* 球場図の小型チップ（常設ラベル・高さ24px以下）。背番号＋姓＋ランクのみ。
   アンカーはチップ下端中央＝立ち位置点で、left/top は Controller が球場座標[m]から与える。
   フルカード（学年/投打/×）はホバー時に field-pop で出す。
   地は守備トークン地(--field-token-fill-day)と同系の濃色チップ＝明芝の上で守備位置トークンに見える配色
   （試合2D俯瞰の濃色ディスクと同じ考え方）。文字は --field-chalk（昼夜共通の明色）で地に対して常に読める。 */
.field-chip {
    position: absolute;
    height: 22px;
    flex-direction: row;
    align-items: center;
    background-color: var(--field-chip-bg-day);
    border-width: var(--border-w);
    border-color: var(--color-line);
    border-radius: var(--radius-chip);
    padding-left: 4px;
    padding-right: 4px;
}
.field-chip:hover { border-color: var(--color-line-focus); }
.field-chip--picked { border-color: var(--sky); background-color: rgba(40, 58, 44, 0.95); }
.field-chip--picked:hover { border-color: var(--sky); }
/* 球場図チップの文字は盤面ジオメトリ都合の固定サイズ（--fs-cap連動だと底上げで図上のチップ同士が重なる。
   13px＝視認性改善後も重ならないことをスクショで確認済みの値）。 */
.field-chip__num { min-width: 15px; -unity-text-align: middle-center; font-size: 13px; color: var(--color-lamp); }
.field-chip__name { font-size: 13px; color: var(--field-chalk); margin-left: 4px; margin-right: 3px; white-space: nowrap; }
.field-chip__empty { font-size: 13px; color: var(--color-faint); margin-left: 4px; }
/* 球場図の小型チップは17px固定ボックス（盤面ジオメトリ都合）＝文字サイズ底上げの対象外 */
.field-chip .rank-chip { min-width: 17px; height: 17px; font-size: 10px; }

/* フルカードのポップオーバー（ホバー/選択時のみ・チップの真上）。 */
.field-pop {
    position: absolute;
    width: 190px;
    background-color: var(--color-panel-deep);
    border-width: var(--border-w);
    border-color: var(--color-line-focus);
    border-radius: var(--radius-card);
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 5px;
    padding-bottom: 6px;
}

/* ── SlotCard：背番号枠の中身（2行：①背番号＋名前＋位置ランク ②学年・投打・解除） ── */
.slot-card__top { flex-direction: row; align-items: center; }
/* カード幅が固定でチップを拡大すると選手名が「…」に切れるため、カード内は小さめ固定。 */
.slot-card__top .rank-chip { min-width: 22px; height: 24px; padding-left: 2px; padding-right: 2px; }
.slot-card__name {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    font-size: var(--fs-label);
    color: var(--color-chalk);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-left: 6px;
    margin-right: 4px;
}
.slot-card__empty {
    flex-grow: 1;
    flex-basis: 0;
    font-size: var(--fs-cap);
    color: var(--color-faint);
    -unity-text-align: middle-center;
    margin-left: 6px;
}
.slot-card__sub { flex-direction: row; align-items: center; margin-top: 3px; }
.slot-card__sub-txt { font-size: var(--fs-cap); color: var(--color-muted); margin-left: 2px; }
.slot-card__spacer { flex-grow: 1; }
.slot-card__clear {
    font-size: var(--fs-cap);
    color: var(--color-faint);
    margin-left: 4px;
}
.slot-card__clear:hover { color: var(--color-warn); }

/* ── BenchSlot：控え（背番号10〜20）の2行カード ───────────────────────── */
.bench-slot {
    width: 190px;
    background-color: var(--color-panel);
    border-width: var(--border-w);
    border-color: var(--color-line);
    border-radius: var(--radius-card);
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 5px;
    padding-bottom: 6px;
    margin-right: var(--sp-2);
    margin-bottom: var(--sp-2);
}
.bench-slot:hover { border-color: var(--color-line-focus); }
.bench-slot--picked { border-color: var(--sky); background-color: var(--color-panel-hover); }
.bench-slot--picked:hover { border-color: var(--sky); }

/* ── PoolChip：割当元プール（部員一覧の小片） ──────────────────────── */
.pool-chip {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-panel);
    border-width: var(--border-w);
    border-color: var(--color-line);
    border-radius: var(--radius-card);
    padding-left: var(--sp-1);
    padding-right: var(--sp-2);
    padding-top: 5px;
    padding-bottom: 5px;
    margin-right: var(--sp-2);
    margin-bottom: var(--sp-2);
}
.pool-chip:hover { border-color: var(--color-line-focus); }
.pool-chip--picked { border-color: var(--sky); opacity: 1; }
.pool-chip--picked:hover { border-color: var(--sky); }
.pool-chip__body { margin-left: var(--sp-2); margin-right: var(--sp-2); }
.pool-chip__name {
    min-width: 0;
    font-size: var(--fs-label);
    color: var(--color-chalk);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.pool-chip__meta { flex-direction: row; align-items: center; margin-top: 1px; }
.cmp-btn {
    width: 22px; height: 22px;
    -unity-text-align: middle-center;
    font-size: var(--fs-cap);
    color: var(--color-muted);
    background-color: var(--color-panel-deep);
    border-width: var(--border-w);
    border-color: var(--color-line);
    border-radius: var(--radius-chip);
    margin-left: 2px;
}
.cmp-btn:hover { border-color: var(--sky); color: var(--sky); }
.cmp-btn--a-on { background-color: var(--cmp-a); color: var(--color-ink); border-color: var(--cmp-a); }
.cmp-btn--b-on { background-color: var(--cmp-b); color: var(--color-ink); border-color: var(--cmp-b); }

/* ── CompareRow：2選手の能力対比（A/B 2カラム並置） ──
   項目名を左に固定し、右にAカラム／Bカラムを横並びにする。横バーは撤去済み（issue #405・監督決定）。
   数値＋ランクチップの併記だけで優劣を読む＝バーが占めていた横幅を文字サイズと余白に回した。
   カラムは値の分だけの幅（flex-shrink:0）に縮め、AB間の余白で区切る。どちらのカラムかは
   色（--cmp-a/--cmp-b）とヘッダ見出しの併記で示す。 */
.cmp-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
    padding-bottom: 2px;
    border-bottom-width: var(--border-w);
    border-bottom-color: var(--color-line);
}
.cmp-head__spacer { width: 76px; flex-shrink: 0; justify-content: center; }
/* ラベル列の見出し（表のグループ名を空セルへ畳む, issue #452）。独立した見出し行を持たない分、
   縦を行に回せる。Label 既定の上下 margin/padding は行送りを狂わせるだけなので消す。 */
.cmp-head__cap {
    font-size: var(--fs-cap);
    color: var(--color-muted);
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
}
.cmp-head__col { flex-shrink: 0; flex-direction: row; align-items: center; }
.cmp-head__col--b { margin-left: var(--sp-3); }
.cmp-head__lab {
    font-size: 14px;
    color: var(--color-ink);
    border-radius: var(--radius-chip);
    padding-left: 5px;
    padding-right: 5px;
    letter-spacing: 1px;
}
.cmp-head__lab--a { background-color: var(--cmp-a); }
.cmp-head__lab--b { background-color: var(--cmp-b); }
.cmp-row { flex-direction: row; align-items: center; margin-top: 1px; margin-bottom: 1px; }
/* ラベル幅は**和文4文字**（「スタミナ」＝投手能力表で最長）が入る実測値。文字サイズを
   --fs-cap(17px)→--fs-label(19px) へ拡大した分（横バー撤去, issue #405）、幅も比例して
   68px→76px に広げた（旧: 3文字50.12pt/--fs-cap の実測比＝issue #388）。 */
.cmp-row__lab { width: 76px; flex-shrink: 0; -unity-text-align: middle-left; font-size: var(--fs-label); color: var(--color-muted); }
.cmp-row__side { flex-shrink: 0; flex-direction: row; align-items: center; height: 20px; }
.cmp-row__side--b { margin-left: var(--sp-3); }
.cmp-row__val {
    width: var(--col-cmp-val);
    flex-shrink: 0;
    font-size: var(--fs-label);
    color: var(--color-muted);
    -unity-text-align: middle-right;
    margin-right: var(--sp-1);
}
/* 単位つきの物理量（「131km/h」＝最大7文字, issue #94）を含む表は、値セルを**表ごと**広げる。
   行単位で広げるとその行だけ数値の右端がずれて桁が揃わなくなる（UI原則③）。
   付け外しは UiComponents.SetCompareUnitColumn（画面側でクラス名を直書きしない, issue #246）。 */
.cmp-rows--unit .cmp-row__val { width: var(--col-cmp-val-unit); }
/* 密な組（issue #452）: 比較表の高さが**自分では決まらない**置き場所（交代モーダル＝隣の打順表が
   パネル高さを決め、比較表はその余り342pxしか使えない）で、野手の9項目を内部スクロールなしに収める。
   付け外しは UiComponents.SetCompareDense（画面側でクラス名を直書きしない, issue #246 と同じ作法）。
   実測（1600×900・issue #452）: 素の組は 1行43px×9＋見出し46＋ヘッダ42＝493px で窓334pxに入らず、
   **「守備」「捕球」「精神力」の3行が既定で窓の外**（縦スクローラは幅6pxで見えない）。
   43pxの実体は Label 既定の上下 margin(4/2)＋padding(4/4) なので、**文字サイズは落とさず**そこだけ削る
   （19px＋余白0＝29px → 行ピッチ32px＝UI原則①の基準）。9行×32＋ヘッダ38＝326px で収まる。 */
.cmp-rows--dense .cmp-row { margin-top: 1px; margin-bottom: 1px; min-height: 30px; align-items: center; }
.cmp-rows--dense .cmp-row__lab,
.cmp-rows--dense .cmp-row__val { margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0; }
/* 見出し行を畳んだぶんラベル列を広げる（「打撃・走守」＝和文5文字が入る実測値96px。
   素の76pxは和文4文字「スタミナ」基準なので、そのままだと見出しが切れる）。
   ヘッダの空セルと同じ幅にしないと列が揃わない＝必ず2つ一緒に変える。 */
.cmp-rows--dense .cmp-row__lab,
.cmp-rows--dense .cmp-head__spacer { width: 96px; }
.cmp-rows--dense .cmp-head { margin-bottom: 0; }
/* 広げた列は A/B で等分して**各側の右端で揃える**（issue #452）。素の組は値セルが内容幅のまま
   左に寄るので、広い列に置くと右に250pxの死に余白ができ、どちらの列の値かも追いにくい
   （実測: 値の右端1172px に対しパネル右端1424px）。UI原則①（整列で捌く）／③（右揃え・桁揃え）。 */
.cmp-rows--dense .cmp-row__side,
.cmp-rows--dense .cmp-head__col { flex-grow: 1; flex-basis: 0; justify-content: flex-end; }
/* 型の値（弾道）も右端へ。素の組が左揃えなのは「固定幅だと和文が収まらない」から（issue #219）で、
   側を明け渡した今は右揃えにできる＝9行の右端が1本に揃う。 */
.cmp-rows--dense .cmp-row--type .cmp-row__val { -unity-text-align: middle-right; }
/* 数字＋和文単位のセル（スタミナ＝目安投球数, issue #356）は Label 2枚の**横並び**なので、
   text-align では寄らない＝並びの側で右へ寄せる。これを忘れるとスタミナ行だけ右端が揃わない。 */
.cmp-rows--dense .cmp-row__numunit { justify-content: flex-end; }
.cmp-row__val--win { color: var(--color-chalk); }
/* ランク併記（issue #326②）: 値セルの隣に小型チップを添える。フォントサイズはトークン化
   （旧11px直書きを是正, issue #405）。チップ文字は不可視画像差し替えなので実寸には影響しない。 */
.cmp-row__side .rank-chip { min-width: 22px; height: 20px; font-size: var(--fs-cap); padding-left: 2px; padding-right: 2px; margin-left: 2px; margin-right: 4px; }
/* タイプ軸表示（弾道など優劣のない値, issue #219）: 数値専用の固定幅/右揃え/固定行高では
   和文ラベル（例「ややフライ型」）が収まらず隣接行と重なるため、側全体を明け渡す。 */
.cmp-row--type .cmp-row__side { height: auto; flex-grow: 1; }
.cmp-row--type .cmp-row__val { width: auto; flex-grow: 1; -unity-text-align: middle-left; color: var(--color-chalk); }
/* 上限のない量（スタミナ＝目安投球数, issue #356）: 比較行でも数字＋和文単位を分割（NumUnit）。
   数字は Oswald（.nu-num=f-num）。cmp-row--type と併用。 */
.cmp-row__numunit { flex-direction: row; align-items: baseline; }
.cmp-row__numunit .nu-num { font-size: var(--fs-label); color: var(--color-chalk); }
.cmp-card {
    flex-grow: 1;
    flex-basis: 0;
    padding-left: var(--sp-3);
    padding-right: var(--sp-3);
    /* 上端は panel(14px)/画面側コンテナと合わせて積み上がるため詰める（issue #326⑥）。
       詰めた分は球種チャート（cmp-card__pitch）と比較表の可視領域に回る。 */
    padding-top: var(--sp-2);
    /* 下端は最後の要素（チップ行/チャート）が小さいので詰める（issue #452）。 */
    padding-bottom: var(--sp-1);
}
.cmp-card__lab { font-size: 14px; color: var(--color-ink); border-radius: var(--radius-chip); padding-left: 5px; padding-right: 5px; letter-spacing: 1px; }
.cmp-card__lab--a { background-color: var(--cmp-a); }
.cmp-card__lab--b { background-color: var(--cmp-b); }
/* 選手名は**カードの外へ出さない**（issue #452）。2枚のカードは隣り合っているので、はみ出すと
   隣の名前の頭に重なって両方読めなくなる（実測: 枠105pxに文字129px＝「7 佐々木　春斗」の右に
   「10 吉川　陽向」が来て「春斗0 吉川」に見えた）。切れるほうが重なるよりまし＝自分の枠で省略する。 */
.cmp-card__name {
    font-size: var(--fs-body);
    color: var(--color-chalk);
    /* 上の余白はカードの padding-top と積み上がるので持たない（issue #452）。 */
    margin-top: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
/* メタ行（学年＋投打）は補助情報なので行箱を詰める（issue #452）。--fs-cap(17px) のままだと
   CJK の行箱で40pxになり、比較列に守備適性の帯が入らない。読ませるのは上の名前（明朝）で、
   ここは添え物＝13px・行高22pxに落とす。 */
.cmp-card__meta { flex-direction: row; align-items: center; margin-top: 0; height: 22px; }
.cmp-card__hand { font-size: 13px; color: var(--color-muted); margin-right: var(--sp-1); }
.cmp-card__empty { color: var(--color-faint); font-size: var(--fs-cap); -unity-text-align: middle-center; }
.cmp-card .cat-rank-chips { margin-top: var(--sp-2); }
/* 持ち球のミニ球種変化チャート（部品 PitchChartView・compact）。Painter2D 描画のため固定高を確保（issue #94） */
.cmp-card__pitch { height: 104px; margin-top: var(--sp-2); }

/* ── LineupRow：打順1枠の行（順・守・選手・通算成績・学年投打）。行高32px基準（UI原則①） ──
   選手個人の総合ランクチップは持たない（Issue #30 で廃止・#270）。能力は右の比較カードで見る。
   スタメン設定の打順表で使う。列幅は画面USS（LineupSetting.uss）側の .lu-row__* 幅と揃える。 */
.lineup-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
    min-height: 40px;
    /* 行の独立パネル化（共通言語＝row-panel と同じ白面＋インク枠＋ベタ影・角0）。
       打順表は密なので影は 4px（枠2+影2）に抑え、行間も 6px にする。 */
    background-color: var(--sf-card);
    border-color: var(--ink);
    border-top-width: var(--nb-border); border-left-width: var(--nb-border);
    border-right-width: 4px; border-bottom-width: 4px;
    border-radius: 0;
    margin-bottom: 6px;
    padding-left: var(--sp-2);
    padding-right: var(--sp-2);
}
/* ホバー＝桜淡 ／ 選択（入替対象）＝桜（row-panel--selected と同じ選択言語）。 */
.lineup-row:hover { background-color: var(--sakura-tint); }
.lineup-row--picked { background-color: var(--sakura); }
.lineup-row--picked:hover { background-color: var(--sakura); }
.lineup-row__ord {
    width: 22px;
    -unity-text-align: middle-center;
    font-size: var(--fs-num);
    color: var(--color-chalk);
}
.lineup-row__name {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    font-size: var(--fs-body);
    color: var(--color-chalk);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-left: var(--sp-2);
    margin-right: var(--sp-2);
}
.lineup-row__pos { width: 40px; margin-left: var(--sp-2); flex-direction: row; align-items: center; }
.lineup-row__info { width: 96px; font-size: var(--fs-cap); color: var(--color-muted); }

/* ── LineupRow の交代プレビュー（issue #452 パワプロ方式）──
   操作が決まった行を「旧名 → 新名」に切り替え、確定前の姿を表の上で見せる。
   旧名は退色して主役を新名（実ウェイト太字 .f-body-bd 併用）へ譲る。✕は保留中の操作の選び直し。 */
.lineup-row__name--out { flex-grow: 0; flex-shrink: 1; flex-basis: auto; min-width: 48px; color: var(--color-muted); }
.lineup-row__arrow { flex-shrink: 0; font-size: var(--fs-body); color: var(--color-muted); margin-right: var(--sp-2); }
.lineup-row__incoming {
    /* 主役は「変えたあとの姿」＝新名。幅が足りない行では旧名側（--out）を縮め、新名は縮めない。 */
    flex-grow: 1;
    flex-shrink: 0;
    flex-basis: auto;
    font-size: var(--fs-body);
    color: var(--color-chalk);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: var(--sp-2);
}
.lineup-row__x {
    width: 24px;
    height: 24px;
    -unity-text-align: middle-center;
    font-size: var(--fs-cap);
    color: var(--color-muted);
    background-color: var(--color-panel-deep);
    border-width: var(--border-w);
    border-color: var(--color-line);
    border-radius: var(--radius-chip);
    flex-shrink: 0;
    padding-left: 0;
    padding-right: 0;
    margin-left: var(--sp-1);
}
.lineup-row__x:hover { color: var(--color-chalk); border-color: var(--color-line-focus); }

/* ── PosChip：守備位置チップ（クリックで選択→別チップのクリックで守備位置を入替）。
   スタメン設定では「投」も含めて9枠すべて入替可（issue #233）＝--fixed は使わない。
   --fixed は入替できない場面（試合中の交代パネルの表示専用チップ）だけに残す。指＝DH（守備に就かない）。 ── */
.pos-chip {
    min-width: 26px;
    height: 24px;
    -unity-text-align: middle-center;
    font-size: var(--fs-label);
    color: var(--color-chalk);
    background-color: var(--color-panel-deep);
    border-width: var(--border-w);
    border-color: var(--color-line);
    border-radius: var(--radius-chip);
    padding-left: 4px;
    padding-right: 4px;
}
.pos-chip:hover { border-color: var(--sky); }
.pos-chip--fixed { color: var(--color-muted); background-color: var(--color-line-soft); }
.pos-chip--dh { color: var(--sky); background-color: var(--color-line-soft); }
/* 選択中（1つ目のチップをクリック済み）。bench-row--picked / sp-pill--picked と同じ表現。 */
.pos-chip--picked { border-color: var(--sky); background-color: var(--color-panel-hover); }

/* ── BenchRow：控え（打順外）の1行（背番号＋名前。投/野タグは Issue #93、総合ランクは #30 で廃止） ── */
.bench-row {
    flex-direction: row;
    align-items: center;
    height: 64px;
    flex-shrink: 0;
    /* lineup-row と同じ独立パネル（白面＋インク枠＋ベタ影4px・角0）。 */
    background-color: var(--sf-card);
    border-color: var(--ink);
    border-top-width: var(--nb-border); border-left-width: var(--nb-border);
    border-right-width: 4px; border-bottom-width: 4px;
    border-radius: 0;
    margin-bottom: 6px;
    padding-left: var(--sp-2);
    padding-right: var(--sp-2);
}
.bench-row:hover { background-color: var(--sakura-tint); }
.bench-row--picked { background-color: var(--sakura); }
.bench-row--picked:hover { background-color: var(--sakura); }
.bench-row__name { flex-grow: 1; flex-basis: 0; min-width: 0; font-size: var(--fs-label); color: var(--color-chalk); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-right: var(--sp-2); }
.bench-row__tag { font-size: 14px; color: var(--color-muted); background-color: var(--color-panel-deep); border-radius: var(--radius-chip); padding-left: 5px; padding-right: 5px; margin-right: var(--sp-2); }

/* ── SpPill：先発投手ピル（DH制時のみ・クリックで選択→控え投手クリックで差替） ── */
.sp-pill {
    flex-direction: row;
    align-items: center;
    height: 26px;
    background-color: var(--color-panel-deep);
    border-width: var(--border-w);
    border-color: var(--color-line);
    border-radius: var(--radius-chip);
    padding-left: var(--sp-2);
    padding-right: var(--sp-2);
}
.sp-pill:hover { border-color: var(--sky); }
.sp-pill--picked { border-color: var(--sky); background-color: var(--color-panel-hover); }
.sp-pill__cap { font-size: var(--fs-cap); color: var(--color-muted); margin-right: var(--sp-2); }
.sp-pill__name { font-size: var(--fs-label); color: var(--color-chalk); margin-right: var(--sp-2); }

/* ── StatBlock：成績2列（通算/今大会）。数値は右揃え・桁揃え（UI原則③） ── */
/* ── StatTable：比較カードの成績表（issue #388） ──
   ラベルを左に1列だけ置き、スコープ（通算/公式戦/今大会）を横に並べる表。
   旧 .stat-col（スコープごとの箱がラベルを繰り返し持つ形）は、3列化した時点で1列の内寸が
   98pt しか無くなり 3文字ラベル(50pt)＋値(最大55pt) が収まらず文字が重なっていた。
   ラベルを1本にすることで値へ幅を明け渡し、接触を構造的に無くしている。
   数値は列ごとに右揃え＝桁が縦に揃う（UI原則③）。 */
.stat-table { }
.stat-table__row { flex-direction: row; align-items: center; height: 22px; }
.stat-table__row--head { height: 18px; }
/* ラベル列: 3文字ラベル（防御率/奪三振/本塁打/出塁率/投球回）の必要幅 50.12pt を実測で確保する。
   潰さない＝flex-shrink を効かせない（UI-BUILD-METHOD「潰して収めるのは常に不正解」）。 */
.stat-table__lab {
    width: 52px;
    flex-shrink: 0;
    font-size: var(--fs-cap);
    color: var(--color-muted);
}
.stat-table__scope {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    -unity-text-align: middle-right;
    font-size: var(--fs-cap);
    color: var(--color-muted);
    letter-spacing: 1px;
}
.stat-table__val {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    -unity-text-align: middle-right;
    font-size: var(--fs-label);
    color: var(--color-chalk);
}

/* ── AptField：守備適性ダイヤ（盤面表示）──
   ⚠ 2026-08-09 に全画面で AptitudeStrip（下の帯）へ差し替えたため、**現在どこからも使っていない**。
   高さ 252px（210px×2枚＋見出し）が試合中の交代モーダルに入らず、3画面で同じ部品にできなかったのが理由
   （issue #452・案A）。盤面へ戻す判断が出たときのために形だけ残してある。 */
.apt-pair { flex-direction: row; }
.apt-field {
    position: relative;
    flex-grow: 1;
    flex-basis: 0;
    height: 210px;
    background-color: var(--field-grass);
    border-radius: var(--radius-panel);
    border-width: var(--border-w);
    border-color: var(--color-line);
    overflow: hidden;
}
.apt-field--a { margin-right: 4px; border-top-width: 2px; border-top-color: var(--cmp-a); }
.apt-field--b { margin-left: 4px; border-top-width: 2px; border-top-color: var(--cmp-b); }
.apt-field__infield {
    position: absolute;
    width: 118px;
    height: 118px;
    left: 50%;
    top: 53%;
    translate: -50% -50%;
    rotate: 45deg;
    background-color: var(--field-clay);
    border-width: 2px;
    border-color: var(--field-line);
    border-radius: var(--radius-chip);
}
.apt-field__home {
    position: absolute;
    width: 8px;
    height: 8px;
    left: 50%;
    top: 82%;
    translate: -50% -50%;
    background-color: var(--field-line);
}
.apt-field__slots { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.apt-node {
    position: absolute;
    translate: -50% -50%;
    align-items: center;
}
.apt-node .rank-chip { min-width: 20px; height: 22px; font-size: var(--fs-cap); }
.apt-node__dash { font-size: var(--fs-label); color: var(--color-faint); -unity-text-align: middle-center; }

/* ── AptitudeStrip：守備適性の帯（issue #452・監督選択の案A, 2026-08-09） ──
   盤面（.apt-field 210px×2枚＋見出し＝252px）は試合中の交代モーダルに残っている高さ56pxに入らない。
   同じ情報＝9ポジションの実効守備力ランクを 見出し30＋2行×30 ＝ 約90px の帯へ畳んだ形で、3画面で共有する。
   ラベル列の幅は同じパネルの .cmp-row__lab と揃える＝縦の線が通る（揃わないと帯だけ左右にずれて見える）。 */
.apt-strip { flex-shrink: 0; margin-top: var(--sp-2); }
.apt-strip__row { flex-direction: row; align-items: center; min-height: 30px; }
/* 詰め版（issue #452・メンバー設定／スタメン設定）: 比較列は 表13行＋帯 を同時に見せたいので、
   見出し行を薄く・データ行を chip の高さ(22px)ぎりぎりまで寄せる。90px→70px。
   交代モーダルは高さが別に決まっている（msub-cmp-scroll）ので付けない＝あちらの見た目は変えない。 */
.apt-strip--tight { margin-top: 0; }
.apt-strip--tight .apt-strip__row { min-height: 26px; }
.apt-strip--tight .apt-strip__row--head { min-height: 18px; }
.apt-strip--tight .apt-strip__pos { font-size: 13px; }
/* データ行の高さは chip(22px) でなく **ラベル列の行箱** が決めていた（--fs-cap 17px の CJK 行箱が32px）。
   min-height を下げるだけでは縮まないので、詰め版はラベルも小さくする。 */
.apt-strip--tight .apt-strip__lab { font-size: 13px; }
.apt-strip__lab {
    width: 76px;
    flex-shrink: 0;
    font-size: var(--fs-cap);
    color: var(--color-muted);
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
}
/* 密な組の比較表（cmp-rows--dense）の中に置いたときはラベル列も96pxへ追従する。 */
.cmp-rows--dense .apt-strip__lab { width: 96px; }
/* どちらの選手の行かは比較表と同じアクセント（--cmp-a / --cmp-b）で示す。盤面版が枠の色でやっていたのと同じ device。 */
.apt-strip__lab--a { border-left-width: 3px; border-left-color: var(--cmp-a); padding-left: 5px; }
.apt-strip__lab--b { border-left-width: 3px; border-left-color: var(--cmp-b); padding-left: 5px; }
/* 9列は等分。チップは盤面版（apt-node）と同寸にして、見比べたときに大きさが変わらないようにする。 */
.apt-strip__cell { flex-grow: 1; flex-basis: 0; align-items: center; }
.apt-strip__pos { font-size: var(--fs-cap); color: var(--color-muted); margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0; }
.apt-strip__cell .rank-chip { min-width: 20px; height: 22px; font-size: var(--fs-cap); }
.apt-strip__dash { font-size: var(--fs-label); color: var(--color-faint); margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0; }

/* ═══════════════════════════════════════════════════════════════════════
   ライブ観戦（MatchLive）3カラム部品 ─ スタメン列 / 投手行 / マッチアップHUD。
   盤面ビュー例外: HUD・調子色は状態コード（アクセント本数制限の対象外）。
   ═══════════════════════════════════════════════════════════════════════ */

/* ── NumberBadge --sm：スタメン列/HUD用の小型背番号。
   背番号は識別情報でありアクセントではない（UI原則②・黄はデータに使わない）＝文字は白、面は小片色。 ── */
.num-badge--sm {
    width: 22px; height: 22px;
    font-size: var(--fs-label);
    border-radius: var(--radius-chip);
    color: var(--color-chalk);
}

/* ── ConditionFace：調子の表情顔（Painter2D・C# ConditionFace が描画）。5段階（0=絶好調〜4=絶不調）。 ── */
/* 昼NB：灰系の「普通」が白地に溶けるので全画面でインク輪郭を出す（design-19。ConditionFace が読む）。
   夜へ戻すときはこの --face-ring 行を消せばリングも消える（既定α=0）。 */
.cond-face { width: 18px; height: 18px; flex-shrink: 0; --face-ring: #131512; }

/* ── RadarChart：レーダーの軸ラベル（絶対配置の位置は C# RadarChartView が角度から算出）。
   小=カード内の従属レーダー / 大(--lg)=1画面の主役レーダー。数値は1色（chalk）で強調はサイズと太さだけ。 ── */
.radar-axis { position: absolute; align-items: center; }
.radar-axis__l { font-size: var(--fs-cap); color: var(--color-muted); }
.radar-axis__v { font-size: var(--fs-num); color: var(--color-chalk); }
.radar-axis--lg .radar-axis__l {
    font-size: 22px;
    margin-bottom: 1px;
}
.radar-axis--lg .radar-axis__v { font-size: 40px; }

/* ── MLineupRow：ライブ観戦のスタメン1行（行高32px基準・左右ミラー可）。
   順序: 打順・背番号・姓・守備位置・調子。右列は row-reverse でミラー。 ── */
.mlineup-row {
    flex-direction: row;
    align-items: center;
    height: 32px;
    flex-shrink: 0;
    background-color: var(--color-panel);
    border-radius: var(--radius-chip);
    margin-bottom: 2px;
    padding-left: var(--sp-1);
    padding-right: var(--sp-1);
}
.mlineup-row--mirror { flex-direction: row-reverse; }
/* 現打者ハイライト（状態コード＝アンバー淡色。攻守交代で左右の列を移る） */
.mlineup-row--at-bat { background-color: rgba(245, 198, 74, 0.16); }
.mlineup-row--at-bat .mlineup-row__name { color: var(--color-lamp); }
/* 交代済みスロット（新選手は通常表示・退いた選手名を薄く併記） */
.mlineup-row__ord {
    width: 16px;
    -unity-text-align: middle-center;
    font-size: var(--fs-cap);
    color: var(--color-muted);
    flex-shrink: 0;
}
.mlineup-row__name {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 100%;
    -unity-text-align: middle-left;
    font-size: var(--fs-label);
    color: var(--color-chalk);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-left: var(--sp-1);
    margin-right: var(--sp-1);
}
/* ライブ観戦の行だけ名前セルを姓3+全角スペース+名3文字ぶん≒133px（--fs-label 19px×7字）に絞る。
   超過は上の text-overflow: ellipsis で省略（issue #297・ユーザー決定）。試合前画面（対戦カード）の
   スタメン一覧は .mlineup-row__name を共有クラスのまま伸縮利用しており、名前の右で学年/投打を
   右寄せしているため直接固定幅化できない → .mlineup-row--compact モディファイアで限定する。
   控え行（.mlineup-benchrow）も同じサイド列なので幅を揃える。
   width ではなく max-width にする（flex-grow:1/flex-basis:0 は base ルールのまま維持）:
   交代済みスロットの ←旧選手名（.mlineup-row__replaced・flex-shrink:0）が同じ行に並ぶとき、
   名前セルが残り幅ぶんだけ自分から縮む自己均衡が効かなくなり、背番号・調子顔が列の外へ
   押し出されて見切れる（実機スクショで確認）。 */
.mlineup-row--compact .mlineup-row__name,
.mlineup-benchrow .mlineup-row__name {
    max-width: 133px;
}
.mlineup-row__replaced {
    font-size: 13px;
    color: var(--color-faint);
    margin-right: var(--sp-1);
    white-space: nowrap;
    flex-shrink: 0;
}
.mlineup-row__pos {
    width: 24px;
    -unity-text-align: middle-center;
    font-size: var(--fs-cap);
    color: var(--color-muted);
    flex-shrink: 0;
}
.mlineup-row__cond { margin-left: var(--sp-1); margin-right: var(--sp-1); }
/* 従属メタ（学年・投打など・成績を出さない場面の右端寄せ小文字）。名前より目立たせない。 */
.mlineup-row__meta {
    -unity-text-align: middle-right;
    font-size: var(--fs-cap);
    color: var(--color-muted);
    margin-right: var(--sp-1);
    flex-shrink: 0;
}

/* ── 控えセクション見出し（「控え」） ── */
.mlineup-subhead {
    font-size: var(--fs-cap);
    color: var(--color-faint);
    letter-spacing: 1px;
    height: 20px;
    margin-top: var(--sp-2);
    -unity-text-align: middle-left;
    flex-shrink: 0;
}
.mlineup-subhead--right { -unity-text-align: middle-right; }

/* ── MLineupBenchRow：控え1行（打順・今日成績なし＝スタメンより淡く従属表示）。守備位置/名前/背番号/調子。 ── */
.mlineup-benchrow {
    flex-direction: row;
    align-items: center;
    height: 26px;
    flex-shrink: 0;
    padding-left: var(--sp-1);
    padding-right: var(--sp-1);
}
.mlineup-benchrow .mlineup-row__name {
    -unity-font-style: normal;
    color: var(--color-muted);
    font-size: var(--fs-cap);
}

/* ── MLineupPitcher：各列下の固定1行（投手＝打順外・名前/球数/投球回/失点） ── */
.mlineup-pitcher {
    flex-direction: row;
    align-items: center;
    height: 30px;
    flex-shrink: 0;
    margin-top: var(--sp-1);
    padding-left: var(--sp-2);
    padding-right: var(--sp-2);
    background-color: var(--color-panel-deep);
    border-radius: var(--radius-chip);
}
.mlineup-pitcher--mirror { flex-direction: row-reverse; }
.mlineup-pitcher__tag {
    font-size: 13px;
    color: var(--color-muted);
    width: 20px;
    flex-shrink: 0;
}
.mlineup-pitcher__name {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    font-size: var(--fs-label);
    color: var(--color-chalk);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-left: var(--sp-1);
    margin-right: var(--sp-1);
}
.mlineup-pitcher__stat {
    font-size: var(--fs-cap);
    color: var(--color-muted);
    margin-left: var(--sp-1);
    margin-right: var(--sp-1);
    flex-shrink: 0;
}

/* ═══ MatchupHud（黒半透明の一体帯）─ 対決ビュー上の右上=打者 / 右下=投手 ═══
   中継のテロップ帯。**面を持つのは帯コンテナ1枚だけ**で、中の段・セル・チップは背景を持たない
   （白面の独立ボックスを並べる旧タイル型は 2026-08-05 に廃止）。段とセルの区切りは
   --hud-divider の1px線だけで作り、隙間（gap/margin）は一切置かない＝帯が1枚に見えることが最優先。
   帯は盤面の右端に密着させる（右マージン・右パディングなし）。

   3Dの絵の上なので文字は全部白系＝データ画面の --tx-* 系統は使わない。
   色は状態コード（CLAUDE.md「適用範囲の例外（試合盤面）」）＝球数の警告色とスタミナ3色は
   データ画面の「アクセント3箇所」制限の対象外。ただしここで新しい色は増やさない。 */

/* コーナー：画面座標の固定オーバーレイ（設計書18 §7-1）。面は持たない＝ただの位置決め。
   打席開始前は中身が空になるので、地を持たせると黒い矩形だけが残ってしまう。 */
.mhud-corner {
    position: absolute;
    width: var(--hud-band-w);
}
.mhud-corner--right { right: 0; bottom: 0; }
/* 打者は右上＝盤面の打者に近い側（2026-07-31）。 */
.mhud-corner--topright { right: 0; top: 0; }

/* 帯本体。地を持つのはここだけ。パディングは持たない＝スタッツ行のセルが帯の端まで届く。 */
.mhud-band {
    flex-direction: column;
    background-color: var(--hud-bg);
}

/* ── 1段目＝名前行 ───────────────────────────────────────── */
/* 行の高さは「名前の実高＋上下パディング」だけ。和文の行箱は級数の倍近くあるので、
   中の文字要素には必ず高さを明示して行箱の余白を殺す（padding を削っても残る）。 */
.mhud-idrow {
    flex-direction: row;
    align-items: center;
    padding-left: var(--sp-2);
    padding-right: var(--sp-2);
    padding-top: 4px;
    padding-bottom: 4px;
}
/* 名前が帯の中で最も大きい要素。人名は明朝（設計書16 §2）＝生成側で .f-display を直接付ける。
   字間は詰める（明朝の既定は帯には緩い）。姓名間の全角空白は生成側で半角へ落とす。 */
.mhud-nm {
    font-size: var(--hud-fs-name);
    height: var(--hud-h-name);
    -unity-text-align: middle-left;
    letter-spacing: -1px;
    color: #FFFFFF;
    white-space: nowrap;
    flex-shrink: 0;
    margin-left: var(--sp-1);
    margin-right: var(--sp-1);
}
/* 背番号＝チップにせず素の白文字（名前より1段階小さい）。打者・投手で同じ見た目。 */
.mhud-no {
    font-size: var(--hud-fs-num);
    height: var(--hud-h-num);
    -unity-text-align: middle-center;
    color: #FFFFFF;
    flex-shrink: 0;
    margin-left: var(--sp-1);
}
/* 名前行の右端に置くもの（打者=調子の顔／投手=球数）。この spacer が押し出す。 */
.mhud-spacer { flex-grow: 1; }
.mhud-face { width: 18px; height: 18px; flex-shrink: 0; --face-ring: rgba(255, 255, 255, 0.55); }
/* 球数＝継投判断の主指標。ラベルは持たず「6球」だけ。学年チップより目立つ級数・太さで出す。 */
.mhud-pc {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: var(--sp-2);
}
.mhud-pc__n {
    font-size: var(--hud-fs-num);
    height: var(--hud-h-num);
    -unity-text-align: middle-right;
    color: #FFFFFF;
}
.mhud-pc__u { font-size: var(--hud-fs-lab); height: var(--hud-h-lab); color: var(--hud-label); margin-left: 1px; }
/* 警告色は絶対球数でなくスタミナ残量で出す（issue #408）。スタミナバーと色を一致させる。 */
.mhud-pc__n--warn { color: var(--color-lamp); }      /* 残量 6割未満＝注意（= .stam__fill--mid。調子色を借りない） */
.mhud-pc__n--alert { color: var(--color-warn); }     /* 残量 3割未満＝警告 */

/* 名前行のチップ（打順・守備位置・先発・学年）。地を持つのは①打順/登板順（白地黒字）
   ②守備位置（チーム色地白字・地色は生成側がインラインで入れる）③学年（薄い白）の3種。 */
.mhud-cp {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-right: var(--sp-1);
}
.mhud-cp__t { font-size: var(--hud-fs-chip); height: var(--hud-h-chip); -unity-text-align: middle-center; }
/* 数字に添える和文単位（「番」「年」「番手」）。Oswald は欧文専用なので Label を分ける
   ＝.nu-unit と同じ作法（設計書16 §2 書体3役ルール）。 */
.mhud-cp__u { font-size: var(--hud-fs-lab); height: var(--hud-h-lab); margin-left: 2px; }
.mhud-cp--key { background-color: #FFFFFF; }                       /* 打順・登板順 */
.mhud-cp--key .mhud-cp__t, .mhud-cp--key .mhud-cp__u { color: var(--ink); }
.mhud-cp--team .mhud-cp__t, .mhud-cp--team .mhud-cp__u { color: #FFFFFF; }  /* 守備位置 */
.mhud-cp--dim { background-color: var(--hud-chip-dim); margin-right: 0; }   /* 学年 */
.mhud-cp--dim .mhud-cp__t, .mhud-cp--dim .mhud-cp__u { color: var(--hud-label); }

/* ── 2段目＝スタッツ行。等幅3セルを隙間なしで並べる（打者・投手とも同構造） ── */
.mhud-stats {
    flex-direction: row;
    border-top-width: 1px;
    border-top-color: var(--hud-divider);
}
.mhud-cell {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 4px;
    padding-bottom: 4px;
}
/* セル間の区切りは上下いっぱいに引かず15%ずつ短くする＝帯を格子に見せない。
   border では詰められない（USS に border の inset は無い）ので絶対配置の細片で引く。
   先頭セルには付けない＝帯の左端に落ちて「枠の縁」に見えるため（生成側で制御）。 */
.mhud-cell__div {
    position: absolute;
    left: 0;
    top: 15%;
    bottom: 15%;
    width: 1px;
    background-color: var(--hud-divider);
}
.mhud-cell__lab {
    font-size: var(--hud-fs-lab);
    height: var(--hud-h-lab);
    -unity-text-align: middle-center;
    color: var(--hud-label);
    margin-bottom: 2px;
}
.mhud-cell__val {
    font-size: var(--hud-fs-val);
    height: var(--hud-h-val);
    -unity-text-align: middle-center;
    color: #FFFFFF;
}

/* ── 3段目＝本日の打席（打者のみ）。結果パネルを左から順に並べるだけで、見出しも器も持たない。
   まだ結果が無い1打席目は生成側が段ごと出さない＝帯の見た目は2段のまま変わらない。
   色は結果の種類コード（design-19 のパレット）＝盤面ビューなのでアクセント本数制限の対象外。 ── */
.mhud-pas {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding-left: var(--sp-2);
    padding-right: var(--sp-2);
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-width: 1px;
    border-top-color: var(--hud-divider);
}
.mhud-pa {
    flex-shrink: 0;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 1px;
    padding-bottom: 1px;
    margin-right: 3px;
}
.mhud-pa__t {
    font-size: var(--hud-fs-pa);
    height: var(--hud-h-pa);
    -unity-text-align: middle-center;
    color: var(--ink);
}
.mhud-pa--hit { background-color: var(--sakura); }        /* 安打系（単打〜本塁打） */
.mhud-pa--walk { background-color: var(--color-lamp); }   /* 四球・死球・犠打犠飛・失策出塁 */
.mhud-pa--out { background-color: var(--sky); }           /* アウト（三振・凡退） */
/* 空青は暗いので白抜き（.signpad__tile--on と同じ判断）。桜とアンバーは明るいのでインクのまま。 */
.mhud-pa--out .mhud-pa__t { color: #FFFFFF; }

/* ── 最下段＝スタミナ（投手のみ）。文字は持たずバーだけを帯の最下段に全幅で置く ── */
.mhud-stam {
    flex-direction: row;
    align-items: center;
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-width: 1px;
    border-top-color: var(--hud-divider);
}

/* スタミナ残量のバー（継投の目安）。残量で色を落とす＝盤面ビューの状態コード。
   溝は帯の上に載るので白の薄膜（昼の --sf-inset だと暗い帯に明るい棒が浮いてしまう）。 */
.stam__track {
    height: 6px;
    flex-grow: 1;
    background-color: var(--hud-track);
}
.stam__fill {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    background-color: var(--color-good);
}
.stam__fill--mid { background-color: var(--color-lamp); }
.stam__fill--low { background-color: var(--color-warn); }
/* 目盛は3等分（残り2/3・1/3の位置）＝色の変わり目と同じ場所。溝と同じく帯の上なので白の薄膜。 */
.stam__tick { position: absolute; top: 0; bottom: 0; width: 1px; background-color: var(--hud-divider); }
/* MatchupHud：盤面ホスト上の画面座標固定オーバーレイ（コーナーの定義はブロック冒頭）。 */
.matchup-hud {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

/* ═══ MiniDiamond：守備フォーカス中の小ダイヤモンド（issue #595・器は MiniDiamondElement.cs）═══════
   守備カメラは球と野手に寄って追随するので、枠外へ出た走者は原理的に映らない
   ＝「三塁で止まったのか本塁を狙ったのか」が絵から読めない。画面固定の小さな図で走者だけを補う。
   面は ScoreBug と同じ黒島語彙（--sb-face ＋ インク枠）＝芝・土・空のどの背景の上でも沈まない。
   黒島は盤面に2つだけ（左上＝ScoreBug／右下＝これ）で対角に置く。
   中身（塁・塁間・走者ドット）は Painter2D。塁と走者の色は tokens の --field-chalk / --color-lamp を
   要素側が読む＝ここでは面と枠だけを持つ。パディングは箱の内側の余白（走者ドットが枠へ触れない幅）。 */
.mdia {
    width: 120px;
    height: 120px;
    flex-shrink: 0;
    background-color: var(--sb-face);
    border-width: var(--nb-border);
    border-color: var(--ink);
    padding: 8px;
}

/* SignPad：指示パネル（issue #289。試合盤面・投手HUD直下の采配指示タイル。SignPad.cs が生成）。
   設計書15 Phase C-3 の常駐1行帯の後継。攻撃中は打撃、守備中は配球だけを出し、既定（任せ/通常）は無点灯。
   盤面overlayなので半透明パネルは MatchupHud の帯（--hud-bg）と同じ考え。選択色は旧セグ選択と同じ --sky を踏襲。
   タイルは flex-wrap で段組み＝定義が増えたら下へ折り返す（gap非対応のため間隔は margin で作る）。 */
/* 2026-07-31: 試合画面の1球指示は TacticsCardDeck（.tcard*）へ置き換えた。SignPad は
   部品辞書の登録として残す（ComponentGallery 用・他画面で使うときの器）。 */
.signpad {
    background-color: rgba(24, 33, 28, 0.85);
    border-radius: var(--radius-panel);
    padding: var(--sp-2);
    margin-top: 6px;
    flex-shrink: 0;
}
.signpad__head { flex-direction: row; align-items: center; margin-bottom: var(--sp-1); }
/* 暗パネル上の文字は昼スキンの chalk/muted（暗インク）だと沈む（issue #236 症状B と同根）。
   主情報（攻撃/守備）は sb-ink-1、副ラベルは faint で階調を作る。 */
.signpad__title { font-size: var(--fs-cap); color: var(--color-faint); margin-right: var(--sp-2); }
.signpad__phase { font-size: var(--fs-cap); color: var(--sb-ink-1); }
.signpad__group { flex-direction: row; align-items: center; flex-wrap: wrap; }
.signpad__grouplab { font-size: var(--fs-cap); color: var(--color-faint); margin-right: var(--sp-1); }
.signpad__tile {
    -unity-text-align: middle-center;
    font-size: var(--fs-label);
    color: var(--color-muted);
    background-color: var(--color-panel-deep);
    border-width: var(--border-w);
    border-color: var(--color-line);
    border-radius: var(--radius-chip);
    min-width: 64px;
    height: 28px;
    padding-left: var(--sp-2);
    padding-right: var(--sp-2);
    margin-right: var(--sp-1);
    margin-top: 2px;
    margin-bottom: 2px;
}
.signpad__tile:hover { color: var(--color-chalk); }
.signpad__tile--on { background-color: var(--sky); color: #FFFFFF; border-color: var(--sky); }
.signpad__tile--off { color: var(--color-faint); }
.signpad__tile--off:hover { color: var(--color-faint); }

/* PitchCall：投球判定の大型オーバーレイ（試合盤面・1球ごとに短時間だけ出す）。
   盤面ビューなので色は状態コード（ストライク＝アンバー／ボール＝良好色／それ以外＝チョーク）で、
   データ画面のアクセント本数制限の対象外（CLAUDE.md「適用範囲の例外（試合盤面）」）。
   既存UIと重なってよい短命表示のため、盤面ホスト上に絶対配置し既定は非表示。 */
.pitch-call {
    position: absolute;
    left: 0; right: 0; top: 38%;
    align-items: center;
    display: none;
}
/* 判定テキスト（issue #479 で参照モック docs/design/mock-pitch-view.html の実測値へ改定）。
   旧実装は半透明パネルで浮かせていたが、パネルをやめて**影2重**で地から起こす＝
   ① ぼかし影 0 0 26px rgba(0,0,0,.9) ② 硬い影 0 3px 0 rgba(0,0,0,.5)。
   USS の text-shadow は1要素1つしか持てないので、①はここ、②は同じ文字を3px下へ置いた
   複製ラベル（--shadow）で出す。影を省略すると明るい昼芝に文字が埋もれる。
   字送り（font-size / letter-spacing）は「画面幅の10%・30〜64pxクランプ」なので USS では書けず、
   MatchLiveController.ApplyCallTextMetrics が実幅から算出して両ラベルへ入れる。 */
.pitch-call__judge {
    -unity-text-align: middle-center;
    color: var(--sb-call-ink);
    margin: 0;
    padding: 0;
}
.pitch-call__judge--strike { color: var(--sb-call-strike); }
.pitch-call__judge--ball { color: var(--sb-call-ball); }
/* 打球・走塁プレーの判定オーバーレイ（issue #59）。PitchCallと同じ器・idiomを流用する。
   アウト＝盤面の赤（ランプのアウトと同じ）、セーフ＝ボール系の緑。盤面ビューの色は状態コードで、
   データ画面のアクセント本数制限の対象外（CLAUDE.md「適用範囲の例外（試合盤面）」）。 */
.pitch-call__judge--out { color: var(--sb-call-out); }
.pitch-call__judge--safe { color: var(--sb-call-ball); }
/* フェア＝際どい飛球が落ちた瞬間の表示（issue #328②）。良し悪しではない中立の判定コールなので
   strikeと同じアンバーを流用する。 */
.pitch-call__judge--fair { color: var(--sb-call-strike); }
/* ホームラン＝柵越えの着地の瞬間（issue #354）。打者側の最良の結果＝ボール系と同じ緑。 */
.pitch-call__judge--homerun { color: var(--sb-call-ball); }
/* 硬い影（②）の実体。色クラス（--out 等）と同じ詳細度だと並び順に勝敗が依存するので、
   2クラス連結で詳細度を1段上げて必ず黒が勝つようにする。 */
.pitch-call__judge.pitch-call__judge--shadow {
    position: absolute;
    left: 0; right: 0; top: 3px;
    color: rgba(0, 0, 0, 0.5);
}
/* 影の複製が実寸を持つと器の幅が狂うので、面のラベルだけが箱を決める（影は絶対配置）。 */
.pitch-call__stack { align-items: center; }

/* 出現/消失（参照モック: 出現160ms・opacity 0→1・scale .84→1 をオーバーシュートさせる）。
   USS に任意の cubic-bezier は無いので ease-out-back（進捗が約110%まで行き過ぎて戻る）で代用する
   ＝参照の cubic-bezier(.2,1.6,.4,1) と同じピーク。**ここだけ他のUIと違うカーブ**にするのが要点で、
   盤面で判定表示だけが跳ねることで視線が集まる。
   既定を「見えている状態」にしてあるのは、display だけを操作する消費者（Match2DPlaybackElement の
   自前経路など）が is-enter を知らなくても**必ず見える**ようにするため。逆にすると判定が無言で消える。 */
.pitch-call__stack,
.pitch-call__readout {
    opacity: 1;
    scale: 1 1;
    transition-property: opacity, scale;
    transition-duration: 160ms, 160ms;
    transition-timing-function: ease-out, ease-out-back;
}
.pitch-call.is-enter .pitch-call__stack,
.pitch-call.is-enter .pitch-call__readout {
    opacity: 0;
    scale: 0.84 0.84;
}

/* 下段の補足（判定オーバーレイを器ごと流用する側＝本塁打の飛距離など。単一ラベル）。
   参照モックの計器表示と同じく黒い盤面の地に載せる（下の readout の項を参照）。 */
.pitch-call__detail {
    font-size: var(--fs-body);
    -unity-text-align: middle-center;
    color: var(--sb-ink-1);
    background-color: var(--sb-face);
    border-bottom-width: var(--nb-border);
    border-bottom-color: var(--ink);
    padding: var(--sp-1) var(--sp-3);
    margin-top: var(--sp-2);
}

/* 球種・球速の計器表示（参照モックの readout。実1球記録がある打席だけ出す）。
   桁が動かないことが計器らしさの正体なので数字は Oswald（.f-num-bd）で、和文との混植を避けて
   ラベルを割る（書体3役ルール）。align-items: baseline は USS 非対応なので flex-end で代用する。

   ⚠ 地を敷くのは飾りではない。参照モックではこの計器は**盤面（黒いスコアボード）の中**にあり、
   11px の補助情報が #6F9A7F で読めるのは地が黒いから。昼芝（#4F7C3B）へ直接置くと同じ数値でも
   完全に沈んで読めない（2026-08-05 実測）。指定の文字サイズ・色を守るために、参照と同じ
   「黒い盤面の上」という前提のほうを持ってくる。地の色は design-19 §8「掲示板島は黒維持」に従う。 */
.pitch-call__readout {
    flex-direction: row;
    align-items: flex-end;
    background-color: var(--sb-face);
    border-bottom-width: var(--nb-border);
    border-bottom-color: var(--ink);
    padding: var(--sp-1) var(--sp-3);
    margin-top: var(--sp-2);
}
.pitch-call__note {
    font-size: var(--fs-readout-note);
    color: var(--sb-call-detail-ink);
    margin: 0 var(--sp-2) 0 0;
    padding: 0;
}
.pitch-call__ptype {
    font-size: var(--fs-readout-type);
    letter-spacing: 1px;
    color: var(--sb-call-strike);
    margin: 0 var(--sp-2) 0 0;
    padding: 0;
}
.pitch-call__speed {
    font-size: var(--fs-readout-speed);
    color: var(--sb-ink-1);
    margin: 0;
    padding: 0;
}
.pitch-call__unit {
    font-size: var(--fs-readout-unit);
    color: var(--sb-call-detail-ink);
    margin: 0 0 0 3px;
    padding: 0;
}

/* DuelFieldLabel：対決ビューの打球処理中（守備の引き）に出す頭上フルネームラベル（issue #393）。
   実況テロップ風＝半透明黒地＋白文字（2026-08-03 監督決定③）。PitchCallと同じ器・idiomを流用する。
   人名は書体3役ルールにより明朝（.f-display と併用、design-16）。画面空間の固定サイズで置くため
   width/height は指定せず呼び出し側が座標だけ動かす（寄っても引いても同じ大きさ＝実況中継のCG寄り）。
   盤面ビューなので色は状態コードの対象外（CLAUDE.md「適用範囲の例外（試合盤面）」）。 */
.duel-field-label {
    position: absolute;
    background-color: rgba(14, 26, 19, 0.82);
    border-radius: var(--radius-chip);
    padding: var(--sp-1) var(--sp-2);
    color: var(--sb-ink-1);
    font-size: var(--fs-cap);
    -unity-text-align: middle-center;
    white-space: nowrap;
    translate: -50% -100%;
}
/* 走者だけアンバー縁（2D俯瞰の走者=アンバーと視覚言語を統一。守備側は無地, 2026-08-03 監督決定①）。 */
.duel-field-label--runner {
    border-width: 2px;
    border-color: var(--color-lamp);
}

/* ScoreCall：得点時の大型スコアオーバーレイ（issue #60）。半透明パネル・既定非表示は
   PitchCall（#6）と同じ盤面overlay idiomを踏襲。並びは自校－相手校固定（先攻/後攻に依存しない）。
   校名は設計書16のシグネチャ規則「校名は常に太明朝」（.f-display、LineScorePanelと同じ扱い）、
   得点はコンデンス数字（.f-num-bd、UI原則③）。1枚の半透明パネルに5要素を横並びで収める。

   ⚠ 縦位置だけは PitchCall と分ける（top 20% → 40% → 63%。監督決定 2026-08-01 / 2026-08-13）。
   本塁打は「判定＋推定飛距離」と得点テロップが**必ず同時に出る**ので、同じ高さに置くと
   得点パネルが判定の上に乗って文字が読めない（コールの側が先に置かれた器なので、
   ずらすのは得点のほう＝ストライク／ボール／アウト／ホームランは常に同じ高さに出る）。

   40% は「判定の器が 20%〜36%」だった頃の値。その後 .pitch-call が top 38% へ動いたため
   **2% しか離れておらず実際には完全に重なっていた**（issue homerun-call-until-home-touch で
   ホームラン表示が本塁到達まで残るようになり、初めて絵に出た。実測 1600×900: 判定 y265〜414 /
   得点 y278〜360 ＝ 重なり 82px で「ホームラン」が読めない）。
   63% は判定の器の下端（＝盤面の 61.0%）に一呼吸空けた値で、同じ実測で重なり 0px を確認済み。
   .pitch-call の top を動かすときはここも測り直すこと（片方だけ動かすと静かに重なる）。 */
.score-call {
    position: absolute;
    left: 0; right: 0; top: 63%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    display: none;
}
.score-call__panel {
    flex-direction: row;
    align-items: center;
    background-color: rgba(14, 26, 19, 0.82);
    border-radius: var(--radius-panel);
    padding: var(--sp-2) var(--sp-4);
}
/* 校名・区切りも暗パネル上なので --sb-ink-1（明色）。chalk は昼スキンで暗インクへ反転している（#236 症状B）。 */
.score-call__team {
    font-size: var(--fs-body);
    -unity-text-align: middle-center;
    color: var(--sb-ink-1);
    padding: 0 var(--sp-2);
}
.score-call__num {
    font-size: var(--fs-callout);
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    color: var(--color-lamp);
    min-width: 40px;
    padding: 0 var(--sp-1);
}
.score-call__sep {
    font-size: var(--fs-callout);
    -unity-text-align: middle-center;
    color: var(--sb-ink-1);
    padding: 0 var(--sp-1);
}

/* SubCall：交代ポップアップ（issue #209 表現）。継投・投野交代・野手登板を数秒だけ盤面へ浮かせる。
   PitchCall/ScoreCall と同じ overlay idiom（半透明パネル・既定非表示）。種別タグは1個だけの一過性強調で
   アンバー（野手系だけ点灯・通常継投は無彩の面）。本文は暗い盤面の上なので掲示板と同じ --sb-ink-1（明色）。 */
.sub-call {
    position: absolute;
    /* 打者HUDを右上へ移したので、天井近くに出すと必ず重なる。得点テロップ（20%）より下へ逃がす。 */
    left: 0; right: 0; top: 30%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    display: none;
}
.sub-call__panel {
    flex-direction: row;
    align-items: center;
    background-color: rgba(14, 26, 19, 0.82);
    border-radius: var(--radius-panel);
    padding: var(--sp-2) var(--sp-4);
}
/* 盤面（緑）の上に浮かせる暗い島なので、文字は掲示板と同じ「黒面上の常時明色」＝--sb-ink-*。
   デースキン反転（--color-chalk はインク暗色に反転）に引きずられないよう board 系トークンを使う。 */
.sub-call__tag {
    font-size: var(--fs-label);
    -unity-text-align: middle-center;
    color: var(--sb-ink-1);
    background-color: var(--sb-board-line);
    border-radius: var(--radius-chip);
    padding: var(--sp-1) var(--sp-2);
    margin-right: var(--sp-2);
}
/* 野手登板・投野交代は「眺めてニヤニヤ」対象＝一過性のアンバー点灯で際立たせる（UI原則⑥）。
   アンバー面の上の文字は暗インク（--color-ink）。 */
.sub-call__tag--fielder {
    color: var(--color-ink);
    background-color: var(--color-lamp);
}
.sub-call__text {
    font-size: var(--fs-body);
    -unity-text-align: middle-center;
    color: var(--sb-ink-1);
}

/* ── BoxRow：ボックススコア表の1行（試合結果画面のイニングスコア／打撃／投手／打席結果に共通）──
   密度は正義（UI原則①）。行高32px・数値は右揃え・列幅は種別クラスで固定してヘッダーとデータを揃える。
   線はヘッダー下だけ（UI原則④）。データ行は面の明度差だけで仕切る（枠線を引かない）。 */
.bs-row {
    flex-direction: row;
    align-items: center;
    height: 32px;
    flex-shrink: 0;
}
/* 表の見出し行。ここだけ罫線を引く（機能のある線）。 */
.bs-row--head {
    height: 26px;
    background-color: var(--color-panel-deep);
    border-bottom-width: var(--border-w);
    border-bottom-color: var(--color-line);
}
.bs-row--head .bs-cell {
    font-size: var(--fs-th);
    color: var(--color-muted);
    -unity-font-style: normal;
}
/* 交互の地色（読み違い防止。線ではなく面で行を仕切る）。 */
.bs-row--alt { background-color: var(--color-panel-deep); }

/* セル既定：数値は右揃え・桁揃え（UI原則③）。種別クラスで幅と揃えを決める。 */
.bs-cell {
    font-size: var(--fs-label);
    color: var(--color-chalk);
    -unity-text-align: middle-right;
    flex-shrink: 0;
    padding-right: var(--sp-1);
}
.bs-cell--pos { width: 24px; -unity-text-align: middle-center; color: var(--color-muted); padding-right: 0; }
.bs-cell--name {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-left: var(--sp-2);
}
.bs-cell--num { width: 32px; }
.bs-cell--avg { width: 48px; }
.bs-cell--inn { width: 46px; }        /* 投球回（5 2/3） */
.bs-cell--mark { width: 22px; -unity-text-align: middle-center; color: var(--color-muted); padding-right: 0; }
/* 打席結果セル（1〜n打席目）。等分割で伸ばす。 */
.bs-cell--pa {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    -unity-text-align: middle-center;
    padding-right: 0;
    white-space: nowrap;
    overflow: hidden;
}
/* 打席結果グリッドの打者名。等分割セルに幅を奪われないよう固定幅にする。 */
.bs-cell--paname {
    width: 104px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-left: var(--sp-2);
}
/* 出塁しなかった打席は淡く（一覧のスキャンで出塁だけ拾える＝UI原則⑥）。 */
.bs-cell--dim { color: var(--color-faint); }
.bs-cell--empty { color: var(--color-line); }

/* イニングスコア専用の列（校名／各回／計H E）。 */
.bs-cell--team {
    width: 132px;
    -unity-text-align: middle-left;
    padding-left: var(--sp-2);
}
.bs-cell--inning { width: 30px; -unity-text-align: middle-center; padding-right: 0; }
.bs-cell--total { width: 38px; }
/* 得点欄だけ一段大きく（数字が主役・UI原則③）。装飾はしない。 */
.bs-cell--runs { font-size: var(--fs-num); }

/* ═══ ScoreboardStrip：電光掲示板の帯（設計書16 §4-1・F1-b 案B「升目グリッド」）═══════
   「二つの声のルール」の掲示板側。黒面（--sb-face）に升目を切り、値を1文字1マスの
   ドット文字（.f-dot）で並べる。この部品の中は必ずドット、外に出たら明朝＋サンセリフ。

   借りるのは視覚言語であって情報ではない（design-16 §1）。ここに出すのは
   TopBar の既存情報（週・カウントダウン）だけで、試合スコアは出さない。

   マスは C# 側（UiComponents.FillScoreboardCells）が値文字列から1文字ずつ生成する。
   非数値（「開催中」「本日 試合」「―」）もそのまま升目に載るので分岐が要らない。 */
/* 明地トップバーの上の「電光掲示板」。黒緑の面＋深いインクのベゼル（筐体）＋升目マトリクスで
   甲子園の電光掲示板に寄せる。黒面積はこの島だけに閉じ込める（design-19）。
   ・ベゼル＝インク3px枠＋右下を太らせた案イ影（マウントした盤面の立体感）
   ・盤面の内側に一段黒い余白（padding）を取り、升目が筐体に嵌まって見える。 */
.sbs {
    flex-direction: row;
    align-items: center;
    background-color: var(--sb-face);
    border-color: var(--ink);
    border-top-width: 3px; border-left-width: 3px;
    border-right-width: 5px; border-bottom-width: 5px;
    border-radius: 0;
    padding: 6px 14px 8px 14px;
    flex-shrink: 0;
}
/* 1グループ＝ラベル行＋升目行（現在／夏予選まで）。 */
.sbs-group { align-items: center; flex-shrink: 0; }
/* ラベル行は升目に密着させ「盤面の見出し」に見せる（浮いた灰キャプションにしない）。 */
.sbs-group__head { flex-direction: row; align-items: center; margin-bottom: 4px; }
/* ラベルもドットで出す（掲示板の中だから）。DotGothic16 は和文もドット字形を持つ。 */
.sbs-group__k {
    font-size: var(--fs-dot-16);
    color: var(--sb-ink-2);   /* 掲示板は黒島＝文字は常に明色（--color-* に追従させない） */
    letter-spacing: 1px;
}
/* 升目に載せない添え字（年など）。マス外の小ドットで、値の主役を奪わない。 */
.sbs-group__sup {
    font-size: var(--fs-dot-16);
    color: var(--sb-ink-2);
    margin-left: var(--sp-2);
}
.sbs-cells { flex-direction: row; align-items: center; }
/* 升目1マス。地を面より一段明るい「消灯セル」にし、枠を明るめの緑グレーにして
   マトリクスをはっきり見せる＝電光掲示板の要。数字は電光アンバーで点灯。 */
.sbs-cell {
    width: var(--sb-cell-w);
    height: var(--sb-cell-h);
    font-size: var(--fs-dot-32);
    color: var(--color-lamp);        /* 値マス＝電光アンバー（掲示板内は電光数字専用でOK） */
    background-color: var(--sb-cell-bg);
    -unity-text-align: middle-center;
    border-width: var(--border-w);
    border-color: var(--sb-grid);
    margin-right: -1px;   /* 隣のマスと枠線を共有して二重線にしない */
    flex-shrink: 0;       /* 掲示板は絶対に潰さない（UI-BUILD-METHOD 落とし穴） */
    padding: 0;
}
.sbs-cell--wide { width: var(--sb-cell-w-wide); }
/* 単位（月・週）のマスは値より一段落とす＝数字が主役（UI原則③）。地はセルのまま。 */
.sbs-cell--unit { color: var(--sb-ink-2); font-size: var(--fs-dot-16); }
/* 点灯マス＝最重要値（カウントダウン）。アンバー地の凹みで「点灯している」感を強める。 */
.sbs-cell--lit { color: var(--color-lamp-hi); background-color: var(--sb-lit-bg); }
/* グループ間の間隔。線は引かず黒面の余白で分ける（UI原則④）。 */
.sbs-gap { width: 34px; flex-shrink: 0; }

/* ═══ SchoolName：校名（設計書16 §4-3）═════════════════════════════════
   「校名は常に太明朝」が本リスタイルのシグネチャ規則（design-16 §1）。
   校名＝掲示板の外＝中継テロップ／新聞の語彙なので、掲示板のドットとは絶対に混ぜない。
   明朝は 16px 以上・太ウェイト限定（暗背景で細い横画が潰れるため）。
   都道府県・シード等の小書きはサンセリフのままにして、明朝は固有名詞だけに絞る。 */
.school-name { flex-direction: row; align-items: center; flex-wrap: wrap; }
.school-name__main {
    font-size: 24px;
    color: var(--color-chalk);
    letter-spacing: 1px;
}
.school-name__sub {
    font-size: var(--fs-label);
    color: var(--color-muted);
    margin-left: var(--sp-2);
}
/* 対戦カード・展望の主役校など「1画面で1つだけ大きく」出す用途（UI原則②）。 */
.school-name--lg .school-name__main { font-size: 26px; }

/* ═══ RuleHead：新聞の柱見出し（設計書16 §5「英語eyebrow廃止」の受け皿）═══════
   英語の eyebrow（TOURNAMENT PREVIEW ―― 等）を置き換える日本語の柱見出し。
   縦罫＋明朝の小見出しで「記事の柱」を表す。アンバーは使わない
   （見出しは全画面に何度も出るのでアクセントにすると希少性が壊れる＝UI原則②）。 */
.rule-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--sp-2);
}
.rule-head__rule {
    width: 3px;
    height: 16px;
    background-color: var(--color-muted);
    margin-right: var(--sp-2);
    flex-shrink: 0;
}
.rule-head__text {
    font-size: var(--fs-label);
    letter-spacing: 3px;
    color: var(--color-muted);
}

/* ═══ NumUnit：数字＋和文単位の混植セル（設計書16 §2・決定2-B）═════════════════
   数字（.nu-num＝Oswald）と和文単位（.nu-unit）を1行に並べる。単位は数字より一段落とした
   ミュートで添える（数字を主役にする＝UI原則③）。色・サイズはセル側の文脈を継承する。 */
.nu-wrap { flex-direction: row; align-items: center; }
.nu-unit { color: var(--color-muted); margin-left: 2px; }

/* ═══ LineScorePanel：甲子園式ラインスコア（設計書16 §4-2・F2 案A「統合1枚板」）═════════
   本リスタイルの本丸。1枚の黒面に「回別得点＋R/H/E」と「B/S/O ランプ＋塁ダイヤ」を横並びで収める
   （現行の mlive-sb ＋ mlive-bso の2段を置き換える）。高さは現行2段と同じ約108pxに収める。

   境界規則の例外: 掲示板の中は原則すべてドットだが、**校名だけは太明朝**にする
   （「校名は常に太明朝」が本リスタイルのシグネチャ規則＝design-16 §1。2026-07-21 にユーザー判断で確定）。

   マスは C# 側（LineScorePanel.Fill）が回数ぶん生成する。延長で回が増えたら --dense へ切り替えて
   マス幅を詰める（列を flex-shrink で潰さない＝UI-BUILD-METHOD の落とし穴）。 */
.lsc {
    flex-direction: row;
    align-items: center;
    background-color: var(--sb-face);
    border-radius: var(--radius-panel);
    padding: var(--sp-1) var(--sp-3);
    margin-bottom: 6px;
    flex-shrink: 0;
}
.lsc-board { flex-shrink: 0; }
.lsc-row { flex-direction: row; align-items: center; height: var(--sb-cell-h); flex-shrink: 0; }
.lsc-row--head { height: var(--lsc-head-h); }

/* ── マス ────────────────────────────────────────────────────────────
   回のマスと R/H/E のマスは幅だけ違い、行高は共有する。枠線は隣と共有して二重線にしない。 */
.lsc-cell {
    width: var(--lsc-cell-w);
    height: 100%;
    font-size: var(--fs-dot-32);
    color: var(--sb-ink-1);   /* 黒島の上の主数字＝常に明色 */
    -unity-text-align: middle-center;
    border-width: var(--border-w);
    border-color: var(--sb-grid);
    margin-right: -1px;
    flex-shrink: 0;
    padding: 0;
}
.lsc--dense .lsc-cell { width: var(--lsc-cell-w-dense); font-size: var(--fs-dot-16); }
/* R / H / E は集計欄。回のマスより広く取り、掲示板の縦罫で回と分ける。 */
.lsc-cell--total { width: var(--lsc-total-w); }
.lsc-cell--sep { border-left-width: 2px; border-left-color: var(--sb-board-line); }
/* 得点が入った回のマスだけ点灯（実物の電球が灯る比喩）。盤面ビューなので色＝状態コード
   ＝UI原則②の本数制限の対象外（CLAUDE.md の但し書き）。 */
.lsc-cell--lit { color: var(--color-lamp); }
/* まだ来ていない回は「・」ではなく空マス。地の色を一段落として空であることを示す。 */
.lsc-cell--empty { color: var(--color-faint); }

/* 見出し行（回番号と R/H/E の見出し）。値より一段小さいドット。 */
.lsc-row--head .lsc-cell {
    font-size: var(--fs-dot-16);
    color: var(--sb-ink-2);
    border-width: 0;
}
/* 進行中の回だけ見出しを点灯させ、どこを見ればよいか一目で分かるようにする。 */
.lsc-row--head .lsc-cell--now { color: var(--color-lamp); }

/* 校名セル。掲示板の中だが校名だけは太明朝（.f-display を C# 側で付与）。 */
.lsc-cell--name {
    width: var(--lsc-name-w);
    height: 100%;
    font-size: 22px;
    color: var(--sb-ink-1);
    -unity-text-align: middle-left;
    padding-left: var(--sp-2);
    border-width: 0;
    flex-shrink: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
/* 見出し行の左上は実物では空欄。ここに現在の回（4回表）をドットで置く。 */
.lsc-cell--inning {
    width: var(--lsc-name-w);
    height: 100%;
    font-size: var(--fs-dot-16);
    color: var(--color-lamp);
    -unity-text-align: middle-left;
    padding-left: var(--sp-2);
    flex-shrink: 0;
}

/* ── B/S/O ランプ＋塁ダイヤ（掲示板の右袖） ─────────────────────────
   ランプ色は現行ルール準拠（B=緑 / S=黄 / O=赤）＋必ず文字併記で色覚対応（設計書16 §4-2）。 */
.lsc-count { flex-direction: row; align-items: center; margin-left: 24px; flex-shrink: 0; }
.lsc-lamps { flex-direction: column; flex-shrink: 0; }
.lsc-lamp-row { flex-direction: row; align-items: center; height: 18px; }
.lsc-lamp-key {
    font-size: var(--fs-dot-16);
    color: var(--sb-ink-2);
    width: 18px;
    -unity-text-align: middle-center;
}
/* 消灯の電球。黒面(--sb-face)の上では --color-line だと沈んで消えるので、
   「消えている電球がそこにある」と読める明度（--line-focus）まで上げる。 */
.lsc-lamp {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin-left: 5px;
    background-color: var(--sb-board-line);   /* 消灯の電球＝黒島の上で見える淡グレー */
    flex-shrink: 0;
}
.lsc-lamp--ball.is-on { background-color: var(--color-good); }
.lsc-lamp--strike.is-on { background-color: var(--color-lamp); }
.lsc-lamp--out.is-on { background-color: var(--color-warn); }

/* 塁ダイヤ（正ひし形。2塁=上・1塁=右・3塁=左）。占有＝アンバー＝2D俯瞰の走者色と一致させる。 */
.lsc-diamond { width: 46px; height: 46px; margin-left: 24px; flex-shrink: 0; }
.lsc-base {
    position: absolute;
    width: 15px;
    height: 15px;
    background-color: var(--color-faint);
    rotate: 45deg;
}
.lsc-base--second { top: 0; left: 15px; }
.lsc-base--first { top: 15px; left: 30px; }
.lsc-base--third { top: 15px; left: 0; }
.lsc-base.is-on { background-color: var(--color-lamp); }

/* ═══ TacticsCardDeck：采配指示の手札（試合画面改修・C#は Components/TacticsCardDeck.cs）═══════
   盤面の直下に、重なり合ったカードとして采配指示を並べる。カーソルが乗った1枚だけが持ち上がり、
   最前面へ出る（両隣を中間拡大する Dock 風は採らない＝2026-07-31 ユーザー判断）。

   カードの箱の寸法（幅・高さ・重なり）は TacticsCardDeck.cs が持つ。ここは色と枠だけ。
   自作要素が自分の幾何を持つのは BaseballFieldElement / Match2DPlaybackElement と同じ作法。 */
.tcards { flex-shrink: 0; align-items: center; }
.tcards__inner { position: relative; height: 100%; }
/* 当たり判定の層。カードの上に透明な短冊を敷き、ポインタの出入りと押下はここだけで拾う
   （カードは重なり順を入れ替える＝木から外れるので、判定を持たせるとクリックが成立しない）。 */
.tcards__hits { position: absolute; left: 0; top: 0; bottom: 0; }
.tcards__hit { position: absolute; top: 0; bottom: 0; }

.tcard {
    position: absolute;
    bottom: 0;
    background-color: var(--sf-card);
    border-width: var(--nb-border);
    /* 左は隣のカードに重なる辺。太くして「上に乗っている」継ぎ目を作る（USS に box-shadow は無い）。 */
    border-left-width: var(--nb-shadow-card);
    border-right-width: var(--nb-shadow);
    border-bottom-width: var(--nb-shadow);
    border-color: var(--ink);
    transition-property: translate, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
    transform-origin: 50% 100%;   /* 下端を軸に上へ伸び上がる（帯の高さを変えずに大きく見せる） */
}
/* 持ち上がるのはカーソルが乗った1枚だけ。最前面化は C# の BringToFront が行う（USS に z-index は無い）。 */
.tcard--hot { translate: 0 -12px; scale: 1.22; }

/* 上2/3＝将来ここへ絵を入れる場所。いまは Icon の1文字を淡く敷いて枠だと分かるようにする。 */
.tcard__art {
    flex-grow: 1;
    background-color: var(--sf-inset);
}
/* 絵の面いっぱいに置いて上下中央（級数はカード寸法から C# が決めるので、余白を数値で持たない）。 */
.tcard__ghost {
    position: absolute;
    left: 0;
    top: 0; bottom: 0;
    color: var(--ink);
    opacity: 0.14;
    -unity-text-align: middle-center;
}
/* 下段＝名前。左の帯（隣に隠れない幅）の中央へ置く＝カード全幅で中央揃えにすると隣の下に潜る。
   段の高さと級数は TacticsCardDeck.cs が決める（長い名前は2行に割るので、幅と高さの両方で効く）。 */
.tcard__cap {
    flex-shrink: 0;
    border-top-width: var(--nb-border);
    border-top-color: var(--ink);
    background-color: var(--sf-card);
}
.tcard__name {
    position: absolute;
    left: 0;
    top: 0; bottom: 0;
    color: var(--tx-1);
    -unity-text-align: middle-center;
}

/* 選択中＝操作系の青（旧 SignPad の選択色を踏襲）。 */
.tcard--on { border-color: var(--sky); }
.tcard--on .tcard__cap { background-color: var(--sky); border-top-color: var(--sky); }
.tcard--on .tcard__name { color: var(--sf-card); }
/* 既定（任せ/通常）＝指示なし。絵の面だけ真っ白にして「白紙のカード」に見せる
   （USS に破線ボーダーは無いので、地の明度差で「中身が無い」を出す）。 */
.tcard--default .tcard__art { background-color: var(--sf-card); }
.tcard--default .tcard__ghost { opacity: 0.07; }
.tcard--default .tcard__name { color: var(--tx-2); }
/* いまの局面で選べないカード（走者なしの盗塁など）。拡大もクリックもしない。 */
.tcard--off .tcard__art { background-color: var(--sf-inset); opacity: 0.4; }
.tcard--off .tcard__cap { background-color: var(--sf-inset); }
.tcard--off .tcard__name { color: var(--tx-3); }

/* ═══ InningBreak：攻守交代のイニング間画面（試合画面改修）══════════════════════════
   3アウトで攻守が入れ替わったら、次の打席を始める前に数秒だけ盤面へ被せる暗幕。
   上部から撤去したラインスコアを大写しにして「いま何回で何点差か」をここで受け取ってもらう。
   既存の一過性オーバーレイ（pitch-call / score-call / sub-call）と同じ作法＝既定非表示＋自前の寿命。
   ラインスコアは拡大せず、部品そのままの寸法で中央に置く（scale で拡大すると罫が半端に太る）。 */
.inning-break {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    /* ほぼ不透明。プロジェクトはリニア色空間で、暗色のアルファ合成は見た目の減光が数値よりずっと弱い
       （0.78 で実測55%減にしかならない）。「画面が切り替わった」と読ませたいので 0.94 まで上げる。 */
    background-color: rgba(10, 15, 12, 0.94);
}
.inning-break__caption {
    font-size: var(--fs-callout);
    color: var(--sb-ink-1);
    margin-bottom: var(--sp-4);
    letter-spacing: 4px;
}
.inning-break__hint {
    font-size: var(--fs-label);
    color: var(--sb-ink-2);
    margin-top: var(--sp-4);
    letter-spacing: 3px;
}
/* 回間にカウントは無意味なので、イニング間のラインスコアでは右袖ごと畳む。
   上部常設だった頃の下マージンも、中央に置く今は不要。 */
.inning-break .lsc-count { display: none; }
.inning-break .lsc { margin-bottom: 0; padding: var(--sp-2) var(--sp-4); }

/* 大写し。ドットは16の整数倍サイズ限定なので 32→48 に上げ、マスと行高もそれに合わせて広げる
   （scale で引き伸ばすと罫が半端に太るので、寸法そのものを差し替える）。 */
.inning-break .lsc-row { height: var(--lsc-row-h-big); }
.inning-break .lsc-row--head { height: var(--lsc-head-h-big); }
.inning-break .lsc-cell { width: var(--lsc-cell-w-big); font-size: var(--fs-dot-48); }
.inning-break .lsc-cell--total { width: var(--lsc-total-w-big); }
.inning-break .lsc-cell--name { width: var(--lsc-name-w-big); font-size: 30px; }
.inning-break .lsc-cell--inning { width: var(--lsc-name-w-big); font-size: var(--fs-dot-32); }
.inning-break .lsc-row--head .lsc-cell { font-size: var(--fs-dot-32); }
/* 延長でマスが増えたら大写しをやめて通常寸法へ戻す（潰して収めない）。 */
.inning-break .lsc--dense .lsc-cell { width: var(--lsc-cell-w); font-size: var(--fs-dot-32); }
.inning-break .lsc--dense .lsc-row { height: var(--sb-cell-h); }

/* ═══ ScoreBug：盤面左上の常時表示バグ（試合画面改修・器は Components/ScoreBug.uxml）═══════
   野球中継のアレ。打席の演出中も切らさずカウント・塁・両校の得点を出しっぱなしにする。
   面は掲示板の黒（--sb-face）＋インク枠＝design-19 の黒島語彙で、盤面の絵の上でも沈まない。

   左袖＝縦の B/S/O。ランプ（点の並び）ではなく**数字**で出す（2026-07-31 ユーザー判断）。
   ラベル列は黒面、数字列は明地に反転させて「カウントだけ別の板」に見せる。
   右＝回表示と塁ダイヤを重ねた段＋チーム2行。塁は埋まっている塁だけ描く（空塁は描かない）。
   アンバーは「走者」と「攻撃中の印」だけ＝盤面ビューの状態コード（UI原則②の但し書き）。 */
.sbug {
    position: absolute;
    top: var(--sp-3);
    left: var(--sp-3);
    flex-direction: row;
    background-color: var(--sb-face);
    border-width: var(--nb-border);
    border-color: var(--ink);
    flex-shrink: 0;
}

/* ── 左袖：縦の B/S/O ランプ（issue #479。2026-07-31 の数字方式から再改定） ──────────
   寸法は参照モック docs/design/mock-pitch-view.html の実測値そのまま（径13 / 間隔6 / 行間5 /
   ラベル幅14）。島は 71×49px にしかならないので、右ブロック（56+32+32=120px）に対して
   上下中央へ置き、余る71pxは均等に捨てる＝案A（2026-08-05 監督選択）。
   USS に gap は無いのでランプ側の margin-left で間隔を作る（ラベル→1個目の6pxも同じ margin が担う）。 */
.sbug-lamps {
    justify-content: center;   /* 余りを上下へ等分＝案A */
    flex-shrink: 0;
    padding-left: var(--sp-3);
    padding-right: var(--sp-3);
}
.sbug-lamprow { flex-direction: row; align-items: center; flex-shrink: 0; }
/* USS に nth-child は無いので、2行目以降だけ修飾子で行間を付ける。 */
.sbug-lamprow--next { margin-top: var(--lamp-row-gap); }
/* ラベルはランプより大きいので、**高さをランプ径に固定して行の高さを決めさせない**
   （決めさせるとランプの縦の間隔が仕様の行間5pxより広がり、格子が崩れる）。
   はみ出したぶんは行間へ出るだけ（UI Toolkit の overflow 既定は visible）。 */
.sbug-lamprow__key {
    width: var(--lamp-key-w);   /* 固定幅＝3行の左端を揃える */
    height: var(--lamp-d);
    flex-shrink: 0;
    font-size: var(--lamp-fs-key);
    letter-spacing: var(--lamp-ls-key);
    color: var(--lamp-key-ink);
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
}
/* ランプ本体。消灯の凹み（inset 0 0 3px rgba(0,0,0,.8)）は USS に inset shadow が無いので、
   縁が最も暗く内へ抜ける黒のテクスチャを background-image として地色の上へ重ねて出す。
   点灯時は凹みを外す（光っているLEDは凹んで見えない）。 */
.sbug-lamp {
    width: var(--lamp-d);
    height: var(--lamp-d);
    border-radius: 50%;
    flex-shrink: 0;
    margin-left: var(--lamp-gap);
    background-color: var(--lamp-off);
    background-image: url("project:///Assets/UI/Images/board/lamp-inset.png");
    transition-property: background-color;
    transition-duration: 120ms;
    transition-timing-function: linear;
}
.sbug-lamp.is-on { background-image: none; }
.sbug-lamp--b.is-on { background-color: var(--lamp-b); }
.sbug-lamp--s.is-on { background-color: var(--lamp-s); }
.sbug-lamp--o.is-on { background-color: var(--lamp-o); }
/* グロー（box-shadow 0 0 9px <同色> 相当）。これが無いと電光掲示板ではなくただの色付きの丸になる。
   テクスチャは本体13pxの外側だけに出るドーナツなので、本体の上に重ねても中心を隠さない
   ＝本体とグローの2要素で済む（内側を焼くと本体を覆ってしまう）。色は点灯色でティントする。

   ⚠ テクスチャの断面は「本体と同じ円板をガウスぼかししたもの」でなければならない。
   box-shadow のぼかしは**元の形をぼかす**ので、縁のαは 1.0 ではなく 0.35 程度から始まる。
   これを「縁で1.0から外へ減衰」で作ると全半径で約3倍明るくなり、13pxのランプに対して
   halo が勝って滲んで見える（2026-08-05 実測・監督指摘）。生成は tools/gen-lamp-sprites.py。 */
.sbug-lamp__glow {
    position: absolute;
    left: var(--lamp-glow-off);
    top: var(--lamp-glow-off);
    width: var(--lamp-glow-d);
    height: var(--lamp-glow-d);
    background-image: url("project:///Assets/UI/Images/board/lamp-glow.png");
    opacity: 0;
    transition-property: opacity;
    transition-duration: 120ms;
    transition-timing-function: linear;
}
.sbug-lamp.is-on .sbug-lamp__glow { opacity: var(--lamp-glow-a); }
.sbug-lamp--b .sbug-lamp__glow { -unity-background-image-tint-color: var(--lamp-b); }
.sbug-lamp--s .sbug-lamp__glow { -unity-background-image-tint-color: var(--lamp-s); }
.sbug-lamp--o .sbug-lamp__glow { -unity-background-image-tint-color: var(--lamp-o); }
/* 左袖と右ブロックの境。旧実装では数字列の明地が境目も兼ねていたが、ランプ化で黒同士が
   突き合わせになるため、黒島専用の淡い分割線を1本だけ引く（UI原則④）。 */
.sbug-sep {
    width: var(--border-w);
    flex-shrink: 0;
    background-color: var(--sb-board-line);
}

/* ── 右：回＋塁ダイヤ／チーム2行 ──────────────────────────────── */
.sbug-main {
    flex-grow: 1;
    flex-basis: 0;
    min-width: var(--sbug-main-w);
    padding-left: var(--sp-3);
    padding-right: var(--sp-3);
}
.sbug-top {
    height: var(--sbug-top-h);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

/* 塁ダイヤ。段いっぱいに広げた透明な枠の中央へ菱形を置き、回表示をその上に重ねる。 */
.sbug-dia {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}
/* 潰す層。USS の変形は scale→rotate の順に効くため、回す層と分けないと平たい菱形にならない。 */
/* 回表示の地色が中央band を隠すので、菱形は文字より十分横長にして左右の稜が残るようにする。 */
.sbug-dia__box { width: 54px; height: 54px; scale: 1.8 0.72; flex-shrink: 0; }
.sbug-dia__in {
    width: 100%;
    height: 100%;
    rotate: 45deg;
    border-width: var(--border-w);
    border-color: var(--sb-ink-2);
}
/* 塁は占有＝アンバー＝2D俯瞰の走者色と一致。空いている塁は描かない（中継の作法）。 */
.sbug-base { position: absolute; width: 14px; height: 14px; display: none; }
.sbug-base.is-on { display: flex; background-color: var(--color-lamp); }
.sbug-base--second { top: -7px; left: -7px; }
.sbug-base--first { top: -7px; right: -7px; }
.sbug-base--third { bottom: -7px; left: -7px; }

/* 回表示は菱形の上。地色を敷いて罫を文字の下で抜く（USS に文字の縁取りは無い）。 */
.sbug-inning {
    flex-direction: row;
    align-items: center;
    background-color: var(--sb-face);
    padding-left: var(--sp-1);
    padding-right: var(--sp-1);
}
.sbug-inning__num { font-size: var(--fs-num-lg); color: var(--sb-ink-1); margin: 0; padding: 0; }
.sbug-inning__half {
    font-size: var(--fs-cap);
    color: var(--sb-ink-1);
    margin: 0 0 0 1px;
    padding: 0;
}

.sbug-team { flex-direction: row; align-items: center; height: var(--sbug-team-h); flex-shrink: 0; }
/* 攻撃中の印。校名の左に立てる細いアンバーの棒（矢印記号はSDFに無い字が混ざるため使わない）。 */
.sbug-team__mark { width: 5px; height: 20px; flex-shrink: 0; }
.sbug-team--batting .sbug-team__mark { background-color: var(--color-lamp); }
.sbug-team__name {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    font-size: var(--sbug-fs-name);
    color: var(--sb-ink-1);
    margin: 0 0 0 var(--sp-2);
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.sbug-team__runs {
    min-width: 30px;
    font-size: var(--sbug-fs-runs);
    color: var(--sb-ink-1);
    -unity-text-align: middle-right;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
}

/* ═══ VerticalName：縦書き選手名（甲子園両翼式）══════════════════════════
   設計書16 §9-2 の試作用。UI Toolkit に縦書き（writing-mode）は無いので、
   1文字＝1 Label のスタックで組む自作部品にする。掲示板の両翼と同じく
   「打順 → 守備 → 姓を1字1行」の縦列を打順ぶん横に並べる。

   採否は F2 のゲートでユーザーが決める（design-16 §9-2）。不採用なら丸ごと削除できるよう、
   画面側に一切のロジックを持たせず、この辞書エントリだけで完結させてある。 */
.vname-wing {
    flex-direction: row;
    background-color: var(--sb-face);
    border-radius: var(--radius-panel);
    padding: var(--sp-3) var(--sp-2);
    flex-shrink: 0;
}
.vname { width: 32px; align-items: center; flex-shrink: 0; }
.vname__ord {
    font-size: var(--fs-dot-16);
    color: var(--color-muted);
    height: 20px;
    -unity-text-align: middle-center;
}
.vname__pos {
    font-size: var(--fs-dot-16);
    color: var(--color-chalk);
    height: 22px;
    margin-bottom: var(--sp-1);
    -unity-text-align: middle-center;
}
/* 1文字ぶんのマス。明朝は16px以上・太ウェイト限定なので22pxで置く。 */
.vname__ch {
    font-size: 22px;
    color: var(--color-chalk);
    height: 26px;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}
/* 自校・注目選手など「1列だけ立てる」用（アンバーは列単位でしか使わない）。 */
.vname--lit .vname__ch { color: var(--color-lamp); }

/* ── LevelPips：段階レベルの升目（経営画面の施設レベル等）────────────────────
   「何段まで上げたか」を数字を読まずに拾えるようにする器（UI原則⑥）。
   状態コードではなく有無の2値なので、色はインク（保有）と地色（未保有）だけ＝
   アクセント（アンバー・警告）は使わない（UI原則②）。段数は呼び出し側が渡す。 */
.lv-pips {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}
.lv-pip {
    width: 14px;
    height: 14px;
    margin-right: var(--sp-1);
    background-color: var(--sf-inset);
    border-color: var(--ink);
    border-top-width: var(--nb-border);
    border-left-width: var(--nb-border);
    border-right-width: var(--nb-border);
    border-bottom-width: var(--nb-border);
    border-radius: 0;
}
.lv-pip--on { background-color: var(--ink); }

/* ═══════════════════════════════════════════════════════════════════════
   UniformColorPicker（配色の領域行・部品辞書 / 設計書18 §3.5.1・issue #585）
   ───────────────────────────────────────────────────────────────────────
   チーム設定画面と新規ゲーム設定画面が共有する。組み立ては Components/UniformColorPicker.cs。
   行高・文字はデータ画面（32px・UI原則①）でなく**操作の的**として決めている＝
   一覧をスキャンする画面ではなく色を送って選ぶ部品だから
   （2026-07-29 監督指示「文字大きく・枠も大きく・ボタンも大きくして選びやすく」）。
   列幅はヘッダー(.ucp-th--*)とデータ(.ucp-cell--*)が同じ変数を見る＝横ずれの構造的対策。
   ═══════════════════════════════════════════════════════════════════════ */
:root {
    --ucp-col-name: 200px;    /* 領域名（最長「アンダーシャツ」7字） */
    --ucp-col-val: 170px;     /* 色の名前（最長「ワインレッド」6字。150pxだと見本欄に噛む） */
    --ucp-col-swatch: 110px;  /* 見本 */
    --ucp-col-pick: 130px;    /* 送りボタン。伸ばさず**固定**＝右に空列を作らない */
    /* 操作行の高さ。8行＋縞の塊分け(12px)が1画面に収まる上限で、これ以上大きくすると
       最終行（縞色）がカードからはみ出して切れる（実測: 行の入る高さ372px / 8行+12 ≦ 372 → 45px） */
    --ucp-row-h: 44px;
}

.ucp-thead {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 28px;
    border-bottom-width: 2px;
    border-bottom-color: var(--color-line);
    margin-bottom: var(--sp-2);
}

.ucp-th {
    font-size: var(--fs-th);
    color: var(--color-muted);
    margin: 0;
    padding: 0;
    flex-shrink: 0;
}

.ucp-th--name { width: var(--ucp-col-name); }
.ucp-th--val { width: var(--ucp-col-val); }
.ucp-th--swatch { width: var(--ucp-col-swatch); }
.ucp-th--pick { width: var(--ucp-col-pick); }

.ucp-rows { flex-shrink: 0; }

.ucp-row {
    flex-direction: row;
    align-items: center;
    height: var(--ucp-row-h);
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-line-soft);
}

/* 縞の2行は配色本体と役割が違うので、上に間を空けて塊を分ける（線でなく余白で区切る＝UI原則④） */
.ucp-row--group { margin-top: var(--sp-3); }

.ucp-cell {
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    font-size: var(--fs-page);
    color: var(--color-chalk);
}

.ucp-cell--name { width: var(--ucp-col-name); }
.ucp-cell--val { width: var(--ucp-col-val); color: var(--color-muted); }

.ucp-cell--swatch {
    width: var(--ucp-col-swatch);
    flex-direction: row;
    align-items: center;
}

.ucp-swatch {
    width: 84px;
    height: 30px;
    border-width: 1px;
    border-color: var(--color-line-focus);
}

.ucp-pick {
    width: var(--ucp-col-pick);
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

Button.ucp-arrow {
    width: 56px;
    height: 36px;
    margin: 0;
    margin-right: var(--sp-2);
    padding: 0;
    font-size: var(--fs-body);
    background-color: var(--color-panel-deep);
    color: var(--color-chalk);
    border-width: 1px;
    border-color: var(--color-line-focus);
    border-radius: var(--radius-chip);
}

Button.ucp-arrow:hover { background-color: var(--color-panel-hover); }

/* ── Timeline：キャリア年表の縦軸＋節点（設計書16 §10.2 の穴#7・issue #586）───────
   「年 ｜ 節点と縦軸 ｜ 出来事」の3列。縦軸は装飾ではなく<b>時間が続いていることを示す線</b>なので
   UI原則④（線は機能がある場所だけ）に反しない。最終節点（現在）だけ白抜きの丸にして、
   そこから先がまだ書かれていないことを形で出す。色はインクの濃淡だけでアクセントを使わない（UI原則②）。 */
.timeline { }
.timeline__node { flex-direction: row; align-items: stretch; flex-shrink: 0; }
/* 年は数字だけのセル＝Oswald（書体3役）。右揃えで桁を揃える。 */
.timeline__year {
    width: var(--col-tl-year);
    flex-shrink: 0;
    font-size: var(--fs-num);
    color: var(--tx-2);
    -unity-text-align: upper-right;
    margin: 0;
    padding: 0;
    padding-top: 5px;
}
/* 節点と縦軸の列。丸の直径ぶんだけ幅を取り、線は丸の中心を通す。 */
.timeline__rail {
    width: var(--col-tl-rail);
    flex-shrink: 0;
    align-items: center;
    margin-left: var(--sp-3);
    margin-right: var(--sp-3);
}
.timeline__dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: var(--ink);
    margin-top: 7px;
    flex-shrink: 0;
}
.timeline__line { width: 2px; background-color: var(--ink); opacity: 0.28; flex-grow: 1; }
/* 現在（まだ続いている節点）＝白抜き。線はここで終わるので出さない。 */
.timeline__node--now .timeline__dot { background-color: var(--sf-card); border-width: 2px; border-color: var(--ink); }
.timeline__node--now .timeline__year { color: var(--tx-3); }
.timeline__body { flex-grow: 1; flex-basis: 0; min-width: 0; padding-bottom: var(--sp-2); }
.timeline__title { font-size: var(--fs-body); color: var(--tx-1); margin: 0; padding: 0; overflow: hidden; }
.timeline__note { font-size: var(--fs-cap); color: var(--tx-2); margin: 2px 0 0 0; padding: 0; white-space: normal; }
.timeline__node--now .timeline__title { color: var(--tx-2); }
/* 空状態（まだ何も起きていない）。 */
.timeline__empty { font-size: var(--fs-label); color: var(--tx-3); margin: 0; padding: var(--sp-3) 0; }

/* ── RecordCell：記録室の混植セル（設計書16 §10.2 の穴#8・issue #600）───────────
   「.384 ／ 中田 大祐 ／ 2027」を1行に組む。Oswald は欧文専用で和文グリフを持たないため
   数字と和文は Label を分ける（書体3役ルール）。値は右揃え・固定幅で桁を揃え（UI原則③）、
   縮むのは氏名だけにする＝年が押し出されない。 */
.recc { flex-direction: row; align-items: center; flex-grow: 1; flex-basis: 0; min-width: 0; }
.recc__value {
    width: var(--col-rc-val);
    flex-shrink: 0;
    font-size: var(--fs-num);
    color: var(--tx-1);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-right;
}
/* 氏名は固定幅。flex-grow にすると年が列の右端まで飛んで「どの記録の年か」が読めなくなる
   （値・氏名・年は1つの記録なので、離さず塊で置く）。 */
.recc__name {
    width: var(--col-rc-name);
    flex-shrink: 0;
    font-size: var(--fs-body);
    color: var(--tx-1);
    margin: 0 0 0 var(--sp-3);
    padding: 0;
    overflow: hidden;
}
.recc__year {
    width: var(--col-rc-year);
    flex-shrink: 0;
    font-size: var(--fs-cap);
    color: var(--tx-3);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}
/* 該当者なし（規定未達で誰も載らない）。列の左端に「—」だけ置いて空けておく。 */
.recc--empty { }
.recc__dash {
    width: var(--col-rc-val);
    flex-shrink: 0;
    font-size: var(--fs-num);
    color: var(--tx-3);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-right;
}

/* ── EmptyState：空状態の汎用（設計書16 §10.2 の穴#11・issue #600）─────────────
   1年目はどの新規画面も全欄が空になる。「壊れている」ではなく「これから埋まる」と読めるよう、
   罫線も枠も足さず余白と最弱文字だけで表す（UI原則④）。 */
.empty-state {
    flex-shrink: 0;
    align-items: center;
    padding-top: var(--sp-4);
    padding-bottom: var(--sp-4);
}
.empty-state__text { font-size: var(--fs-label); color: var(--tx-3); margin: 0; padding: 0; }
.empty-state__note { font-size: var(--fs-cap); color: var(--tx-3); margin: var(--sp-2) 0 0 0; padding: 0; }
