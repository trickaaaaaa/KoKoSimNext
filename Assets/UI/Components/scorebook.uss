/* ═══════════════════════════════════════════════════════════════════════
   scorebook.uss — 試作スキン「モダンミニマル＋スコアブック」のトークンと部品（2026-11-09）
   ───────────────────────────────────────────────────────────────────────
   オーダー画面（LineupSetting）で試す新スキン。良ければ設計書を改訂して他画面へ広げる前提の試作で、
   それまでは .sbk を付けた画面ルートの中だけに効く（他画面の昼NBスキンは変えない）。
   ・トークンは .sbk に置く（USSカスタムプロパティは子へ継承される）。部品はトークンだけを参照する。
   ・スクールカラー --color-accent は既定値。実行時の差し替えは C# SchoolAccent.Apply が
     acc-fg / acc-bg / acc-bd / acc-bd-top の付いた要素へ直接色を流し込む
     （USS変数は C# から書き換えられないため。差し色の付く場所はこの4クラスでしか表さない）。
   ・ランク（画像）は機能色なので変えない（設計書19 §0）。書体（Noto Sans JP）と調子の色は全画面共通（design-22 G0）。
   gap/grid/擬似要素は使わない（USS非対応）。
   ═══════════════════════════════════════════════════════════════════════ */

.sbk {
    /* 面と線 */
    --sbk-paper: #F2EFE8;          /* 画面背景（紙色） */
    --sbk-card: #FFFFFF;           /* カード・パネル */
    --sbk-card-line: #E3DFD5;      /* カードの枠（通常） */
    --sbk-card-line-hover: #D9D4C8;/* カードの枠（ホバー） */
    --sbk-rule: #D9D4C8;           /* ヘッダー下の区切り線 */
    --sbk-rule-soft: #ECE8DF;      /* パネル内の区切り線・横棒の下地 */
    --sbk-seg-bg: #E6E2D8;         /* 2択切替の土台 */

    /* 文字 */
    --sbk-text: #1D1B18;           /* 本文 */
    --sbk-sub: #6F6A60;            /* 補足 */
    --sbk-info: #4F4A42;           /* 学年・投打 */
    --sbk-lose: #7A756C;           /* 負けている数値 */

    /* 差し色と比較相手 */
    --color-accent: #7A1F2B;       /* スクールカラー既定（臙脂）。実行時に SchoolAccent が差し替える */
    --sbk-ink: #2F2C27;            /* 比較相手（墨） */

    /* 背番号布 */
    --sbk-patch-bg: #FBFAF6;
    --sbk-patch-line: #3A3631;

    /* 怪我タグ */
    --sbk-injury-bg: #F9E3E0;
    --sbk-injury-fg: #8A1F1A;

    /* 守備位置チップ（系統で色分け） */
    --sbk-pos-p-bg: #F6D4D0;  --sbk-pos-p-fg: #8A1F1A;   /* 投手 */
    --sbk-pos-c-bg: #DBE8F5;  --sbk-pos-c-fg: #1D4E80;   /* 捕手 */
    --sbk-pos-if-bg: #F6E6CF; --sbk-pos-if-fg: #7A4510;  /* 内野 */
    --sbk-pos-of-bg: #DFECD2; --sbk-pos-of-fg: #2F5612;  /* 外野 */
    --sbk-pos-dh-bg: #E9E6F3; --sbk-pos-dh-fg: #4A3E8C;  /* 指名打者 */

    /* 角丸 */
    --sbk-r-card: 10px;
    --sbk-r-panel: 12px;
    --sbk-r-chip: 6px;
    --sbk-r-tag: 4px;
    --sbk-r-patch: 3px;

    /* 線の太さ */
    --sbk-line: 1px;
    --sbk-line-sel: 2px;
    --sbk-line-patch: 1.5px;

    /* ダイアログ（試合中のタイム・2026-11-14） */
    --sbk-dialog: #F7F4EE;         /* ダイアログの地（画面の紙色より一段明るい） */
    --sbk-scrim: rgba(26, 23, 19, 0.52);   /* 背後の試合画面に敷く暗幕 */
    --sbk-paper-veil: rgba(247, 244, 238, 0.90);   /* 絵の上に敷く紙色の薄い地（タイトルのメニュー・2026-11-22） */
    --sbk-r-dialog: 16px;
    --sbk-mute: #8C867B;           /* 空き塁・アウトの枠・区切りの記号 */
    --sbk-mute-soft: #B5AFA4;      /* 使えない側の伝令の丸 */
    --sbk-accent-soft: rgba(122, 31, 43, 0.10);   /* 臙脂の10%（アイコンの地） */

    /* メンバー設定（背番号の画面）：一段濃い紙色の地・入れ物の地・点線・球場の絵 */
    --sbk-paper-deep: #E7E2D7;     /* 画面の地（紙色のカードが浮く濃さ） */
    --sbk-well: #DED8CB;           /* カードを並べる入れ物の地 */
    --sbk-dash: #CFC8BB;           /* 空き枠の点線 */
    --sbk-field-deep: #3F6B3A;     /* 球場の絵：外周 */
    --sbk-field-grass: #4B7A44;    /* 球場の絵：芝 */
    --sbk-field-grass-edge: #5A8A52;   /* 球場の絵：外野の芝の縁 */
    --sbk-field-dirt: #B48A60;     /* 球場の絵：土 */
    --sbk-field-line: rgba(243, 239, 230, 0.8);   /* 球場の絵：ファウルライン */
    --sbk-field-base: #F6F3EC;     /* 球場の絵：塁 */
    --sbk-danger: #A0473C;         /* 元に戻せない操作（削除）のアイコンと確定ボタン */

    background-color: var(--sbk-paper);
    color: var(--sbk-text);
}


/* ── 差し色クラス（既定値。実行時は SchoolAccent.Apply が上書き） ── */
.sbk .acc-fg { color: var(--color-accent); }
.sbk .acc-bg { background-color: var(--color-accent); }
.sbk .acc-bd { border-color: var(--color-accent); }
.sbk .acc-bd-top { border-top-color: var(--color-accent); }

/* ── カード（白・角丸10・1px枠）。選択枠は2px＝通常時も 1px枠＋1px内余白で同じ外寸を確保し、
      選択時に 2px枠＋0内余白へ切り替える（レイアウトがずれない）。 ── */
.sbk-card {
    background-color: var(--sbk-card);
    border-width: var(--sbk-line);
    border-color: var(--sbk-card-line);
    border-radius: var(--sbk-r-card);
    padding: 1px;
    flex-shrink: 0;
}
.sbk-card:hover { border-color: var(--sbk-card-line-hover); }
.sbk-card--sel { border-width: var(--sbk-line-sel); padding: 0; }
.sbk-card--sel-ink { border-width: var(--sbk-line-sel); padding: 0; border-color: var(--sbk-ink); }
.sbk-card--sel-ink:hover { border-color: var(--sbk-ink); }

/* パネル（白・角丸12・1px枠） */
.sbk-panel {
    background-color: var(--sbk-card);
    border-width: var(--sbk-line);
    border-color: var(--sbk-card-line);
    border-radius: var(--sbk-r-panel);
}

/* 小見出しラベル（12px・補足色） */
.sbk-cap { font-size: 12px; color: var(--sbk-sub); }

/* ── NumberPatch：背番号布（30×24・数字14px） ── */
.sbk-patch {
    width: 30px;
    height: 24px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: 14px;
    color: var(--sbk-text);
    background-color: var(--sbk-patch-bg);
    border-width: var(--sbk-line-patch);
    border-color: var(--sbk-patch-line);
    border-radius: var(--sbk-r-patch);
}

/* ── PositionChip：守備位置チップ（高さ30・15px。系統で色分け。ボタンとして押せる） ── */
.sbk-pos {
    width: 44px;
    height: 30px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: 15px;
    border-radius: var(--sbk-r-chip);
    border-width: var(--sbk-line-sel);
    border-color: rgba(0, 0, 0, 0);   /* 選択時の2px枠ぶんを常に確保（外寸を変えない） */
}
.sbk-pos--p { background-color: var(--sbk-pos-p-bg); color: var(--sbk-pos-p-fg); }
.sbk-pos--c { background-color: var(--sbk-pos-c-bg); color: var(--sbk-pos-c-fg); }
.sbk-pos--if { background-color: var(--sbk-pos-if-bg); color: var(--sbk-pos-if-fg); }
.sbk-pos--of { background-color: var(--sbk-pos-of-bg); color: var(--sbk-pos-of-fg); }
.sbk-pos--dh { background-color: var(--sbk-pos-dh-bg); color: var(--sbk-pos-dh-fg); }
.sbk-pos--button:hover { border-color: var(--sbk-card-line-hover); }
/* 1つ目を選んだ状態（2つ目のチップで入替）。差し色は使わない＝墨の枠。 */
.sbk-pos--picked { border-color: var(--sbk-ink); }
.sbk-pos--picked:hover { border-color: var(--sbk-ink); }

/* ── CaptainStamp：主将マーク（20pxの円・差し色1.5px枠・「主」11px・-8度） ── */
.sbk-captain {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    border-width: var(--sbk-line-patch);
    border-radius: 10px;
    rotate: -8deg;
    align-items: center;
    justify-content: center;
    margin-left: 6px;
}
.sbk-captain__ch { font-size: 11px; -unity-text-align: middle-center; }

/* ── 怪我タグ（11px） ── */
.sbk .sbk-injury {
    font-size: 11px;
    color: var(--sbk-injury-fg);
    background-color: var(--sbk-injury-bg);
    border-radius: var(--sbk-r-tag);
    padding: 1px 6px;
    align-self: flex-start;
}
.sbk .sbk-injury--row { flex-direction: row; align-items: center; }
.sbk .sbk-injury--row Label { font-size: 11px; color: var(--sbk-injury-fg); }

/* ── 入部の条件（約束）のタグ（11px。墨の細枠＝選手についている約束／警告色＝いまの並びで破る） ── */
.sbk .sbk-promise {
    font-size: 11px;
    color: var(--sbk-ink);
    border-width: 1px;
    border-color: var(--sbk-ink);
    border-radius: var(--sbk-r-tag);
    padding: 0 5px;
    margin: 0;
    align-self: flex-start;
}
.sbk .sbk-promise--warn {
    color: var(--sbk-injury-fg);
    background-color: var(--sbk-injury-bg);
    border-color: var(--sbk-injury-fg);
}

/* ── RankChip のこの試作での大きさ（画像はそのまま。設計書19＝ランク色は機能色） ── */
.sbk .rank-chip--sbk22 { min-width: 22px; width: 22px; height: 22px; padding: 0; flex-shrink: 0; }
.sbk .rank-chip--sbk36 { min-width: 36px; width: 36px; height: 36px; padding: 0; flex-shrink: 0; }

/* ── ConditionFace：この試作では輪郭リングを出さない（白カードの上なので「普通」も溶けない） ── */
.sbk .cond-face { --face-ring: rgba(0, 0, 0, 0); }   /* 調子の色は全画面共通（tokens.uss --cond-*）。ここでは輪郭だけ消す */
.sbk .cond-face--26 { width: 26px; height: 26px; }
.sbk .cond-face--24 { width: 24px; height: 24px; }

/* ── 2択切替（DHあり/なし・野手/投手タブ）。選ばれている側は白地＋1px枠 ── */
.sbk-seg {
    flex-direction: row;
    background-color: var(--sbk-seg-bg);
    border-radius: 8px;
    padding: 3px;
    flex-shrink: 0;
}
.sbk .sbk-seg__opt {
    height: 26px;
    padding: 0 12px;
    -unity-text-align: middle-center;
    font-size: 12px;
    color: var(--sbk-sub);
    border-radius: var(--sbk-r-chip);
    border-width: var(--sbk-line);
    border-color: rgba(0, 0, 0, 0);
}
.sbk .sbk-seg__opt:hover { color: var(--sbk-text); }
.sbk .sbk-seg__opt--on { background-color: var(--sbk-card); color: var(--sbk-text); border-color: var(--sbk-card-line); }

/* ── StatBarRow：ランクチップ（22）＋数値（28・右揃え・15px）＋横棒（残り・太さ8） ── */
.sbk-bar {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 26px;
}
.sbk .sbk-bar__val {
    width: 28px;
    flex-shrink: 0;
    font-size: 15px;
    -unity-text-align: middle-right;
    color: var(--sbk-text);
    margin-left: 6px;
    margin-right: 8px;
}
.sbk-bar__track {
    flex-grow: 1;
    height: 8px;
    border-radius: 4px;
    background-color: var(--sbk-rule-soft);
    overflow: hidden;
}
.sbk-bar__fill { height: 8px; border-radius: 4px; }
.sbk-bar--b .sbk-bar__fill { background-color: var(--sbk-ink); }
.sbk-bar--lose .sbk-bar__val { color: var(--sbk-lose); }
.sbk-bar--lose .sbk-bar__fill { opacity: 0.35; }
/* 数値なし（弾道などのタイプ軸）。テキストだけを置く。 */
.sbk-bar__text { font-size: 14px; color: var(--sbk-text); -unity-text-align: middle-left; }
.sbk-bar__none { font-size: 14px; color: var(--sbk-lose); }

/* ═══════════════════════════════════════════════════════════════════════
   design-22 G1：シェルと共通の器をスコアブックへ（.sbk を付けたデータ画面だけ）
   ───────────────────────────────────────────────────────────────────────
   ① 昼NB（design-19）のトークンを .sbk の中で読み替える＝トークン駆動の部品は自動で切り替わる。
   ② インクの枠（--ink は文字色も兼ねる）・塗りの見出しプレート・ベタ影の固定幅は
      トークンだけでは消えないので、器ごとに .sbk 付きのセレクタで上書きする。
   試合中の画面は .sbk を付けない＝ここは一切効かない。
   ═══════════════════════════════════════════════════════════════════════ */
.sbk {
    /* 面 */
    --sf-base: #F2EFE8;  --color-field: #F2EFE8;
    --sf-raise: #F2EFE8; --color-strip: #F2EFE8;
    --sf-card: #FFFFFF;  --color-panel: #FFFFFF;
    --sf-inset: #F4F1EA; --color-panel-deep: #F4F1EA;
    --sf-hover: #ECE8DF; --color-panel-hover: #ECE8DF;
    --dirt-well: #F2EFE8;
    --color-row-hover: #F7F5F0;
    /* 文字（--ink は文字色として残す。枠は下で個別に淡色へ） */
    --ink: #1D1B18;
    --tx-1: #1D1B18; --color-chalk: #1D1B18; --day-tx-1: #1D1B18;
    --tx-2: #6F6A60; --color-muted: #6F6A60; --day-tx-2: #6F6A60;
    --tx-3: #8A857A; --color-faint: #8A857A; --day-tx-3: #8A857A;
    /* 線 */
    --color-line: #E3DFD5; --color-line-soft: #ECE8DF; --divider: #D9D4C8;
    --color-line-focus: #2F2C27;
    /* 枠の太さ・ベタ影は撤去（1px の淡い枠だけ） */
    --nb-border: 1px; --nb-border-card: 1px;
    --nb-shadow: 0;   --nb-shadow-card: 0;
    --nb-card-edge: 1px; --nb-panel-edge: 1px;
    /* 角丸 */
    --radius-card: 10px; --radius-panel: 12px; --radius-chip: 6px; --radius-modal: 12px;
    /* 役割色：操作・選択は墨。見出しの塗りプレートは白（＝塗らない） */
    --sky: #2F2C27;
    --sakura: #ECE8DF; --sakura-tint: #F6F3EC;
    --grass: #FFFFFF; --dirt: #FFFFFF;
}

/* ── カード・パネル系の器：淡い1px枠＋角丸。右下のベタ影（固定幅）も1pxへ ── */
.sbk .card, .sbk .tpm-card, .sbk .tpc-card, .sbk .ev__box, .sbk .nb-plate__front, .sbk .tcard {
    border-color: var(--sbk-card-line);
    border-width: 1px;
    border-radius: var(--sbk-r-card);
}
.sbk .nb-plate__shadow { display: none; }
.sbk .panel { border-radius: var(--sbk-r-panel); }

/* カードの見出し：塗りをやめ、白地に明朝の題字＋パネル内の淡い区切り線 */
.sbk .card__hd, .sbk .plate-header {
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 1px;
    border-bottom-color: var(--sbk-rule-soft);
    padding: 14px 18px 10px 18px;
}
.sbk .card__hd--tight { padding-top: 8px; padding-bottom: 6px; }
.sbk .card__hd-title, .sbk .plate-header__title {
    color: var(--sbk-text);
    font-size: 18px;
    letter-spacing: 1.4px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/ShipporiMinchoB1-ExtraBold.asset?fileID=11400000&guid=7f2420c220fb74dc88a61dafe12284b0&type=2#ShipporiMinchoB1-ExtraBold");
}
.sbk .card__hd-sub, .sbk .plate-header__sub { color: var(--sbk-sub); opacity: 1; }

/* 小さな器（ボタン・枠・小片）：淡い1px枠 */
.sbk .nb-border, .sbk .tool-btn, .sbk .banner, .sbk .lv-pip, .sbk .ev__stage,
.sbk .ev-por__head, .sbk .ev-por__body, .sbk .ev-por__image, .sbk .tpm-head, .sbk .tpm-preset-strip,
.sbk .tpm-foot, .sbk .tpc-head, .sbk .tp-ed-id, .sbk Button.ngs-sug {
    border-color: var(--sbk-card-line);
}
.sbk .tool-btn, .sbk Button.ngs-sug { border-width: 1px; border-radius: var(--sbk-r-chip); }

/* ── 行パネル：紙色の上に白カードの行を6px間隔で積む。選択は墨の2px枠 ── */
.sbk .row-well { background-color: rgba(0, 0, 0, 0); padding: 4px 0 12px 0; }
.sbk .row-panel, .sbk .lineup-row, .sbk .bench-row {
    border-color: var(--sbk-card-line);
    border-width: 1px;
    border-radius: var(--sbk-r-card);
    margin-bottom: 6px;
}
.sbk .row-panel:hover { background-color: var(--sbk-card); border-color: var(--sbk-card-line-hover); }
.sbk .row-panel--selected, .sbk .row-panel--selected:hover {
    background-color: var(--sbk-card);
    border-width: 2px;
    border-color: var(--sbk-ink);
    /* 枠が1px→2px になった差ぶん、components.uss の既定パディング（16/8・dense は上下4）から1px引いて中身をずらさない */
    padding-left: 15px; padding-right: 15px; padding-top: 7px; padding-bottom: 7px;
}
.sbk .row-panel--dense.row-panel--selected, .sbk .row-panel--dense.row-panel--selected:hover { padding-top: 3px; padding-bottom: 3px; }
.sbk .row--selected { border-color: var(--sbk-ink); }

/* 表（リーグ表・ボックススコア）の外枠と見出し下の線は淡い1px（設計書22 §2。--line-focus は sbk が読み替えない） */
.sbk .bs-table { border-color: var(--sbk-card-line); }
.sbk .bs-row--head { border-bottom-color: var(--sbk-rule); }

/* ── トップバー（墨の帯・Home.*.mock 準拠・全データ画面共通）。1段目78px＋タブ46px、左右28px ── */
.sbk .sb2 {
    background-color: var(--tb-ink);
    border-bottom-width: 0;
    height: 78px;
    padding: 0 28px;
    align-items: center;
}
.sbk .sb2-left { padding: 0; border-right-width: 0; flex-grow: 1; }
.sbk .sb2-badge {
    width: 46px; height: 46px;
    border-width: 0;
    border-radius: 8px;
    background-color: var(--color-accent);
    color: #FFFFFF;
    font-size: 26px;
    margin-right: 14px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/ShipporiMinchoB1-ExtraBold.asset?fileID=11400000&guid=7f2420c220fb74dc88a61dafe12284b0&type=2#ShipporiMinchoB1-ExtraBold");
}
.sbk .sb2-id { margin-right: 28px; }
.sbk .sb2-name {
    color: var(--tb-text);
    font-size: 24px;
    letter-spacing: 1.9px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/ShipporiMinchoB1-ExtraBold.asset?fileID=11400000&guid=7f2420c220fb74dc88a61dafe12284b0&type=2#ShipporiMinchoB1-ExtraBold");
}
.sbk .sb2-pref { font-size: 12px; color: var(--tb-sub); letter-spacing: 0; margin-top: 1px; }
.sbk .sb2-div { width: 1px; height: 40px; background-color: var(--tb-rule); margin: 0 28px 0 0; flex-shrink: 0; }
.sbk .sb2-div--gap { margin-left: 36px; }
.sbk .sb2-record__v { font-size: 22px; margin-top: 3px; }
.sbk .sb2-date__k { font-size: 15px; color: var(--tb-sub); margin: 0; padding: 0; }
.sbk .sb2-date__v {
    font-size: 26px;
    color: var(--tb-text);
    margin: 1px 0 0 0; padding: 0;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/ShipporiMinchoB1-ExtraBold.asset?fileID=11400000&guid=7f2420c220fb74dc88a61dafe12284b0&type=2#ShipporiMinchoB1-ExtraBold");
}

/* 右側：部費残高・チーム総合・名声・信頼度（項目の間隔30px）＋進めるボタン */
.sbk .sb2-right { padding: 0; border-left-width: 0; flex-shrink: 0; }
.sbk .sb2-meter { margin-right: 30px; align-items: center; }
.sbk .sb2-meter--start { align-items: flex-start; }
.sbk .sb2-meter__k { font-size: 12px; color: var(--tb-sub); letter-spacing: 0; margin: 0 0 4px 0; padding: 0; }
.sbk .sb2-meter__v { margin: 0; padding: 0; }
.sbk .sb2-meter__v--funds {
    font-size: 20px;
    color: var(--tb-text);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/NotoSansJP-Bold.asset?fileID=11400000&guid=0a6535b0156cd4b349a9c2b1c707ba43&type=2#NotoSansJP-Bold");
}
.sbk .sb2-meter__v--fame, .sbk .sb2-meter__v--trust { width: 26px; height: 26px; min-width: 26px; font-size: 15px; }
.sbk .sb2-rank__row { flex-direction: row; align-items: center; margin: 0; height: 26px; }
.sbk .sb2-rank__chip .grade, .sbk .sb2-rank__chip .rank-chip { width: 26px; height: 26px; min-width: 26px; font-size: 15px; margin: 0; padding: 0; }
.sbk .sb2-rank__v {
    font-size: 19px;
    color: var(--tb-text);
    margin: 0 0 0 6px; padding: 0;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/NotoSansJP-Bold.asset?fileID=11400000&guid=0a6535b0156cd4b349a9c2b1c707ba43&type=2#NotoSansJP-Bold");
}

/* ── 主ボタン（今週を進める・1日進める）：応援団赤のまま（設計書22）。高さ50・角丸10・17px太字 ── */
.sbk .advance {
    height: 50px;
    border-width: 0;
    border-radius: 10px;
    font-size: 17px;
    letter-spacing: 1.7px;
    padding: 0 22px 0 26px;
    margin: 0;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/NotoSansJP-Bold.asset?fileID=11400000&guid=0a6535b0156cd4b349a9c2b1c707ba43&type=2#NotoSansJP-Bold");
}
.sbk .advance:hover { background-color: var(--color-cta-hi); }

/* ナビ：墨の帯の2段目（46px）。タブは帯の幅いっぱいに均等に並べる（右に余白を残さない）。
   選択中は白の太字＋白の3px下線、それ以外は淡い灰 */
.sbk .nav {
    flex-direction: row;
    flex-wrap: nowrap;
    background-color: var(--tb-ink);
    border-bottom-width: 0;
    height: 46px;
    margin: 0;
    padding: 0 28px;
    flex-shrink: 0;
}
.sbk .nav__item {
    flex-grow: 1;
    flex-basis: 0;
    -unity-text-align: middle-center;
    color: var(--tb-sub);
    font-size: 18px;
    letter-spacing: 0;
    padding: 0;
    margin: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}
.sbk .nav__item:hover { color: #FFFFFF; }
.sbk .nav__item--on {
    background-color: rgba(0, 0, 0, 0);
    color: #FFFFFF;
    border-bottom-color: #FFFFFF;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/NotoSansJP-Bold.asset?fileID=11400000&guid=0a6535b0156cd4b349a9c2b1c707ba43&type=2#NotoSansJP-Bold");
}

/* ═══════════════════════════════════════════════════════════════════════
   design-22 G2：主要データ画面に残る旧スキンの共通部品をスコアブックの部品へ寄せる
   ═══════════════════════════════════════════════════════════════════════ */

/* 背番号バッジ → 背番号布（NumberPatch と同じ見た目） */
.sbk .num-badge, .sbk .num-badge--sm {
    background-color: var(--sbk-patch-bg);
    color: var(--sbk-text);
    border-width: var(--sbk-line-patch);
    border-color: var(--sbk-patch-line);
    border-radius: var(--sbk-r-patch);
}
/* 寸法もオーダー画面の背番号布（30×24・数字14px）に揃える。小型（--sm）は 24×20・12px */
.sbk .num-badge { width: 30px; height: 24px; font-size: 14px; }
.sbk .num-badge--sm { width: 24px; height: 20px; font-size: 12px; }
.sbk .num-badge--out { color: var(--sbk-lose); border-color: var(--sbk-card-line-hover); }

/* 切替（タブ・絞り込み）→ 2択切替と同じ。土台の上で、選ばれている側だけ白地＋1px枠 */
.sbk .ms-cmp-tabs, .sbk .seg-tabs {
    background-color: var(--sbk-seg-bg);
    border-radius: 8px;
    padding: 3px;
}
.sbk .ms-tab, .sbk .seg-tab, .sbk .filter-chip {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: var(--sbk-r-chip);
    color: var(--sbk-sub);
}
.sbk .ms-tab:hover, .sbk .seg-tab:hover, .sbk .filter-chip:hover { color: var(--sbk-text); border-color: rgba(0, 0, 0, 0); }
.sbk .ms-tab--on, .sbk .seg-tab--on, .sbk .filter-chip--on,
.sbk .ms-tab--on:hover, .sbk .seg-tab--on:hover, .sbk .filter-chip--on:hover {
    background-color: var(--sbk-card);
    color: var(--sbk-text);
    border-color: var(--sbk-card-line);
}
.sbk .ms-tab { margin-left: 0; margin-right: 0; }

/* 矢印ボタン（配色の選択など）：白地・淡い枠 */
.sbk Button.ucp-arrow {
    background-color: var(--sbk-card);
    color: var(--sbk-sub);
    border-color: var(--sbk-card-line);
    border-radius: var(--sbk-r-chip);
}
.sbk Button.ucp-arrow:hover { color: var(--sbk-text); border-color: var(--sbk-card-line-hover); background-color: var(--sbk-card); }

/* 練習の行：学年・投打はタグにせず文字で（オーダー画面と同じ「1年 右投右打」） */
.sbk .trow .chip--tag {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--sbk-info);
    padding-left: 0;
    padding-right: 0;
    margin-right: 8px;
}

/* ═══════════════════════════════════════════════════════════════════════
   比較表 CompareTable（オーダー画面・メンバー設定で共有）
   列：能力名64｜自チーム側｜間24｜比較相手。見出し・能力行・守備適性・持ち球チャートで同じ構成。
   ═══════════════════════════════════════════════════════════════════════ */
.sbk .sbk-cmp-lab { width: 64px; flex-shrink: 0; font-size: 12px; color: var(--sbk-sub); margin: 0; padding: 0; -unity-text-align: middle-left; }
.sbk .sbk-cmp-col { flex-grow: 1; flex-basis: 0; min-width: 0; }
.sbk .sbk-cmp-gap { width: 24px; flex-shrink: 0; }

/* 選手の見出し（上端に3pxの線：自チーム側＝差し色、比較相手＝墨、いない側＝淡線だけ） */
.sbk .sbk-cmp__head { flex-direction: row; flex-shrink: 0; margin-top: 10px; padding-bottom: 12px; border-bottom-width: 1px; border-bottom-color: var(--sbk-rule-soft); }
.sbk .sbk-cmp-pl { border-top-width: 3px; padding-top: 10px; }
.sbk .sbk-cmp-pl--b { border-top-color: var(--sbk-ink); }
.sbk .sbk-cmp-pl--none { border-top-color: var(--sbk-rule-soft); }
.sbk .sbk-cmp-pl__name { font-size: 20px; letter-spacing: 1.6px; color: var(--sbk-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0; padding: 0; }
.sbk .sbk-cmp-pl__meta { font-size: 12px; color: var(--sbk-info); margin: 4px 0 0 0; padding: 0; white-space: nowrap; overflow: hidden; }
/* 先頭ラベルの左余白（4px）ぶん行ごと左へ寄せる（USS は :first-child 非対応）。 */
.sbk .sbk-cmp-pl .cat-rank-chips { margin-top: 6px; margin-left: -4px; justify-content: flex-start; }
.sbk .sbk-cmp-pl .cat-rank-chips__label { font-size: 11px; color: var(--sbk-sub); margin: 0 1px 0 4px; padding: 0; }
.sbk .sbk-cmp-pl .skill-chips { margin-top: 6px; }
.sbk .sbk-cmp-pl .skill-chip {
    height: 20px;
    font-size: 11px;
    color: var(--sbk-info);
    border-color: var(--sbk-card-line-hover);
    border-radius: 10px;
    padding: 0 8px;
    margin: 0 4px 4px 0;
}

/* 能力の行（高さ26） */
.sbk .sbk-cmp__rows { margin-top: 8px; }
.sbk .sbk-cmp-row { flex-direction: row; align-items: center; height: 26px; }

/* 守備適性（9マス）。共通部品 AptitudeStrip を表の列（能力名64）に合わせて敷き直す。 */
.sbk .sbk-cmp__apt { margin-top: 12px; padding-top: 10px; border-top-width: 1px; border-top-color: var(--sbk-rule-soft); }
.sbk .sbk-cmp__apt .apt-strip { margin-top: 0; }
.sbk .sbk-cmp__apt .apt-strip__row { min-height: 26px; }
.sbk .sbk-cmp__apt .apt-strip__row--head { min-height: 18px; }
.sbk .sbk-cmp__apt .apt-strip__lab { width: 64px; font-size: 12px; color: var(--sbk-text); border-left-width: 0; padding-left: 0; }
.sbk .sbk-cmp__apt .apt-strip__row--head .apt-strip__lab { color: var(--sbk-sub); }
.sbk .sbk-cmp__apt .apt-strip__pos { font-size: 12px; color: var(--sbk-sub); }
.sbk .sbk-cmp__apt .apt-strip__cell .rank-chip { min-width: 22px; height: 22px; padding: 0; }

/* 持ち球チャート（投手能力タブ） */
.sbk .sbk-cmp__chart { flex-direction: row; margin-top: 12px; }
.sbk .sbk-cmp__chart-cell { flex-grow: 1; flex-basis: 0; min-width: 0; height: 150px; }

/* ═══════════════════════════════════════════════════════════════════════
   G3 残りのデータ画面
   ═══════════════════════════════════════════════════════════════════════ */
/* 主ボタン（応援団赤）の文字は白。試合開始前・試合結果の CTA はアンバー時代の暗文字のままだった。 */
.sbk Button.mp-cta,
.sbk Button.mr-cta { color: var(--color-on-fill); }

/* レーダーの軸ラベル：Label 既定の上下余白のぶん「名前」と「値」の間が空き、値が6角形に重なっていた。 */
.sbk .radar-axis__l,
.sbk .radar-axis__v { margin: 0; padding: 0; }

/* 入力欄（新規作成の都道府県・地区・校名）：Unity 既定の灰色を白地＋淡い1px枠へ。
   部品 SbkField＝`.sbk-field` を TextField / DropdownField に付ければ同じ見た目になる（校名の編集 #946 で辞書化）。 */
.sbk .ngs-drop .unity-base-field__input,
.sbk .ngs-text .unity-base-field__input,
.sbk .sbk-field .unity-base-field__input {
    background-color: var(--sbk-card);
    border-width: 1px;
    border-color: var(--sbk-card-line-hover);
    border-radius: var(--sbk-r-chip);
    color: var(--sbk-text);
}
.sbk .ngs-drop .unity-base-popup-field__arrow,
.sbk .sbk-field .unity-base-popup-field__arrow { -unity-background-image-tint-color: var(--sbk-sub); }
.sbk .sbk-field { margin: 0; }
/* 部品 SbkFieldSuffix：入力欄の右に固定表示する接尾（校名欄の「高校」）。明朝で校名の一部として読ませる。 */
.sbk .sbk-field-suffix {
    margin: 0 0 0 var(--sp-2);
    padding: 0;
    font-size: var(--fs-page);
    color: var(--sbk-text);
    flex-shrink: 0;
}

/* ── DialogButton の墨と削除色（セーブデータ画面の確認：上書き・読み込み＝墨／削除＝削除色） ── */
.sbk .dlg-btn--ink { background-color: var(--sbk-text); color: var(--sbk-card); border-width: 0; }
.sbk .dlg-btn--danger { background-color: var(--sbk-danger); color: var(--sbk-card); border-width: 0; }
