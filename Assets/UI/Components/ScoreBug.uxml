<?xml version="1.0" encoding="utf-8"?>
<!-- ScoreBug（部品辞書 / 試合画面改修）。野球中継の常時表示バグ。
     盤面（対決ビュー・2D俯瞰のどちらでも）の左上に出しっぱなしにして、
     カウント・塁・両校の得点を打席の演出中も切らさず見せる。

     左袖＝縦のB/S/O。**点灯ランプ**（B=3 / S=2 / O=2）で出す。
       ・2026-07-31 の判断では「ランプではなく数字」だったが、2026-08-05 に
         参照モック docs/design/mock-pitch-view.html の電光掲示板方式へ再改定（issue #479）。
       ・寸法は参照の実測値そのまま。島(71x49px)は右ブロック(120px)に対し上下中央＝案A。
     右＝回表示と塁ダイヤ（重ねる）＋両校の得点。塁は埋まっている塁だけ描く（中継の作法）。

     置くのは器だけ。回・校名・得点は ScoreBug.Fill が、カウントと塁は
     MatchLiveController が sbug-lamp-b0 / sbug-base-1 等の name を1球ごとに駆動する。 -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="sbug-root" class="sbug">

        <!-- 各ランプは本体1枚＋グロー1枚の2要素。グローは本体の外側だけに出るドーナツなので
             子として重ねても中心を隠さない。点灯/消灯は MatchLiveController が is-on を付け外しする。 -->
        <ui:VisualElement class="sbug-lamps">
            <ui:VisualElement class="sbug-lamprow">
                <ui:Label class="sbug-lamprow__key f-body-bd" text="B" />
                <ui:VisualElement name="sbug-lamp-b0" class="sbug-lamp sbug-lamp--b"><ui:VisualElement class="sbug-lamp__glow" /></ui:VisualElement>
                <ui:VisualElement name="sbug-lamp-b1" class="sbug-lamp sbug-lamp--b"><ui:VisualElement class="sbug-lamp__glow" /></ui:VisualElement>
                <ui:VisualElement name="sbug-lamp-b2" class="sbug-lamp sbug-lamp--b"><ui:VisualElement class="sbug-lamp__glow" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="sbug-lamprow sbug-lamprow--next">
                <ui:Label class="sbug-lamprow__key f-body-bd" text="S" />
                <ui:VisualElement name="sbug-lamp-s0" class="sbug-lamp sbug-lamp--s"><ui:VisualElement class="sbug-lamp__glow" /></ui:VisualElement>
                <ui:VisualElement name="sbug-lamp-s1" class="sbug-lamp sbug-lamp--s"><ui:VisualElement class="sbug-lamp__glow" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="sbug-lamprow sbug-lamprow--next">
                <ui:Label class="sbug-lamprow__key f-body-bd" text="O" />
                <ui:VisualElement name="sbug-lamp-o0" class="sbug-lamp sbug-lamp--o"><ui:VisualElement class="sbug-lamp__glow" /></ui:VisualElement>
                <ui:VisualElement name="sbug-lamp-o1" class="sbug-lamp sbug-lamp--o"><ui:VisualElement class="sbug-lamp__glow" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="sbug-sep" />

        <ui:VisualElement class="sbug-main">
            <ui:VisualElement class="sbug-top">
                <!-- 平たい菱形。USS の変形は scale→rotate の順に効くので、1要素に両方書くと
                     「傾いた長方形」になる。潰す層(box)と回す層(in)を分けて初めて左右に平たい菱形になる。 -->
                <ui:VisualElement class="sbug-dia">
                    <ui:VisualElement class="sbug-dia__box">
                        <ui:VisualElement class="sbug-dia__in">
                            <ui:VisualElement name="sbug-base-2" class="sbug-base sbug-base--second" />
                            <ui:VisualElement name="sbug-base-1" class="sbug-base sbug-base--first" />
                            <ui:VisualElement name="sbug-base-3" class="sbug-base sbug-base--third" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <!-- 回表示は菱形の上に重ねる。地色を敷いて菱形の罫を文字の下で抜く（USSに縁取りは無い）。
                     Oswald は欧文専用なので数字と「回表」は Label を分ける（書体3役ルール）。 -->
                <ui:VisualElement class="sbug-inning">
                    <ui:Label name="sbug-inning-num" class="sbug-inning__num f-num-bd" text="1" />
                    <ui:Label name="sbug-inning-half" class="sbug-inning__half f-body-bd" text="回表" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="sbug-away" class="sbug-team">
                <ui:VisualElement class="sbug-team__mark" />
                <ui:Label name="sbug-away-name" class="sbug-team__name f-display" text="" />
                <ui:Label name="sbug-away-runs" class="sbug-team__runs f-num-bd" text="0" />
            </ui:VisualElement>
            <ui:VisualElement name="sbug-home" class="sbug-team">
                <ui:VisualElement class="sbug-team__mark" />
                <ui:Label name="sbug-home-name" class="sbug-team__name f-display" text="" />
                <ui:Label name="sbug-home-runs" class="sbug-team__runs f-num-bd" text="0" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
