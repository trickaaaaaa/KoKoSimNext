/* ═══════════════════════════════════════════════════════════════════════
   SaveSlots.uss — セーブデータ画面（「システム」タブ／タイトルの「つづきから」）
   ───────────────────────────────────────────────────────────────────────
   上＝画面内の切り替えと「タイトルへ戻る」。セーブデータのページは 3枠のカード（部品 SaveSlotCard）を横に並べる。
   タイトルから入る「つづきから」は画面ルートに ss-root--night（墨の地・見出しの行・ダイヤモンドの線画）。
   色は tokens（scorebook.uss の --sbk-*）を参照する。gap は無いので間隔は margin で作る。
   校名の編集・設定・クレジットのページは下のほうの節（.ss-body 以下）で、ここの上部の行を共用する。
   ═══════════════════════════════════════════════════════════════════════ */

.ss-root { flex-grow: 1; }
/* 画面の地は紙色より一段濃くし、紙色のカードを浮かせる（影は使わない）。 */
.sbk.ss-root { background-color: var(--sbk-paper-deep); }

.ss-main {
    flex-grow: 1;
    min-height: 0;
    padding: 16px 24px 20px 24px;
}

/* ── ① 切り替えの行（高さ44px・下に16px） ── */
.ss-header {
    flex-direction: row;
    align-items: center;
    height: 44px;
    flex-shrink: 0;
    margin-bottom: 16px;
}
.ss-header__spacer { flex-grow: 1; }
.ss-tabs { flex-shrink: 0; }
/* つまみ型の切り替え：入れ物の地に、選択中だけ白地＋墨の太字（太字は Controller が書体クラスで付ける） */
.sbk .ss-tabs .seg-tabs {
    flex-direction: row;
    background-color: var(--sbk-well);
    border-radius: 10px;
    padding: 4px;
}
.sbk .ss-tabs .seg-tab,
.sbk .ss-tabs .seg-tab:hover {
    height: 36px;
    margin: 0 4px 0 0;
    padding: 0 20px;
    border-width: 0;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--sbk-sub);
    font-size: 14px;
}
.sbk .ss-tabs .seg-tab--last { margin-right: 0; }
.sbk .ss-tabs .seg-tab:hover { color: var(--sbk-text); }
.sbk .ss-tabs .seg-tab--on,
.sbk .ss-tabs .seg-tab--on:hover {
    background-color: var(--sbk-card);
    color: var(--sbk-text);
}
/* 「タイトルへ戻る」：枠だけのボタン（左に左向きの矢印） */
.sbk Button.ss-title-btn {
    flex-direction: row;
    align-items: center;
    height: 40px;
    flex-shrink: 0;
    margin: 0;
    padding: 0 18px;
    border-width: 1px;
    border-color: var(--sbk-dash);
    border-radius: 9px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--sbk-info);
}
.sbk Button.ss-title-btn:hover { border-color: var(--sbk-mute); }
.ss-title-btn .licon { width: 16px; height: 16px; margin-right: 8px; }
.ss-title-btn__txt { margin: 0; padding: 0; font-size: 14px; color: var(--sbk-info); }

/* 使用中の枠の数（「2 / 3 枠を使用中」）。ゲーム内は切り替えの右・つづきからは見出しの行の右端 */
.ss-count { flex-direction: row; align-items: flex-end; flex-shrink: 0; margin-left: 24px; }
.ss-count Label { margin: 0; padding: 0; }
.ss-count .ss-count__n { font-size: 16px; color: var(--sbk-text); }
.ss-count .ss-count__rest { margin-left: 4px; margin-bottom: 1px; font-size: 13px; color: var(--sbk-sub); }

/* ── ② セーブデータのページ：3枠のカード（部品 SaveSlotCard）を横に3等分・上下中央 ── */
.ss-saves { flex-grow: 1; min-height: 0; flex-direction: column; }
.ss-saves Label { margin: 0; padding: 0; }
.ss-slots {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    align-items: center;
}
.ss-slots .ssc { margin-right: 24px; }
.ss-slots .ssc--last { margin-right: 0; }

/* 保存できない理由・読み込みや保存の失敗（本当の警告だけ＝警告色） */
.ss-saves .ss-note {
    flex-shrink: 0;
    margin-bottom: 8px;
    font-size: 13px;
    color: var(--color-warn);
    white-space: normal;
}

/* つづきからの見出しの行（ゲーム内では隠す） */
.ss-heading { flex-direction: row; align-items: flex-end; flex-shrink: 0; margin-top: 18px; margin-bottom: 26px; }   /* 切り替えの行の下16px＋18＝34px */
.ss-heading Label { margin: 0; padding: 0; }
.ss-heading .ss-heading__title { font-size: 38px; letter-spacing: 5.3px; color: var(--sbk-night-paper); }
.ss-heading .ss-heading__sub { margin-left: 18px; margin-bottom: 8px; font-size: 14px; color: var(--sbk-night-sub); }
.ss-heading__spacer { flex-grow: 1; }
.ss-heading .ss-count { margin-bottom: 8px; }

/* ═══ つづきから（タイトルから入る・墨の地） ═══════════════════════════ */
.sbk.ss-root--night { background-color: var(--sbk-night); }
.ss-root--night .ss-main { padding: 30px 56px 40px 56px; overflow: hidden; }
.ss-root--night .ss-header { height: 46px; }
.ss-root--night .ss-slots .ssc { margin-right: 28px; }
.ss-root--night .ss-slots .ssc--last { margin-right: 0; }
.ss-root--night .ss-count .ss-count__n { font-size: 17px; color: var(--sbk-night-paper); }
.ss-root--night .ss-count .ss-count__rest { color: var(--sbk-night-sub); }
/* 透明度はモック（sRGB で混ぜる）と同じ見え方の値（UI はリニア空間で混ぜる。SaveSlotCard.uss の注記）。（）がモックの指定 */
.sbk.ss-root--night .ss-tabs .seg-tabs { background-color: rgba(255, 255, 255, 0.016); border-radius: 11px; }   /* （白8%） */
.sbk.ss-root--night .ss-tabs .seg-tab,
.sbk.ss-root--night .ss-tabs .seg-tab:hover {
    height: 38px;
    padding: 0 22px;
    border-radius: 8px;
    color: var(--sbk-night-sub);
}
.sbk.ss-root--night .ss-tabs .seg-tab:hover { color: var(--sbk-night-paper); }
.sbk.ss-root--night .ss-tabs .seg-tab--on,
.sbk.ss-root--night .ss-tabs .seg-tab--on:hover {
    background-color: var(--sbk-night-paper);
    color: var(--sbk-night);
}
.sbk.ss-root--night Button.ss-title-btn { height: 42px; border-color: rgba(255, 255, 255, 0.067); border-radius: 10px; }   /* （白22%） */
.sbk.ss-root--night Button.ss-title-btn:hover { border-color: rgba(255, 255, 255, 0.175); }
.ss-root--night .ss-title-btn .licon,
.ss-root--night .ss-title-btn__txt { color: var(--sbk-night-btn); }
/* 内野のダイヤモンドの線画（右上にはみ出す。InfieldDiamondLines が描く） */
.ss-diamond {
    position: absolute;
    width: 900px;
    height: 900px;
    right: -210px;
    top: -160px;
}

/* ── 校名の編集・設定・クレジットのページ（2カラム本体） ─────────────── */
.ss-body {
    flex-direction: row;
    flex-grow: 1;
}
.card--list {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: var(--sp-3);
}
.card--detail {
    width: var(--w-editor);
    flex-shrink: 0;
}

/* ── 詳細ペイン ─────────────────────────────────────────── */
.ss-d__name {
    color: var(--color-chalk);
}
.ss-d__sub {
    font-size: var(--fs-cap);
    color: var(--color-muted);
    margin-top: var(--sp-1);
    margin-bottom: var(--sp-3);
}
/* 詳細ペインの案内文。既定は本文色＝ただの案内（空き枠・セーブ無し）はここに出る。
   警告色は本当の警告だけに残す（UI原則②）＝読み込み不可・保存できない理由・操作の失敗は
   --warn を足して赤にする（種別は SaveSlotsController.RenderDetail が知っている。issue #575①）。 */
.ss-d__note {
    font-size: var(--fs-label);
    color: var(--color-chalk);
    white-space: normal;
    margin-top: var(--sp-3);
}
.ss-d__note--warn { color: var(--color-warn); }
.ss-d__foot {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 0;
    align-items: flex-end;
    justify-content: flex-start;
    margin-top: var(--sp-3);
}

/* ── 削除確認ダイアログ ─────────────────────────────────── */
/* 器・問い・ボタン列は部品辞書の ConfirmDialog（confirm-card / confirm-q / confirm-btns・components.uss） */
/* 「タイトルへ戻る」確認の補足（最後の保存から何週か。issue #730 でホームから移設） */
.ss-confirm__sub { font-size: var(--fs-label); color: var(--color-muted); margin-bottom: var(--sp-4); }

.ss-root .ss-body { flex-grow: 0; }   /* カードは中身の高さで止める */

/* ═══ 校名の編集（issue #946・A案）═══════════════════════════════════
   左＝県の切り替え＋学校一覧（行パネル）／右＝選んだ学校の名前の編集（詳細ペインは ss-d__* を共用）。
   一覧は県の全校（多い県で100校超）なので、こちらのページだけ画面の高さまで伸ばして中をスクロールする。 */
.ss-root .sr-body { flex-grow: 1; min-height: 0; }
.sr-list { flex-direction: column; }
.sr-line {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: var(--sp-2);
}
.sr-lbl {
    margin: 0;
    padding: 0;
    margin-right: var(--sp-3);
    font-size: var(--fs-body);
    color: var(--color-muted);
}
.sr-drop { width: var(--w-sr-pref); flex-shrink: 0; margin: 0; }
/* 県名の文字はラベル「都道府県」と同じ本文サイズ（既定テーマの 13px を上書き）。 */
.sr-drop .unity-base-field__input,
.sr-drop .unity-text-element { font-size: var(--fs-body); }
.sr-scroll { flex-grow: 1; min-height: 0; }
.sr-row__name {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0;
    padding: 0;
    font-size: var(--fs-body);
    color: var(--color-chalk);
}
.sr-row .chip { flex-shrink: 0; margin-left: var(--sp-2); }

/* 今の名前＝右ペインの見出し（明朝・一覧の行の校名より一段大きい）。 */
.sr-d__name { margin: 0; padding: 0; font-size: var(--fs-page); color: var(--color-chalk); }
/* 「元の名前」の1行：ラベル左・値右で同じ行にそろえる。線は引かない（区切りは余白）。 */
.sr-kv {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 32px;
    flex-shrink: 0;
}
.sr-kv__k { margin: 0; padding: 0; font-size: var(--fs-label); color: var(--color-muted); }
.sr-kv__v { margin: 0; padding: 0; font-size: var(--fs-body); color: var(--color-chalk); -unity-text-align: middle-right; }
.sr-input { flex-shrink: 0; margin-top: var(--sp-3); }
.sr-input .sr-kv__k { margin-bottom: var(--sp-1); }
.sr-input__line { flex-direction: row; align-items: center; }
.sr-text { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 0; }
/* 入力の文字は校名＝明朝・一覧の行と同じサイズ（横の固定「高校」もこのサイズ）。 */
.sr-text .unity-base-field__input,
.sr-text .unity-text-element { font-size: var(--fs-body); }
.sr-input__line .sbk-field-suffix { font-size: var(--fs-body); }
/* ブラウザ版で入力欄の代わりに出す表示（BrowserNamePicker）。入力欄の文字と同じ大きさ。 */
.sr-input__line > Label.sr-text { font-size: var(--fs-body); padding: 0; }
/* ブラウザ版の校名の候補（入力欄の代わり・#1323）。新しい名前の行の下に道具ボタンを並べる。 */
.sr-cands { flex-direction: row; flex-wrap: wrap; margin-top: var(--sp-2); }
.sr-cands > Button { margin: 0; margin-right: var(--sp-2); margin-bottom: var(--sp-2); }

/* クレジット（issue #1179）。ライセンス本文は長い定型文＝折り返して読める高さいっぱいまで流す。
   「校名の編集」等と違い常設の入力欄が無いので、スクロール領域の余白だけ別クラスに分ける。 */
/* ページは画面の高さまで伸ばして中をスクロールする（校名の編集 .sr-body と同じ。min-height:0 が無いと
   本文の高さで器が伸び、見出し・画面内タブの行が押し潰される） */
.ss-root .ss-credits-page { flex-grow: 1; flex-basis: 0; min-height: 0; }
.ss-credits-scroll { flex-grow: 1; flex-basis: 0; }
.ss-credits-body {
    white-space: normal;
    margin: 0;
    padding: 0;
    font-size: var(--fs-body);
    color: var(--color-chalk);
}

/* クレジットの「素材」カード（issue #1318）。区分ラベル左・名前右の1行（校名の編集の .sr-kv と同じ組み方）。
   線は引かず行の高さで揃える。名前は長いもの（書体の列挙）があるので折り返す。 */
.ss-cr {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    padding: 6px 0;
    flex-shrink: 0;
}
.ss-cr__k { width: 300px; flex-shrink: 0; margin: 0; padding: 0; font-size: var(--fs-label); color: var(--color-muted); }
.ss-cr__v { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 0; padding: 0; white-space: normal; font-size: var(--fs-body); color: var(--color-chalk); }

/* 設定（issue #1315）。1枚のカードに「画面・fps・音量」の行を縦に並べる。区分の見出しは行の頭に小さく、
   項目名は左の固定幅・操作は右（クレジットの .ss-cr と同じ組み方）。線は引かず行の高さで揃える。 */
.ss-root .ss-settings-page { flex-grow: 1; flex-basis: 0; min-height: 0; align-items: flex-start; }
.ss-set-card { width: 760px; }
.ss-set__group { margin: var(--sp-3) 0 var(--sp-1) 0; padding: 0; font-size: var(--fs-cap); color: var(--color-muted); }
.ss-set__group--first { margin-top: 0; }
.ss-set { flex-direction: row; align-items: center; min-height: 44px; flex-shrink: 0; }
.ss-set__k { width: 200px; flex-shrink: 0; margin: 0; padding: 0; font-size: var(--fs-label); color: var(--color-chalk); }
