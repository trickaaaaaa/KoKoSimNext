/* ═══════════════════════════════════════════════════════════════════════
   SaveSlots.uss — セーブデータ画面（「システム」タブ／タイトルの「つづきから」）
   ───────────────────────────────────────────────────────────────────────
   上＝画面内の切り替えと「タイトルへ戻る」。セーブデータのページは 左＝枠ごとのカード／右＝いま遊んでいるデータ。
   色は tokens（scorebook.uss の --sbk-*）を参照する。gap は無いので間隔は margin で作る。
   校名の編集・設定・クレジットのページは下のほうの節（.ss-body 以下）で、ここの上部の行を共用する。
   ═══════════════════════════════════════════════════════════════════════ */

.ss-root { flex-grow: 1; }
/* 画面の地は紙色より一段濃くし、紙色のカードを浮かせる（影は使わない）。 */
.sbk.ss-root { background-color: var(--sbk-paper-deep); }

.ss-main {
    flex-grow: 1;
    min-height: 0;
    padding: 16px 24px 20px 24px;
}

/* ── ① 切り替えの行（高さ44px・下に16px） ── */
.ss-header {
    flex-direction: row;
    align-items: center;
    height: 44px;
    flex-shrink: 0;
    margin-bottom: 16px;
}
.ss-header__spacer { flex-grow: 1; }
.ss-tabs { flex-shrink: 0; }
/* つまみ型の切り替え：入れ物の地に、選択中だけ白地＋墨の太字（太字は Controller が書体クラスで付ける） */
.sbk .ss-tabs .seg-tabs {
    flex-direction: row;
    background-color: var(--sbk-well);
    border-radius: 10px;
    padding: 4px;
}
.sbk .ss-tabs .seg-tab,
.sbk .ss-tabs .seg-tab:hover {
    height: 36px;
    margin: 0 4px 0 0;
    padding: 0 20px;
    border-width: 0;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--sbk-sub);
    font-size: 14px;
}
.sbk .ss-tabs .seg-tab--last { margin-right: 0; }
.sbk .ss-tabs .seg-tab:hover { color: var(--sbk-text); }
.sbk .ss-tabs .seg-tab--on,
.sbk .ss-tabs .seg-tab--on:hover {
    background-color: var(--sbk-card);
    color: var(--sbk-text);
}
/* 「タイトルへ戻る」：枠だけのボタン（左に左向きの矢印） */
.sbk Button.ss-title-btn {
    flex-direction: row;
    align-items: center;
    height: 40px;
    flex-shrink: 0;
    margin: 0;
    padding: 0 18px;
    border-width: 1px;
    border-color: var(--sbk-dash);
    border-radius: 9px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--sbk-info);
}
.sbk Button.ss-title-btn:hover { border-color: var(--sbk-mute); }
.ss-title-btn .licon { width: 16px; height: 16px; margin-right: 8px; }
.ss-title-btn__txt { margin: 0; padding: 0; font-size: 14px; color: var(--sbk-info); }

/* ── ② 本体：左＝枠のカード（残り全部）／右＝いま遊んでいるデータ（420px） ── */
.ss-saves { flex-direction: row; flex-grow: 1; min-height: 0; }
.ss-saves__left { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; }
.ss-slots-scroll { flex-grow: 1; min-height: 0; }
.ss-saves Label { margin: 0; padding: 0; }

/* 保存できない理由・読み込みや保存の失敗（本当の警告だけ＝警告色） */
.ss-saves .ss-note {
    flex-shrink: 0;
    margin-bottom: 12px;
    font-size: 13px;
    color: var(--color-warn);
    white-space: normal;
}

/* ── 枠のカード（高さ172px・間隔12px）。ふだんは 1px枠＋1px内余白、プレイ中は 2px枠＋0内余白＝大きさは同じ ── */
.ss-card {
    flex-direction: row;
    align-items: center;
    height: 172px;
    flex-shrink: 0;
    margin-bottom: 12px;
    background-color: var(--sbk-patch-bg);
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--sbk-card-line);
    padding: 1px;
}
.sbk .ss-card--playing { border-width: 2px; padding: 0; border-color: var(--color-accent); }
/* 空いている枠：背景なし・点線（DashedFrame が外周に重なる） */
.ss-card--empty { background-color: rgba(0, 0, 0, 0); border-color: rgba(0, 0, 0, 0); }

/* 左端：枠の番号（76px・右に線） */
.ss-card__no {
    width: 76px;
    flex-shrink: 0;
    align-self: stretch;
    align-items: center;
    justify-content: center;
    border-right-width: 1px;
    border-right-color: var(--sbk-rule-soft);
}
.ss-card--empty .ss-card__no { border-right-width: 0; }
.ss-card__no-k { font-size: 11px; color: var(--sbk-sub); }
.ss-card__no-v { font-size: 30px; color: var(--sbk-text); }
.ss-card--empty .ss-card__no-k,
.ss-card--empty .ss-card__no-v { color: var(--sbk-mute); }
/* 空きの枠の番号の右の点線（縦） */
.ss-card__vrule { width: 2px; align-self: stretch; flex-shrink: 0; }

/* 中：情報（3行・行の間隔12px） */
.ss-card__info { flex-grow: 1; flex-basis: 0; min-width: 0; margin-left: 24px; margin-right: 24px; justify-content: center; }
.ss-card__head { flex-direction: row; align-items: flex-end; }
.ss-card__name { font-size: 26px; letter-spacing: 2.1px; color: var(--sbk-text); white-space: nowrap; }
.ss-saves .ss-card__pref { font-size: 19px; letter-spacing: 1.1px; color: var(--sbk-info); margin-left: 14px; padding-bottom: 2px; }
/* 「プレイ中」の札（スクールカラー地に白。色は SchoolAccent.Apply が流す） */
.ss-saves .ss-card__playing {
    align-self: center;
    margin-left: 14px;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 11px;
    color: var(--sbk-card);
    background-color: var(--color-accent);
}
.ss-card__items { flex-direction: row; align-items: flex-end; margin-top: 12px; }
.ss-item { margin-right: 30px; flex-shrink: 0; }
.ss-item__k { font-size: 11px; color: var(--sbk-mute); }
.ss-item__v { flex-direction: row; align-items: flex-end; height: 32px; margin-top: 4px; }
.ss-item__big { font-size: 20px; color: var(--sbk-text); }                    /* 明朝の値（「9月2週」） */
.ss-item__score { font-size: 26px; color: var(--sbk-text); }                  /* 総合の点数（明朝） */
.ss-item__num { font-size: 20px; color: var(--sbk-text); }                    /* 太字の数字（勝敗・回数） */
.ss-saves .ss-item__unit { font-size: 13px; color: var(--sbk-info); padding-bottom: 3px; margin-left: 2px; margin-right: 4px; }
.ss-saves .ss-item__sep { font-size: 13px; color: var(--sbk-mute-soft); padding-bottom: 3px; margin-left: 4px; margin-right: 8px; }
.ss-saves .ss-item__year { font-size: 13px; color: var(--sbk-info); padding-bottom: 3px; margin-left: 8px; }
.ss-saves .ss-item__tag {
    align-self: center;
    margin-left: 8px;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 12px;
    color: var(--sbk-info);
    background-color: var(--sbk-rule-soft);
    white-space: nowrap;
}
.ss-item__none { font-size: 20px; color: var(--sbk-mute); }                   /* 値がない項目の「—」 */
.sbk .ss-item .rank-chip { min-width: 30px; width: 30px; height: 30px; padding: 0; margin: 0 8px 1px 0; flex-shrink: 0; }
.ss-saves .ss-card__saved { font-size: 12px; color: var(--sbk-mute); margin-top: 12px; }
.ss-card__vacant { font-size: 16px; color: var(--sbk-mute); }

/* 右端：操作（間隔10px・右の余白24px） */
.ss-card__ops { flex-direction: row; align-items: center; flex-shrink: 0; margin-right: 22px; }
.sbk Button.ss-op-trash {
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--sbk-danger);
    align-items: center;
    justify-content: center;
}
.sbk Button.ss-op-trash:hover { background-color: var(--sbk-rule-soft); }
.ss-op-trash .licon { width: 20px; height: 20px; }
.sbk Button.ss-op {
    flex-direction: row;
    align-items: center;
    height: 48px;
    margin: 0 0 0 10px;
    padding: 0 20px;
    border-width: 1.5px;
    border-color: var(--sbk-text);
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--sbk-text);
    font-size: 15px;
}
.sbk Button.ss-op--fill { border-width: 0; background-color: var(--sbk-text); color: var(--sbk-card); }
.sbk Button.ss-op--fill:hover { background-color: var(--sbk-ink); }
.ss-op .licon { width: 16px; height: 16px; margin-right: 8px; }
.ss-op__txt { font-size: 15px; color: var(--sbk-card); }

/* ── 右列：いま遊んでいるデータ ── */
.ss-now {
    width: 420px;
    flex-shrink: 0;
    margin-left: 16px;
    padding: 22px 24px;
    background-color: var(--sbk-patch-bg);
    border-radius: 14px;
}
.ss-now__title { font-size: 18px; letter-spacing: 1.4px; color: var(--sbk-text); }
.ss-now__school { flex-direction: row; align-items: flex-end; margin-top: 16px; }
.ss-now__name { font-size: 24px; letter-spacing: 1.9px; color: var(--sbk-text); }
.ss-saves .ss-now__pref { font-size: 18px; letter-spacing: 1.1px; color: var(--sbk-info); margin-left: 14px; padding-bottom: 2px; }
.ss-now__rows { margin-top: 16px; border-top-width: 2px; border-top-color: var(--sbk-text); }
.ss-now__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--sbk-rule-soft);
}
.ss-now__k { font-size: 13px; color: var(--sbk-sub); }
.ss-now__v { flex-direction: row; align-items: center; }
.ss-now__v Label { font-size: 15px; color: var(--sbk-text); }
.sbk .ss-now__v .rank-chip { min-width: 22px; width: 22px; height: 22px; padding: 0; margin: 0 8px 0 0; flex-shrink: 0; }

/* ── 校名の編集・設定・クレジットのページ（2カラム本体） ─────────────── */
.ss-body {
    flex-direction: row;
    flex-grow: 1;
}
.card--list {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: var(--sp-3);
}
.card--detail {
    width: var(--w-editor);
    flex-shrink: 0;
}

/* ── 詳細ペイン ─────────────────────────────────────────── */
.ss-d__name {
    color: var(--color-chalk);
}
.ss-d__sub {
    font-size: var(--fs-cap);
    color: var(--color-muted);
    margin-top: var(--sp-1);
    margin-bottom: var(--sp-3);
}
/* 詳細ペインの案内文。既定は本文色＝ただの案内（空き枠・セーブ無し）はここに出る。
   警告色は本当の警告だけに残す（UI原則②）＝読み込み不可・保存できない理由・操作の失敗は
   --warn を足して赤にする（種別は SaveSlotsController.RenderDetail が知っている。issue #575①）。 */
.ss-d__note {
    font-size: var(--fs-label);
    color: var(--color-chalk);
    white-space: normal;
    margin-top: var(--sp-3);
}
.ss-d__note--warn { color: var(--color-warn); }
.ss-d__foot {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 0;
    align-items: flex-end;
    justify-content: flex-start;
    margin-top: var(--sp-3);
}

/* ── 削除確認ダイアログ ─────────────────────────────────── */
/* 器・問い・ボタン列は部品辞書の ConfirmDialog（confirm-card / confirm-q / confirm-btns・components.uss） */
/* 「タイトルへ戻る」確認の補足（最後の保存から何週か。issue #730 でホームから移設） */
.ss-confirm__sub { font-size: var(--fs-label); color: var(--color-muted); margin-bottom: var(--sp-4); }

.ss-root .ss-body { flex-grow: 0; }   /* カードは中身の高さで止める */

/* ═══ 校名の編集（issue #946・A案）═══════════════════════════════════
   左＝県の切り替え＋学校一覧（行パネル）／右＝選んだ学校の名前の編集（詳細ペインは ss-d__* を共用）。
   一覧は県の全校（多い県で100校超）なので、こちらのページだけ画面の高さまで伸ばして中をスクロールする。 */
.ss-root .sr-body { flex-grow: 1; min-height: 0; }
.sr-list { flex-direction: column; }
.sr-line {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: var(--sp-2);
}
.sr-lbl {
    margin: 0;
    padding: 0;
    margin-right: var(--sp-3);
    font-size: var(--fs-body);
    color: var(--color-muted);
}
.sr-drop { width: var(--w-sr-pref); flex-shrink: 0; margin: 0; }
/* 県名の文字はラベル「都道府県」と同じ本文サイズ（既定テーマの 13px を上書き）。 */
.sr-drop .unity-base-field__input,
.sr-drop .unity-text-element { font-size: var(--fs-body); }
.sr-scroll { flex-grow: 1; min-height: 0; }
.sr-row__name {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0;
    padding: 0;
    font-size: var(--fs-body);
    color: var(--color-chalk);
}
.sr-row .chip { flex-shrink: 0; margin-left: var(--sp-2); }

/* 今の名前＝右ペインの見出し（明朝・一覧の行の校名より一段大きい）。 */
.sr-d__name { margin: 0; padding: 0; font-size: var(--fs-page); color: var(--color-chalk); }
/* 「元の名前」の1行：ラベル左・値右で同じ行にそろえる。線は引かない（区切りは余白）。 */
.sr-kv {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 32px;
    flex-shrink: 0;
}
.sr-kv__k { margin: 0; padding: 0; font-size: var(--fs-label); color: var(--color-muted); }
.sr-kv__v { margin: 0; padding: 0; font-size: var(--fs-body); color: var(--color-chalk); -unity-text-align: middle-right; }
.sr-input { flex-shrink: 0; margin-top: var(--sp-3); }
.sr-input .sr-kv__k { margin-bottom: var(--sp-1); }
.sr-input__line { flex-direction: row; align-items: center; }
.sr-text { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 0; }
/* 入力の文字は校名＝明朝・一覧の行と同じサイズ（横の固定「高校」もこのサイズ）。 */
.sr-text .unity-base-field__input,
.sr-text .unity-text-element { font-size: var(--fs-body); }
.sr-input__line .sbk-field-suffix { font-size: var(--fs-body); }
/* ブラウザ版で入力欄の代わりに出す表示（BrowserNamePicker）。入力欄の文字と同じ大きさ。 */
.sr-input__line > Label.sr-text { font-size: var(--fs-body); padding: 0; }
/* ブラウザ版の校名の候補（入力欄の代わり・#1323）。新しい名前の行の下に道具ボタンを並べる。 */
.sr-cands { flex-direction: row; flex-wrap: wrap; margin-top: var(--sp-2); }
.sr-cands > Button { margin: 0; margin-right: var(--sp-2); margin-bottom: var(--sp-2); }

/* クレジット（issue #1179）。ライセンス本文は長い定型文＝折り返して読める高さいっぱいまで流す。
   「校名の編集」等と違い常設の入力欄が無いので、スクロール領域の余白だけ別クラスに分ける。 */
/* ページは画面の高さまで伸ばして中をスクロールする（校名の編集 .sr-body と同じ。min-height:0 が無いと
   本文の高さで器が伸び、見出し・画面内タブの行が押し潰される） */
.ss-root .ss-credits-page { flex-grow: 1; flex-basis: 0; min-height: 0; }
.ss-credits-scroll { flex-grow: 1; flex-basis: 0; }
.ss-credits-body {
    white-space: normal;
    margin: 0;
    padding: 0;
    font-size: var(--fs-body);
    color: var(--color-chalk);
}

/* クレジットの「素材」カード（issue #1318）。区分ラベル左・名前右の1行（校名の編集の .sr-kv と同じ組み方）。
   線は引かず行の高さで揃える。名前は長いもの（書体の列挙）があるので折り返す。 */
.ss-cr {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    padding: 6px 0;
    flex-shrink: 0;
}
.ss-cr__k { width: 300px; flex-shrink: 0; margin: 0; padding: 0; font-size: var(--fs-label); color: var(--color-muted); }
.ss-cr__v { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 0; padding: 0; white-space: normal; font-size: var(--fs-body); color: var(--color-chalk); }

/* 設定（issue #1315）。1枚のカードに「画面・fps・音量」の行を縦に並べる。区分の見出しは行の頭に小さく、
   項目名は左の固定幅・操作は右（クレジットの .ss-cr と同じ組み方）。線は引かず行の高さで揃える。 */
.ss-root .ss-settings-page { flex-grow: 1; flex-basis: 0; min-height: 0; align-items: flex-start; }
.ss-set-card { width: 760px; }
.ss-set__group { margin: var(--sp-3) 0 var(--sp-1) 0; padding: 0; font-size: var(--fs-cap); color: var(--color-muted); }
.ss-set__group--first { margin-top: 0; }
.ss-set { flex-direction: row; align-items: center; min-height: 44px; flex-shrink: 0; }
.ss-set__k { width: 200px; flex-shrink: 0; margin: 0; padding: 0; font-size: var(--fs-label); color: var(--color-chalk); }
