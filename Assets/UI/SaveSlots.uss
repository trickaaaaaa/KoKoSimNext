/* ═══════════════════════════════════════════════════════════════════════
   SaveSlots.uss — セーブスロット選択画面（issue #508・保存/戻るは #509 でホーム経由のみ追加）
   ───────────────────────────────────────────────────────────────────────
   値は tokens.uss の変数のみを参照する（直書き禁止）。
   区切りは面の明度差で作り、罫線は表のヘッダー下だけに引く（UI原則④）。
   主要操作は右の詳細ペインの「読込」（ホーム経由は「保存」も）（UI原則⑦）。削除は警告色（本当の警告＝破壊的操作）。

   ── 監督判断（2026-08-10・issue #575。自己レビューで再指摘しないこと）─────────────
   ・見出し帯の濃緑＋白抜き題字は design-19 §8-4/§8-5 の正典どおり（.card / .card__hd 共通部品）。
     「白地＋インク枠へ未移行」は誤診＝この画面だけ白見出しにしない。
   ・画面下半分の余白は「意図した余白」。手動3枠しか無く情報量を増やせないので、カードは
     中身の高さで止め、上寄せのまま残す（.card--grow 相当を足さない）。
   ═══════════════════════════════════════════════════════════════════════ */

.ss-main {
    flex-grow: 1;
    padding-left: var(--sp-4);
    padding-right: var(--sp-4);
    padding-top: var(--sp-4);
    padding-bottom: var(--sp-3);
}

/* ── ヘッダ（柱見出し＋ホーム経由だけ出る「戻る」） ───────────────── */
.ss-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--sp-2);
}
.ss-header .rule-head { margin-bottom: 0; }

/* ── 2カラム本体 ─────────────────────────────────────────── */
.ss-body {
    flex-direction: row;
    flex-grow: 1;
}
.card--list {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: var(--sp-3);
}
.card--detail {
    width: var(--w-editor);
    flex-shrink: 0;
}

/* ── スロット一覧（行高32px・UI原則①） ───────────────────── */
.ss-thead {
    flex-direction: row;
    align-items: center;
    height: var(--h-thead);
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--divider);
}
.ss-th {
    font-size: var(--fs-th);
    color: var(--color-muted);
}
.ss-th--slot { width: var(--col-ss-slot); flex-shrink: 0; }
.ss-th--school { flex-grow: 1; flex-basis: 0; min-width: 0; }
.ss-th--yw { width: var(--col-ss-yw); flex-shrink: 0; -unity-text-align: middle-right; }

.ss-rows { flex-grow: 1; }

.ss-row {
    flex-direction: row;
    align-items: center;
    height: 32px;
    flex-shrink: 0;
    padding-left: var(--sp-1);
    padding-right: var(--sp-1);
    border-radius: var(--radius-chip);
}
.ss-row:hover { background-color: var(--color-row-hover); }
.ss-row--on {
    background-color: var(--sf-hover);
    border-left-width: 2px;
    border-left-color: var(--line-focus);
}
.ss-row--empty { opacity: 0.5; }
.ss-row__slot {
    width: var(--col-ss-slot);
    flex-shrink: 0;
    font-size: var(--fs-cap);
    color: var(--color-muted);
}
.ss-row__school {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    font-size: var(--fs-body);
    color: var(--color-chalk);
}
.ss-row__yw {
    width: var(--col-ss-yw);
    flex-shrink: 0;
    font-size: var(--fs-num);
    color: var(--color-chalk);
    -unity-text-align: middle-right;
}

/* ── 詳細ペイン ─────────────────────────────────────────── */
.ss-d__name {
    color: var(--color-chalk);
}
.ss-d__sub {
    font-size: var(--fs-cap);
    color: var(--color-muted);
    margin-top: var(--sp-1);
    margin-bottom: var(--sp-3);
}
.ss-d__facts { flex-shrink: 0; }
.ss-d__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 32px;
    border-bottom-width: 1px;
    border-bottom-color: var(--divider);
}
.ss-d__row-k {
    font-size: var(--fs-label);
    color: var(--color-muted);
}
/* 詳細ペインの案内文。既定は本文色＝ただの案内（空き枠・セーブ無し）はここに出る。
   警告色は本当の警告だけに残す（UI原則②）＝読み込み不可・保存できない理由・操作の失敗は
   --warn を足して赤にする（種別は SaveSlotsController.RenderDetail が知っている。issue #575①）。 */
.ss-d__note {
    font-size: var(--fs-label);
    color: var(--color-chalk);
    white-space: normal;
    margin-top: var(--sp-3);
}
.ss-d__note--warn { color: var(--color-warn); }
.ss-d__foot {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 0;
    align-items: flex-end;
    justify-content: flex-start;
    margin-top: var(--sp-3);
}

/* ── 削除確認ダイアログ ─────────────────────────────────── */
.ss-confirm__card {
    padding: 28px 40px;
    min-width: 360px;
    align-items: center;
}
.ss-confirm__q {
    font-size: var(--fs-body);
    color: var(--color-chalk);
    margin-bottom: var(--sp-4);
    white-space: normal;
    -unity-text-align: middle-center;
}
.ss-confirm__btns { flex-direction: row; }
