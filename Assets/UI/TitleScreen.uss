/* ═══════════════════════════════════════════════════════════════════════
   TitleScreen.uss — タイトル画面の配置のみ（UI-BUILD-METHOD Step 4・issue #482 B案）
   ───────────────────────────────────────────────────────────────────────
   全面＝水彩画の背景（issue #1423）、上の空に見出し、左下に紙色の薄い地のメニュー。
   色は tokens.uss / scorebook.uss のトークンを参照するだけ（UI原則⑤）。
   gap/grid は使わない（USS非対応）。固定寸法セクションは flex-shrink:0（付けないと縦方向で潰れる）。
   ═══════════════════════════════════════════════════════════════════════ */

.ts-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--day-base);
}

/* ── 背景：水彩画を全面に敷く（issue #1423）。
   画面比が 16:9 からずれても歪まないよう scale-and-crop＝拡大して余りを切る。
   画像の上3分の1は空の余白で、タイトル文字はそこに載せる。 */
.ts-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project:///Assets/UI/Images/title/title-koshien-watercolor.jpeg");
    -unity-background-scale-mode: scale-and-crop;
}

/* ── 本文：見出しは上の空、メニューは左下（UI原則⑦＝主要操作は少なく大きく） ── */
.ts-content {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    padding-left: 96px;
    padding-top: 7%;
    padding-bottom: 5%;
}

/* 題字ロゴ（2000×752 の透過PNG）。画面幅の約4割＝760px、縦は原寸比。
   ロゴ自体に一筆と落款があるので、下線は引かない。 */
.ts-logo {
    width: 760px;
    height: 286px;
    flex-shrink: 0;
    margin-left: -12px;
    background-image: url("project:///Assets/UI/Images/title/title-logo.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* 絵の上でも読めるよう紙色の薄い地に載せる。 */
.ts-menu {
    flex-direction: column;
    align-items: flex-start;
    margin-top: auto;
    padding: 20px 40px 10px 24px;
    background-color: var(--sbk-paper-veil);
    border-radius: var(--sbk-r-card);
}

/* Button の既定テーマ（角丸背景・パディング）を解除し、テキストだけの項目にする。 */
.ts-menu-item {
    align-self: flex-start;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    padding: 8px 4px;
    margin: 0 0 10px 0;
    font-size: 32px;
    color: var(--ink);
}
.ts-menu-item:hover { color: var(--sky); }
.ts-menu-item:disabled { opacity: 0.35; }

/* CTA（希少資源・issue #482 = 「はじめから」1箇所だけ）: 応援団赤＋インク下線代わりの border-bottom。 */
.ts-menu-item--cta {
    color: var(--color-cta);
    border-bottom-width: 3px;
    border-bottom-color: var(--color-cta);
}
.ts-menu-item--cta:hover { color: var(--color-cta-hi); border-bottom-color: var(--color-cta-hi); }

.ts-version {
    position: absolute;
    right: 24px;
    bottom: 16px;
    font-size: var(--fs-cap);
    color: var(--day-tx-3);
}

/* ── スコアブック（design-22 G3） ── */
.sbk.ts-root { background-color: var(--sbk-paper); }
.sbk .ts-title { color: var(--sbk-text); }
.sbk .ts-rule { background-color: var(--sbk-text); }
.sbk .ts-menu-item { color: var(--sbk-text); }
.sbk .ts-menu-item:hover { color: var(--sbk-sub); }
.sbk .ts-version { color: var(--sbk-sub); }
.sbk .ts-menu-item--cta { color: var(--color-cta); }
.sbk .ts-menu-item--cta:hover { color: var(--color-cta-hi); }
