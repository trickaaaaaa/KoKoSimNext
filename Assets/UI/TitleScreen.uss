/* ═══════════════════════════════════════════════════════════════════════
   TitleScreen.uss — タイトル画面の配置のみ（UI-BUILD-METHOD Step 4・issue #482 B案）
   ───────────────────────────────────────────────────────────────────────
   上＝球場バック（design-19の色ブロック4段：空/スタンド/芝/土）、下＝白地に見出し＋3項目メニュー。
   色は tokens.uss の --sky / --field-stand-hi-day / --field-grass-day / --field-clay-day / --day-base /
   --ink / --color-cta を参照するだけで新規カラーは足さない（UI原則⑤）。
   gap/grid は使わない（USS非対応）。固定寸法セクションは flex-shrink:0（付けないと縦方向で潰れる）。
   ═══════════════════════════════════════════════════════════════════════ */

.ts-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--day-base);
}

/* ── 球場バック：4段の色ブロック（写真・3Dは使わない） ──
   高さは 400px を基準にするが flex-shrink:1 ＝ 縦が足りない時はここが縮んで本文を守る。
   パネルは ScaleWithScreenSize / 基準 1600x900 / match 0.5 なので、点の高さは画面比で変わり
   16:9 ちょうどで 900pt まで下がる。背景を flex-shrink:0 のまま固定すると本文 544pt が
   500pt の枠に入らず、溢れた分がメニュー末尾（「終了」）を画面外へ押し出して切っていた（issue #482）。
   帯は px でなく背景に対する % で持つ（縮んでも 4 段の比が崩れないため。値は 220/56/90/34px と同一比）。 */
.ts-backdrop {
    flex-direction: column;
    flex-shrink: 1;
    height: 400px;
    min-height: 200px;
}
.ts-band { flex-shrink: 1; }
.ts-band--sky   { height: 55%;   background-color: var(--sky); }
.ts-band--stand { height: 14%;   background-color: var(--field-stand-hi-day); }
.ts-band--grass { height: 22.5%; background-color: var(--field-grass-day); }
.ts-band--dirt  { height: 8.5%;  background-color: var(--field-clay-day); }

/* ── 本文：見出し＋メニュー（白地・左寄せ・UI原則⑦＝主要操作は少なく大きく） ──
   flex-shrink:0 ＝ 縦が足りない時に縮む側は背景であって本文ではない（メニューを切らせない）。 */
.ts-content {
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-left: 96px;
}

.ts-title {
    font-size: 84px;
    color: var(--ink);
    margin: 0;
}

.ts-rule {
    width: 280px;
    height: 4px;
    flex-shrink: 0;
    background-color: var(--ink);
    margin-top: 20px;
    margin-bottom: 40px;
}

.ts-menu {
    flex-direction: column;
    align-items: flex-start;
}

/* Button の既定テーマ（角丸背景・パディング）を解除し、テキストだけの項目にする。 */
.ts-menu-item {
    align-self: flex-start;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    padding: 8px 4px;
    margin: 0 0 10px 0;
    font-size: 32px;
    color: var(--ink);
}
.ts-menu-item:hover { color: var(--sky); }
.ts-menu-item:disabled { opacity: 0.35; }

/* CTA（希少資源・issue #482 = 「はじめから」1箇所だけ）: 応援団赤＋インク下線代わりの border-bottom。 */
.ts-menu-item--cta {
    color: var(--color-cta);
    border-bottom-width: 3px;
    border-bottom-color: var(--color-cta);
}
.ts-menu-item--cta:hover { color: var(--color-cta-hi); border-bottom-color: var(--color-cta-hi); }

.ts-version {
    position: absolute;
    right: 24px;
    bottom: 16px;
    font-size: var(--fs-cap);
    color: var(--day-tx-3);
}
