<?xml version="1.0" encoding="utf-8"?>
<!-- セーブスロット選択画面（issue #508・オーナー承認の案2＝リスト＋詳細ペイン）。issue #509 でホームの
     メニュー「セーブ」からも同じ画面を開くようになった（SaveSlots.Entry で分岐。SaveSlotsController 参照）。
     入口は3つ（タイトルの「つづきから」／ホームの ≡メニュー／共通ナビの「システム」タブ）。
     タイトル経由は開いた時点でどのシェルサービスも遅延初期化されていないため共通トップバーは出さない
     （TitleScreen と同じ理由）。ホームのメニュー経由も出さず ss-back で戻る。
     タブ経由（issue #565）だけトップバーを出す＝他のタブと同じ見え方にし、移動はタブで行う。
     左＝手動3枠＋オート1枠の32px行一覧、右＝選択枠の詳細（学校名・年度・週・保存日時）＋保存(ホーム経由のみ)／読込／削除。 -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="TopBar" src="Components/TopBar.uxml" />
    <Style src="tokens.uss" />
    <Style src="KokoSimTheme.uss" />
    <Style src="Components/components.uss" />
    <Style src="SaveSlots.uss" />

    <ui:VisualElement class="ui-root ss-root">
        <!-- 共通トップバー（タブ帯）。「システム」タブから開いたときだけ出す＝他のタブと同じ見え方にする。
             タイトル/ホームのメニュー経由では隠す（SaveSlotsController が display を切る）。 -->
        <ui:VisualElement name="ss-topbar" style="display: none;">
            <ui:Instance template="TopBar" />
        </ui:VisualElement>
        <ui:VisualElement class="ss-main">

            <ui:VisualElement class="ss-header">
                <ui:VisualElement class="rule-head">
                    <ui:VisualElement class="rule-head__rule" />
                    <ui:Label class="rule-head__text f-display" text="セーブデータ" />
                </ui:VisualElement>
                <ui:Button name="ss-back" class="dlg-btn dlg-btn--ghost" text="◀ ホームへ戻る" />
            </ui:VisualElement>

            <ui:VisualElement class="ss-body">

                <!-- 左：スロット一覧（手動1〜3＋オート・32px行） -->
                <ui:VisualElement class="card card--list">
                    <ui:VisualElement class="card__hd">
                        <ui:Label class="card__hd-title" text="スロット" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card__body">
                        <ui:VisualElement class="ss-thead">
                            <ui:Label class="ss-th ss-th--slot" text="枠" />
                            <ui:Label class="ss-th ss-th--school" text="学校名" />
                            <ui:Label class="ss-th ss-th--yw" text="年度/週" />
                        </ui:VisualElement>
                        <ui:VisualElement name="ss-rows" class="ss-rows" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 右：選択枠の詳細 -->
                <ui:VisualElement class="card card--detail">
                    <ui:VisualElement class="card__hd">
                        <ui:Label class="card__hd-title" text="詳細" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card__body card__body--fill">
                        <ui:Label name="ss-d-name" class="ss-d__name f-display-lg" text="" />
                        <ui:Label name="ss-d-sub" class="ss-d__sub f-body" text="" />
                        <ui:VisualElement name="ss-d-facts" class="ss-d__facts" />
                        <ui:Label name="ss-d-note" class="ss-d__note f-body" text="" />
                        <ui:VisualElement class="ss-d__foot">
                            <ui:Button name="ss-save" class="dlg-btn dlg-btn--primary" text="保存" style="display: none;" />
                            <ui:Button name="ss-load" class="dlg-btn dlg-btn--primary" text="読込" />
                            <ui:Button name="ss-delete" class="dlg-btn dlg-btn--warn" text="削除" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 削除確認ダイアログ（同一ドキュメント内オーバーレイ。部品辞書の modal-scrim / modal-card を使用） -->
        <ui:VisualElement name="ss-confirm" class="ui-root modal-scrim">
            <ui:VisualElement class="modal-card ss-confirm__card">
                <ui:Label name="ss-confirm-q" class="ss-confirm__q f-body" text="" />
                <ui:VisualElement class="ss-confirm__btns">
                    <ui:Button name="ss-confirm-no" class="dlg-btn dlg-btn--ghost" text="いいえ" />
                    <ui:Button name="ss-confirm-yes" class="dlg-btn dlg-btn--warn" text="削除する" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
