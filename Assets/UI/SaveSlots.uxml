<?xml version="1.0" encoding="utf-8"?>
<!-- セーブスロット選択画面（issue #508・オーナー承認の案2＝リスト＋詳細ペイン）。issue #509 でホームの
     メニュー「セーブ」からも同じ画面を開くようになった（SaveSlots.Entry で分岐。SaveSlotsController 参照）。
     入口は2つ（タイトルの「つづきから」／共通ナビの「システム」タブ。ホームの ≡メニューは #730 で廃止）。
     タイトル経由は開いた時点でどのシェルサービスも遅延初期化されていないため共通トップバーは出さない
     （TitleScreen と同じ理由）。ホームのメニュー経由も出さず ss-back で戻る。
     タブ経由（issue #565）だけトップバーを出す＝他のタブと同じ見え方にし、移動はタブで行う。
     左＝手動3枠＋オート1枠の32px行一覧、右＝選択枠の詳細（学校名・年度・週・保存日時）＋保存(ホーム経由のみ)／読込／削除。 -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="TopBar" src="Components/TopBar.uxml" />
    <Style src="tokens.uss" />
    <Style src="KokoSimTheme.uss" />
    <Style src="Components/components.uss" />
    <Style src="Components/scorebook.uss" />
    <Style src="SaveSlots.uss" />

    <ui:VisualElement class="ui-root ss-root sbk">
        <!-- 共通トップバー（タブ帯）。「システム」タブから開いたときだけ出す＝他のタブと同じ見え方にする。
             タイトル/ホームのメニュー経由では隠す（SaveSlotsController が display を切る）。 -->
        <ui:VisualElement name="ss-topbar" style="display: none;">
            <ui:Instance template="TopBar" class="topbar-slot" />
        </ui:VisualElement>
        <ui:VisualElement class="ss-main">

            <ui:VisualElement class="ss-header">
                <ui:VisualElement class="rule-head">
                    <ui:VisualElement class="rule-head__rule" />
                    <ui:Label name="ss-heading" class="rule-head__text f-display" text="セーブデータ" />
                </ui:VisualElement>
                <ui:VisualElement class="ss-header__end">
                    <!-- ゲーム中だけ出す画面内タブ（セーブデータ／校名の編集・issue #946）。部品は SegTabs。 -->
                    <ui:VisualElement name="ss-tabs" class="ss-tabs" />
                    <ui:Button name="ss-title" class="dlg-btn dlg-btn--ghost" text="タイトルへ戻る" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="ss-page-saves" class="ss-body">

                <!-- 左：スロット一覧（手動1〜3＋オート・32px行） -->
                <ui:VisualElement class="card card--list">
                    <ui:VisualElement class="card__hd">
                        <ui:Label class="card__hd-title" text="スロット" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card__body">
                        <ui:VisualElement class="ss-thead">
                            <ui:Label class="ss-th ss-th--slot" text="枠" />
                            <ui:Label class="ss-th ss-th--school" text="学校名" />
                            <ui:Label class="ss-th ss-th--yw" text="年度/週" />
                        </ui:VisualElement>
                        <ui:VisualElement name="ss-rows" class="ss-rows" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 右：選択枠の詳細 -->
                <ui:VisualElement class="card card--detail">
                    <ui:VisualElement class="card__hd">
                        <ui:Label class="card__hd-title" text="詳細" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card__body card__body--fill">
                        <ui:Label name="ss-d-name" class="ss-d__name f-display-lg" text="" />
                        <ui:Label name="ss-d-sub" class="ss-d__sub f-body" text="" />
                        <ui:VisualElement name="ss-d-facts" class="ss-d__facts" />
                        <ui:Label name="ss-d-note" class="ss-d__note f-body" text="" />
                        <ui:VisualElement class="ss-d__foot">
                            <ui:Button name="ss-save" class="dlg-btn dlg-btn--primary" text="保存" style="display: none;" />
                            <ui:Button name="ss-load" class="dlg-btn dlg-btn--primary" text="読込" />
                            <ui:Button name="ss-delete" class="dlg-btn dlg-btn--warn" text="削除" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- 校名の編集（issue #946・監督決定のA案）。左＝県の切り替え＋その県の学校一覧（自校は先頭に固定・
                 改名済みには印）、右＝選んだ学校の元の名前・新しい名前（幹だけ入力し「高校」は固定表示）・元に戻す／確定。
                 中身は SchoolRenamePage が組む。 -->
            <ui:VisualElement name="ss-page-rename" class="ss-body sr-body" style="display: none;">

                <ui:VisualElement class="card card--list sr-list">
                    <ui:VisualElement class="card__hd">
                        <ui:Label class="card__hd-title" text="学校" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card__body card__body--fill">
                        <ui:VisualElement class="sr-line">
                            <ui:Label class="sr-lbl f-body" text="都道府県" />
                            <ui:DropdownField name="sr-pref" class="sbk-field sr-drop" />
                        </ui:VisualElement>
                        <ui:ScrollView name="sr-scroll" mode="Vertical" class="sr-scroll scroll">
                            <ui:VisualElement name="sr-rows" class="row-well" />
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="card card--detail">
                    <ui:VisualElement class="card__hd">
                        <ui:Label class="card__hd-title" text="校名" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card__body card__body--fill">
                        <ui:Label name="sr-d-name" class="sr-d__name f-display" text="" />
                        <ui:Label name="sr-d-sub" class="ss-d__sub f-body" text="" />
                        <ui:VisualElement class="sr-kv">
                            <ui:Label class="sr-kv__k f-body" text="元の名前" />
                            <ui:Label name="sr-d-gen" class="sr-kv__v f-display" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement class="sr-input">
                            <ui:Label class="sr-kv__k f-body" text="新しい名前" />
                            <ui:VisualElement class="sr-input__line">
                                <ui:TextField name="sr-name" class="sbk-field sr-text f-display" />
                                <ui:Label class="sbk-field-suffix f-display" text="高校" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <!-- 県内の学校と重なる名前のときだけ出す（新規作成画面と同じ文言）。 -->
                        <ui:Label name="sr-d-note" class="ss-d__note ss-d__note--warn f-body" text="その校名は県内の学校と重複しています" style="display: none;" />
                        <ui:VisualElement class="ss-d__foot">
                            <ui:Button name="sr-revert" class="dlg-btn dlg-btn--ghost" text="元に戻す" />
                            <ui:Button name="sr-confirm" class="dlg-btn dlg-btn--primary" text="確定" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- クレジット（issue #1179・オーナー決定「入口は設定」／issue #1318 で素材の一覧と全書体を足した）。
                 先頭の「素材」カードに素材の出所、続けて書体（画面の3書体＋テロップ画像に焼き込んだ2書体）の
                 ライセンス全文を載せる。場内放送の行は体験版では出さない（コードで隠す）。見た目はスコアブックの
                 既存部品（card）で組み、説明文は足さない＝ライセンス本文そのものだけを出す。 -->
            <!-- 設定（issue #1315・オーナー決定: 1枚のカードに縦並び）。行は SaveSlotsController.BuildSettingsPage が組む -->
            <ui:VisualElement name="ss-page-settings" class="ss-body ss-settings-page" style="display: none;">
                <ui:VisualElement class="card ss-set-card">
                    <ui:VisualElement name="ss-set-rows" class="card__body" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="ss-page-credits" class="ss-body ss-credits-page" style="display: none;">
                <ui:ScrollView mode="Vertical" class="scroll ss-credits-scroll">
                    <ui:VisualElement class="card">
                        <ui:VisualElement class="card__hd card__hd--tight">
                            <ui:Label class="card__hd-title" text="素材" />
                        </ui:VisualElement>
                        <ui:VisualElement class="card__body">
                            <ui:VisualElement class="ss-cr">
                                <ui:Label class="ss-cr__k" text="効果音" />
                                <ui:Label class="ss-cr__v" text="On-Jin ~音人~　https://on-jin.com/" />
                            </ui:VisualElement>
                            <ui:VisualElement class="ss-cr">
                                <ui:Label class="ss-cr__k" text="歓声" />
                                <ui:Label class="ss-cr__v" text="効果音ラボ" />
                            </ui:VisualElement>
                            <ui:VisualElement name="credits-row-announcer" class="ss-cr">
                                <ui:Label class="ss-cr__k" text="場内放送" />
                                <ui:Label class="ss-cr__v" text="VOICEVOX:No.7" />
                            </ui:VisualElement>
                            <ui:VisualElement class="ss-cr">
                                <ui:Label class="ss-cr__k" text="3Dモデル（防具・帽子）" />
                                <ui:Label class="ss-cr__v" text="Meshy（CC BY 4.0）" />
                            </ui:VisualElement>
                            <ui:VisualElement class="ss-cr">
                                <ui:Label class="ss-cr__k" text="3Dモデル（ミット・グラブ）" />
                                <ui:Label class="ss-cr__v" text="Tripo AI（CC BY 4.0）" />
                            </ui:VisualElement>
                            <ui:VisualElement class="ss-cr">
                                <ui:Label class="ss-cr__k" text="地図データ" />
                                <ui:Label class="ss-cr__v" text="「国土数値情報（行政区域データ）」（国土交通省 https://nlftp.mlit.go.jp/ksj/ ・CC BY 4.0）を加工して作成・Natural Earth" />
                            </ui:VisualElement>
                            <ui:VisualElement class="ss-cr">
                                <ui:Label class="ss-cr__k" text="フォント" />
                                <ui:Label class="ss-cr__v" text="Noto Sans JP・しっぽり明朝 B1・DotGothic16・Anton・Dela Gothic One（SIL OFL 1.1）" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="card">
                        <ui:VisualElement class="card__hd card__hd--tight">
                            <ui:Label class="card__hd-title" text="Noto Sans JP" />
                        </ui:VisualElement>
                        <ui:VisualElement class="card__body">
                            <ui:Label name="credits-notosansjp-body" class="f-body ss-credits-body" text="" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="card">
                        <ui:VisualElement class="card__hd card__hd--tight">
                            <ui:Label class="card__hd-title" text="しっぽり明朝 B1" />
                        </ui:VisualElement>
                        <ui:VisualElement class="card__body">
                            <ui:Label name="credits-shippori-body" class="f-body ss-credits-body" text="" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="card">
                        <ui:VisualElement class="card__hd card__hd--tight">
                            <ui:Label class="card__hd-title" text="DotGothic16" />
                        </ui:VisualElement>
                        <ui:VisualElement class="card__body">
                            <ui:Label name="credits-dotgothic-body" class="f-body ss-credits-body" text="" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="card">
                        <ui:VisualElement class="card__hd card__hd--tight">
                            <ui:Label class="card__hd-title" text="Anton" />
                        </ui:VisualElement>
                        <ui:VisualElement class="card__body">
                            <ui:Label name="credits-anton-body" class="f-body ss-credits-body" text="" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="card">
                        <ui:VisualElement class="card__hd card__hd--tight">
                            <ui:Label class="card__hd-title" text="Dela Gothic One" />
                        </ui:VisualElement>
                        <ui:VisualElement class="card__body">
                            <ui:Label name="credits-delagothic-body" class="f-body ss-credits-body" text="" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 削除確認ダイアログ（同一ドキュメント内オーバーレイ。部品辞書の modal-scrim / modal-card を使用） -->
        <ui:VisualElement name="ss-confirm" class="ui-root modal-scrim">
            <ui:VisualElement class="modal-card confirm-card">
                <ui:Label name="ss-confirm-q" class="confirm-q f-body" text="" />
                <ui:VisualElement class="confirm-btns">
                    <ui:Button name="ss-confirm-no" class="dlg-btn dlg-btn--ghost" text="いいえ" />
                    <ui:Button name="ss-confirm-yes" class="dlg-btn dlg-btn--warn" text="削除する" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- 「タイトルへ戻る」確認（issue #730 でホームの ≡メニューから移設。破壊的操作＝確認を挟む）。 -->
        <ui:VisualElement name="ss-title-confirm" class="ui-root modal-scrim">
            <ui:VisualElement class="modal-card confirm-card">
                <ui:Label class="confirm-q f-body" text="タイトルへ戻りますか？　保存していない進行は失われます。" />
                <ui:Label name="ss-title-since" class="ss-confirm__sub f-body" text="" />
                <ui:VisualElement class="confirm-btns">
                    <ui:Button name="ss-title-no" class="dlg-btn dlg-btn--ghost" text="いいえ" />
                    <ui:Button name="ss-title-yes" class="dlg-btn dlg-btn--warn" text="タイトルへ戻る" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
