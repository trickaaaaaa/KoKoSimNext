/* ═══════════════════════════════════════════════════════════════════════
   TrainingPlan.uss — 練習 画面（一覧と練習メニューの配分）
   ───────────────────────────────────────────────────────────────────────
   練習画面のリデザイン（1600×900 基準）。上の共通の帯（TopBar）は触らない。
   部品（rank のチップ・switch・LineIcon・DashedFrame・LabeledStackBar・tm-bg--X）は部品辞書、
   色は tokens.uss / scorebook.uss の変数。ここには画面固有の配置と寸法だけを書く。
   ・列幅は列見出し（.tp-th）と行（.tp-cell）が同じ .tp-col--X を共有する（横ずれ防止）。
   ・枠の太さが変わる要素（個別指導の枠・星のボタン）はふだんから透明の枠を持ち、大きさを変えない。
   ═══════════════════════════════════════════════════════════════════════ */

.tp-root {
    flex-grow: 1;
    background-color: var(--sbk-paper-deep);
    color: var(--sbk-text);
}
/* 画面内の Label の既定余白を外す（.sbk Label に置くと全データ画面が崩れる）。共通の帯（TopBar）は
   触らないので、本体（.tp-body）・ポップアップ（.tpm-card / .tpc-card）・トーストだけに効かせる。 */
.tp-body Label, .tpm-card Label, .tpc-card Label { margin: 0; padding: 0; }
.tp-body Button, .tpm-card Button, .tpc-card Button { margin: 0; }
.tp-root .tpm-spacer { flex-grow: 1; }

.tp-root .tp-body {
    flex-grow: 1;
    flex-direction: column;
    padding: 16px 24px 20px 24px;
    min-height: 0;
}

/* ═══ ① 個別指導の帯 ═══ */
.tp-root .tp-coach {
    flex-shrink: 0;
    flex-direction: row; align-items: center;
    height: 72px;
    background-color: var(--sbk-sheet);
    border-radius: 14px;
    padding: 0 20px;
    margin-bottom: 14px;
}
.tp-root .tp-coach__head { width: 150px; flex-shrink: 0; margin-right: 14px; }
.tp-root .tp-coach__title { font-size: 18px; letter-spacing: 1.4px; color: var(--sbk-text); }
.tp-root .tp-coach__count { flex-direction: row; align-items: flex-end; margin-top: 2px; }
.tp-root .tp-coach__count-num { font-size: 14px; color: var(--sbk-text); }
.tp-root .tp-coach__count-cap { font-size: 12px; color: var(--sbk-sub); margin-left: 3px; margin-bottom: 1px; }
.tp-root .tp-coach__slots { flex-direction: row; align-items: center; }

/* 1枠：300×50。指名中はスクールカラーの2px枠＋6%の地（C# で色を流す）。空きは点線（DashedFrame）。 */
.tp-root .tp-slot {
    flex-shrink: 0;
    width: 300px; height: 50px;
    border-radius: 10px;
    border-width: 2px; border-color: rgba(0, 0, 0, 0);
    flex-direction: row; align-items: center;
    padding: 0 8px 0 12px;
    margin-right: 14px;
}
.tp-root .tp-slot--empty { justify-content: center; padding: 0; border-width: 0; }
.tp-root .tp-slot__star { width: 18px; height: 18px; flex-shrink: 0; color: var(--sbk-star); margin-right: 10px; }
.tp-root .tp-slot__num { margin-right: 10px; }
.tp-root .tp-slot__body { flex-grow: 1; flex-shrink: 1; min-width: 0; flex-direction: row; align-items: center; margin-right: 10px; overflow: hidden; }
.tp-root .tp-slot__name { font-size: 17px; letter-spacing: 1px; color: var(--sbk-text); }
.tp-root .tp-slot__meta { font-size: 12px; color: var(--sbk-sub); margin-left: 10px; }
.tp-root .tp-slot__x {
    width: 30px; height: 30px; flex-shrink: 0;
    border-radius: 6px; border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--sbk-mute);
    align-items: center; justify-content: center;
    padding: 0;
}
.tp-root .tp-slot__x:hover { background-color: var(--sbk-rule-soft); }
.tp-root .tp-slot__x .licon { width: 16px; height: 16px; }
.tp-root .tp-slot__empty { flex-direction: row; align-items: center; }
.tp-root .tp-slot__empty-t { font-size: 13px; color: var(--sbk-mute); }
.tp-root .tp-slot__empty-star { width: 14px; height: 14px; color: var(--sbk-mute); margin: 0 4px; }

/* 背番号の箱（白地＋墨の1.5px枠・角丸3） */
.tp-root .tp-num {
    flex-shrink: 0;
    height: 22px; min-width: 28px;
    background-color: var(--sbk-card);
    border-width: 1.5px; border-color: var(--sbk-patch-line); border-radius: 3px;
    font-size: 12px; color: var(--sbk-text);
    -unity-text-align: middle-center;
    padding: 0 4px;
}
.tp-root .tp-num--row { width: 30px; min-width: 30px; padding: 0; }

/* ═══ ② 部員別 練習割当 ═══ */
.tp-root .tp-table {
    flex-grow: 1; min-height: 0;
    flex-direction: column;
    background-color: var(--sbk-sheet);
    border-radius: 14px;
    overflow: hidden;
}
.tp-root .tp-toolbar {
    flex-shrink: 0;
    flex-direction: row; align-items: center;
    height: 58px;
    margin: 0 20px;
    border-bottom-width: 2px; border-bottom-color: var(--sbk-text);
}
.tp-root .tp-toolbar__title { font-size: 18px; letter-spacing: 1.4px; color: var(--sbk-text); margin-right: 14px; }
.tp-root .tp-toolbar__count-num { font-size: 14px; color: var(--sbk-text); }
.tp-root .tp-toolbar__count-cap { font-size: 12px; color: var(--sbk-sub); margin-left: 3px; }
.tp-root .tp-toolbar__spacer { flex-grow: 1; }
.tp-root .tp-toolbar__cap { font-size: 12px; color: var(--sbk-sub); margin-right: 10px; }
.tp-root .tp-toolbar__cap--gap { margin-left: 18px; }

/* つまみ型の切り替え（地 #ECE8DF・余白3・角丸9。選択中は白地＋淡い1px枠＋墨の太字） */
.tp-root .tp-seg {
    flex-direction: row;
    background-color: var(--sbk-rule-soft);
    border-radius: 9px;
    padding: 3px;
}
.tp-root .tp-seg__item {
    height: 30px;
    padding: 0 14px;
    border-radius: 6px;
    border-width: 1px; border-color: rgba(0, 0, 0, 0);
    font-size: 13px; color: var(--sbk-sub);
    -unity-text-align: middle-center;
}
.tp-root .tp-seg__item:hover { color: var(--sbk-text); }
.tp-root .tp-seg__item--on { background-color: var(--sbk-card); border-color: var(--sbk-card-line); color: var(--sbk-text); }

/* 列見出し＋行で共通の列幅（44｜300｜188｜残り｜84｜40・間隔14） */
.tp-root .tp-thead {
    flex-shrink: 0;
    flex-direction: row; align-items: center;
    height: 32px;
    margin: 0 20px;
    border-bottom-width: 1px; border-bottom-color: var(--sbk-rule-soft);
}
.tp-root .tp-th { font-size: 12px; color: var(--sbk-mute); }
.tp-root .tp-col--nom { width: 44px;  flex-shrink: 0; }
.tp-root .tp-col--id { width: 300px; flex-shrink: 0; margin-left: 14px; }
.tp-root .tp-col--rank { width: 188px; flex-shrink: 0; margin-left: 14px; }
.tp-root .tp-col--menu { flex-grow: 1; flex-basis: 0; min-width: 0; margin-left: 14px; }
.tp-root .tp-col--go { width: 84px;  flex-shrink: 0; margin-left: 14px; }
.tp-root .tp-col--copy { width: 40px;  flex-shrink: 0; margin-left: 14px; }
.tp-root .tp-thead__gutter { width: var(--scrollbar-w); flex-shrink: 0; }

.tp-root .tp-scroll { flex-grow: 1; min-height: 0; }
.tp-root .tp-rows { padding: 0 20px; }

/* 選手の行：高さ56・下に淡い1px線 */
.tp-root .trow {
    flex-direction: row; align-items: center;
    height: 56px; flex-shrink: 0;
    border-bottom-width: 1px; border-bottom-color: var(--sbk-rule-soft);
}
.tp-root .trow:hover { background-color: var(--sbk-paper); }
.tp-root .tp-cell { flex-direction: row; align-items: center; }

/* 指導：星のボタン（34角・角丸8）。未指名は線画の星、指名中は塗りの星＋金の地 */
.tp-root .tp-star {
    width: 34px; height: 34px;
    border-radius: 8px;
    border-width: 1px; border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    align-items: center; justify-content: center;
    padding: 0;
    color: var(--sbk-star-off);
}
.tp-root .tp-star:hover { border-color: var(--sbk-card-line-hover); }
.tp-root .tp-star .licon { width: 20px; height: 20px; }
.tp-root .tp-star--on { background-color: var(--sbk-star-bg); color: var(--sbk-star); }

/* 選手：背番号の箱・名前（明朝18）・学年と投打 */
.tp-root .tp-cell--id { overflow: hidden; }
.tp-root .trow__name { font-size: 18px; letter-spacing: 1px; color: var(--sbk-text); margin-left: 12px; }
.tp-root .trow__meta { font-size: 12px; color: var(--sbk-sub); margin-left: 12px; }

/* 能力：「打・走・守・投」の見出しとランクのチップ（22角）の組を間隔10で */
.tp-root .tp-ranks { flex-direction: row; align-items: center; }
.tp-root .tp-ranks__pair { flex-direction: row; align-items: center; margin-right: 10px; }
.tp-root .tp-ranks__label { font-size: 11px; color: var(--sbk-mute); margin-right: 4px; }
.tp-root .tp-chip22 { width: 22px; min-width: 22px; height: 22px; margin: 0; padding: 0; font-size: 12px; }
.tp-root .tp-chip20 { width: 20px; min-width: 20px; height: 20px; margin: 0; padding: 0; font-size: 11px; }

/* 練習メニュー：型の名前（104）｜横棒（残り）・間隔14 */
.tp-root .tp-menu__type { width: 104px; flex-shrink: 0; font-size: 14px; color: var(--sbk-text); }
.tp-root .tp-menu__bar { flex-grow: 1; flex-basis: 0; min-width: 0; margin-left: 14px; }

/* 変更・複製 */
.tp-root .tp-go {
    width: 84px; height: 36px;
    border-radius: 8px;
    border-width: 1.5px; border-color: var(--sbk-text);
    background-color: rgba(0, 0, 0, 0);
    flex-direction: row; align-items: center; justify-content: center;
    padding: 0;
}
.tp-root .tp-go:hover { background-color: var(--sbk-card); }
.tp-root .tp-go__t { font-size: 13px; color: var(--sbk-text); }
.tp-root .tp-go .licon { width: 14px; height: 14px; color: var(--sbk-text); margin-left: 4px; }
.tp-root .tp-copy {
    width: 36px; height: 36px;
    border-radius: 8px;
    border-width: 1px; border-color: var(--sbk-rule);
    background-color: rgba(0, 0, 0, 0);
    align-items: center; justify-content: center;
    padding: 0;
    color: var(--sbk-info);
}
.tp-root .tp-copy:hover { background-color: var(--sbk-card); }
.tp-root .tp-copy .licon { width: 18px; height: 18px; }

/* ═══ 練習メニューの配分（ポップアップ） ═══ */
.tp-root .tpm-scrim { background-color: var(--sbk-ink-scrim); }
.tp-root .tpm-card {
    position: absolute;
    left: 48px; right: 48px; top: 34px; bottom: 34px;
    background-color: var(--sbk-sheet);
    border-width: 0;
    border-radius: 18px;
    overflow: hidden;
}
.tp-root .tpm-cap { font-size: 12px; color: var(--sbk-sub); }

/* アイコンだけの四角いボタン（前・次・閉じる） */
.tp-root .tpm-iconbtn {
    width: 38px; height: 38px; flex-shrink: 0;
    border-radius: 9px;
    border-width: 1px; border-color: var(--sbk-rule);
    background-color: var(--sbk-card);
    align-items: center; justify-content: center;
    padding: 0;
    color: var(--sbk-text);
}
.tp-root .tpm-iconbtn .licon { width: 18px; height: 18px; }
.tp-root .tpm-iconbtn:hover { border-color: var(--sbk-mute); }
.tp-root .tpm-iconbtn:disabled { color: var(--sbk-rule); }
.tp-root .tpm-iconbtn--next { margin-left: 6px; }
.tp-root .tpm-close { width: 40px; height: 40px; border-width: 0; background-color: var(--sbk-rule-soft); margin-left: 14px; }

/* ① 選手の見出し（高さ92・下に淡い1px線） */
.tp-root .tpm-head {
    flex-shrink: 0;
    flex-direction: row; align-items: center;
    height: 92px;
    padding: 0 28px;
    border-bottom-width: 1px; border-bottom-color: var(--sbk-rule-soft);
}
.tp-root .tpm-head__num {
    width: 44px; height: 34px; flex-shrink: 0;
    background-color: var(--sbk-card);
    border-width: 2px; border-color: var(--sbk-text); border-radius: 4px;
    font-size: 18px; color: var(--sbk-text);
    -unity-text-align: middle-center;
    margin-left: 18px;
}
.tp-root .tpm-head__id { margin-left: 18px; }
.tp-root .tpm-head__name { font-size: 28px; letter-spacing: 2.2px; color: var(--sbk-text); }
.tp-root .tpm-head__metarow { flex-direction: row; align-items: center; margin-top: 4px; }
.tp-root .tpm-head__meta { font-size: 13px; color: var(--sbk-sub); margin-right: 12px; }
.tp-root .tpm-head__cats .tp-ranks__pair { margin-right: 8px; }

/* 個別指導のボタン（高さ40・角丸9）。枠の太さは指名中/未指名で 1.5 に揃える＝大きさを変えない */
.tp-root .tpm-nom {
    height: 40px;
    border-radius: 9px;
    border-width: 1.5px; border-color: var(--sbk-rule);
    background-color: var(--sbk-card);
    flex-direction: row; align-items: center;
    padding: 0 16px;
    color: var(--sbk-info);
}
.tp-root .tpm-nom .licon { width: 16px; height: 16px; margin-right: 8px; }
.tp-root .tpm-nom__t { font-size: 14px; color: var(--sbk-info); }
.tp-root .tpm-nom--on { background-color: var(--sbk-star-bg); border-color: var(--sbk-star); color: var(--sbk-star); }
.tp-root .tpm-nom--on .tpm-nom__t { color: var(--sbk-star-fg); }

.tp-root .tpm-delegate { flex-direction: row; align-items: center; margin-left: 14px; }
.tp-root .tpm-delegate .switch { margin-right: 8px; }
.tp-root .tpm-delegate__state { font-size: 13px; color: var(--sbk-info); }

/* ② メニューの型の行（高さ76） */
.tp-root .tpm-presetrow {
    flex-shrink: 0;
    flex-direction: row; align-items: center;
    height: 76px;
    padding: 0 28px;
}
.tp-root .tpm-presetrow > .tpm-cap { margin-right: 10px; }
.tp-root .tpm-presets { flex-direction: row; align-items: center; }
.tp-root .tpm-preset {
    height: 40px;
    padding: 0 16px;
    margin-right: 10px;
    border-radius: 9px;
    border-width: 1px; border-color: var(--sbk-rule);
    background-color: var(--sbk-card);
    font-size: 14px; color: var(--sbk-info);
    -unity-text-align: middle-center;
}
.tp-root .tpm-preset:hover { border-color: var(--sbk-mute); }
.tp-root .tpm-preset--on, .tp-root .tpm-preset--on:hover { background-color: var(--sbk-text); border-color: var(--sbk-text); color: var(--color-on-fill); }
.tp-root .tpm-preset--locked { opacity: 0.45; }
.tp-root .tpm-lock { font-size: 12px; color: var(--sbk-mute); }

.tp-root .tpm-budget { width: 250px; flex-shrink: 0; }
.tp-root .tpm-budget__top { flex-direction: row; align-items: flex-end; height: 36px; }
.tp-root .tpm-budget__top > .tpm-cap { margin-bottom: 6px; }
.tp-root .tpm-budget__total { font-size: 28px; color: var(--sbk-text); }
.tp-root .tpm-budget__total--short { color: var(--sbk-short); }
.tp-root .tpm-budget__of { font-size: 14px; color: var(--sbk-sub); margin-left: 4px; margin-bottom: 5px; }
.tp-root .tpm-budget__remain { font-size: 12px; color: var(--sbk-short); margin-right: 8px; margin-bottom: 6px; }
.tp-root .tpm-budget__bar { margin-top: 4px; }
.tp-root .tpm-budget__bar .lstack { background-color: var(--sbk-rule-soft); }

/* ③ 本体（3列：残りの半分｜残りの半分｜440・間隔28） */
.tp-root .tpm-body {
    flex-grow: 1; min-height: 0;
    flex-direction: row;
    padding: 4px 28px 0 28px;
}
.tp-root .tpm-col { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 28px; }
.tp-root .tpm-list { flex-shrink: 0; }

.tp-root .tpm-group {
    flex-shrink: 0;
    flex-direction: row; align-items: center;
    height: 30px;
    border-bottom-width: 2px; border-bottom-color: var(--sbk-text);
}
.tp-root .tpm-group--gap { margin-top: 14px; }
.tp-root .tpm-group__name { font-size: 16px; letter-spacing: 1.3px; color: var(--sbk-text); }
.tp-root .tpm-group__note { font-size: 12px; color: var(--sbk-mute); margin-left: 8px; }
.tp-root .tpm-group__sum { font-size: 15px; color: var(--sbk-text); }
.tp-root .tpm-group__unit { font-size: 12px; color: var(--sbk-sub); margin-left: 2px; }

/* 練習の行：記号26｜項目名｜(適性44)｜棒92｜分数40｜増減62・間隔10 */
.tp-root .mrow {
    flex-shrink: 0;
    flex-direction: row; align-items: center;
    height: 34px;
    border-bottom-width: 1px; border-bottom-color: var(--sbk-rule-faint);
}
.tp-root .mrow--tall { height: 42px; }
.tp-root .mrow__icon {
    width: 26px; height: 26px; flex-shrink: 0;
    border-radius: 6px;
    font-size: 13px; color: var(--color-on-fill);
    -unity-text-align: middle-center;
}
.tp-root .mrow__name { flex-grow: 1; flex-basis: 0; min-width: 0; font-size: 14px; color: var(--sbk-text); margin-left: 10px; }
.tp-root .mrow__apt { width: 44px; flex-shrink: 0; flex-direction: row; align-items: center; margin-left: 10px; }
.tp-root .mrow__apt-v { font-size: 12px; color: var(--sbk-mute); margin-left: 4px; }
.tp-root .mrow__bar { width: 92px; flex-shrink: 0; margin-left: 10px; }
.tp-root .mrow__min { width: 40px; flex-shrink: 0; flex-direction: row; align-items: flex-end; justify-content: flex-end; margin-left: 10px; }
.tp-root .mrow__min-v { font-size: 17px; color: var(--sbk-text); }
.tp-root .mrow__min-u { font-size: 11px; color: var(--sbk-text); margin-left: 1px; margin-bottom: 2px; }
.tp-root .mrow__step {
    width: 62px; height: 28px; flex-shrink: 0;
    flex-direction: row;
    margin-left: 10px;
    border-width: 1px; border-color: var(--sbk-rule); border-radius: 7px;
    background-color: var(--sbk-card);
    overflow: hidden;
}
.tp-root .mrow__btn {
    flex-grow: 1; flex-basis: 0;
    height: 100%;
    border-width: 0; border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 15px; color: var(--sbk-text);
    -unity-text-align: middle-center;
    padding: 0;
}
.tp-root .mrow__btn:hover { background-color: var(--sbk-paper); }
.tp-root .mrow__btn--plus { border-left-width: 1px; border-left-color: var(--sbk-rule); }
.tp-root .mrow__btn--off, .tp-root .mrow__btn--off:hover { color: var(--sbk-rule); background-color: rgba(0, 0, 0, 0); }
.tp-root .mrow__btn--full, .tp-root .mrow__btn--full:hover { color: var(--sbk-mute-soft); background-color: rgba(0, 0, 0, 0); }
/* 0分の行は薄く（記号30%・項目名と分数は淡色、項目名は細字） */
.tp-root .mrow--zero .mrow__icon { opacity: 0.3; }
.tp-root .mrow--zero .mrow__name, .tp-root .mrow--zero .mrow__min-v, .tp-root .mrow--zero .mrow__min-u { color: var(--sbk-mute); }

/* 練習時間の棒（高さ8・地 #ECE8DF・塗りは項目の色・120分で満タン）。ドラッグで分数を変えられる */
.tp-root .mrow__bar .ta-slider { flex-grow: 0; flex-basis: auto; width: 100%; height: 8px; border-width: 0; border-radius: 4px; background-color: var(--sbk-rule-soft); }
.tp-root .mrow__bar .ta-slider__fill { border-radius: 4px; }

/* この配分で伸びる能力（地 #F3F0E8・角丸12・余白 上下12 左右18・下18あける） */
.tp-root .tpm-growth {
    width: 440px; flex-shrink: 0;
    background-color: var(--sbk-growth-bg);
    border-radius: 12px;
    padding: 12px 18px;
    margin-bottom: 18px;
}
.tp-root .tpm-ggroup {
    flex-shrink: 0;
    flex-direction: row; align-items: center;
    height: 26px;
    border-bottom-width: 1px; border-bottom-color: var(--sbk-well);
}
.tp-root .tpm-ggroup--gap { margin-top: 10px; }
.tp-root .tpm-ggroup__name { font-size: 13px; color: var(--sbk-info); }
.tp-root .tpm-ggroup__note { font-size: 11px; color: var(--sbk-mute); }
.tp-root .tpm-glist { flex-shrink: 0; }

/* 能力の行：能力名64｜ランク20｜数値34（右寄せ）｜伸びの棒（残り）・間隔10 */
.tp-root .grow {
    flex-shrink: 0;
    flex-direction: row; align-items: center;
    height: 26px;
}
.tp-root .grow--still { opacity: 0.45; }
.tp-root .grow__name { width: 64px; flex-shrink: 0; font-size: 13px; color: var(--sbk-text); }
.tp-root .grow__chip { margin-left: 10px; }
.tp-root .grow__val { width: 34px; flex-shrink: 0; font-size: 13px; color: var(--sbk-text); -unity-text-align: middle-right; margin-left: 10px; }
.tp-root .grow__track { flex-grow: 1; flex-basis: 0; min-width: 0; margin-left: 10px; }
.tp-root .grow__fill { height: 10px; border-radius: 3px; }
.tp-root .grow__text { font-size: 13px; color: var(--sbk-info); margin-left: 10px; }
.tp-root .grow__tag {
    font-size: 11px; color: var(--color-on-fill);
    border-radius: 4px;
    padding: 1px 7px;
    margin-left: 10px;
}

/* ④ 下の操作の行（高さ76・上に淡い1px線） */
.tp-root .tpm-foot {
    flex-shrink: 0;
    flex-direction: row; align-items: center;
    height: 76px;
    padding: 0 28px;
    border-top-width: 1px; border-top-color: var(--sbk-rule-soft);
}
.tp-root .tpm-foot > .tpm-cap { margin-right: 12px; }
.tp-root .tpm-tplsel {
    width: 220px; height: 42px; flex-shrink: 0;
    flex-direction: row; align-items: center;
    background-color: var(--sbk-card);
    border-width: 1px; border-color: var(--sbk-rule); border-radius: 9px;
    padding: 0 12px 0 14px;
}
.tp-root .tpm-tplsel:hover { border-color: var(--sbk-mute); }
.tp-root .tpm-tplsel__label { flex-grow: 1; font-size: 14px; color: var(--sbk-text); -unity-text-align: middle-left; }
.tp-root .tpm-tplsel__label--none { color: var(--sbk-mute); }
.tp-root .tpm-tplsel .licon { width: 16px; height: 16px; color: var(--sbk-info); }
.tp-root .tpm-tplsel--locked { opacity: 0.45; }
.tp-root .tpm-tplsave {
    height: 42px;
    margin-left: 12px;
    padding: 0 16px;
    border-radius: 9px;
    border-width: 1px; border-color: var(--sbk-rule);
    background-color: rgba(0, 0, 0, 0);
    font-size: 14px; color: var(--sbk-info);
}
.tp-root .tpm-tplsave:hover { background-color: var(--sbk-card); }
.tp-root .tpm-revert {
    height: 46px;
    padding: 0 22px;
    border-radius: 9px;
    border-width: 1.5px; border-color: var(--sbk-text);
    background-color: rgba(0, 0, 0, 0);
    font-size: 15px; color: var(--sbk-text);
}
.tp-root .tpm-revert:hover { background-color: var(--sbk-card); }
.tp-root .tpm-done {
    width: 160px; height: 46px;
    margin-left: 12px;
    border-radius: 9px;
    border-width: 0;
    font-size: 16px; letter-spacing: 3.2px; color: var(--color-on-fill);
}

/* 週テンプレートの一覧（選択欄の上に開く） */
.tp-root .tpm-tplmenu {
    position: absolute;
    left: 125px; bottom: 66px;
    width: 220px;
    background-color: var(--sbk-card);
    border-width: 1px; border-color: var(--sbk-rule); border-radius: 9px;
    padding: 4px 0;
    display: none;
}
.tp-root .tpm-tplmenu__item { flex-direction: row; align-items: center; height: 36px; padding: 0 6px 0 14px; }
.tp-root .tpm-tplmenu__item:hover { background-color: var(--sbk-paper); }
.tp-root .tpm-tplmenu__item--on .tpm-tplmenu__name { color: var(--sbk-text); }
.tp-root .tpm-tplmenu__name { flex-grow: 1; font-size: 14px; color: var(--sbk-info); }
.tp-root .tpm-tplmenu__del {
    width: 28px; height: 28px;
    border-width: 0; border-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    align-items: center; justify-content: center;
    padding: 0;
    color: var(--sbk-mute);
}
.tp-root .tpm-tplmenu__del:hover { background-color: var(--sbk-rule-soft); }
.tp-root .tpm-tplmenu__del .licon { width: 14px; height: 14px; }

/* ═══ 複製ピッカー（tp-copy-modal・コピー元を選ぶ, Issue #133-⑤） ═══ */
.tp-root .tpc-card {
    width: 760px; max-width: 86%; max-height: 82%;
    background-color: var(--sbk-sheet);
    border-width: 0;
    border-radius: 18px;
    overflow: hidden;
}
.tp-root .tpc-head {
    flex-shrink: 0;
    flex-direction: row; align-items: center;
    height: 72px;
    padding: 0 24px;
    border-bottom-width: 1px; border-bottom-color: var(--sbk-rule-soft);
}
.tp-root .tpc-head__name { font-size: 22px; letter-spacing: 1.5px; color: var(--sbk-text); }
.tp-root .tpc-head__cap { font-size: 13px; color: var(--sbk-sub); margin-left: 12px; }
.tp-root .tpc-scroll { flex-grow: 1; min-height: 0; }
.tp-root .tpc-list { padding: 4px 24px 12px 24px; }
.tp-root .tpc-row {
    flex-direction: row; align-items: center;
    height: 56px;
    border-bottom-width: 1px; border-bottom-color: var(--sbk-rule-soft);
}
.tp-root .tpc-row:hover { background-color: var(--sbk-paper); }
.tp-root .tpc-row__body { width: 190px; flex-shrink: 0; margin-left: 12px; }
.tp-root .tpc-row__name { font-size: 16px; letter-spacing: 1px; color: var(--sbk-text); }
.tp-root .tpc-row__meta { font-size: 12px; color: var(--sbk-sub); margin-top: 2px; }
.tp-root .tpc-row__preset { width: 96px; flex-shrink: 0; font-size: 13px; color: var(--sbk-text); margin-left: 12px; }
.tp-root .tpc-row__bar { flex-grow: 1; flex-basis: 0; min-width: 0; margin-left: 12px; }

/* toast */
.tp-root .tp-toast {
    position: absolute; bottom: 24px; left: 50%;
    translate: -50% 0;
    background-color: var(--sbk-text); color: var(--color-on-fill);
    font-size: 14px; padding: 10px 20px; border-radius: 9px;
    display: none;
}
