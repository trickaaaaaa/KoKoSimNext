/* KokoSim スコアボードテーマ（設計書06）。モック mock-home-dashboard.html を UI Toolkit(Flexbox) へ移植。
   UI Toolkit は CSS grid 非対応のため grid は flex で表現。色覚対応の等級カラーを共通言語とする。
   書体は design-22（本文・数字=Noto Sans JP / 見出し・校名・人名=Shippori Mincho B1）＋
   掲示板のドット(DotGothic16)。役割クラスは tokens.uss の .f-* に集約し、ここでは指定しない。 */

.root {
    flex-grow: 1;
    background-color: var(--color-field);   /* --field 深緑 */
    color: var(--color-chalk);              /* --chalk */
    font-size: 22px;
    /* 既定フォント＝Noto Sans JP Regular（tokens.uss .ui-root と同一・設計書16 F1-a／design-22 G0）。
       既定テーマの legacy ビットマップフォント(NotInter)を上書きし、全子孫へ継承させる。
       これが無いとテキストが legacy フォントで拡大描画されて滲む（設計書06）。 */
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/NotoSansJP-Regular.asset?fileID=11400000&guid=5839fd367ddf74b178e747a3a65ccbf9&type=2#NotoSansJP-Regular");
}

/* トップバー（<ui:Instance template="TopBar" class="topbar-slot" />）は絶対に潰さない。
   ⚠ instance が作る TemplateContainer は**どの USS にも当たらない裸の要素**で、既定で縮む。
   中身（.sb2 / .nav）は flex-shrink:0 なので、潰れた分だけ下の本文域が上へ乗り上げ、
   タブが隠れて押せなくなる（実測 2026-08-14: 本文が育つと 181px → 67px まで潰れた）。
   本文側の要求高を抑えるのは .dash-col / .card__scroll の役目で、こちらは最後の砦。 */
.topbar-slot { flex-shrink: 0; }

/* UI Toolkit は Web と違いパネルが固定高。コンテナが flex-shrink で潰れて
   重ならないよう、主要ブロックは縮小を禁止して自然な内容高を保つ。 */
.header, .nav, .board, .school, .meters, .meter,
.main, .top-row, .panel, .stats, .stat, .days, .day,
.row, .vs, .vs__teams, .winbar, .feed__item {
    flex-shrink: 0;
}

/* 全体を縦スクロール（UI Toolkitはパネル固定高のため）。背景は root に任せ透過。 */
.scroll { flex-grow: 1; }
.scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    flex-grow: 1;
}

/* ===== ヘッダー（スコアボード） ===== */
.header {
    background-color: var(--color-panel-deep);
    border-bottom-width: 2px;
    border-bottom-color: var(--color-line);
    padding: 10px 22px 0 22px;
}
.board {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
}
.school {
    flex-direction: row;
    align-items: baseline;
}
.school__pref {
    font-size: 19px;
    color: var(--color-muted);
    letter-spacing: 2px;
    margin-right: 12px;
}
.school__name {
    font-size: 28px;
    letter-spacing: 1px;
    margin-right: 12px;
}
.school__week {
    font-size: 25px;
    letter-spacing: 1px;
    color: var(--ink);             /* --lamp 電光ランプ */
}
.meters { flex-direction: row; }
.meter {
    align-items: flex-end;
    margin-left: 22px;
}
.meter__k {
    font-size: 18px;
    letter-spacing: 2px;
    color: var(--color-muted);
}
.meter__v {
    font-size: 25px;
    flex-direction: row;
    align-items: center;
}
.advance {
    background-color: var(--color-lamp);
    color: var(--color-ink);
    border-width: 0;
    border-radius: var(--radius-chip);
    font-size: 22px;
    letter-spacing: 1px;
    padding: 9px 22px;
    margin-left: 22px;
}
.advance:hover { background-color: var(--color-lamp-hi); }

/* ===== ナビ ===== */
.nav {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 12px;
}
.nav__item {
    color: var(--color-muted);
    font-size: 21px;
    letter-spacing: 1px;
    padding: 10px 16px;
    border-radius: 8px 8px 0 0;
}
.nav__item:hover { color: var(--color-chalk); }
.nav__item--on {
    color: var(--color-chalk);
    background-color: var(--color-panel);
    border-width: 0;
}

/* ===== レイアウト ===== */
.main {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 10px 22px 0 22px;
}
.col-left {
    flex-grow: 1;
    flex-basis: 56%;
    min-width: 420px;
    padding-right: 14px;
}
.col-right {
    flex-grow: 1;
    flex-basis: 40%;
    min-width: 320px;
}
.top-row { flex-direction: row; flex-wrap: wrap; }

.panel {
    background-color: var(--color-panel);   /* --panel（枠線廃止・角丸12・面色で区切る） */
    border-width: 0;
    border-radius: var(--radius-card);
    padding: 14px 16px;
    margin-bottom: 12px;
}
.panel--half { flex-grow: 1; flex-basis: 45%; min-width: 200px; margin-right: 14px; }
.panel__title {
    font-size: 19px;
    letter-spacing: 2px;
    color: var(--color-muted);
    margin-bottom: 7px;
}

/* ===== 次の試合 ===== */
.vs {
    background-color: var(--color-panel-deep);
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: var(--radius-card);
    padding: 16px;
    align-items: center;
}
.vs__tag { font-size: 19px; color: var(--color-muted); letter-spacing: 2px; }
.vs__teams { flex-direction: row; align-items: center; margin: 10px 0 6px 0; }
.vs__team { font-size: 26px; margin: 0 10px; }
.vs__x { color: var(--color-muted); margin: 0 6px; }
.vs__info { font-size: 20px; color: var(--color-muted); }
.winbar { width: 100%; margin-top: 12px; }
.winbar__lbl { flex-direction: row; justify-content: space-between; font-size: 19px; color: var(--color-muted); margin-bottom: 4px; }
.bar {
    height: 10px;
    background-color: var(--color-panel-deep);
    border-radius: 0;
    border-width: 1px;
    border-color: var(--color-line);
    overflow: hidden;
}
.bar__fill { height: 100%; background-color: var(--sky); }
.note { font-size: 20px; color: var(--color-muted); margin-top: 10px; white-space: normal; }

/* ===== 部の状態 ===== */
.stats { flex-direction: row; }
.stat {
    flex-grow: 1;
    background-color: var(--color-panel-deep);
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: var(--radius-card);
    padding: 9px 6px;
    margin: 0 3px;
    align-items: center;
}
.stat__k { font-size: 18px; color: var(--color-muted); letter-spacing: 1px; }
.stat__v { font-size: 30px; margin-top: 2px; }
.stat__v--warn { color: var(--color-warn); }

/* ===== 通知フィード ===== */
.feed__item {
    background-color: var(--color-panel-deep);
    border-width: 1px;
    border-color: var(--color-line);
    border-left-width: 3px;
    border-radius: var(--radius-chip);
    padding: 8px 12px;
    margin-bottom: 6px;
}
.feed__item--up { border-left-color: var(--sky); }
.feed__item--warn { border-left-color: var(--color-warn); }
.feed__when { font-size: 18px; color: var(--color-muted); margin-bottom: 2px; }
.feed__text { font-size: 21px; }

/* ===== 練習計画 ===== */
.days { flex-direction: row; flex-wrap: wrap; }
.day {
    flex-grow: 1;
    background-color: var(--color-panel-deep);
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: var(--radius-card);
    padding: 8px 6px;
    margin: 0 3px 6px 3px;
    align-items: center;
    min-width: 56px;
}
.day__d { font-size: 19px; color: var(--color-muted); letter-spacing: 1px; }
.day__m { font-size: 21px; margin-top: 3px; }
.day--rest .day__m { color: var(--color-muted); }
.day--match { border-color: var(--sky); }
.day--match .day__m { color: var(--sky); }

/* ===== 注目選手テーブル ===== */
.row {
    flex-direction: row;
    align-items: center;
    padding: 9px 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-line-soft);
}
.row--head { border-bottom-color: var(--color-line); }
.cell { flex-grow: 1; flex-basis: 0; font-size: 21px; }
.cell--head { font-size: 18px; color: var(--color-muted); letter-spacing: 1px; }

/* ===== 等級チップ（S〜G 共通カラー, 色覚対応で文字併記） ===== */
/* 等級チップはパワプロ風レター画像（components.uss .rank-chip と同方式のミラー）。
   文字は画像に焼き込み済み。Label テキストはレイアウト幅のために残し透明化する。
   塗り色（バー・レーダー等）は tokens.uss --rank-* ＝画像から抽出した代表色（RankPalette.cs と3面同期）。 */
.grade {
    min-width: 28px;
    height: 30px;
    -unity-text-align: middle-center;
    font-size: 20px;
    padding: 2px 5px;
    margin-right: 5px;
    color: rgba(0, 0, 0, 0);
    background-size: contain;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
}
.grade--S { background-image: url("project:///Assets/UI/Images/ranks/rank-S.png"); }
.grade--A { background-image: url("project:///Assets/UI/Images/ranks/rank-A.png"); }
.grade--B { background-image: url("project:///Assets/UI/Images/ranks/rank-B.png"); }
.grade--C { background-image: url("project:///Assets/UI/Images/ranks/rank-C.png"); }
.grade--D { background-image: url("project:///Assets/UI/Images/ranks/rank-D.png"); }
.grade--E { background-image: url("project:///Assets/UI/Images/ranks/rank-E.png"); }
.grade--F { background-image: url("project:///Assets/UI/Images/ranks/rank-F.png"); }
.grade--G { background-image: url("project:///Assets/UI/Images/ranks/rank-G.png"); }

/* ===== 選手一覧（単一カラム／ツールバー／列幅） ===== */
.col-full { flex-grow: 1; flex-basis: 100%; }
.toolbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}
.toolbar .panel__title { margin-bottom: 0; }
.toolbar__ctrls { flex-direction: row; align-items: center; }
.toolbar__counts { color: var(--color-muted); font-size: 20px; margin-right: 14px; letter-spacing: 1px; }
.chip-btn {
    background-color: var(--color-panel-deep);
    color: var(--color-chalk);
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: var(--radius-card);
    font-size: 20px;
    letter-spacing: 1px;
    padding: 7px 14px;
    margin-left: 8px;
}
.chip-btn:hover { border-color: var(--sky); color: var(--sky); }

/* 列幅（.cell の等幅を上書き。基底の後に置き同特異度で勝つ） */
.cell--name { flex-grow: 2.2; }
.cell--wide { flex-grow: 3.2; }
.cell--narrow { flex-grow: 0.8; }
.cell--warn { color: var(--color-warn); }   /* 怪我など本当の警告だけ（調子色 .cond--* を借りない） */

/* ===== 練習計画 ===== */
.day__e { font-size: 18px; color: var(--color-muted); margin-top: 3px; -unity-text-align: middle-center; white-space: normal; }
.day--edit { }
.day--edit:hover { border-color: var(--sky); }
.chip-btn--hard { border-color: var(--color-warn); color: var(--color-warn); }
.chip-btn--light { border-color: var(--color-good); color: var(--color-good); }
/* 選択中はホバーでも白文字のまま（.chip-btn:hover は特異度が上で、青地に青文字になっていた・issue #1529） */
.chip-btn--on, .chip-btn--on:hover { background-color: var(--sky); color: var(--color-on-fill); border-color: var(--sky); }

.eff-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 7px 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-line-soft);
}
.eff-row__k { font-size: 21px; }
.eff-row__v { font-size: 22px; color: #B9D45A; }
.eff-foot {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 10px;
    padding: 8px 4px 0 4px;
}
.eff-foot__k { font-size: 18px; color: var(--color-muted); letter-spacing: 1px; }
.eff-foot__v { font-size: 24px; color: var(--ink); }

.coach-row { flex-direction: row; }
.coach-slot {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: var(--color-panel-deep);
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: var(--radius-card);
    padding: 14px;
    margin: 0 4px;
}
.coach-slot__t { font-size: 20px; color: var(--color-faint); letter-spacing: 1px; }

/* 部員別 練習割当テーブル */
.cell--menu { flex-grow: 1.3; }
.cell--mid { flex-grow: 1.6; font-size: 20px; color: var(--color-muted); }
.menu-chip {
    background-color: var(--color-panel-deep);
    color: var(--color-chalk);
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: var(--radius-chip);
    font-size: 20px;
    -unity-text-align: middle-center;
    padding: 6px 12px;
}
.menu-chip:hover { border-color: var(--sky); color: var(--sky); }
.menu-chip--rest { background-color: var(--color-panel-deep); color: var(--color-muted); border-color: var(--color-line); }
.menu-chip--locked { background-color: var(--color-field); color: var(--color-faint); border-color: var(--color-line); }
.menu-chip--locked:hover { border-color: var(--color-line); color: var(--color-faint); }

/* 選択行のハイライト */
.row--selected { background-color: var(--sakura-tint); border-left-width: 3px; border-left-color: var(--ink); }

/* 分配分エディタ（選択選手のメニュー別 分） */
.edit-slot {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: var(--color-panel-deep);
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: var(--radius-card);
    padding: 8px 10px;
    margin: 4px;
    min-width: 150px;
}
.edit-slot__name { font-size: 20px; color: var(--color-chalk); flex-grow: 1; }
.edit-slot__min { font-size: 20px; color: var(--color-muted); -unity-text-align: middle-center; min-width: 48px; }
.edit-slot__btn {
    background-color: var(--color-panel-deep);
    color: var(--color-chalk);
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: var(--radius-chip);
    font-size: 22px;
    width: 32px;
    padding: 2px;
}
.edit-slot__btn:hover { border-color: var(--sky); color: var(--sky); }
.coach-row { flex-direction: row; flex-wrap: wrap; }
.proj--up { color: #B9D45A; }
.proj--none { color: var(--color-faint); }
.fat--warn { color: var(--color-warn); }

/* ===== 試合（高速モード） ===== */
.play-btn { margin-left: 0; margin-top: 14px; }
.result-banner { font-size: 25px; -unity-text-align: middle-center; margin-bottom: 6px; }
.result-banner--win { color: var(--color-lamp); }
.result-banner--lose { color: var(--color-warn); }
.result-banner--draw { color: var(--color-muted); }

.match-top { align-items: center; }
.match-winbar { max-width: 460px; margin-top: 14px; }

.scoreboard { flex-direction: column; align-items: center; margin-top: 6px; }
.sb-row { flex-direction: row; align-items: center; }
.sb-cell {
    width: 34px;
    height: 34px;
    -unity-text-align: middle-center;
    font-size: 21px;
    border-width: 1px;
    border-color: var(--color-line-soft);
    background-color: var(--color-panel-deep);
}
.sb-cell--team {
    width: 120px;
    -unity-text-align: middle-left;
    padding-left: 10px;
    background-color: var(--color-panel);
}
.sb-cell--rhe { background-color: var(--color-field); }
.sb-head { color: var(--color-muted); font-size: 19px; background-color: var(--color-panel); }
.sb-cell--lead { color: var(--color-lamp); }

/* ===== 出場成績テーブル（打撃・投手） ===== */
.stat-sub { font-size: 19px; color: var(--ink); margin: 8px 0 4px 2px; letter-spacing: 1px; }
.st-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-line-soft);
}
.st-row--head { border-bottom-color: var(--color-line); }
.st-cell { -unity-text-align: middle-center; font-size: 20px; }
.st-cell--head { font-size: 18px; color: var(--color-muted); }
.st-ord { width: 34px; color: var(--color-muted); }
.st-pos { width: 34px; }
.st-name { flex-grow: 1; flex-basis: 0; -unity-text-align: middle-left; padding-left: 6px; min-width: 90px; }
.st-num { width: 44px; }
.st-ip { width: 60px; }
.st-num--hi { color: #B9D45A; }

.mfeed { padding: 5px 4px; border-bottom-width: 1px; border-bottom-color: var(--color-line-soft); }
.mfeed--header { color: var(--ink); font-size: 19px; margin-top: 8px; letter-spacing: 1px; }
.mfeed--hit { color: var(--color-chalk); font-size: 20px; }
.mfeed--run { color: #B9D45A; font-size: 21px; }


/* ===== 大会プレビュー（設計書06 §3.5b, mock-tournament-preview.html） ===== */
.tp-masthead {
    border-bottom-width: 3px; border-bottom-color: var(--color-line);
    padding-bottom: 12px; margin-bottom: 16px;
}
/* 大会名は 32px 超の大見出しなので明朝 Bold（.f-display-lg）。設計書16 §2 の書体表どおり。
   疑似ボールド（-unity-font-style: bold）は使わない＝実ウェイトで出す。 */
.tp-title {
    font-size: 34px; letter-spacing: 2px; color: var(--color-chalk);
    margin-top: var(--sp-1); margin-bottom: var(--sp-2); white-space: normal;
}
.tp-meta { font-size: 18px; color: var(--color-muted); white-space: normal; }

/* チームの勢い（issue #863）: 校名＋「勢い」ラベル＋升目（部品辞書 LevelPips）を1行に並べる。
   数字は出さない（升目の有無だけ＝UI原則③⑥）。相手校は常に0なので出さない＝自校だけの行。 */
.tp-momentum {
    flex-direction: row; align-items: center;
    margin-top: var(--sp-2);
}
.tp-momentum__name { font-size: 18px; color: var(--color-chalk); margin-right: var(--sp-2); }
.tp-momentum__label { font-size: 16px; color: var(--color-muted); margin-right: var(--sp-2); }

/* リード文は「読み物」だが本文であることに変わりはないのでサンセリフ（明朝は見出し・固有名詞のみ）。
   疑似イタリックは実イタリックが無く斜体変形になるため廃止した（design-16 §2）。 */
.tp-lead {
    background-color: var(--sf-card); border-width: 0;
    border-radius: var(--radius-card);
    padding: 14px 16px; font-size: 20px; color: var(--color-chalk);
    white-space: normal; margin-bottom: var(--sp-1);
}
/* 節見出し（新聞の柱見出し）。縦罫は白に落としアンバーを使わない
   ＝1画面に何本も出るものをアクセントにすると希少性が壊れる（UI原則②）。 */
.tp-h2 {
    font-size: 24px; letter-spacing: 2px; color: var(--color-chalk);
    border-left-width: 3px; border-left-color: var(--color-muted); padding-left: 11px;
    margin-top: 22px; margin-bottom: 12px;
}

/* 地区予選のブロックリーグ戦（issue #772・A案）: 左＝自校ブロックの順位表＋日程、右＝他ブロックの小さな順位表。 */
.lg-wrap { flex-direction: row; align-items: flex-start; }
.lg-main { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: var(--sp-4); }
.lg-side { width: var(--col-league-side); flex-shrink: 0; }
.lg-sec { margin-top: var(--sp-3); }

/* 出場校カード。枠線ではなく面の明度で区切る（UI原則④）。角丸はカードトークンに従う。 */
.tp-team {
    flex-direction: row; background-color: var(--sf-card); border-width: 0;
    border-radius: var(--radius-card); padding: 12px 14px; margin-bottom: 9px;
}
/* 優勝候補だけは左端の太罫（新聞の柱）で示す。全周アンバー枠は面を飾りすぎるのでやめた。 */
.tp-team--fav { border-left-width: 3px; border-left-color: var(--sky); }

/* 幅は「優勝候補」（4字＋字送り）が収まる実測値。64px だと右へはみ出して寸評に重なる
   （実機で確認）。flex-shrink:0 が無いと本文側の伸長で潰れてやはり重なる。 */
.tp-mark { width: 80px; flex-shrink: 0; align-items: center; justify-content: flex-start; }
.tp-mark__sym { font-size: 34px; }
.tp-mark__sym--fav { color: var(--sky); }
.tp-mark__sym--cont { color: var(--color-chalk); }
.tp-mark__sym--dark { color: var(--color-warn); }
.tp-mark__label {
    font-size: var(--fs-cap); letter-spacing: 1px; color: var(--color-muted); margin-top: 2px;
    white-space: nowrap; -unity-text-align: middle-center;
}

.tp-body { flex-grow: 1; }
.tp-team-sub { flex-direction: row; align-items: center; flex-wrap: wrap; }
.tp-team-name { font-size: 22px; color: var(--color-chalk); }
.tp-team-sub__rank { margin-left: 8px; }
.tp-seed { font-size: var(--fs-label); color: var(--color-muted); margin-left: 8px; }
/* 試合結果のスコア。校名（明朝）と混ぜず独立 Label にしてコンデンス数字を当てる。 */
.tp-mscore {
    font-size: 22px; color: var(--color-chalk);
    margin-left: var(--sp-3); margin-right: var(--sp-3);
    letter-spacing: 1px;
}
.tp-blurb { font-size: 19px; color: var(--color-chalk); white-space: normal; margin-top: 5px; margin-bottom: 9px; }

.tp-bars { flex-direction: row; }
.tp-bar { flex-grow: 1; margin-right: 14px; }
.tp-bar__top { flex-direction: row; justify-content: space-between; margin-bottom: 3px; }
.tp-bar__label { font-size: var(--fs-label); color: var(--color-muted); }
/* 数値はコンデンス（.f-num を C# 側で付与）。桁が揃うよう右寄せにする（UI原則③）。 */
.tp-bar__val { font-size: var(--fs-num); color: var(--color-chalk); -unity-text-align: middle-right; }
/* 丸端バー → 角端（design-16 §5）。トラックの枠線も落とし、面の明度差だけで示す。 */
.tp-track { height: 6px; background-color: var(--sf-inset); border-radius: 0; border-width: 0; }
.tp-fill { height: 100%; background-color: var(--sky); border-radius: 0; }
.tp-fill--def { background-color: var(--color-good); }

/* ── 大会展望：追加部品（トークン参照。UI-BUILD-METHOD Step 2「辞書に足してから使う」） ──
   ビュー切替（トーナメント⇄展望）・空状態・注目選手カード・登録メンバー表。 */

/* 主要操作は1画面1つ・大きく（UI原則7）。展望への唯一の入口。 */
.tp-cta-wrap { align-items: center; margin-top: var(--sp-4); margin-bottom: var(--sp-4); flex-shrink: 0; }
/* 既定テーマの .unity-button と同順位で当たるため、型＋クラスで特異度を上げて確実に勝たせる。 */
Button.tp-cta {
    background-color: var(--color-cta); color: #FFFFFF;
    font-size: var(--fs-page); letter-spacing: 1px;
    border-width: 0; border-radius: var(--radius-card);
    padding: var(--sp-3) 40px; min-width: 320px; margin: 0;
}
Button.tp-cta:hover { background-color: var(--color-cta-hi); }

/* 戻る導線は控えめ（アクセントを CTA に集中させる）。 */
Button.tp-back {
    align-self: flex-start; background-color: var(--sf-inset); color: var(--tx-2);
    font-size: var(--fs-label); border-width: 0; border-radius: var(--radius-chip);
    padding: var(--sp-1) var(--sp-3); margin: 0 0 var(--sp-3) 0;
}
Button.tp-back:hover { background-color: var(--sf-hover); color: var(--tx-1); }
/* 戻る＋HTMLで開く を1行に並べる（どちらも控えめなサブ操作＝CTA は増やさない）。 */
.tp-subrow { flex-direction: row; align-items: center; flex-shrink: 0; }
Button.tp-subrow__next { margin-left: var(--sp-2); }   /* Button.tp-back の margin:0 に勝つため型＋クラス */

/* 次戦カード（トーナメントビューの要点）。 */
.tp-next {
    background-color: var(--sf-card); border-radius: var(--radius-card);
    padding: var(--sp-3) var(--sp-4); margin-bottom: var(--sp-3);
    font-size: var(--fs-body); color: var(--tx-1); white-space: normal;
}

/* 補助注記（該当なし・表示件数の打ち切りなど）。 */
.tp-note { font-size: var(--fs-label); color: var(--tx-2); padding: var(--sp-2) var(--sp-1); white-space: normal; }

/* 非大会時の空状態。 */
.tp-empty { align-items: center; padding-top: 80px; padding-bottom: 80px; }
.tp-empty__title { font-size: var(--fs-page); color: var(--tx-1); }

/* 注目選手：2列（USSは grid 非対応のため flex-wrap ＋ 幅%で段組み）。 */
.tp-players { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.tp-pcard {
    width: 49%; background-color: var(--sf-card); border-radius: var(--radius-card);
    padding: var(--sp-3) var(--sp-3); margin-bottom: var(--sp-2);
}
.tp-pcard__top { flex-direction: row; align-items: center; margin-bottom: var(--sp-2); }
/* 背番号バッジ：中立の小片面（issue #379）。旧「投手＝アンバー／野手＝グリーン」は廃止した。
   塗り分けの実体は選手の属性ではなく「その校の看板が投手か打線か」で、投打の別は成績行
   （防御率 vs 打率）と守備位置ラベルで既に読める。対抗校ぶん4〜6枚並ぶのでアンバーの
   撒き過ぎでもあった（UI原則②＝アクセントは1画面3箇所まで）。 */
.tp-pcard__no {
    width: 32px; height: 32px; border-radius: var(--radius-card); flex-shrink: 0;
    background-color: var(--color-panel-deep); color: var(--color-chalk);
    font-size: var(--fs-num); -unity-text-align: middle-center;
}
.tp-pcard__nm { font-size: var(--fs-body); color: var(--tx-1); margin-left: var(--sp-2); }
.tp-pcard__sub { font-size: var(--fs-cap); color: var(--tx-2); margin-left: var(--sp-2); }
.tp-pcard__stat { font-size: var(--fs-label); color: var(--ink); margin-bottom: var(--sp-1); white-space: normal; }
.tp-pcard__blurb { font-size: var(--fs-label); color: var(--tx-1); white-space: normal; }

/* ── 出場校（甲子園の展望）: 左＝49代表の名簿／右＝選んだ1校 ────────────
   ブロック自体は固定高で、中の2ペインが独立にスクロールする（ページのスクロールに
   49行が埋もれると「選んだ校の詳細」が画面外へ出てしまうため）。
   区切りは面の明度差だけ（UI原則④）。表は登録メンバー表と同じ語彙で組む。 */
.tp-ent-split {
    flex-direction: row; height: var(--tp-ent-h); flex-shrink: 0; margin-bottom: var(--sp-3);
}
.tp-ent-split__left {
    width: 40%; flex-shrink: 0; background-color: var(--sf-card);
    border-radius: var(--radius-card); overflow: hidden;
}
.tp-ent-split__right {
    flex-grow: 1; flex-basis: 0; min-width: 0; margin-left: var(--sp-3);
    background-color: var(--sf-card); border-radius: var(--radius-card);
    padding: var(--sp-3) var(--sp-4);
}
/* 左ペインの見出しはスクロールの外（列名を常に見せる）。 */
.tp-eth {
    flex-direction: row; align-items: center; height: var(--h-thead); flex-shrink: 0;
    padding-left: var(--sp-4); padding-right: var(--sp-4);
    border-bottom-width: 1px; border-bottom-color: var(--divider);
}
.tp-eth Label { font-size: var(--fs-th); color: var(--tx-2); margin: 0; }
.tp-ent-scroll { flex-grow: 1; min-height: 0; }

.tp-erow {
    flex-direction: row; align-items: center; min-height: 32px; flex-shrink: 0;
    padding-left: var(--sp-4); padding-right: var(--sp-4);
    border-bottom-width: 1px; border-bottom-color: var(--color-line-soft);
}
.tp-erow Label { font-size: var(--fs-label); color: var(--tx-1); margin: 0; }
.tp-erow:hover { background-color: var(--sf-hover); }
/* 選択中・自校は「面」で示す（線を足さない・UI原則④）。自校は一段濃い面で常に見つけられる。 */
.tp-erow--selected { background-color: var(--sf-inset); }
.tp-erow--own .tp-ec--name { color: var(--sky); }

.tp-ec--pref { width: var(--col-ent-pref); flex-shrink: 0; color: var(--tx-2); }
.tp-ec--name { flex-grow: 1; flex-basis: 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tp-ec--rank { width: var(--col-ent-rank); flex-shrink: 0; flex-direction: row; justify-content: center; }
.tp-ec--app { width: var(--col-ent-app); flex-shrink: 0; -unity-text-align: middle-right; color: var(--tx-2); }

/* 右ペイン（選んだ1校）。見出し・寸評は展望カードと同じ語彙・同じ物差しで出す。 */
.tp-ed-name { font-size: 24px; color: var(--tx-1); margin-bottom: var(--sp-1); }
.tp-ed-tag { font-size: var(--fs-label); color: var(--tx-2); margin-bottom: var(--sp-2); }
.tp-ed-blurb { font-size: var(--fs-label); color: var(--tx-1); white-space: normal; margin-bottom: var(--sp-3); }
/* 成績スコープの切替（県予選／甲子園）。部品辞書の SegTabs をそのまま置く器。 */
.tp-ed-tabs { margin-top: var(--sp-3); margin-bottom: var(--sp-2); flex-shrink: 0; }

/* 登録メンバー：背番号順の表を収める枠（校別詳細ページ, issue #189）。 */
.tp-roster {
    background-color: var(--sf-card); border-radius: var(--radius-card);
    margin-bottom: var(--sp-3); overflow: hidden;
}

/* 表：見出しとデータが同一の列幅トークンを参照する（横ずれの構造対策）。行高32px基準（UI原則1）。 */
.tp-mth {
    flex-direction: row; align-items: center; height: var(--h-thead);
    padding-left: var(--sp-4); padding-right: var(--sp-4); margin-top: var(--sp-2);
    border-bottom-width: 1px; border-bottom-color: var(--divider);
}
.tp-mrow {
    flex-direction: row; align-items: center; min-height: 32px;
    padding-left: var(--sp-4); padding-right: var(--sp-4);
    border-bottom-width: 1px; border-bottom-color: var(--color-line-soft);
}
/* 既定Labelの margin だけ落とす（padding はセル側で列ごとに指定するので潰さない）。 */
.tp-mth Label { font-size: var(--fs-th); color: var(--tx-2); margin: 0; }
.tp-mrow Label { font-size: var(--fs-label); color: var(--tx-1); margin: 0; }
.tp-mc--no { width: var(--col-mem-no); flex-shrink: 0; -unity-text-align: middle-right; padding-right: var(--sp-3); }
.tp-mc--name { flex-grow: 1; flex-basis: 0; min-width: 0; padding-left: var(--sp-4); }
.tp-mc--grade { width: var(--col-mem-grade); flex-shrink: 0; -unity-text-align: middle-right; }
.tp-mc--hand { width: var(--col-mem-hand); flex-shrink: 0; -unity-text-align: middle-right; }
/* 今大会成績（issue #634）。数字は右揃え・桁揃え（UI原則③）。見出しと同じ幅トークンを参照する。 */
.tp-mc--st {
    width: var(--col-mem-stat); flex-shrink: 0; -unity-text-align: middle-right;
    padding-left: var(--sp-2);
}
/* 背番号だけアンバー（モックの td.n 相当）。数値は右揃え・装飾なし。 */
.tp-mrow .tp-mc--no { color: var(--ink); }
.tp-mrow .tp-mc--hand { color: var(--tx-2); }

/* ===== トーナメント表（新聞型・issue #645） =====
   校名は1回戦の端にだけ置き、2回戦以降は線だけ（勝った側＝太線）。線は NewspaperBracketElement が
   Painter2D で描き、校名・スコアはその座標へ絶対配置する。 */
.brk-scroll {
    height: var(--brk-view-h); flex-shrink: 0;
    background-color: var(--sf-card); border-radius: var(--radius-card);
    /* 上は0：段名帯が上端に貼り付くので、余白があると帯の上に中身の端が覗く。 */
    padding: 0 var(--sp-3) var(--sp-2) var(--sp-3); margin-bottom: var(--sp-2);
}
.brk-tree { flex-direction: row; align-items: flex-start; padding-top: var(--h-thead); }
.brk-paper { flex-shrink: 0; }

/* ラウンド名の帯（樹形図の上に浮かせて縦スクロールに追従＝段名を常に見せる）。 */
.brk-head {
    position: absolute; left: 0; top: 0; flex-direction: row;
    height: var(--h-thead); background-color: var(--sf-card);
}
.brk-head__row { height: var(--h-thead); flex-shrink: 0; }
.brk-col__name {
    height: var(--h-thead); margin: 0; padding: 0;
    font-size: var(--fs-th); color: var(--tx-2); -unity-text-align: middle-center;
}

/* 1回戦の端の校名。左ブロックは線へ向けて右寄せ、右ブロックは左寄せ。 */
.brk-leaf {
    position: absolute; margin: 0; padding: 0;
    font-size: var(--fs-label); color: var(--tx-1);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.brk-leaf--left { -unity-text-align: middle-right; }
.brk-leaf--right { -unity-text-align: middle-left; }
.brk-leaf--out { color: var(--tx-3); }
.brk-leaf--fav { color: var(--sky); }
/* 校別詳細へ遷移できる（issue #189）。新規装飾は増やさず、hover だけ既存アクセントで示す。 */
.brk-leaf:hover { color: var(--sky); }

/* 試合の線の脇のスコア（数字＋コールド印を1行に並べる器）。 */
.brk-scorebox { position: absolute; flex-direction: row; align-items: center; }
.brk-score { margin: 0; padding: 0; font-size: var(--fs-label); color: var(--tx-1); }
.brk-score--out { color: var(--tx-3); }
.brk-score--fav { color: var(--sky); }
/* コールドゲームの印（設計書05 §1.3, Q18）。 */
.brk-mercy { margin: 0 0 0 2px; padding: 0; font-size: var(--fs-cap); color: var(--tx-2); }

/* 優勝欄（決勝の合流点から上へ伸びた線の先）。優勝校が決まるまで名前は出さない。 */
.brk-champ {
    position: absolute; flex-direction: row; align-items: center; justify-content: center;
}
.brk-champ__cap { font-size: var(--fs-cap); color: var(--tx-2); margin: 0 var(--sp-2) 0 0; padding: 0; }
.brk-champ__name {
    font-size: var(--fs-label); color: var(--tx-1); margin: 0; padding: 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.brk-champ__name--fav { color: var(--sky); }

/* ================================================================ */
/* ホーム ダッシュボード v2（mock-ui-v2-dashboard.html） */
/* ================================================================ */

/* --- スコアボードヘッダー --- */
.sb2 { flex-direction: row; align-items: stretch; background-color: var(--color-strip); border-bottom-width: 1px; border-bottom-color: var(--color-line); flex-shrink: 0; }
.sb2-left { flex-direction: row; align-items: center; padding: 10px 20px; border-right-width: 1px; border-right-color: var(--color-line); }
.sb2-badge { width: 46px; height: 46px; border-width: 0; border-radius: var(--radius-card); background-color: var(--color-panel-deep); color: var(--color-chalk); font-size: 24px; -unity-text-align: middle-center; margin-right: 14px; }
.sb2-id { margin-right: 18px; }
.sb2-name { font-size: 26px; letter-spacing: 1px; color: var(--color-chalk); }
.sb2-pref { font-size: var(--fs-cap); color: var(--color-muted); letter-spacing: 2px; margin-top: 2px; }
.sb2-rank { align-items: center; padding-left: 16px; border-left-width: 1px; border-left-color: var(--color-line); }
.sb2-rank__k { font-size: var(--fs-cap); color: var(--color-muted); letter-spacing: 2px; }
.sb2-rank__row { flex-direction: row; align-items: center; margin-top: 5px; }
.sb2-rank__t { font-size: var(--fs-label); color: var(--color-chalk); margin-left: 6px; }

.sb2-center { flex-grow: 1; flex-direction: row; align-items: center; justify-content: center; }
.sb2-cell { align-items: center; }
.sb2-cell__k { font-size: var(--fs-cap); color: var(--color-muted); letter-spacing: 2px; }
.sb2-cell__v { font-size: 24px; color: var(--color-chalk); letter-spacing: 1px; margin-top: 2px; }
.sb2-cell__v--amber { color: var(--color-lamp); }
.sb2-div { width: 1px; height: 38px; background-color: var(--color-line); margin: 0 34px; }

.sb2-right { flex-direction: row; align-items: center; padding: 0 18px; border-left-width: 1px; border-left-color: var(--color-line); }
.sb2-meter { align-items: center; margin-right: 22px; }
.sb2-meter__k { font-size: var(--fs-cap); color: var(--color-muted); letter-spacing: 1px; }
.sb2-meter__v { font-size: 24px; color: var(--color-chalk); margin-top: 2px; }

/* --- 3カラム本体（外側スクロールなし・内部スクロール） --- */
.dash { flex-grow: 1; flex-direction: row; padding: 14px; overflow: hidden; }
/* min-height:0 が無いと、カード内 ScrollView の**中身の高さ**が列の最小高になり、
   列が縮めない＝本文域が要求する高さが青天井になる（トップバーが潰される。下の .topbar-slot 参照）。 */
.dash-col { flex-direction: column; overflow: hidden; min-height: 0; }
.dash-col--a { width: 440px; flex-shrink: 0; margin-right: 14px; }
.dash-col--b { flex-grow: 1; margin-right: 14px; }
.dash-col--c { width: 372px; flex-shrink: 0; }

/* --- カード（ヘッダーバー付きパネル） --- */
/* カード：枠線を廃し明度(面色)で区切る・角丸12・余白拡大（リファイン） */
/* flex-shrink の既定は 1 なので、付けないとカラムが詰まったとき固定高カードが黙って潰れ、
   中身が overflow:hidden で切れる（UI-BUILD-METHOD「固定高セクションは flex-shrink:0」）。
   伸縮を担うのは .card--grow だけにする。 */
/* design-19 フルNB：カード＝インク枠＋ベタ影（案イ＝右下だけ太らせる単一要素）＋塗り見出し帯。
   overflow:hidden で見出し帯を枠内にクリップ（角丸0）。右下の太枠がオフセット影に見える。 */
.card { background-color: var(--sf-card); border-color: var(--ink); border-top-width: var(--nb-border-card); border-left-width: var(--nb-border-card); border-right-width: var(--nb-card-edge); border-bottom-width: var(--nb-card-edge); border-radius: 0; margin-bottom: 16px; overflow: hidden; flex-shrink: 0; }
/* flex-grow だけだと中身（ScrollView）の希望高でカードが膨らみ、同じカラムの後続カードを
   はみ出させる（.dash-col は overflow:hidden なので押し出された分は切れる）。
   UI Toolkit(Yoga) は flex-shrink の既定が 0 なので、明示的に 1 と min-height:0 を与えて
   内容より小さく縮めるようにし、あふれはカード内スクロールで受ける。 */
.card--grow { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.card__scroll { min-height: 0; }
.card__hd { flex-direction: row; align-items: center; justify-content: space-between; padding: 12px 16px; flex-shrink: 0; background-color: var(--grass); border-bottom-width: var(--nb-border-card); border-bottom-color: var(--ink); }
.card__hd-title { font-size: 20px; letter-spacing: 1px; color: #FFFFFF; }
.card__hd-sub { font-size: var(--fs-cap); color: #FFFFFF; opacity: 0.82; letter-spacing: 1px; }
.card__body { padding: 6px 16px 16px 16px; }
/* flex-shrink の既定は UI Toolkit では 0。ScrollView に付けないと「中身の高さのまま」居座り、
   カードからあふれてスクロールバーも出ない（＝12件のフィードが 1,349px を要求して画面を押し広げる。
   実測 2026-08-14）。縮められるようにして初めて「はみ出しはスクロールで受ける」が成立する。 */
.card__scroll { flex-grow: 1; flex-shrink: 1; }
/* ── 横並びカードの寸法（左右に並べる時。列間は margin-right で作る）───────────
   旧 pd2-card--half/--grow/--radar/--hidden/--pitch を .card に統合（部品一本化・design-19）。
   縦積み(margin-bottom)と横並び(margin-right)が両立するよう、横並びは modifier で右余白を持つ。 */
.card--half   { flex-grow: 1; flex-basis: 0; margin-right: 14px; }   /* 等幅で伸縮 */
.card--col    { flex-grow: 1; flex-basis: 0; margin-right: 14px; }   /* 等幅列（旧 pd2-card--grow） */
.card--radar  { width: 318px; margin-right: 14px; }                  /* レーダー固定幅 */
.card--hidden { width: 338px; margin-right: 14px; }                  /* 隠しパラメータ固定幅 */
/* 内部に ScrollView を持つカードで本文を伸ばす（旧 pm-card__body の flex-grow を担う）。 */
.card__body--fill { flex-grow: 1; min-height: 0; }
/* 見出し帯の色替え（芝＝既定 / 土＝副 / 空＝操作）。plate-header と同じ役割語彙。 */
.card__hd--dirt { background-color: var(--dirt); }
.card__hd--dirt .card__hd-title { color: var(--ink); }
.card__hd--dirt .card__hd-sub { color: var(--ink); }
.card__hd--sky { background-color: var(--sky); }
/* 見出し帯の高さを詰める（1画面に複数のカードを縦積みする画面用。既定 72px → 60px）。
   題字・副題の書体と色はそのままで、上下の余白だけを落とす。 */
.card__hd--tight { padding-top: 6px; padding-bottom: 6px; }

/* ホームの本体は下の「ホーム（Home.*.mock 準拠）」の節。 */

/* 調子5段階の色（選手一覧・主将指名など全画面共通）。
   値の正は tokens.uss の --cond-*（この画面群は tokens.uss を読まないため写し。両者を必ず一致させること）。
   色分岐はC#側で Condition enum から行い、表示文字列で比較しない。 */
.cond--best { color: #E0605A; }    /* = --cond-best 絶好調（赤） */
.cond--good { color: #E8904A; }    /* = --cond-good 好調（橙） */
.cond--normal { color: #E3BD3C; }  /* = --cond-normal 普通（黄） */
.cond--bad { color: #7FA8D6; }     /* = --cond-bad 不調（水色） */
.cond--worst { color: #4F6FA8; }   /* = --cond-worst 絶不調（青） */

/* ═══ ホーム（Home.tournament.mock / Home.offseason.mock 準拠・1600×900基準） ═════════════
   地 #E7E2D7・カードは #FBFAF6 の角丸14（枠線なし）。主役のカード（スクールカラー地）の下に
   3列（372｜残り全部｜360・間隔16）。スクールカラーは SchoolAccent が acc-* の付いた要素へ流し込む。 */
.sbk.hm-root { background-color: var(--hm-ground); }
.hm-hero Label, .hm-dash Label { margin: 0; padding: 0; }

/* ── カード ── */
.hm-root .hm-card {
    background-color: var(--hm-card);
    border-width: 0;
    border-radius: 14px;
    padding: 18px 22px;
    margin-bottom: 16px;
    flex-shrink: 0;
}
.hm-root .hm-card--side { padding-left: 20px; padding-right: 20px; }
.hm-root .hm-card--grow { flex-grow: 1; flex-shrink: 1; min-height: 0; margin-bottom: 0; }
.hm-root .hm-card__hd { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; }
.hm-root .hm-card__hd-right { flex-direction: row; align-items: center; }
.hm-root .hm-card__title {
    font-size: 18px;
    letter-spacing: 1.4px;
    color: var(--hm-tx-1);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/ShipporiMinchoB1-ExtraBold.asset?fileID=11400000&guid=7f2420c220fb74dc88a61dafe12284b0&type=2#ShipporiMinchoB1-ExtraBold");
}
.hm-root .hm-card__title--sm { font-size: 16px; letter-spacing: 1.3px; }
.hm-root .hm-card__aside { font-size: 13px; color: var(--hm-tx-2); }

/* ── 主役のカード（高さ148・角丸14・左右32） ── */
.hm-root .hm-hero {
    flex-shrink: 0;
    height: 148px;
    margin: 18px 24px 0 24px;
    padding: 0 32px;
    border-width: 0;
    border-radius: 14px;
    overflow: hidden;
    background-color: #7A1F2B;
}
/* 右上の飾りの円（直径300・白6%の28px枠を半分はみ出させる） */
.hm-root .hm-hero__ring {
    position: absolute;
    right: -40px; top: -60px;
    width: 300px; height: 300px;
    border-width: 28px;
    border-color: var(--hm-on-accent-ring);
    border-radius: 150px;
}
.hm-root .hm-hero__state { flex-direction: row; align-items: center; flex-grow: 1; }
.hm-root .hm-hero__big {
    align-items: center;
    padding-right: 36px;
    margin-right: 36px;
    border-right-width: 1px;
    border-right-color: var(--hm-on-accent-rule);
    flex-shrink: 0;
}
.hm-root .hm-hero__big-k { font-size: 13px; color: var(--hm-on-accent-1); margin-bottom: 2px; }
.hm-root .hm-hero__big-row { flex-direction: row; align-items: flex-end; }
.hm-root .hm-hero__big-num {
    font-size: 72px;
    color: #FFFFFF;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/ShipporiMinchoB1-ExtraBold.asset?fileID=11400000&guid=7f2420c220fb74dc88a61dafe12284b0&type=2#ShipporiMinchoB1-ExtraBold");
}
.hm-root .hm-hero__big-unit {
    font-size: 20px;
    color: #FFFFFF;
    margin: 0 0 20px 4px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/NotoSansJP-Bold.asset?fileID=11400000&guid=0a6535b0156cd4b349a9c2b1c707ba43&type=2#NotoSansJP-Bold");
}
.hm-root .hm-hero__mid { flex-shrink: 1; min-width: 0; }
.hm-root .hm-hero__mid--grow { flex-grow: 1; }
.hm-root .hm-hero__row { flex-direction: row; align-items: center; }
.hm-root .hm-hero__row--teams { margin-top: 10px; }
.hm-root .hm-hero__tag {
    font-size: 17px;
    color: #FFFFFF;
    background-color: var(--hm-on-accent-chip);
    border-radius: 4px;
    padding: 2px 10px;
    margin-right: 12px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/NotoSansJP-Bold.asset?fileID=11400000&guid=0a6535b0156cd4b349a9c2b1c707ba43&type=2#NotoSansJP-Bold");
}
.hm-root .hm-hero__tname { font-size: 17px; color: rgba(255, 255, 255, 0.85); }
.hm-root .hm-hero__team {
    font-size: 36px;
    letter-spacing: 2.9px;
    color: #FFFFFF;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/ShipporiMinchoB1-ExtraBold.asset?fileID=11400000&guid=7f2420c220fb74dc88a61dafe12284b0&type=2#ShipporiMinchoB1-ExtraBold");
}
.hm-root .hm-hero__vs { font-size: 16px; color: var(--hm-on-accent-2); margin: 0 18px; }
.hm-root .hm-hero__rank { flex-direction: row; align-items: center; margin-left: 18px; }
.hm-root .hm-hero__rank-k { font-size: 13px; color: rgba(255, 255, 255, 0.8); margin-right: 6px; }
.hm-root .hm-hero__rank-chip .grade { width: 28px; height: 28px; min-width: 28px; margin: 0; }
.hm-root .hm-hero__side { flex-direction: row; align-items: center; margin-left: auto; flex-shrink: 0; }
.hm-root .hm-hero__fact { margin-left: 28px; }
.hm-root .hm-hero__fact-k { font-size: 12px; color: rgba(255, 255, 255, 0.75); margin-bottom: 4px; }
.hm-root .hm-hero__fact-v {
    font-size: 24px;
    color: #FFFFFF;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/ShipporiMinchoB1-ExtraBold.asset?fileID=11400000&guid=7f2420c220fb74dc88a61dafe12284b0&type=2#ShipporiMinchoB1-ExtraBold");
}
.hm-root .hm-hero__wx { flex-direction: row; align-items: center; height: 29px; }
.hm-root .hm-hero__weather-icon { width: 24px; height: 24px; margin-right: 8px; }
.hm-root .hm-hero__wx-num, .hm-root .hm-hero__wx-unit {
    font-size: 18px;
    color: #FFFFFF;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/NotoSansJP-Bold.asset?fileID=11400000&guid=0a6535b0156cd4b349a9c2b1c707ba43&type=2#NotoSansJP-Bold");
}
.hm-root .hm-hero__next {
    font-size: 28px;
    letter-spacing: 2.2px;
    color: #FFFFFF;
    margin-right: 14px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/ShipporiMinchoB1-ExtraBold.asset?fileID=11400000&guid=7f2420c220fb74dc88a61dafe12284b0&type=2#ShipporiMinchoB1-ExtraBold");
}
.hm-root .hm-hero__open { font-size: 14px; color: rgba(255, 255, 255, 0.8); padding-top: 8px; }

/* 週の目盛り：今週＝白・これから＝白22%・開幕＝白の2px枠。マスとラベルは同じ幅で並べる */
.hm-root .hm-ticks { flex-direction: row; margin-top: 12px; }
.hm-root .hm-ticks--labels { margin-top: 6px; }
.hm-root .hm-tick {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 10px;
    margin-right: 4px;
    border-radius: 3px;
    background-color: var(--hm-on-accent-tick);
}
.hm-root .hm-tick--last { margin-right: 0; }
.hm-root .hm-tick--now { background-color: #FFFFFF; }
.hm-root .hm-tick--open { background-color: rgba(0, 0, 0, 0); border-width: 2px; border-color: #FFFFFF; }
.hm-root .hm-tick-label {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 4px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.72);
    overflow: visible;
    white-space: nowrap;
}
.hm-root .hm-tick-label.hm-tick--last { margin-right: 0; }
.hm-root .hm-tick-label--strong { color: #FFFFFF; -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/NotoSansJP-Bold.asset?fileID=11400000&guid=0a6535b0156cd4b349a9c2b1c707ba43&type=2#NotoSansJP-Bold"); }

/* ── 3列 ── */
.hm-root .hm-dash { flex-grow: 1; flex-direction: row; padding: 16px 24px 20px 24px; min-height: 0; overflow: hidden; }
.hm-root .hm-col { flex-direction: column; min-height: 0; overflow: hidden; }
.hm-root .hm-col--a { width: 372px; flex-shrink: 0; margin-right: 16px; }
.hm-root .hm-col--b { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 16px; }
.hm-root .hm-col--c { width: 360px; flex-shrink: 0; }

/* チームランク：見出しの右に「総合」チップ（30角）＋数字（明朝30）。レーダーは 320×290 */
.hm-root .hm-overall__chip { margin-left: 8px; }
.hm-root .hm-overall__chip .grade { width: 30px; height: 30px; min-width: 30px; margin: 0; }
.hm-root .hm-overall__v {
    font-size: 30px;
    color: var(--hm-tx-1);
    margin-left: 8px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/ShipporiMinchoB1-ExtraBold.asset?fileID=11400000&guid=7f2420c220fb74dc88a61dafe12284b0&type=2#ShipporiMinchoB1-ExtraBold");
}
.hm-root .hm-radar-wrap { flex-grow: 1; align-items: center; justify-content: center; }
.hm-root .hm-radar {
    width: 320px;
    height: 290px;
    flex-shrink: 0;
    --radar-grid-inner: #E7E2D7;
    --radar-grid-outer: #D3CDC0;
}
.hm-root .hm-radar .radar-axis { align-items: center; }
.hm-root .hm-radar .radar-axis__l { font-size: 12px; color: var(--hm-tx-2); }
.hm-root .hm-radar .radar-axis__v {
    font-size: 20px;
    color: var(--hm-tx-1);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/NotoSansJP-Bold.asset?fileID=11400000&guid=0a6535b0156cd4b349a9c2b1c707ba43&type=2#NotoSansJP-Bold");
}

/* 故障者（0人のときは高さ56の1行。1人以上は今の一覧を下に出す） */
.hm-root .hm-card--inj { padding-top: 0; padding-bottom: 0; margin-bottom: 0; }
.hm-root .hm-inj-hd { flex-direction: row; align-items: center; justify-content: space-between; height: 56px; flex-shrink: 0; }
.hm-root .hm-count__n {
    font-size: 18px;
    color: var(--hm-tx-1);
    margin-right: 2px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/NotoSansJP-Bold.asset?fileID=11400000&guid=0a6535b0156cd4b349a9c2b1c707ba43&type=2#NotoSansJP-Bold");
}
.hm-root .hm-count__n--sm { font-size: 16px; margin: 0 3px; }
.hm-root .hm-count__u { font-size: 13px; color: var(--hm-tx-2); padding-top: 3px; }
.hm-root .hm-inj-scroll { max-height: 160px; flex-shrink: 1; margin-bottom: 12px; }
.hm-root .hm-inj { flex-direction: row; align-items: center; height: 32px; flex-shrink: 0; border-top-width: 1px; border-top-color: var(--hm-line); }
.hm-root .hm-inj__no { width: 28px; flex-shrink: 0; font-size: 12px; color: var(--hm-tx-3); -unity-text-align: middle-right; }
.hm-root .hm-inj__n { flex-grow: 1; flex-basis: 0; min-width: 0; font-size: 14px; color: var(--hm-tx-1); margin-left: 10px; overflow: hidden; }
.hm-root .hm-inj__st { width: 150px; flex-shrink: 0; font-size: 12px; color: var(--hm-tx-2); }
.hm-root .hm-inj__st--severe { color: var(--color-warn); }
.hm-root .hm-inj__bk { width: 64px; flex-shrink: 0; font-size: 12px; color: var(--hm-tx-2); -unity-text-align: middle-right; }

/* チーム成績：項目140｜通算・公式戦・今大会は残りを等分（数字は右寄せ・今大会だけ中央）。行34・行間に淡い線。
   モックの固定幅（96/96/120）のままだと1600幅の中の列では項目と数字の間が大きく空くので、列を伸ばして詰める */
.hm-root .hm-card--stats { padding-bottom: 12px; }
.hm-root .hm-card--stats-empty { height: 150px; }
.hm-root .hm-st-row { flex-direction: row; align-items: center; height: 34px; flex-shrink: 0; border-top-width: 1px; border-top-color: var(--hm-line); }
.hm-root .hm-st-row--head { height: 30px; border-top-width: 0; align-items: flex-end; }
.hm-root .hm-st-k { width: 140px; flex-shrink: 0; font-size: 16px; color: var(--hm-tx-label); }
.hm-root .hm-st-row--head .hm-st-k { align-self: center; font-size: 18px; color: var(--hm-tx-1); }
.hm-root .hm-card--stats-empty .hm-st-row--head .hm-st-k { flex-grow: 1; }
.hm-root .hm-st-c { flex-grow: 1; flex-basis: 0; min-width: 0; font-size: 20px; color: var(--hm-tx-3); -unity-text-align: middle-right; }
.hm-root .hm-st-c--off { padding-right: 28px; }
.hm-root .hm-st-c--th { font-size: 14px; color: var(--hm-tx-2); padding-bottom: 4px; }
.hm-root .hm-st-cur {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 100%;
    -unity-text-align: middle-center;
    font-size: 24px;
    color: var(--hm-tx-1);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/ShipporiMinchoB1-ExtraBold.asset?fileID=11400000&guid=7f2420c220fb74dc88a61dafe12284b0&type=2#ShipporiMinchoB1-ExtraBold");
}
.hm-root .hm-st-cur--th {
    height: auto;
    font-size: 14px;
    color: #FFFFFF;
    padding: 4px 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/NotoSansJP-Bold.asset?fileID=11400000&guid=0a6535b0156cd4b349a9c2b1c707ba43&type=2#NotoSansJP-Bold");
}

/* 記録がないときの案内（線画アイコン34＋2行） */
.hm-root .hm-empty { flex-grow: 1; flex-direction: row; align-items: center; justify-content: center; }
.hm-root .hm-empty__icon { width: 34px; height: 34px; margin-right: 14px; flex-shrink: 0; color: var(--hm-tx-4); }
.hm-root .hm-empty__icon .licon { width: 34px; height: 34px; }
.hm-root .hm-empty__t1 { font-size: 15px; color: var(--hm-tx-strong); margin-bottom: 2px; }
.hm-root .hm-empty__t2 { font-size: 13px; color: var(--hm-tx-2); }

/* チーム内ランキング：打撃・投手を左右に。各行は 部門64｜1位｜2位76（行44） */
.hm-root .hm-seg { flex-direction: row; padding: 3px; background-color: var(--hm-line); border-radius: 8px; }
.hm-root .hm-seg__btn {
    height: 26px;
    padding: 0 12px;
    margin: 0 0 0 2px;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    font-size: 12px;
    color: var(--hm-tx-2);
    -unity-text-align: middle-center;
}
.hm-root .hm-seg__btn--first { margin-left: 0; }
.hm-root .hm-seg__btn--on { background-color: #FFFFFF; color: var(--hm-tx-1); -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/NotoSansJP-Bold.asset?fileID=11400000&guid=0a6535b0156cd4b349a9c2b1c707ba43&type=2#NotoSansJP-Bold"); }
.hm-root .hm-rk { flex-direction: row; flex-grow: 1; min-height: 0; margin-top: 10px; }
.hm-root .hm-rk__col { flex-grow: 1; flex-basis: 0; min-width: 0; }
.hm-root .hm-rk__gap { width: 28px; flex-shrink: 0; }
.hm-root .hm-rk-row { flex-direction: row; align-items: center; height: 44px; flex-shrink: 0; border-bottom-width: 1px; border-bottom-color: var(--hm-line); }
.hm-root .hm-rk-row--head { height: 26px; border-bottom-width: 2px; border-bottom-color: var(--hm-tx-1); }
.hm-root .hm-rk-k { width: 64px; flex-shrink: 0; margin-right: 10px; font-size: 13px; color: var(--hm-tx-label); }
.hm-root .hm-rk-k--sec { font-size: 12px; color: var(--hm-tx-1); -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/NotoSansJP-Bold.asset?fileID=11400000&guid=0a6535b0156cd4b349a9c2b1c707ba43&type=2#NotoSansJP-Bold"); }
.hm-root .hm-rk-th { font-size: 12px; color: var(--hm-tx-2); }
.hm-root .hm-rk-th--r { -unity-text-align: middle-right; }
.hm-root .hm-rk-1 { flex-grow: 1; flex-basis: 0; min-width: 0; flex-direction: row; align-items: flex-end; margin-right: 10px; overflow: hidden; }
.hm-root .hm-rk-1__v {
    font-size: 20px;
    color: var(--hm-tx-1);
    margin-right: 10px;
    flex-shrink: 0;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/ShipporiMinchoB1-ExtraBold.asset?fileID=11400000&guid=7f2420c220fb74dc88a61dafe12284b0&type=2#ShipporiMinchoB1-ExtraBold");
}
.hm-root .hm-rk-1__n {
    font-size: 14px;
    color: var(--hm-tx-strong);
    padding-bottom: 1px;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/ShipporiMinchoB1-Bold.asset?fileID=11400000&guid=79e45b7605bce4026b70c4d8d01cf21b&type=2#ShipporiMinchoB1-Bold");
}
.hm-root .hm-rk-2 { width: 76px; flex-shrink: 0; align-items: flex-end; }
.hm-root .hm-rk-2__v { font-size: 13px; color: var(--hm-tx-2); -unity-text-align: middle-right; }
.hm-root .hm-rk-2__n { font-size: 11px; color: var(--hm-tx-3); -unity-text-align: middle-right; overflow: hidden; }
.hm-root .hm-rk--none { font-size: 13px; color: var(--hm-tx-4); }

/* 個別指導：指名済み＝#F2EFE8 の角丸10（高さ52）・番号の丸はスクールカラー。空き＝点線 */
.hm-root .gd-slot {
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding: 0 14px;
    margin-top: 10px;
    border-radius: 10px;
    background-color: var(--hm-slot);
    flex-shrink: 0;
}
.hm-root .gd-slot--link:hover { background-color: var(--hm-line); }
.hm-root .gd-no {
    width: 26px; height: 26px;
    border-radius: 13px;
    margin-right: 12px;
    font-size: 12px;
    color: #FFFFFF;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/NotoSansJP-Bold.asset?fileID=11400000&guid=0a6535b0156cd4b349a9c2b1c707ba43&type=2#NotoSansJP-Bold");
}
.hm-root .gd-name {
    flex-grow: 1;
    font-size: 17px;
    letter-spacing: 1.4px;
    color: var(--hm-tx-1);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Generated/ShipporiMinchoB1-ExtraBold.asset?fileID=11400000&guid=7f2420c220fb74dc88a61dafe12284b0&type=2#ShipporiMinchoB1-ExtraBold");
}
.hm-root .gd-arrow { width: 16px; height: 16px; color: var(--hm-tx-3); flex-shrink: 0; }
.hm-root .gd-plus { width: 16px; height: 16px; color: var(--hm-tx-2); margin-right: 8px; }
.hm-root .gd-slot--empty { background-color: rgba(0, 0, 0, 0); justify-content: center; }
.hm-root .gd-dash { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hm-root .gd-empty-t { font-size: 15px; color: var(--hm-tx-2); }
.hm-root .gd-slot--empty.gd-slot--link:hover { background-color: var(--hm-slot); }

/* 今週の出来事：左にスクールカラーの縦線（4px）、札（情報など）・時期・本文 */
.hm-root .hm-feed-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; margin-top: 8px; }
.hm-root .fd-item { flex-direction: row; align-items: stretch; padding: 10px 0; }
.hm-root .fd-item--link:hover { background-color: var(--hm-slot); }
.hm-root .fd-bar { width: 4px; border-radius: 2px; flex-shrink: 0; margin-right: 12px; }
.hm-root .fd-body { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.hm-root .fd-meta { flex-direction: row; align-items: center; margin-bottom: 4px; }
.hm-root .fd-tag {
    font-size: 12px;
    color: var(--hm-tx-label);
    background-color: var(--hm-line);
    border-radius: 4px;
    padding: 1px 7px;
    margin-right: 8px;
}
.hm-root .fd-bar--warn { background-color: var(--color-warn); }
.hm-root .fd-tag--warn { color: #FFFFFF; background-color: var(--color-warn); }
.hm-root .fd-time { font-size: 12px; color: var(--hm-tx-2); }
.hm-root .fd-text { font-size: 16px; color: var(--hm-tx-1); white-space: normal; }

/* ============================================================ */
/* 選手詳細（mock: 野球部監督GM「選手詳細」）              pd2-* */
/* ============================================================ */
.pd2-scroll { flex-grow: 1; }

/* --- プレイヤーヘッダー --- */
.pd2-head { flex-direction: row; align-items: stretch; background-color: var(--color-panel); border-width: 1px; border-color: var(--color-line); margin: 14px; }
.pd2-numbox { width: 122px; background-color: var(--color-strip); border-right-width: 1px; border-right-color: var(--color-line); align-items: center; justify-content: center; padding: 14px 0; }
.pd2-numbox__role { color: var(--sky); font-size: var(--fs-cap); letter-spacing: 3px; }
.pd2-numbox__no { font-size: 62px; color: var(--color-chalk); }
.pd2-numbox__sub { font-size: var(--fs-cap); color: var(--color-muted); }
.pd2-headmain { flex-grow: 1; flex-direction: row; align-items: center; justify-content: space-between; padding: 16px 24px; }
.pd2-nameline { flex-direction: row; align-items: center; }
.pd2-name { font-size: 32px; letter-spacing: 2px; color: var(--color-chalk); margin-right: 14px; }

/* 主将バッジ（設計書09 §8）: 名前脇の金地ピル。 */
.pd2-captain {
    background-color: var(--color-lamp);
    color: var(--color-ink);
    font-size: var(--fs-label);
    letter-spacing: 1px;
    border-radius: var(--radius-chip);
    padding: 2px 9px;
    margin-right: 14px;
}
.pd2-meta { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.pd2-meta__i { font-size: 18px; color: var(--color-muted); margin-right: 20px; }
/* 故障中だけ警告色（UI原則②: 本当の警告にだけ使う）。健常時はこの要素自体を隠す。 */
.pd2-meta__i--injury { color: var(--color-warn); }
.pd2-overall { align-items: center; padding-left: 24px; border-left-width: 1px; border-left-color: var(--color-line); }
.pd2-overall__k { font-size: var(--fs-cap); color: var(--color-muted); letter-spacing: 2px; margin-bottom: 8px; }
.pd2-overall__chip { flex-direction: row; }
.grade--lg { font-size: 28px; min-width: 44px; height: 44px; padding: 6px 12px; margin-right: 0; }

/* --- 行/列レイアウト（カードの器は共通 .card。ここは並べ方の容器だけ）---
   カード本体・見出し帯・寸法修飾子は .card / .card__hd / .card--* に一本化した（design-19）。
   選手詳細・チーム総合力はこの容器の中に .card を並べる。 */
.pd2-row { flex-direction: row; margin-left: 14px; margin-right: 0; margin-bottom: 14px; }
.pd2-col-right { width: 360px; margin-right: 14px; }
/* 右カラムのカードは横並びでなく縦積み＝右余白を消し下余白を付ける（modifier の margin-right を上書き）。 */
.pd2-col-right .card { margin-right: 0; margin-bottom: 14px; }

/* --- 能力バー --- */
.pd2-abils { padding: 6px 14px 12px 14px; }
/* 能力バー行そのものは部品辞書 components.uss の .abil-row に一本化（issue #3）。ここは器の余白のみ。 */

/* --- レーダー / 成長 --- */
.pd2-radar { flex-grow: 1; min-height: 224px; align-items: center; justify-content: center; padding: 8px; }
.ts-radar { min-height: 500px; }
/* 右パネル: 6行をパネル高さ全体へ均等分散。数値を指標名より大きく（ダッシュボード視認性） */
.ts-factors { flex-grow: 1; justify-content: space-between; padding: 20px 20px; }
/* 指標行は部品辞書 components.uss の .abil-row（--lg 修飾子）に一本化（issue #3）。 */
/* 分析コメント（弱点）: パネル最下部 */
.ts-analysis { border-top-width: 1px; border-top-color: var(--color-line); padding: 16px 20px 6px 20px; }
.ts-analysis__k { font-size: var(--fs-cap); color: var(--color-muted); letter-spacing: 2px; margin-bottom: 4px; }
.ts-analysis__t { font-size: 19px; color: var(--color-chalk); white-space: normal; }
.ts-analysis__row { flex-direction: row; flex-wrap: wrap; }
.ts-analysis__weak { color: var(--color-chalk); margin-right: 8px; }
/* レーダー軸ラベルは部品辞書 components.uss の radar-axis 系（--lg 修飾子）に一本化（issue #7）。 */
/* 総合ランク: チップ＋(値) を1行に（1.5倍拡大） */
.ts-overall-line { flex-direction: row; align-items: center; }
.ts-overall-value { font-size: 34px; color: var(--color-chalk); margin-left: 8px; }
.grade--xl { font-size: 40px; min-width: 60px; height: 60px; padding: 8px 18px; margin-right: 0; }
.pd2-growth { flex-grow: 1; min-height: 180px; }
/* 成長推移の分野タブ（issue #1027）: 成績タブのスコープ切替と同じ見た目を、見出し帯に収まる寸法で。 */
.pd2-scope--hd { margin-bottom: 0; }
.pd2-scope--hd .pd2-scope__item { padding: 2px 10px; margin-right: 0; margin-left: 4px; }
.pd2-empty { font-size: var(--fs-cap); color: var(--color-faint); -unity-text-align: middle-center; white-space: normal; padding: 20px; }

/* --- 隠しパラメータ --- */
.pd2-hidden-row { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 10px; }
/* 性格の行＋4軸の見立て（issue #935）。塊ごとに下の余白を取り、中の行どうしは詰める。 */
.pd2-hidden-block { margin-bottom: 10px; }
.pd2-hidden-block > .pd2-hidden-row { margin-bottom: 2px; }
/* チーム総合力パネル: 精神力の行の右に並べる結束のランク（issue #935）。 */
.tsp-cohesion { flex-direction: row; align-items: center; width: 64px; flex-shrink: 0; margin-left: var(--sp-3); }
.tsp-cohesion__k { font-size: var(--fs-cap); color: var(--color-muted); margin: 0 var(--sp-1) 0 0; padding: 0; }
.pd2-hidden-k { font-size: var(--fs-label); color: var(--color-muted); }
.pd2-hidden-v { font-size: 18px; color: var(--color-chalk); }
.pd2-hidden-v--unknown { font-size: 19px; color: var(--color-faint); }

/* --- 球種テーブル --- */
.pd2-pitch-head { flex-direction: row; padding: 9px 0; border-bottom-width: 1px; border-bottom-color: var(--color-line); }
.pd2-pc { font-size: var(--fs-cap); color: var(--color-muted); letter-spacing: 1px; }
.pd2-pc--name { flex-grow: 2; flex-basis: 0; }
.pd2-pc--rank { width: 56px; -unity-text-align: middle-center; }
.pd2-pc--num { flex-grow: 1; flex-basis: 0; -unity-text-align: middle-right; }
.pd2-pitch-row { flex-direction: row; align-items: center; padding: 9px 0; border-bottom-width: 1px; border-bottom-color: var(--color-line); }
.pd2-pv--name { flex-grow: 2; flex-basis: 0; font-size: var(--fs-label); color: var(--color-chalk); }
.pd2-pv--rank { width: 56px; flex-direction: row; justify-content: center; }
.pd2-pv--num { flex-grow: 1; flex-basis: 0; -unity-text-align: middle-right; font-size: 18px; color: var(--color-chalk); }

/* --- 特殊能力 --- */
.pd2-skill { margin-bottom: 11px; }
.pd2-skill__name { font-size: var(--fs-cap); color: var(--sky); background-color: rgba(245,198,74,0.12); border-width: 1px; border-color: var(--sky); padding: 3px 10px; align-self: flex-start; }
.pd2-skill__desc { font-size: var(--fs-cap); color: var(--color-muted); margin-top: 5px; white-space: normal; }

/* --- 簡易成績 --- */
.pd2-stat-label { font-size: var(--fs-cap); color: var(--sky); letter-spacing: 1px; margin-top: 8px; margin-bottom: 6px; }
.pd2-stat-row { flex-direction: row; margin-bottom: 6px; }
.pd2-stat { flex-grow: 1; flex-basis: 0; background-color: var(--color-strip); border-width: 1px; border-color: var(--color-line); padding: 8px 4px; align-items: center; margin-right: 6px; }
.pd2-stat__v { font-size: 24px; color: var(--ink); }
.pd2-stat__k { font-size: 13px; color: var(--color-muted); margin-top: 2px; }

/* ===== 成績タブ（issue #77）: 能力/成績タブ・スコープ切替・成績グリッド ===== */
.pd2-tabs { flex-direction: row; border-bottom-width: 2px; border-color: var(--color-line); margin: 0 14px 12px 14px; }
.pd2-tab { color: var(--color-muted); font-size: 20px; letter-spacing: 1px; padding: 10px 22px; border-bottom-width: 2px; border-color: rgba(0, 0, 0, 0); margin-bottom: -2px; }
.pd2-tab:hover { color: var(--color-chalk); }
.pd2-tab--on { color: var(--ink); border-color: var(--ink); }

.pd2-stats-tab { padding: 0 14px 20px 14px; }

.pd2-scope { flex-direction: row; margin-bottom: 12px; }
.pd2-scope__item { color: var(--color-muted); font-size: var(--fs-cap); letter-spacing: 1px; padding: 8px 16px; background-color: var(--color-strip); border-width: 1px; border-color: var(--color-line); margin-right: 6px; }
.pd2-scope__item:hover { color: var(--color-chalk); }
.pd2-scope__item--on { color: var(--ink); background-color: var(--color-panel); border-color: var(--ink); }

.pd2-statgrid { flex-direction: row; flex-wrap: wrap; padding: 8px 6px 4px 6px; }
.pd2-statgrid--pit { border-top-width: 1px; border-color: var(--color-line); margin-top: 4px; }
.pd2-statcell { width: 76px; padding: 4px 7px; margin: 0 4px 6px 0; background-color: var(--color-strip); border-width: 1px; border-color: var(--color-line); }
.pd2-statcell__k { font-size: 11px; color: var(--color-muted); letter-spacing: 1px; }
.pd2-statcell__v { font-size: var(--fs-num); color: var(--ink); -unity-text-align: middle-right; }

.pd2-trow { margin-bottom: 10px; padding-bottom: 6px; border-bottom-width: 1px; border-color: var(--color-line); }
.pd2-trow__head { flex-direction: row; align-items: center; padding: 4px 8px; }
.pd2-trow__num { font-size: 20px; color: var(--sky); width: 34px; -unity-text-align: middle-right; margin-right: 10px; }
.pd2-trow__slot { font-size: var(--fs-body); color: var(--color-chalk); letter-spacing: 1px; }

/* 行クリック可能な一覧行 */
.row--click:hover { background-color: var(--color-line); }

/* --- 球種チャート（丸の列・部品 PitchChartView。寸法の基準は 480×310） --- */
/* 投手能力カード内へ埋め込み（issue #215）: 能力4行の下に置く。 */
.pd2-pitchchart { min-height: 310px; flex-grow: 1; margin: 0 16px 16px 16px; }
/* 中心のボール（160px の画像を縮めて置く。寸法・位置は部品が決める） */
.pchart__ball { position: absolute; background-image: url("project:///Assets/UI/Images/pitch/ball.png"); -unity-background-scale-mode: scale-to-fit; }
/* 札＝球種名＋ランクのチップ（ストレートはチップの代わりに最速）。高さをチップに揃え、中身は上下中央。
   Label の既定の余白が残ると名前とチップの芯がずれるので、札の中は余白0から組む。 */
.pd2-pchip { position: absolute; flex-direction: row; align-items: center; height: 22px; }
.pd2-pchip Label { margin: 0; padding: 0; }
.pd2-pchip .pd2-pchip__name { height: 22px; font-size: 15px; letter-spacing: 0.6px; -unity-text-align: middle-left; margin-right: 2px; white-space: nowrap; }
.pd2-pchip .rank-chip { width: 22px; min-width: 22px; height: 22px; padding: 0; margin: 0; flex-shrink: 0; }
/* ストレートのみ添える最速（Issue #130）。数字 15px 太字・単位 12px。 */
.pd2-pchip .pd2-pchip__velo { height: 22px; align-items: center; margin-left: 4px; }
.pd2-pchip__velo .nu-num { font-size: 15px; color: var(--ms-ink); -unity-text-align: middle-left; }
.pd2-pchip .pd2-pchip__velo .nu-unit { font-size: 12px; color: var(--ms-tx-3); margin-left: 3px; padding-top: 2px; -unity-text-align: middle-left; }

/* compact 版（比較カード 104px 高・試合中の偵察/交代 150px 高, issue #326⑤/#560）: 同じ描き方を縮める。
   札は略記＋小さいチップ。器が狭いので、部品が重ならない置き場所を選ぶ。 */
.pd2-pchip--compact { height: 18px; }
.pd2-pchip.pd2-pchip--compact .pd2-pchip__name { height: 18px; font-size: 12px; letter-spacing: 0; margin-right: 1px; }
.pd2-pchip--compact .rank-chip { width: 14px; min-width: 14px; height: 14px; }
/* ストレートに添える最速も小型版に合わせる（issue #560）。ここが唯一の球速表示なので名前より小さくしない。 */
.pd2-pchip--compact .pd2-pchip__velo { height: 18px; margin-left: 0; }
.pd2-pchip--compact .pd2-pchip__velo .nu-num { font-size: 12px; }
.pd2-pchip.pd2-pchip--compact .pd2-pchip__velo .nu-unit { font-size: 10px; margin-left: 2px; padding-top: 1px; }

/* ═══════════════════════════════════════════════════════════════════════
   ミニマルスクロールバー（全画面共通・リファイン）
   OS標準の矢印付き太バーを廃止し、幅6px・角丸・つまみのみへ置換する。
   KokoSimTheme は全画面が読み込むためここに置けば全 ScrollView に効く。
   ═══════════════════════════════════════════════════════════════════════ */
.unity-scroller--vertical { width: 6px; background-color: transparent; }
.unity-scroller--horizontal { height: 6px; background-color: transparent; }
/* 矢印ボタン（トラック上下端）を消す */
.unity-scroller__low-button, .unity-scroller__high-button { display: none; width: 0; height: 0; }
/* トラック（溝）を透明に */
.unity-scroller .unity-base-slider { width: 6px; margin: 0; background-color: transparent; }
.unity-scroller--horizontal .unity-base-slider { height: 6px; width: auto; }
#unity-tracker { background-color: transparent; border-width: 0; }
/* つまみのみ表示（半透明の明色・角丸） */
#unity-dragger {
    background-color: var(--color-faint);
    border-width: 0; border-radius: 3px;
    width: 6px; min-height: 40px; margin: 0;
}
#unity-dragger:hover { background-color: var(--color-muted); }
/* 横スクロールのつまみは縦横が入れ替わる（高さ6px・最小長40px）。 */
.unity-scroller--horizontal #unity-dragger { width: auto; height: 6px; min-height: 0; min-width: 40px; }

/* ═══════════════════════════════════════════════════════════════════════
   リファイン追補：カード類の枠線を廃し「面の明度」で区切る（全画面共通・後勝ち）
   PlayerDetail / Tournament / Match 等の残存枠線をまとめて無効化し、角丸12へ統一する。
   枠線を残すのは focus/入力/スコアボード格子（sb-cell）と、意味を持つ左アクセントのみ。
   ═══════════════════════════════════════════════════════════════════════ */
.tp-team, .tp-lead, .pd2-head, .pd2-stat,
.vs, .stat, .day, .coach-slot, .edit-slot {
    border-width: 0;
}
.tp-team, .tp-lead, .pd2-head, .vs, .coach-slot, .edit-slot, .stat, .day { border-radius: var(--radius-card); }
/* 優勝候補だけは意味のある左アクセント（黄）を細く残す（全周枠は廃止） */
.tp-team--fav { border-left-width: 3px; border-left-color: var(--sky); }
/* 通知フィード（旧レイアウト）：全周枠は廃止し左アクセントのみ残す */
.feed__item { border-width: 0; border-left-width: 3px; border-left-color: var(--color-line); }

/* ===== 大会モード オーバーレイ（開幕バナー・試合開始ダイアログ・結果） ===== */
/* 同一document内オーバーレイ。別UIDocument/PanelSettingsはScreenRouter競合になるため使わない。
   ルート要素なので class="ui-root" を必ず付ける。既定は display:none でコントローラが出す。 */
.tm-scrim {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(6, 12, 8, 0.72);
    align-items: center;
    justify-content: center;
    display: none;
}
.tm-card {
    background-color: var(--color-panel);   /* --sf-card */
    border-width: 1px;
    border-color: var(--color-line);       /* --color-line */
    border-radius: var(--radius-modal);
    flex-direction: column;
    align-items: center;
    padding: 28px 40px;
    min-width: 360px;
}

/* 開幕バナー（全画面センター・フェード。opacity はコントローラが制御） */
.tm-banner {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(6, 12, 8, 0.88);
    align-items: center;
    justify-content: center;
    display: none;
}
.tm-banner__inner { flex-direction: column; align-items: center; }
.tm-banner__top { font-size: 40px; color: var(--color-lamp); letter-spacing: 3px; }
.tm-banner__rule { height: 2px; width: 220px; background-color: var(--color-lamp); margin: 14px 0; }
/* 開幕バナーは暗幕(0.88)の上の劇的告知＝スコアボードと同じ「暗い島は明色文字」。
   昼で --color-chalk がインク（暗）へ反転するため、常時明色の --sb-ink-1 を使う。 */
.tm-banner__name { font-size: 26px; color: var(--sb-ink-1); letter-spacing: 2px; }
.tm-banner__open { font-size: 34px; color: var(--sb-ink-1); letter-spacing: 8px; margin-top: 18px; }

/* 試合開始ダイアログ */
.tm-dialog__round { font-size: 19px; color: var(--color-muted); letter-spacing: 2px; }
.tm-dialog__vs { font-size: 24px; color: var(--color-chalk); margin-top: 6px; }
.tm-dialog__q { font-size: 21px; color: var(--color-chalk); margin-top: 18px; margin-bottom: 20px; }
/* 問いに添える補足1行（例: 最後の保存からの経過）。問いより弱く、警告色は使わない（UI原則②）。 */
.tm-dialog__sub { font-size: var(--fs-cap); color: var(--color-muted); margin-top: -12px; margin-bottom: 20px; white-space: normal; -unity-text-align: middle-center; }
.tm-dialog__btns { flex-direction: row; }

/* 試合結果（自動消化） */
.tm-result__round { font-size: 19px; color: var(--color-muted); letter-spacing: 2px; }
.tm-result__headline { font-size: 30px; -unity-text-align: middle-center; margin-top: 8px; }
.tm-result__headline--win { color: var(--color-chalk); }
.tm-result__headline--lose { color: var(--color-warn); }
.tm-result__score { font-size: 24px; color: var(--color-chalk); margin-top: 10px; margin-bottom: 20px; }

/* 大会モードのボタン（主要=黄CTA・副次=ゴースト・警告=破壊的操作の確認だけに使う, UI原則②） */
.tm-btn { min-width: 120px; height: 40px; -unity-text-align: middle-center; font-size: 20px; border-radius: var(--radius-card); margin: 0 8px; }
.tm-btn--primary { background-color: var(--color-cta); color: #FFFFFF; border-width: 0; }
.tm-btn--ghost { background-color: var(--color-panel-deep); color: var(--color-chalk); border-width: 1px; border-color: var(--color-line); }
.tm-btn--warn { background-color: var(--color-warn); color: #FFFFFF; border-width: 0; }

/* ===== ホームメニュー（issue #509・セーブ／タイトルへ戻る） =====
   ヒーロー帯の右端に置く唯一の入口（hm-hero__match/plain が flex-grow:1 のため自然に右端へ収まる）。
   それ以外の操作（保存・タイトルへ戻る）はこのメニューの中に寄せる（UI原則⑦）。 */

/* ===== 新チーム発足：次期主将の指名モーダル（設計書09 §8・案C 左リスト＋右詳細） =====
   同一document内オーバーレイ（部品辞書の modal-scrim / modal-card を使用）。既定は display:none。
   列幅はヘッダーとデータ行が同じトークンを参照する（横ずれの構造対策・UI-BUILD-METHOD Step 1）。
   アクセント黄はこのモーダル内で「選択中の行」と「主要CTA」の2箇所だけに絞る（UI原則②）。 */
.nt-card { width: var(--modal-lg-w); padding: 20px 24px 18px 24px; }

.nt-hd { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; }
.nt-hd__t { font-size: var(--fs-page); color: var(--color-chalk); letter-spacing: 2px; }
.nt-hd__s { font-size: var(--fs-label); color: var(--color-muted); }
.nt-lead { font-size: var(--fs-label); color: var(--color-muted); margin-top: 4px; margin-bottom: 12px; flex-shrink: 0; }

/* 高さは主将指名だけ大きいモーダル共通（--modal-lg-body-h）より高い --modal-nt-body-h（issue #869/#861/#1533）。 */
.nt-body { flex-direction: row; height: var(--modal-nt-body-h); flex-shrink: 0; }

/* 左：候補リスト */
.nt-list { flex-grow: 1; flex-basis: 0; min-width: 0; background-color: var(--color-panel); border-radius: var(--radius-card); padding: 6px 8px 8px 8px; }
.nt-th { flex-direction: row; align-items: center; height: 26px; flex-shrink: 0;
    border-bottom-width: 1px; border-bottom-color: var(--color-line); }
.nt-th__c { font-size: var(--fs-cap); color: var(--color-faint); }
.nt-rows { flex-grow: 1; }

.nt-row { flex-direction: row; align-items: center; height: 32px; flex-shrink: 0; padding-left: 6px;
    border-left-width: 3px; border-left-color: rgba(0, 0, 0, 0); border-radius: var(--radius-chip); }
.nt-row:hover { background-color: var(--color-row-hover); }
.nt-row--on { background-color: var(--color-panel-hover); border-left-color: var(--sky); }

.nt-c-no { width: 34px; flex-shrink: 0; -unity-text-align: middle-right; padding-right: 8px;
    font-size: var(--fs-label); color: var(--color-muted); }
.nt-c-name { flex-grow: 1; flex-basis: 0; min-width: 0; font-size: var(--fs-body); color: var(--color-chalk);
    -unity-text-align: middle-left; }
.nt-th .nt-c-name { font-size: var(--fs-cap); color: var(--color-faint); }
.nt-c-pos { width: 30px; flex-shrink: 0; -unity-text-align: middle-center; font-size: var(--fs-label); color: var(--color-muted); }
.nt-c-rank { width: 78px; flex-shrink: 0; flex-direction: row; justify-content: center; align-items: center;
    -unity-text-align: middle-center; }
.nt-c-mental { width: 46px; flex-shrink: 0; -unity-text-align: middle-right; padding-right: 8px;
    font-size: var(--fs-label); color: var(--color-chalk); }
.nt-c-tag { width: 44px; flex-shrink: 0; -unity-text-align: middle-center; font-size: var(--fs-cap); color: var(--color-faint); }

/* 右：選択中の詳細 */
.nt-detail { width: var(--modal-lg-detail-w); flex-shrink: 0; margin-left: 12px; background-color: var(--color-panel);
    border-radius: var(--radius-card); padding: 12px 14px; overflow: hidden; }
.nt-d__name { font-size: 22px; color: var(--color-chalk); }
.nt-d__sub { font-size: var(--fs-cap); color: var(--color-muted); margin-top: 2px; }
.nt-d__radar { height: var(--nt-radar-h); flex-shrink: 0; margin-top: 4px; }
.nt-d__facts { flex-direction: row; flex-wrap: wrap; margin-top: 6px; flex-shrink: 0; }
.nt-fact { flex-direction: row; align-items: center; width: 50%; height: 26px; flex-shrink: 0; }
.nt-fact__k { font-size: var(--fs-cap); color: var(--color-faint); flex-grow: 1; flex-basis: 0; min-width: 0;
    -unity-text-align: middle-left; }
.nt-fact__chip { flex-direction: row; align-items: center; justify-content: flex-end; padding-right: 10px; }
.nt-fact__v { font-size: var(--fs-label); color: var(--color-chalk); -unity-text-align: middle-right; padding-right: 10px; }
.nt-d__cap { font-size: var(--fs-cap); color: var(--color-faint); margin-top: 8px; letter-spacing: 1px; }
.nt-d__skills { flex-direction: row; flex-wrap: wrap; margin-top: 4px; flex-grow: 1; overflow: hidden; }
.nt-skill { font-size: var(--fs-cap); color: var(--color-chalk); background-color: var(--color-panel-deep);
    border-radius: var(--radius-chip); padding: 2px 8px; margin-right: 4px; margin-top: 4px; }
.nt-skill--none { color: var(--color-faint); background-color: rgba(0, 0, 0, 0); padding-left: 0; }

/* 足元：注記＋主要CTA（1画面1つ・大きく。UI原則⑦） */
.nt-foot { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 14px; flex-shrink: 0; }
.nt-foot__note { font-size: var(--fs-cap); color: var(--color-faint); flex-grow: 1; flex-basis: 0; min-width: 0; }
.nt-ok { min-width: 220px; margin-right: 0; }

/* ===== 監督オファー：転任の選択（設計書04 §1.3・issue「監督の転任システムが実ゲームに完全未配線」） =====
   新チーム発足モーダル（nt-*）と同じ「左リスト＋右詳細」（部品辞書の modal-scrim / modal-card を使用）。
   列幅はヘッダーとデータ行が同じトークンを参照する（UI-BUILD-METHOD Step 1）。
   アクセント黄はこのモーダル内で「選択中の行」と「主要CTA」の2箇所だけに絞る（UI原則②）。 */
.xt-card { width: var(--modal-lg-w); padding: 20px 24px 18px 24px; }

.xt-hd { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; }
.xt-hd__t { font-size: var(--fs-page); color: var(--color-chalk); letter-spacing: 2px; }
.xt-lead { font-size: var(--fs-label); color: var(--color-muted); margin-top: 4px; margin-bottom: 12px; flex-shrink: 0; white-space: normal; }

/* 高さは候補10校＋残留の11行がスクロールなしで全部見える値（トークン --modal-lg-body-h。issue #869）。 */
.xt-body { flex-direction: row; height: var(--modal-lg-body-h); flex-shrink: 0; }

/* 左：候補リスト（残留＋オファー校） */
.xt-list { flex-grow: 1; flex-basis: 0; min-width: 0; background-color: var(--color-panel); border-radius: var(--radius-card); padding: 6px 8px 8px 8px; }
.xt-th { flex-direction: row; align-items: center; height: 26px; flex-shrink: 0;
    border-bottom-width: 1px; border-bottom-color: var(--color-line); }
.xt-th__c { font-size: var(--fs-cap); color: var(--color-faint); }
.xt-rows { flex-grow: 1; }

.xt-row { flex-direction: row; align-items: center; height: 32px; flex-shrink: 0; padding-left: 6px;
    border-left-width: 3px; border-left-color: rgba(0, 0, 0, 0); border-radius: var(--radius-chip); }
.xt-row:hover { background-color: var(--color-row-hover); }
.xt-row--on { background-color: var(--color-panel-hover); border-left-color: var(--sky); }

.xt-c-name { flex-grow: 1; flex-basis: 0; min-width: 0; font-size: var(--fs-body); color: var(--color-chalk); }
.xt-c-pref { width: 90px; flex-shrink: 0; -unity-text-align: middle-left; font-size: var(--fs-label); color: var(--color-muted); }
.xt-c-rank { width: 46px; flex-shrink: 0; flex-direction: row; justify-content: center; align-items: center; }
.xt-c-power { width: 54px; flex-shrink: 0; -unity-text-align: middle-right; padding-right: 8px;
    font-size: var(--fs-label); color: var(--color-chalk); }

/* 右：選択中の詳細 */
.xt-detail { width: var(--modal-lg-detail-w); flex-shrink: 0; margin-left: 12px; background-color: var(--color-panel);
    border-radius: var(--radius-card); padding: 12px 14px; overflow: hidden; }
.xt-d__name { font-size: 20px; color: var(--color-chalk); }
.xt-d__sub { font-size: var(--fs-cap); color: var(--color-muted); margin-top: 2px; }
.xt-d__facts { flex-direction: column; margin-top: 10px; flex-shrink: 0; }
.xt-fact { flex-direction: row; align-items: center; height: 22px; flex-shrink: 0; }
.xt-fact__k { font-size: var(--fs-cap); color: var(--color-faint); flex-grow: 1; flex-basis: 0; min-width: 0; }
.xt-fact__v { font-size: var(--fs-label); color: var(--color-chalk); -unity-text-align: middle-right; padding-right: 2px; }

/* 足元：注記＋主要CTA（1画面1つ・大きく。UI原則⑦） */
.xt-foot { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 14px; flex-shrink: 0; }
.xt-foot__note { font-size: var(--fs-cap); color: var(--color-faint); flex-grow: 1; flex-basis: 0; min-width: 0; white-space: normal; }
.xt-ok { min-width: 200px; margin-right: 0; }

/* ===== 年契約の更新モーダル（設計書04 §1.4a・issue #1034） =====
   部品辞書の modal-scrim / modal-card / dlg-btn / TierChoice を使う。主ボタンは足元の1つだけ（UI原則②⑦）。
   本文域は固定高＝ページをめくっても足元のボタンが動かない。 */
.crn-card { width: 700px; padding: 20px 24px 18px 24px; }
.crn-hd { font-size: var(--fs-page); color: var(--color-chalk); letter-spacing: 2px; flex-shrink: 0; margin-bottom: 12px; }
.crn-body { height: 340px; flex-shrink: 0; }
.crn-name { font-size: 26px; color: var(--color-chalk); flex-shrink: 0; margin: 0; padding: 0; }
.crn-sub { font-size: var(--fs-label); color: var(--color-muted); margin: 2px 0 12px 0; padding: 0; flex-shrink: 0; }
.crn-foot { flex-direction: row; justify-content: flex-end; align-items: center; margin-top: 14px; flex-shrink: 0; }

/* 行内の文字は箱いっぱいに伸ばして上下中央に置く（数字の書体と和文の書体で字面の高さが違い、中央寄せだけだと数字が下へずれる）。 */
.crn-row { flex-direction: row; align-items: stretch; height: 32px; flex-shrink: 0; }
.crn-row Label { margin: 0; padding: 0; -unity-text-align: middle-left; }
.crn-row__name { flex-grow: 1; flex-basis: 0; min-width: 0; font-size: var(--fs-body); color: var(--color-chalk); }
.crn-row__lv { width: 110px; flex-shrink: 0; font-size: var(--fs-label); color: var(--color-muted); }
.crn-row__cost { width: 110px; flex-shrink: 0; justify-content: flex-end; align-items: stretch; }
.crn-row__cost .nu-num { font-size: var(--fs-body); color: var(--color-chalk); -unity-text-align: middle-right; }
.crn-row__cost .nu-unit { font-size: var(--fs-label); color: var(--color-chalk); }
.crn-row--changed .crn-row__lv { color: var(--color-chalk); }
.crn-sep { height: 1px; flex-shrink: 0; background-color: var(--color-line); margin-top: 8px; margin-bottom: 8px; }
.crn-arrow { width: 36px; flex-shrink: 0; -unity-text-align: middle-center; font-size: var(--fs-label); color: var(--color-muted); }
.crn-warn .nu-num, .crn-warn .nu-unit { color: var(--color-warn); }

/* ═══════════════════════════════════════════════════════════════════════
   design-19 G1 昼スキン上書き（TopBar/nav/CTA）。tokens 反転で全面が昼になった後、
   「スコアボードは昼でも黒」「nav は白地インク枠・選択=空青」「CTA=応援団赤」を上書きする。
   ファイル末尾＝同特異度で後勝ち。夜へ戻す時はこのブロックごと外せばよい（可逆）。
   ═══════════════════════════════════════════════════════════════════════ */

/* --- トップバー帯は明地（ナビと同質）。黒は中央の掲示板ストリップ(sbs)だけに閉じ込める。
       校名・ランク・部費/名声/CTA はインク文字で明地に載る（design-19：黒い島を最小化）。 --- */
.sb2 { background-color: var(--sf-base); border-bottom-width: 0; }
.sb2-left { border-right-color: var(--divider); }
.sb2-rank { border-left-color: var(--divider); }
.sb2-right { border-left-color: var(--divider); }
.sb2-div { background-color: var(--divider); }
.sb2-badge { background-color: var(--sf-inset); color: var(--ink); border-width: 2px; border-color: var(--ink); }
.sb2-name, .sb2-rank__t, .sb2-meter__v { color: var(--tx-1); }
.sb2-pref, .sb2-rank__k, .sb2-meter__k { color: var(--tx-2); }
/* 名声/信頼度はランクのチップ画像で出す（TopBarMeters.SetRank が文字を透明化する）ので、文字色の意味色は持たない。掲示板ストリップ内の電光黄は不変。 */

/* --- ナビ帯：白地に沈め、下端をインク太罫で締める。選択タブは空の青。 --- */
.nav {
    background-color: var(--sf-base);
    border-bottom-width: 3px; border-bottom-color: var(--ink);
    padding: 10px 18px 0 18px; margin-top: 0;
}
.nav__item { color: var(--ink); border-radius: 0; }
.nav__item:hover { color: var(--sky); }
.nav__item--on { background-color: var(--sky); color: #FFFFFF; border-radius: 0; }

/* --- 主要CTA（今週を進める等）＝応援団赤・白抜き・インク枠＋ベタ影（案イ小型）。UI原則⑦ --- */
.advance {
    background-color: var(--color-cta); color: #FFFFFF;
    border-color: var(--ink);
    border-top-width: 2px; border-left-width: 2px; border-right-width: 4px; border-bottom-width: 4px;
    border-radius: 0;
}
.advance:hover { background-color: #F0563C; }

/* ═══ イベント（ノベル提示・設計書03 §5 / issue #609）════════════════════════
   案B「トップバー残し・立ち絵中」。トップバーは残し、本文域（ヒーロー帯＋3カラム）だけを
   この面と入れ替える（display の二者択一。コントローラが切り替える）。
   暗幕を敷かないのは、昼NB（白地＋インク枠）に全画面の黒幕が乗ると別のゲームに見えるため。

   色は使わない: 立ち絵が入るまでのプレースホルダは単色シルエットで、アクセント（応援団赤）は
   1つも置かない（UI原則②＝赤はCTA専用。ここに主要操作は無く、面のどこを押しても進む）。 */
.ev {
    flex-grow: 1;
    flex-direction: column;
    padding: 14px;          /* .dash と同じ＝入れ替えても本文域の起点が動かない */
    overflow: hidden;
    display: none;          /* 既定は非表示。コントローラが出す */
}
.ev__eyebrow { flex-shrink: 0; }

/* 立ち絵の舞台。薄い土の井に沈め、会話ボックスとの主従を作る。 */
.ev__stage {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    align-items: center;
    justify-content: flex-end;
    background-color: var(--dirt-well);
    border-width: var(--nb-border);
    border-color: var(--ink);
    padding: var(--sp-4);
    overflow: hidden;
}

/* 役割スロット（単色シルエット＋役割名）。絵が入ったらこの中身だけ差し替える。 */
/* 立ち絵は<b>舞台の高さに追従させる</b>（胴を伸縮させる）。固定高にすると、効果帯が付いて
   舞台が縮んだ週だけ頭が切れる＝「効果のあるイベントでだけ絵が壊れる」形になる。 */
.ev-por { flex-grow: 1; flex-shrink: 1; min-height: 0; align-items: center; justify-content: flex-end; }
/* 枠はインクで締める（この画面だけ枠なしの塊が浮くのを避ける。design-19 の「インク枠」）。 */
.ev-por__head {
    width: 92px; height: 92px;
    border-radius: 46px;            /* 正円（--radius-pill=12px では角丸の四角に見える） */
    background-color: var(--day-tx-3);
    border-width: var(--nb-border);
    border-color: var(--ink);
    flex-shrink: 0;
}
.ev-por__body {
    width: 208px;
    flex-grow: 1; flex-shrink: 1;
    min-height: 96px; max-height: 260px;
    border-radius: 96px 96px 0 0;   /* 肩の丸み。人の形に見える最低限 */
    background-color: var(--day-tx-3);
    border-width: var(--nb-border);
    border-color: var(--ink);
    margin-top: var(--sp-1);
}
.ev-por__role {
    font-size: var(--fs-cap);
    letter-spacing: 3px;
    color: var(--day-tx-2);
    margin-top: var(--sp-2);
}
/* 地の文（narration）は話者が居ない＝立ち絵ごと消す。 */
.ev-por--none { display: none; }

/* 実写ポートレート（issue manager-npc-replaces-coach-speaker・2026-08-29）。役割ごとに1枚差し込む。
   絵がまだ無い役割は既定で display:none のまま＝ev-por__head/__body のシルエットが見える。
   絵がある役割だけ EventNovelView が .ev-por--photo を立て、シルエットと入れ替える。 */
.ev-por__image {
    display: none;
    width: 208px;
    flex-grow: 1; flex-shrink: 1;
    min-height: 96px; max-height: 260px;
    border-radius: 8px 8px 0 0;
    background-color: var(--day-tx-3);
    border-width: var(--nb-border);
    border-color: var(--ink);
    /* 縦長の写真を横に潰さない＝アスペクト保持で塗り切る（cover）。
       旧 -unity-background-scale-mode は非推奨なので新プロパティで書く。 */
    background-repeat: no-repeat;
    background-position: center top;
    background-size: cover;
}
.ev-por--photo .ev-por__head,
.ev-por--photo .ev-por__body { display: none; }
.ev-por--photo .ev-por__image { display: flex; }

.ev-por__image--manager { background-image: url("project:///Assets/UI/Images/portraits/manager.jpeg"); }
/* マネージャーは10人（tm01〜tm10・issue #1430）。番号は C#（EventNovelView.EventPortraits）が
   Manager.TeamManagerPortrait / OutgoingTeamManagerPortrait から選ぶ＝クラスは固定割当でなく差し替え式。 */
.ev-por__image--team_manager-01 { background-image: url("project:///Assets/UI/Images/portraits/team_manager/tm01.png"); }
.ev-por__image--team_manager-02 { background-image: url("project:///Assets/UI/Images/portraits/team_manager/tm02.png"); }
.ev-por__image--team_manager-03 { background-image: url("project:///Assets/UI/Images/portraits/team_manager/tm03.png"); }
.ev-por__image--team_manager-04 { background-image: url("project:///Assets/UI/Images/portraits/team_manager/tm04.png"); }
.ev-por__image--team_manager-05 { background-image: url("project:///Assets/UI/Images/portraits/team_manager/tm05.png"); }
.ev-por__image--team_manager-06 { background-image: url("project:///Assets/UI/Images/portraits/team_manager/tm06.png"); }
.ev-por__image--team_manager-07 { background-image: url("project:///Assets/UI/Images/portraits/team_manager/tm07.png"); }
.ev-por__image--team_manager-08 { background-image: url("project:///Assets/UI/Images/portraits/team_manager/tm08.png"); }
.ev-por__image--team_manager-09 { background-image: url("project:///Assets/UI/Images/portraits/team_manager/tm09.png"); }
.ev-por__image--team_manager-10 { background-image: url("project:///Assets/UI/Images/portraits/team_manager/tm10.png"); }
/* 部員と主将は同じ絵（Gemini 生成・自前の素材なのでコミットする）。 */
.ev-por__image--player,
.ev-por__image--captain { background-image: url("project:///Assets/UI/Images/portraits/player.png"); }
.ev-por__image--scout { background-image: url("project:///Assets/UI/Images/portraits/scout.png"); }

/* 会話ボックス。白面＋インク枠＋ベタ影（案イ＝右下だけ枠を太らせる。部品級）。 */
.ev__box {
    flex-shrink: 0;
    min-height: 168px;
    background-color: var(--sf-card);
    border-color: var(--ink);
    border-top-width: var(--nb-border);
    border-left-width: var(--nb-border);
    border-right-width: var(--nb-panel-edge);
    border-bottom-width: var(--nb-panel-edge);
    padding: var(--sp-3) var(--sp-4);
    margin-top: var(--sp-3);
}
.ev__speaker {
    font-size: var(--fs-page);
    color: var(--ink);
    margin-bottom: var(--sp-2);
}
.ev__speaker--none { display: none; }
.ev__say {
    font-size: var(--fs-body);
    color: var(--ink);
    white-space: normal;
    flex-grow: 1;
}
/* 地の文は「誰の声でもない」＝一段落として中央に置く。 */
.ev__say--narration { color: var(--day-tx-2); -unity-text-align: middle-center; }
.ev__foot {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--sp-2);
    flex-shrink: 0;
}
.ev__progress { font-size: var(--fs-cap); color: var(--day-tx-3); }
.ev__hint { font-size: var(--fs-cap); color: var(--day-tx-2); letter-spacing: 2px; }
/* 監督の対応の3択（issue #945・案A）。最後の台詞の下に縦並び。出していないときは消す（空の余白を残さない）。
   ボタンの見た目は部品辞書の .choice-btn（components.uss）。 */
.ev__choices { flex-shrink: 0; margin-top: var(--sp-3); display: none; }
.ev__choices--open { display: flex; }
.ev__hint--none { display: none; }
/* 会話を飛ばす（issue #1496）。「クリックで次へ」の左に同じ大きさの文字で置く。飛ばせない会話・最後の行では消す。 */
.ev__skip {
    flex-grow: 1;
    -unity-text-align: middle-right;
    margin-right: var(--sp-4);
    font-size: var(--fs-cap);
    color: var(--day-tx-2);
    letter-spacing: 2px;
    display: none;
}
.ev__skip--open { display: flex; }
.ev__skip:hover { color: var(--ink); }

/* 結果行（監督指示 2026-08-19。旧・案A2 の右下の帯は廃止）。会話の最終行に
   「山田 のミートが ＋5 上がった！」を太字＋色で言い切る。色は通知フィードの Up/Warn と
   同じ意味づけ＝吉報は空の青、凶報（怪我・スランプ・破損）は警告色。太字は実ウェイト
   （.f-body-bd をコード側で付ける）。中央寄せは地の文と同じ「誰の声でもない行」の扱い。 */
.ev__say--result { color: var(--sky); -unity-text-align: middle-center; }
.ev__say--result-bad { color: var(--color-warn); }
