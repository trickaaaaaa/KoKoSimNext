<?xml version="1.0" encoding="utf-8"?>
<!-- メンバー設定 画面（UI-BUILD-METHOD Step 4）。背番号1〜20の固定枠に選手を割り当て、
     選んだ2選手の全能力を比較する。骨組みだけ置き、枠・ベンチ外・比較は MemberSettingController が
     動的生成する。スタイルは tokens → KokoSimTheme → components → scorebook → 画面USS の順。
     4列＝背番号1〜9（球場の絵）｜背番号10〜20（縦1列）｜ベンチ外｜2選手比較。 -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="TopBar" src="Components/TopBar.uxml" />
    <Style src="tokens.uss" />
    <Style src="KokoSimTheme.uss" />
    <Style src="Components/components.uss" />
    <Style src="Components/scorebook.uss" />
    <Style src="MemberSetting.uss" />

    <ui:VisualElement class="ui-root ms-root sbk">

        <!-- 共通トップバー（スコアボード＋ナビ・単一ソース） -->
        <ui:Instance template="TopBar" class="topbar-slot" />

        <!-- 新チームの背番号決定（issue #954・案C）。主将指名の確定後にこの画面へ直行したときだけ出す上部帯。
             主ボタン「背番号を確定」でホームへ戻る（このときトップバーの週送りは隠す＝主ボタンは1画面1つ）。 -->
        <ui:VisualElement name="ms-newteam" class="banner ms-newteam ms-hidden">
            <ui:Label name="ms-newteam-lead" class="ms-newteam__lead f-body-bd" />
            <ui:VisualElement class="ms-head__spacer" />
            <ui:Button name="ms-newteam-ok" text="背番号を確定" class="dlg-btn dlg-btn--primary ms-newteam__ok" />
        </ui:VisualElement>

        <ui:VisualElement class="ms-body">

            <!-- 1列目：背番号1〜9。球場の絵（MemberFieldArtElement）の上に、Controller がカードを絶対配置で置く。 -->
            <ui:VisualElement class="ms-col ms-col--field">
                <ui:VisualElement class="ms-col__head">
                    <ui:Label text="背番号 1〜9" class="ms-col__title f-display" />
                </ui:VisualElement>
                <ui:VisualElement name="ms-field" class="ms-field">
                    <ui:VisualElement name="ms-field-slots" class="ms-field__slots" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 2列目：背番号10〜20（縦1列・11枠）。高さが足りないとき（新チームの帯が出ている間など）だけ列の中でスクロールする。 -->
            <ui:VisualElement class="ms-col ms-col--bench">
                <ui:VisualElement class="ms-col__head">
                    <ui:Label text="背番号 10〜20" class="ms-col__title f-display" />
                    <ui:VisualElement class="ms-col__meta">
                        <ui:Label text="登録" class="ms-col__meta-txt" />
                        <ui:Label name="ms-assigned" text="0" class="ms-col__count f-num-bd" />
                        <ui:Label text="/ 20" class="ms-col__meta-txt" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:ScrollView mode="Vertical" class="ms-bench-scroll">
                    <ui:VisualElement name="ms-bench" />
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- 3列目：ベンチ外。入りきらないときは入れ物の中だけスクロールする。 -->
            <ui:VisualElement class="ms-col ms-col--out">
                <ui:VisualElement class="ms-col__head">
                    <ui:Label text="ベンチ外" class="ms-col__title f-display" />
                    <ui:VisualElement class="ms-col__meta">
                        <ui:Label name="ms-out-count" text="0" class="ms-col__count f-num-bd" />
                        <ui:Label text="人" class="ms-col__meta-txt" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="ms-out">
                    <ui:ScrollView name="ms-out-scroll" mode="Vertical" class="ms-out__scroll">
                        <ui:VisualElement name="ms-pool" />
                    </ui:ScrollView>
                    <ui:Label name="ms-out-empty" text="ベンチ外の選手はいません" class="ms-out__empty ms-hidden" />
                    <ui:Label text="選手を選んでから入れたい背番号をクリックすると入れ替わります。" class="ms-out__note" />
                </ui:VisualElement>
                <ui:Button name="ms-auto" text="能力順で自動割当" class="ms-auto-btn f-body-bd" />
            </ui:VisualElement>

            <!-- 右：2選手比較 -->
            <ui:VisualElement class="ms-compare panel">
                <ui:VisualElement name="ms-cmp-tabs" class="ms-cmp-tabs" />

                <!-- 比較表（共通部品 CompareTable：見出し＋ランク・数値・横棒。オーダー画面と同じ表） -->
                <ui:VisualElement name="ms-cmp-head" />
                <ui:ScrollView mode="Vertical" class="ms-cmp-scroll">
                    <ui:VisualElement name="ms-cmp-rows" class="sbk-cmp__rows" />
                    <ui:VisualElement name="ms-cmp-apt" class="sbk-cmp__apt" />
                    <ui:VisualElement name="ms-cmp-chart" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
