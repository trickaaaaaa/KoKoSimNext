<?xml version="1.0" encoding="utf-8"?>
<!-- 練習 画面（一覧と練習メニューの配分）。静的な骨組みだけを置き、個別指導の枠・部員の行・配分の行・
     伸びる能力は TrainingPlanController が組み立てる。スタイルは tokens（値）→ KokoSimTheme →
     components（部品辞書）→ scorebook（スコアブックの読み替え）→ TrainingPlan（画面配置）の順。
     配分の編集はポップアップ（tp-modal）1枚で行う。配分と能力のタブは置かない（守備適性は守備位置の行、
     今の能力値は伸びる能力の列に出す）。 -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="TopBar" src="Components/TopBar.uxml" />
    <Style src="tokens.uss" />
    <Style src="KokoSimTheme.uss" />
    <Style src="Components/components.uss" />
    <Style src="Components/scorebook.uss" />
    <Style src="TrainingPlan.uss" />

    <ui:VisualElement class="ui-root tp-root sbk">

        <!-- 共通トップバー（スコアボード＋ナビ・単一ソース） -->
        <ui:Instance template="TopBar" class="topbar-slot" />

        <ui:VisualElement class="tp-body">

            <!-- 個別指導の帯：見出しと使用枠数＋3枠 -->
            <ui:VisualElement class="tp-coach">
                <ui:VisualElement class="tp-coach__head">
                    <ui:Label text="個別指導" class="tp-coach__title f-display" />
                    <ui:VisualElement class="tp-coach__count">
                        <ui:Label name="nom-count" text="0" class="tp-coach__count-num f-num-bd" />
                        <ui:Label name="nom-cap" text="/ 3枠" class="tp-coach__count-cap" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="nom-slots" class="tp-coach__slots" />
            </ui:VisualElement>

            <!-- 部員別 練習割当 -->
            <ui:VisualElement class="tp-table">
                <ui:VisualElement class="tp-toolbar">
                    <ui:Label name="roster-title" text="部員別 練習割当" class="tp-toolbar__title f-display" />
                    <ui:Label name="roster-count" text="0" class="tp-toolbar__count-num f-num-bd" />
                    <ui:Label text="名" class="tp-toolbar__count-cap" />
                    <ui:VisualElement class="tp-toolbar__spacer" />
                    <ui:Label text="在籍" class="tp-toolbar__cap" />
                    <ui:VisualElement name="bench-filters" class="tp-seg" />
                    <ui:Label text="学年" class="tp-toolbar__cap tp-toolbar__cap--gap" />
                    <ui:VisualElement name="year-filters" class="tp-seg" />
                </ui:VisualElement>

                <ui:VisualElement class="tp-thead">
                    <ui:Label text="指導" class="tp-th tp-col--nom" />
                    <ui:Label text="選手" class="tp-th tp-col--id" />
                    <ui:Label text="能力" class="tp-th tp-col--rank" />
                    <ui:Label name="thead-menu" text="練習メニュー（1日 300分）" class="tp-th tp-col--menu" />
                    <ui:VisualElement class="tp-col--go" />
                    <ui:VisualElement class="tp-col--copy" />
                    <ui:VisualElement name="thead-gutter" class="tp-thead__gutter" />
                </ui:VisualElement>

                <ui:ScrollView name="tp-scroll" mode="Vertical" class="tp-scroll">
                    <ui:VisualElement name="train-rows" class="tp-rows" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="toast" text="" class="tp-toast" picking-mode="Ignore" />

        <!-- 練習メニューの配分（ポップアップ・1画面） -->
        <ui:VisualElement name="tp-modal" class="ui-root modal-scrim tpm-scrim">
            <ui:VisualElement class="modal-card tpm-card">

                <!-- 選手の見出し：前後・背番号・名前・ランク｜個別指導・手動・閉じる -->
                <ui:VisualElement class="tpm-head">
                    <ui:Button name="sel-prev" text="" class="tpm-iconbtn tpm-iconbtn--nav" />
                    <ui:Button name="sel-next" text="" class="tpm-iconbtn tpm-iconbtn--nav tpm-iconbtn--next" />
                    <ui:Label name="sel-num" text="18" class="tpm-head__num f-num-bd" />
                    <ui:VisualElement class="tpm-head__id">
                        <ui:Label name="sel-name" text="選手名" class="tpm-head__name f-display" />
                        <ui:VisualElement class="tpm-head__metarow">
                            <ui:Label name="sel-meta" text="2年・右投左打" class="tpm-head__meta" />
                            <ui:VisualElement name="sel-cats" class="tpm-head__cats" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="tpm-spacer" />
                    <ui:Button name="sel-nom" text="" class="tpm-nom" />
                    <ui:VisualElement class="tpm-delegate">
                        <ui:VisualElement name="delegate-toggle" class="switch">
                            <ui:VisualElement class="switch__knob" />
                        </ui:VisualElement>
                        <ui:Label name="delegate-state" text="手動" class="tpm-delegate__state" />
                    </ui:VisualElement>
                    <ui:Button name="modal-close" text="" class="tpm-iconbtn tpm-close" />
                </ui:VisualElement>

                <!-- メニューの型の行：型のボタン7つ｜1日の配分 -->
                <ui:VisualElement class="tpm-presetrow">
                    <ui:Label text="メニュー" class="tpm-cap" />
                    <ui:VisualElement name="tpm-presets" class="tpm-presets" />
                    <ui:Label name="menu-lock-hint" text="委任中ロック" class="tpm-lock" />
                    <ui:VisualElement class="tpm-spacer" />
                    <ui:VisualElement class="tpm-budget">
                        <ui:VisualElement class="tpm-budget__top">
                            <ui:Label text="1日の配分" class="tpm-cap" />
                            <ui:VisualElement class="tpm-spacer" />
                            <ui:Label name="sel-remain" text="残り 0分" class="tpm-budget__remain" />
                            <ui:Label name="sel-total" text="300" class="tpm-budget__total f-display" />
                            <ui:Label name="sel-budget" text="/ 300分" class="tpm-budget__of" />
                        </ui:VisualElement>
                        <ui:VisualElement name="sel-alloc-bar" class="tpm-budget__bar" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 本体：野手練習｜投手練習＋守備位置｜この配分で伸びる能力 -->
                <ui:VisualElement class="tpm-body">
                    <ui:VisualElement class="tpm-col">
                        <ui:VisualElement class="tpm-group">
                            <ui:Label text="野手練習" class="tpm-group__name f-display" />
                            <ui:VisualElement class="tpm-spacer" />
                            <ui:Label name="sum-fielder" text="0" class="tpm-group__sum f-num-bd" />
                            <ui:Label text="分" class="tpm-group__unit" />
                        </ui:VisualElement>
                        <ui:VisualElement name="tpm-fielder" class="tpm-list" />
                    </ui:VisualElement>
                    <ui:VisualElement class="tpm-col">
                        <ui:VisualElement class="tpm-group">
                            <ui:Label text="投手練習" class="tpm-group__name f-display" />
                            <ui:VisualElement class="tpm-spacer" />
                            <ui:Label name="sum-pitcher" text="0" class="tpm-group__sum f-num-bd" />
                            <ui:Label text="分" class="tpm-group__unit" />
                        </ui:VisualElement>
                        <ui:VisualElement name="tpm-pitcher" class="tpm-list" />
                        <ui:VisualElement class="tpm-group tpm-group--gap">
                            <ui:Label text="守備位置" class="tpm-group__name f-display" />
                            <ui:Label text="守備適性つき" class="tpm-group__note" />
                            <ui:VisualElement class="tpm-spacer" />
                            <ui:Label name="sum-defense" text="0" class="tpm-group__sum f-num-bd" />
                            <ui:Label text="分" class="tpm-group__unit" />
                        </ui:VisualElement>
                        <ui:VisualElement name="tpm-defense" class="tpm-list" />
                    </ui:VisualElement>
                    <ui:VisualElement class="tpm-growth">
                        <ui:VisualElement class="tpm-ggroup">
                            <ui:Label text="野手能力" class="tpm-ggroup__name f-body-bd" />
                            <ui:VisualElement class="tpm-spacer" />
                            <ui:Label text="この配分での伸び" class="tpm-ggroup__note" />
                        </ui:VisualElement>
                        <ui:VisualElement name="tpm-growth-fielder" class="tpm-glist" />
                        <ui:VisualElement class="tpm-ggroup tpm-ggroup--gap">
                            <ui:Label text="投手能力" class="tpm-ggroup__name f-body-bd" />
                            <ui:VisualElement class="tpm-spacer" />
                            <ui:Label text="この配分での伸び" class="tpm-ggroup__note" />
                        </ui:VisualElement>
                        <ui:VisualElement name="tpm-growth-pitcher" class="tpm-glist" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 下の操作の行：週テンプレート（選択＋保存）｜元に戻す・決定 -->
                <ui:VisualElement class="tpm-foot">
                    <ui:Label text="週テンプレート" class="tpm-cap" />
                    <ui:Button name="tpl-select" text="" class="tpm-tplsel">
                        <ui:Label name="tpl-current" text="保存なし" class="tpm-tplsel__label" />
                    </ui:Button>
                    <ui:Button name="template-save" text="＋ 今の配分を保存" class="tpm-tplsave" />
                    <ui:VisualElement class="tpm-spacer" />
                    <ui:Button name="modal-revert" text="元に戻す" class="tpm-revert f-body-bd" />
                    <ui:Button name="modal-done" text="決定" class="tpm-done f-body-bd acc-bg" />
                </ui:VisualElement>

                <!-- 週テンプレートの一覧（選択欄から上へ開く。項目を押すと適用・×で削除） -->
                <ui:VisualElement name="tpl-menu" class="tpm-tplmenu" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 複製ピッカー（コピー元を選ぶ・Issue #133-⑤。行は Controller が動的生成） -->
        <ui:VisualElement name="tp-copy-modal" class="ui-root modal-scrim tpm-scrim">
            <ui:VisualElement class="modal-card tpc-card">
                <ui:VisualElement class="tpc-head">
                    <ui:Label name="copy-name" text="選手名" class="tpc-head__name f-display" />
                    <ui:Label text="へコピーする計画を選ぶ" class="tpc-head__cap" />
                    <ui:VisualElement class="tpm-spacer" />
                    <ui:Button name="copy-close" text="" class="tpm-iconbtn tpm-close" />
                </ui:VisualElement>
                <ui:ScrollView mode="Vertical" class="tpc-scroll">
                    <ui:VisualElement name="copy-list" class="tpc-list" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
