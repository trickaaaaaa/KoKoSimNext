/* ═══════════════════════════════════════════════════════════════════════
   LineupSetting.uss — オーダー画面の配置だけ（スコアブック試作スキン 2026-11-09）
   ───────────────────────────────────────────────────────────────────────
   見た目の部品とトークンは Components/scorebook.uss。ここは列幅・行高・間隔など
   「この画面固有の並べ方」だけを持つ。基準解像度 1600×900（KokoSimPanelSettings）。
   ルールは .lu-root から書く（scorebook.uss の Label 余白リセット .sbk Label より強くするため）。
   列幅はヘッダーとデータで同じクラス（.lu-c-*）を使う＝横ずれしない。
   gap/grid/擬似要素は使わない（USS非対応）。固定寸法の要素は flex-shrink:0。
   ═══════════════════════════════════════════════════════════════════════ */

.lu-root {
    flex-grow: 1;
    padding: 28px 32px;
}
/* Label 既定の上下 margin/padding は行の高さを狂わせるので、この画面では消す（行高は器で決める）。
   スコアブックの部品（.sbk-*）もこの前提で寸法を決めている。 */
.lu-root Label { margin: 0; padding: 0; }
.lu-root .lu-flex { flex-grow: 1; }

/* ── ヘッダー（高さ52・下に1px区切り） ── */
.lu-root .lu-head {
    flex-direction: row;
    align-items: center;
    height: 52px;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--sbk-rule);
    margin-bottom: 20px;
}
.lu-root .lu-head__bar { width: 12px; height: 28px; border-radius: 2px; margin-right: 14px; flex-shrink: 0; }
.lu-root .lu-head__title { font-size: 30px; letter-spacing: 3.6px; color: var(--sbk-text); margin-right: 20px; }
.lu-root .lu-head__match { font-size: 15px; color: var(--sbk-sub); margin-right: 16px; }
.lu-root .lu-head__opp { font-size: 15px; color: var(--sbk-text); }
.lu-root .lu-head__spacer { flex-grow: 1; }
.lu-root .lu-head__cap { font-size: 12px; color: var(--sbk-sub); margin-right: 10px; }
.lu-root .lu-head__rank { flex-direction: row; align-items: center; }
.lu-root .lu-head__value { font-size: 22px; color: var(--sbk-text); margin-left: 8px; }

/* ── 本体3列（間隔24） ── */
.lu-root .lu-body { flex-direction: row; flex-grow: 1; min-height: 0; }

/* 左列：スタメン（幅620） */
.lu-root .lu-orders { width: 620px; flex-shrink: 0; margin-right: 24px; }
/* 見出しの段＝「スタメン」＋DH切替（36）＋列見出し（24）＝60。控えの見出し行と高さを揃える。 */
.lu-root .lu-orders__top { flex-direction: row; align-items: center; height: 36px; flex-shrink: 0; }
.lu-root .lu-thead {
    flex-direction: row;
    align-items: center;
    height: 24px;
    flex-shrink: 0;
    /* 行カードの左右余白16＋枠1＋確保した選択枠1 と同じ位置に列を揃える */
    padding-left: 18px;
    padding-right: 18px;
}
.lu-root .lu-th { font-size: 12px; color: var(--sbk-sub); }

/* 列（ヘッダーとデータで共用）。要素間の横の間隔10は、2列目以降の左マージンで作る。 */
.lu-root .lu-c-ord { width: 36px; flex-shrink: 0; -unity-text-align: middle-center; }
.lu-root .lu-c-num { width: 32px; flex-shrink: 0; margin-left: 10px; align-items: center; -unity-text-align: middle-center; }
.lu-root .lu-c-pos { width: 44px; flex-shrink: 0; margin-left: 10px; -unity-text-align: middle-center; }
.lu-root .lu-c-name { flex-grow: 1; flex-basis: 0; min-width: 0; margin-left: 10px; }
.lu-root .lu-c-info { width: 116px; flex-shrink: 0; margin-left: 10px; }
.lu-root .lu-c-avg { width: 52px; flex-shrink: 0; margin-left: 10px; -unity-text-align: middle-right; }
.lu-root .lu-c-hr { width: 30px; flex-shrink: 0; margin-left: 10px; -unity-text-align: middle-right; }
.lu-root .lu-c-rbi { width: 30px; flex-shrink: 0; margin-left: 10px; -unity-text-align: middle-right; }
.lu-root .lu-c-cond { width: 26px; flex-shrink: 0; margin-left: 10px; align-items: center; }

/* スタメン行（高さ52・白カード・行間6・左右余白16） */
.lu-root .lu-rows { flex-shrink: 0; }
.lu-root .lu-row {
    flex-direction: row;
    align-items: center;
    height: 52px;
    margin-bottom: 6px;
    padding-left: 17px;   /* 16＋確保した選択枠1（選択時は 2px枠で吸収） */
    padding-right: 17px;
}
.lu-root .lu-row.sbk-card--sel { padding-left: 16px; padding-right: 16px; }
.lu-root .lu-row__ord { font-size: 26px; color: var(--sbk-text); }
.lu-root .lu-row__name-cell { flex-direction: row; align-items: center; }
.lu-root .lu-row__name {
    font-size: 20px;
    letter-spacing: 1.6px;
    color: var(--sbk-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
    min-width: 0;
}
.lu-root .lu-row__info { font-size: 15px; color: var(--sbk-info); white-space: nowrap; overflow: hidden; }
.lu-root .lu-row__avg { font-size: 18px; color: var(--sbk-text); }
.lu-root .lu-row__cnt { font-size: 17px; color: var(--sbk-text); }
/* 名前の下に置く怪我タグ（行高52の中に2段で収める） */
.lu-root .lu-row__name-block { flex-direction: column; justify-content: center; }
.lu-root .lu-row__name-block .sbk-injury { margin-top: 2px; }

/* 警告（編成不備・故障者起用）。本当の警告なので怪我タグと同じ色。空なら非表示。 */
.lu-root .lu-warn {
    font-size: 12px;
    color: var(--sbk-injury-fg);
    white-space: normal;
    margin-top: 4px;
    display: none;
}

/* 先発投手カード（高さ60・列の下端へ寄せる） */
/* 9番打者の行のすぐ下に置く（行間と同じ 6px は行側の margin-bottom で既に空いている）。 */
.lu-root .lu-sp { flex-shrink: 0; }
.lu-root .lu-sp-card {
    flex-direction: row;
    align-items: center;
    height: 60px;
    padding-left: 17px;
    padding-right: 17px;
}
.lu-root .lu-sp-card.sbk-card--sel { padding-left: 16px; padding-right: 16px; }
.lu-root .lu-sp-card__cap { font-size: 13px; color: var(--sbk-sub); }
.lu-root .lu-sp-card__info { font-size: 15px; color: var(--sbk-info); margin-top: 2px; white-space: nowrap; }
.lu-root .lu-sp-stats { flex-direction: row; align-items: center; flex-shrink: 0; margin-left: 10px; }
.lu-root .lu-sp-stats__lab { font-size: 13px; color: var(--sbk-sub); margin-left: 12px; margin-right: 4px; }
.lu-root .lu-sp-stats__val { font-size: 17px; color: var(--sbk-text); }
.lu-root .lu-sp-stats__frac { font-size: 11px; color: var(--sbk-text); align-self: flex-start; margin-top: 0; margin-left: 1px; }

/* ── 中央列：控え（幅290） ── */
.lu-root .lu-bench-col { width: 290px; flex-shrink: 0; margin-right: 24px; }
/* 見出し行の高さ60（スタメン側の「スタメン＋列見出し」と揃える）。ラベルは下寄せ。 */
.lu-root .lu-bench-col__top { height: 60px; flex-shrink: 0; justify-content: flex-end; padding-bottom: 6px; }
.lu-root .lu-bench-scroll { flex-grow: 1; min-height: 0; }
.lu-root .lu-bench-row {
    flex-direction: row;
    align-items: center;
    height: 52px;
    margin-bottom: 6px;
    padding-left: 15px;
    padding-right: 15px;
}
.lu-root .lu-bench-row.sbk-card--sel-ink { padding-left: 14px; padding-right: 14px; }
.lu-root .lu-bench-row__name { font-size: 18px; letter-spacing: 1.4px; color: var(--sbk-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.lu-root .lu-bench-row__cond { width: 24px; flex-shrink: 0; margin-left: 10px; align-items: center; }

/* ── 右列：入れ替え比較（残りの幅すべて・余白18×22） ── */
.lu-root .lu-cmp {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    padding: 18px 22px;
}
.lu-root .lu-cmp__top { flex-direction: row; align-items: center; height: 32px; flex-shrink: 0; }
.lu-root .lu-cmp-scroll { flex-grow: 1; min-height: 0; }

/* 比較表の列：能力名64｜自チーム側｜間24｜比較相手。見出し・能力行・守備適性で同じ構成。 */
.lu-root .lu-cmp-lab { width: 64px; flex-shrink: 0; font-size: 12px; color: var(--sbk-sub); }
.lu-root .lu-cmp-col { flex-grow: 1; flex-basis: 0; min-width: 0; }
.lu-root .lu-cmp-gap { width: 24px; flex-shrink: 0; }

/* 選手の見出し（上端に3pxの線：自チーム側＝差し色、比較相手＝墨） */
.lu-root .lu-cmp__head { flex-direction: row; flex-shrink: 0; margin-top: 10px; padding-bottom: 12px; border-bottom-width: 1px; border-bottom-color: var(--sbk-rule-soft); }
.lu-root .lu-cmp-pl { border-top-width: 3px; padding-top: 10px; }
.lu-root .lu-cmp-pl--b { border-top-color: var(--sbk-ink); }
.lu-root .lu-cmp-pl--none { border-top-color: var(--sbk-rule-soft); }
.lu-root .lu-cmp-pl__name { font-size: 20px; letter-spacing: 1.6px; color: var(--sbk-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.lu-root .lu-cmp-pl__meta { font-size: 12px; color: var(--sbk-info); margin-top: 4px; white-space: nowrap; overflow: hidden; }
.lu-root .lu-cmp-pl .cat-rank-chips { margin-top: 6px; justify-content: flex-start; }
.lu-root .lu-cmp-pl .cat-rank-chips__label { font-size: 11px; color: var(--sbk-sub); }
/* 特殊能力のタグ（11px・枠付きの丸いタグ） */
.lu-root .lu-cmp-pl .skill-chips { margin-top: 6px; }
.lu-root .lu-cmp-pl .skill-chip {
    height: 20px;
    font-size: 11px;
    color: var(--sbk-info);
    border-color: var(--sbk-card-line-hover);
    border-radius: 10px;
    padding: 0 8px;
    margin: 0 4px 4px 0;
}

/* 能力の行（高さ26） */
.lu-root .lu-cmp__rows { margin-top: 8px; }
.lu-root .lu-cmp-row { flex-direction: row; align-items: center; height: 26px; }

/* 守備適性（9マス）。共通部品 AptitudeStrip を、この画面の列（能力名64）に合わせて敷き直す。 */
.lu-root .lu-cmp__apt { margin-top: 12px; padding-top: 10px; border-top-width: 1px; border-top-color: var(--sbk-rule-soft); }
.lu-root .lu-cmp__apt.lu-hidden { display: none; }
.lu-root .lu-cmp__apt .apt-strip { margin-top: 0; }
.lu-root .lu-cmp__apt .apt-strip__row { min-height: 26px; }
.lu-root .lu-cmp__apt .apt-strip__row--head { min-height: 18px; }
.lu-root .lu-cmp__apt .apt-strip__lab { width: 64px; font-size: 12px; color: var(--sbk-text); border-left-width: 0; padding-left: 0; }
.lu-root .lu-cmp__apt .apt-strip__row--head .apt-strip__lab { color: var(--sbk-sub); }
.lu-root .lu-cmp__apt .apt-strip__pos { font-size: 12px; color: var(--sbk-sub); }
.lu-root .lu-cmp__apt .apt-strip__cell .rank-chip { min-width: 22px; height: 22px; padding: 0; }

/* 持ち球チャート（投手能力タブ）と成績表（④で存置） */
.lu-root .lu-cmp__chart { flex-direction: row; margin-top: 12px; }
.lu-root .lu-cmp__chart-cell { flex-grow: 1; flex-basis: 0; min-width: 0; height: 150px; }
.lu-root .lu-cmp__stats { margin-top: 12px; padding-top: 10px; border-top-width: 1px; border-top-color: var(--sbk-rule-soft); }
/* 成績表は能力表と同じ列（ラベル64）に揃え、級数を比較表の小見出しと揃える。 */
.lu-root .lu-cmp__stats .stat-table__row { height: 22px; }
.lu-root .lu-cmp__stats .stat-table__row--head { height: 18px; }
.lu-root .lu-cmp__stats .stat-table__lab { width: 64px; font-size: 12px; color: var(--sbk-sub); }
.lu-root .lu-cmp__stats .stat-table__scope { font-size: 12px; color: var(--sbk-sub); -unity-text-align: middle-right; }
.lu-root .lu-cmp__stats .stat-table__val { font-size: 15px; color: var(--sbk-text); -unity-text-align: middle-right; }
.lu-root .lu-cmp-stat-name { font-size: 12px; color: var(--sbk-info); margin-top: 6px; margin-bottom: 2px; }

/* ── フッター（高さ56） ── */
.lu-root .lu-foot { flex-direction: row; height: 56px; flex-shrink: 0; margin-top: 20px; }
.lu-root Button.lu-cancel {
    width: 160px;
    flex-shrink: 0;
    margin: 0;
    font-size: 15px;
    color: var(--sbk-sub);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}
.lu-root Button.lu-cancel:hover { color: var(--sbk-text); }
.lu-root Button.lu-ok {
    flex-grow: 1;
    margin: 0;
    font-size: 18px;
    letter-spacing: 3.6px;
    color: #FFFFFF;
    border-width: 0;
    border-radius: var(--sbk-r-card);
}
/* 差し色の塗りは実行時に直接入るので、ホバーは塗り替えず不透明度で示す。 */
.lu-root Button.lu-ok:hover { opacity: 0.9; }
.lu-root Button.lu-ok:disabled { opacity: 0.4; }
