<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="LineScorePanel" src="Components/LineScorePanel.uxml" />
    <ui:Template name="ScoreBug" src="Components/ScoreBug.uxml" />
    <Style src="tokens.uss" />
    <Style src="KokoSimTheme.uss" />
    <Style src="Components/components.uss" />
    <Style src="MatchDetail.uss" />
    <Style src="MatchLive.uss" />
    <Style src="MatchSubstitution.uss" />
    <ui:VisualElement class="ui-root mlive-root">
        <ui:VisualElement class="mlive-3col">

            <!-- 左列: 自校スタメン -->
            <ui:VisualElement class="mlive-col mlive-col--side">
                <ui:Label name="left-team" class="mlive-col-title" text="自校" />
                <ui:VisualElement name="left-lineup" class="mlive-lineup" />
                <ui:VisualElement name="left-pitcher" class="mlive-pitcher-host" />
            </ui:VisualElement>

            <!-- 中央列: スコアボード＋盤面＋実況 -->
            <ui:VisualElement class="mlive-col mlive-col--center">

                <!-- 上部の常設ラインスコアは撤去した（盤面を縦に使い切るため）。回別得点は
                     攻守交代のイニング間画面（下の inning-break）へ移し、点差・カウント・塁は
                     盤面左上の ScoreBug が常時受け持つ。 -->
                <ui:VisualElement class="mlive-field-wrap">
                    <ui:VisualElement name="field-host" class="mlive-field" />
                    <!-- 対決ビュー（設計書18 A案）。盤面と差し替えで表示する3D RTのホスト。
                         中身の DuelViewElement は MatchLiveController が生成し整数倍サイズへスナップする。 -->
                    <ui:VisualElement name="duel-host" class="mlive-duel" />
                    <!-- 高速試合モード（design-06 §3.4）。演出（対決ビュー/2D俯瞰）を出さず、盤面をこの
                         大型ラインスコアに差し替えて実時間経過で半イニングずつ進める。ScoreBug（得点・BSO・塁）
                         は下で常時表示のまま重ねて残す＝このホストより先に置いて背面に敷く（DOM順=描画順）。
                         中身の充填は MatchLiveController.PostFastModeBoard が LineScorePanel.Fill を叩く。 -->
                    <ui:VisualElement name="fastmode-board" class="fastmode-board" style="display: none;">
                        <ui:Instance template="LineScorePanel" />
                    </ui:VisualElement>
                    <!-- 中継風の常時表示バグ。盤面の左上に出しっぱなしにして、打席の演出中も
                         カウント・塁・両校の得点を切らさない。俯瞰と対決ビューのどちらでも同じ位置に残る。 -->
                    <ui:Instance template="ScoreBug" />
                    <!-- 守備フォーカス中の小ダイヤモンド（issue #595）。守備カメラは球に寄って追随するので
                         枠外の走者が映らない＝止まったのか回ったのかが読めない。盤面の右下に画面固定で
                         走者ドットと塁だけを描いて補う。中身の MiniDiamondElement は MatchLiveController が
                         生成する。既定は非表示（守備フォーカス中だけ・打席の寄りでは出さない）。 -->
                    <ui:VisualElement name="minidia-host" class="mdia-host" />
                    <ui:VisualElement name="hud-host" class="matchup-hud" />
                    <!-- 1球ごとの判定＋球速球種（短時間で自動的に消えるので既存UIと重なってよい）。
                         judge は影用の複製を先に置いて背面に敷く（USS の text_shadow は1要素1つしか
                         持てないので、ぼかし影は面のラベル・硬い影はこの複製が担う。issue #479）。
                         下段は球種と球速を別ラベルに割る（数字は Oswald・和文はサンセリフ＝書体3役ルール）。 -->
                    <!-- 走った！の叫び吹き出し（issue #696）。走者の元の塁ごとの BurstBalloon を MatchLiveController が
                         この層へ生成し、その球でスタートを切った塁だけ出す。クリックは素通し。 -->
                    <ui:VisualElement name="runner-go-host" class="runner-go" picking-mode="Ignore" />
                    <ui:VisualElement name="pitch-call" class="pitch-call">
                        <ui:VisualElement class="pitch-call__stack">
                            <ui:Label name="pitch-call-judge-sh" class="pitch-call__judge pitch-call__judge--shadow" text="" />
                            <ui:Label name="pitch-call-judge" class="pitch-call__judge" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement name="pitch-call-detail" class="pitch-call__readout">
                            <ui:Label name="pitch-call-note" class="pitch-call__note f-body" text="" />
                            <ui:Label name="pitch-call-ptype" class="pitch-call__ptype f-body-bd" text="" />
                            <ui:Label name="pitch-call-speed" class="pitch-call__speed f-num-bd" text="" />
                            <ui:Label name="pitch-call-unit" class="pitch-call__unit f-body" text="km/h" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <!-- 打球・走塁プレーの判定（アウト/セーフ/フェア/ホームラン）。以前は俯瞰の描画部品が
                         内側に持っていたが、守備を3Dへ一本化すると盤面ごと隠れて判定が出なくなるため、
                         俯瞰と3Dの両方にかかるこの層へ出した。中身を書くのは Match2DPlaybackElement のまま。 -->
                    <ui:VisualElement name="judgement-call" class="pitch-call">
                        <ui:VisualElement class="pitch-call__stack">
                            <ui:Label name="judgement-judge-sh" class="pitch-call__judge pitch-call__judge--shadow" text="" />
                            <ui:Label name="judgement-judge" class="pitch-call__judge" text="" />
                        </ui:VisualElement>
                        <ui:Label name="judgement-detail" class="pitch-call__detail" text="" />
                    </ui:VisualElement>
                    <!-- 得点時の大型スコア（issue #60）。自校－相手校固定・加点前→1点ずつ加算→加点後で自動的に消える。 -->
                    <ui:VisualElement name="score-call" class="score-call">
                        <ui:VisualElement class="score-call__panel">
                            <ui:Label name="score-call-own-name" class="score-call__team f-display" text="" />
                            <ui:Label name="score-call-own-num" class="score-call__num f-num-bd" text="" />
                            <ui:Label name="score-call-sep" class="score-call__sep f-num-bd" text="-" />
                            <ui:Label name="score-call-opp-num" class="score-call__num f-num-bd" text="" />
                            <ui:Label name="score-call-opp-name" class="score-call__team f-display" text="" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 交代ポップアップ（issue #209 表現）。継投・投野交代・野手登板が起きた瞬間に数秒だけ盤面へ浮かせる。
                         PitchCall/ScoreCall と同じ overlay idiom（半透明パネル・既定非表示・自前寿命で消去）。 -->
                    <ui:VisualElement name="sub-call" class="sub-call">
                        <ui:VisualElement class="sub-call__panel">
                            <ui:Label name="sub-call-tag" class="sub-call__tag f-body" text="投手交代" />
                            <ui:Label name="sub-call-text" class="sub-call__text f-body" text="" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- イニング間のスコア画面。3アウトで攻守が入れ替わったら、次の打席を始める前に
                         数秒だけ挟んで回別得点を大写しにする（クリックで即スキップ）。
                         上部から撤去したラインスコアはここが唯一の置き場所になる。 -->
                    <ui:VisualElement name="inning-break" class="inning-break">
                        <ui:Label name="ib-caption" class="inning-break__caption f-display" text="" />
                        <ui:Instance template="LineScorePanel" />
                        <ui:Label class="inning-break__hint f-body" text="クリックで続ける" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 采配指示の手札（試合画面改修）。盤面の直下・中央寄せ。中身の TacticsCardDeck は
                     MatchLiveController が生成する（カードの寸法は部品が持つ）。 -->
                <ui:VisualElement name="tactics-host" class="tcards-host" />

                <!-- 残置した常時操作（issue #289 で操作列を縮小）: 速度・カメラ演出・対決ビューだけ。
                     1球指示は盤面内・投手HUD直下の SignPad へ、タイム・選手交代・スキップは
                     「盤面クリック→中断ポップアップ」(pause-modal) へ集約した。実況帯（履歴・実況バー）は
                     撤去＝ロジックのみ存続（MatchLiveController）。back-home はデモ観戦（結果画面へ
                     渡さない文脈）の終局時だけ出るフォールバック導線。 -->
                <ui:VisualElement class="md-controls">
                    <ui:VisualElement class="md-group">
                        <ui:Button name="spd-05" class="chip-btn" text="×0.5" />
                        <ui:Button name="spd-1" class="chip-btn chip-btn--on" text="×1" />
                        <ui:Button name="spd-2" class="chip-btn" text="×2" />
                        <ui:Button name="spd-4" class="chip-btn" text="×4" />
                        <ui:Button name="spd-fast" class="chip-btn" text="⚡高速" />
                    </ui:VisualElement>
                    <ui:VisualElement class="md-group">
                        <ui:Button name="cam-work" class="chip-btn" text="🎥 カメラ演出" />
                        <ui:Button name="duel-view" class="chip-btn" text="2D俯瞰（デバッグ）" />
                        <ui:Button name="back-home" class="chip-btn md-replay" text="ホームへ戻る ▶" style="display: none;" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- 右列: 相手校スタメン（ミラー配置） -->
            <ui:VisualElement class="mlive-col mlive-col--side">
                <ui:Label name="right-team" class="mlive-col-title mlive-col-title--right" text="相手校" />
                <ui:VisualElement name="right-lineup" class="mlive-lineup" />
                <ui:VisualElement name="right-pitcher" class="mlive-pitcher-host" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- クリック中断ポップアップ（issue #289・案P1）。盤面のどこをクリックしても進行を一時停止して開く。
             クリック中断は演出の停止だけ＝エンジンに触れない（伝令は消費しない。消費は中の「伝令を送る」だけ）。
             選手交代は伝令なしで可（設計書09 §3 改・issue #289）。sub-modal より前に置く＝交代モーダルが上に重なる。
             器は部品の modal-scrim / modal-card、ボタンは交代モーダルと同じ msub-btn 系を流用。 -->
        <ui:VisualElement name="pause-modal" class="ui-root modal-scrim">
            <ui:VisualElement class="modal-card pausem-card">
                <ui:Label class="pausem-title" text="タイム" />
                <ui:Label name="pm-situation" class="pausem-situation" text="" />
                <ui:VisualElement name="pm-menu">
                    <ui:VisualElement class="pausem-row">
                        <ui:Button name="pm-timeout" class="msub-btn msub-btn--ghost pausem-btn" text="📣 伝令を送る" />
                        <ui:Button name="pm-sub" class="msub-btn msub-btn--ghost pausem-btn" text="⇄ 選手交代" />
                    </ui:VisualElement>
                    <ui:VisualElement class="pausem-row">
                        <ui:Button name="pm-scout" class="msub-btn msub-btn--ghost pausem-btn" text="🔍 選手能力" />
                        <ui:Button name="pm-skip" class="msub-btn msub-btn--ghost pausem-btn" text="⏭ スキップ（委任）" />
                    </ui:VisualElement>
                    <ui:VisualElement class="pausem-row">
                        <ui:Button name="pm-resume" class="msub-btn msub-btn--go pausem-btn pausem-btn--wide" text="▶ 再開" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <!-- 伝令役の人選（issue #716・A案）: 「伝令を送る」を押すとメニューと入れ替わる。
                     行を押すとその控えを伝令に出して閉じる。効き目の数字・状態は出さない（名前・学年・性格だけ）。 -->
                <ui:VisualElement name="pm-messenger" class="pausem-messenger" style="display: none;">
                    <ui:Label name="pm-messenger-cap" class="pausem-messenger__cap" text="誰を伝令に？" />
                    <ui:ScrollView name="pm-messenger-list" class="pausem-messenger__list" />
                    <ui:VisualElement class="pausem-row">
                        <ui:Button name="pm-messenger-back" class="msub-btn msub-btn--ghost pausem-btn pausem-btn--wide" text="もどる" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 選手能力ビューア（issue #602）。タイム（pause-modal）から開き、閉じるとポップアップへ戻る。
             両校の打線・現投手・控えを左右に並べ、行の右に能力をランクチップで出す（監督決定 A案）。
             **読むだけ**＝エンジンに一切触れない（伝令を消費しない・乱数を引かない・決定論不変）。
             骨組みだけ置き、行は MatchScoutPanel が部品辞書で動的生成する。 -->
        <ui:VisualElement name="scout-modal" class="ui-root modal-scrim">
            <ui:VisualElement class="modal-card mscout-card">

                <ui:VisualElement class="mscout-head">
                    <ui:Label text="選手能力" class="msub-title" />
                    <ui:Label name="mscout-situation" text="" class="msub-phase" />
                    <ui:VisualElement name="mscout-tabs" class="seg-tabs mscout-tabs" />
                    <ui:VisualElement class="msub-head__spacer" />
                    <ui:Button name="mscout-close" text="✕" class="msub-close" />
                </ui:VisualElement>

                <ui:VisualElement class="mscout-body">
                    <ui:VisualElement name="mscout-left" class="mscout-team" />
                    <ui:VisualElement name="mscout-right" class="mscout-team mscout-team--last" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 選手交代モーダル（設計書09 §6）。同一ドキュメント内オーバーレイ（modal-scrim/modal-card）。
             骨組みだけ置き、行・比較は MatchSubstitutionPanel が部品辞書で動的生成する。
             スタメン設定と同じ部品（lineup-row / bench-row / pos-chip / rank-chip / abil-row）を使う。 -->
        <ui:VisualElement name="sub-modal" class="ui-root modal-scrim">
            <ui:VisualElement class="modal-card msub-card">

                <ui:VisualElement class="msub-head">
                    <ui:Label text="選手交代" class="msub-title" />
                    <ui:Label name="msub-phase" text="" class="msub-phase" />
                    <ui:VisualElement name="msub-kinds" class="seg seg--auto msub-kinds" />
                    <ui:VisualElement class="msub-head__spacer" />
                    <ui:Button name="msub-close" text="✕" class="msub-close" />
                </ui:VisualElement>

                <ui:VisualElement class="msub-body">

                    <!-- 左：退く選手（打順9人／塁上の走者／現投手） -->
                    <ui:VisualElement class="msub-outs">
                        <ui:Label name="msub-outs-cap" text="退く選手" class="msub-section" />
                        <ui:ScrollView mode="Vertical" class="msub-scroll">
                            <ui:VisualElement name="msub-out-rows" />
                        </ui:ScrollView>
                        <!-- 予約した交代（issue #718）。打順表の下の空きに出す（モーダルの高さを変えない）。
                             確定して試合へ戻るまでは「全部やめる」で開く前へ戻せる。 -->
                        <ui:VisualElement name="msub-queue" class="msub-queue" style="display: none;" />
                    </ui:VisualElement>

                    <!-- 中：入る選手（控え／DHの行き先） -->
                    <ui:VisualElement class="msub-ins">
                        <ui:Label name="msub-ins-cap" text="入る選手" class="msub-section" />
                        <ui:ScrollView mode="Vertical" class="msub-scroll">
                            <ui:VisualElement name="msub-in-rows" />
                        </ui:ScrollView>
                    </ui:VisualElement>

                    <!-- 右：能力比較（退く選手 ↔ 入る選手）。投手が絡む操作のときだけ msub-cmp-toggle に
                         「投球／打撃・守備」の切替が乗る（守備位置を考えたいときに野手情報も見られる）。 -->
                    <ui:VisualElement class="msub-compare panel">
                        <ui:VisualElement name="msub-cmp-toggle" class="msub-cmp-toggle" />
                        <ui:VisualElement class="msub-cmp-cards">
                            <ui:VisualElement name="msub-cmp-a" class="cmp-card msub-cmp-card--a" />
                            <ui:VisualElement name="msub-cmp-b" class="cmp-card" />
                        </ui:VisualElement>
                        <ui:ScrollView mode="Vertical" class="msub-cmp-scroll">
                            <ui:VisualElement name="msub-cmp-rows" />
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label name="msub-note" text="" class="msub-note" />
                <ui:VisualElement class="msub-actions">
                    <ui:Button name="msub-cancel" text="やめる" class="msub-btn msub-btn--ghost" />
                    <ui:Button name="msub-ok" text="この操作を予約 ＋" class="msub-btn msub-btn--ghost" />
                    <ui:Button name="msub-commit" text="試合へ戻る ▶" class="msub-btn msub-btn--go" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
