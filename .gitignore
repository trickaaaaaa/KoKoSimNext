# --- .NET エンジン ---
engine/**/bin/
engine/**/obj/
[Oo]ut/
*.user

# --- バランスレポート出力（成果物は都度貼るため追跡しない） ---
out/

# --- Unity（既存プロジェクト） ---
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]serSettings/
[Bb]uild/
[Bb]uilds/
*.csproj
*.sln
!engine/KokoSim.sln
!engine/**/*.csproj

# --- 購入アセット（再配布NG・公開リポジトリに含めない。design-18 §3.1） ---
Assets/Animo/
Assets/Animo.meta
Assets/DuelSpike/Vendor/
Assets/DuelSpike/Vendor.meta

# --- Mixamo モーション（Adobe 素材。作品への使用は自由だが素材単体の再配布はNG） ---
# Assets/Motions/ 直下は自作収録＝追跡するが、このサブフォルダだけ外す。
# インポート既定（DuelMotionImportDefaults）は Assets/Motions/ 配下なら効くので置き場所は変えない。
Assets/Motions/Mixamo/
Assets/Motions/Mixamo.meta

# --- アート中間生成物（AI生成の高密度FBX。デシメート後の *_lo.fbx だけを Assets 側で追跡） ---
art-src/
# AI生成の入力参照画像と生の出力（他社製品の写真を含むため追跡しない。デシメート後だけを持つ）
Assets/_AIGearRaw/
Assets/_AIGearRaw.meta

# --- Unity クラッシュ復旧シーン（自動生成の退避物） ---
Assets/_Recovery/
Assets/_Recovery.meta

# --- OS / IDE ---
.DS_Store
.vs/

# --- Claude Code ローカル状態（settings.json と hooks は共有・これらは端末ローカル） ---
.claude/settings.local.json
.claude/scheduled_tasks.lock

# --- 検証用スクリーンショット（コミットしない・2026-07-29 監督指示） ---
# 撮影ハーネス（*Shooter.cs）でいつでも撮り直せる作業成果物なので履歴に載せない。
# main に既にあるぶんは追跡が残るが、新規は追加しない。
screenshots/

# テスト実行の成果物（dotnet test --logger trx）
TestResults/

# 対決／守備ビューのビルド同梱索引（F8）。購入素体・購入クリップの GUID 参照を含む＝
# 実質的な再配布経路になるので履歴に載せない。焼き直しは
# メニュー「KokoSim/Duel/F8 ビルド同梱の索引を焼く」で作れる
Assets/KokoSim/Resources/
Assets/KokoSim/Resources.meta
